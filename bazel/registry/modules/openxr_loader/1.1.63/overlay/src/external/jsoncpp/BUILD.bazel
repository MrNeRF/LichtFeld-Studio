load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Replaces jsoncpp's own BUILD.bazel (which compiles with JSON_USE_EXCEPTION=0).
# Used by the OpenXR loader only with --@openxr_loader//:bundled_jsoncpp=True;
# built with exceptions enabled, as upstream's CMake build of the loader does.
cc_library(
    name = "jsoncpp",
    srcs = [
        "src/lib_json/json_reader.cpp",
        "src/lib_json/json_tool.h",
        "src/lib_json/json_value.cpp",
        "src/lib_json/json_valueiterator.inl",
        "src/lib_json/json_writer.cpp",
    ],
    hdrs = [
        "include/json/allocator.h",
        "include/json/assertions.h",
        "include/json/config.h",
        "include/json/forwards.h",
        "include/json/json.h",
        "include/json/json_features.h",
        "include/json/reader.h",
        "include/json/value.h",
        "include/json/version.h",
        "include/json/writer.h",
    ],
    includes = ["include"],
    visibility = ["//:__pkg__"],
)
