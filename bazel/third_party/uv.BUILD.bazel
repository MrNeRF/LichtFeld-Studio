# Prebuilt uv (https://github.com/astral-sh/uv), bundled for plugin package management.
package(default_visibility = ["//visibility:public"])

exports_files([
    "uv.exe",
    "uvw.exe",
    "uvx.exe",
])

filegroup(
    name = "uv",
    srcs = ["uv.exe"],
)
