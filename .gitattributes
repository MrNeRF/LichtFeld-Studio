src/python/stubs/**/*.pyi text eol=lf
tests/data/param_json_golden/*.json text eol=lf
tools/ci_format_push.sh text eol=lf

# vcpkg applies these patches to sources extracted with LF line endings.
.github/overlays/**/*.patch text eol=lf
.github/overlays/**/*.diff text eol=lf

# Unified-diff prefixes are not source indentation.
.github/overlays/rmlui/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
