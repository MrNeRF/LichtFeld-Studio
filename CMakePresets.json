{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "build",
      "displayName": "Build",
      "description": "Release build: full application dependency set, one locally detected CUDA architecture, tests off, compiler cache on",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BUILD_UNICODE_TEST_ONLY": "OFF",
        "ENABLE_COMPILER_CACHE": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Same feature set as build, compiled with debug information",
      "inherits": "build",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "build",
      "jobs": 6
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 6
    }
  ]
}
