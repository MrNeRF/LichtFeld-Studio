cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/HipArchitectures.cmake")
set(LFS_HIP_OFFLOAD_COMPRESSION OFF)
set(LFS_HIP_PORTABLE ON)
lfs_hip_architectures()
foreach(required IN ITEMS gfx1100 gfx1150 gfx1200 gfx900 gfx906 gfx908 gfx90a gfx942 gfx950)
    if(NOT required IN_LIST LFS_HIP_EFFECTIVE_ARCHITECTURES)
        message(FATAL_ERROR "Portable HIP build omitted ${required}")
    endif()
endforeach()
# Explicit mixed lists override portable defaults and retain deterministic order.
set(LFS_HIP_ARCHITECTURES "gfx942;gfx1150;gfx942")
lfs_hip_architectures()
if(NOT LFS_HIP_COMPILED_ARCHITECTURES STREQUAL "gfx942,gfx1150" OR
        NOT LFS_HIP_OFFLOAD_FLAGS STREQUAL "--offload-arch=gfx942;--offload-arch=gfx1150")
    message(FATAL_ERROR "Mixed wave32/wave64 targets lost explicit selection or duplicate removal")
endif()
set(LFS_HIP_PORTABLE OFF)
set(LFS_HIP_ARCHITECTURES "")
set(LFS_HIP_ARCHITECTURE gfx1150)
lfs_hip_architectures()
if(NOT LFS_HIP_COMPILED_ARCHITECTURES STREQUAL "gfx1150")
    message(FATAL_ERROR "Default developer target changed")
endif()
if(TEST_UNSUPPORTED)
    set(LFS_HIP_ARCHITECTURE "gfx942/../gfx1150")
    lfs_hip_architectures()
    message(FATAL_ERROR "Unsupported target was admitted")
endif()
message(STATUS "PASS HIP portable wave32/wave64, mixed explicit list and unchanged developer target")
