cmake_minimum_required(VERSION 3.30)
if(NOT TEST_ROOT)
    message(FATAL_ERROR "Pass an isolated TEST_ROOT")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/source" "${TEST_ROOT}/stage")
file(WRITE "${TEST_ROOT}/source/libfixture.so.1.2" "One physical runtime payload\n")
file(CREATE_LINK "libfixture.so.1.2" "${TEST_ROOT}/source/libfixture.so.1" SYMBOLIC RESULT _result)
if(NOT _result STREQUAL "0")
    message(STATUS "SKIP symlink staging: ${_result}")
    return()
endif()
file(CREATE_LINK "libfixture.so.1" "${TEST_ROOT}/source/libfixture.so" SYMBOLIC)
set(LFS_HIP_RUNTIME_FILES "${TEST_ROOT}/source/libfixture.so")
set(LFS_HIP_RUNTIME_DEST "${TEST_ROOT}/stage")
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/StageHipRuntime.cmake")
foreach(name libfixture.so libfixture.so.1)
    if(NOT IS_SYMLINK "${TEST_ROOT}/stage/${name}")
        message(FATAL_ERROR "Runtime alias was expanded to a duplicate payload: ${name}")
    endif()
endforeach()
file(READ "${TEST_ROOT}/stage/libfixture.so" _content)
if(NOT _content STREQUAL "One physical runtime payload\n")
    message(FATAL_ERROR "Runtime soname chain is broken")
endif()
message(STATUS "PASS soname aliases preserve links and one physical payload")
