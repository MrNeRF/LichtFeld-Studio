# Compile the exact production occupancy query into a compute probe.
function(lfs_collision_query_shader target)
    find_program(LFS_COLLISION_GLSLANG NAMES glslangValidator glslang
        HINTS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/tools/glslang")
    if(NOT LFS_COLLISION_GLSLANG)
        message(STATUS "Collision occupancy GPU probe requires glslangValidator")
        return()
    endif()
    get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(fragment "${root}/src/visualizer/rendering/resources/viewport/collision_overlay.frag")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fragment}")
    file(READ "${fragment}" source)
    string(FIND "${source}" "// Cache the terminal region" start)
    string(FIND "${source}" "void main()" finish)
    if(start LESS 0 OR finish LESS start)
        message(FATAL_ERROR "Collision occupancy shader extraction boundary missing")
    endif()
    math(EXPR length "${finish}-${start}")
    string(SUBSTRING "${source}" ${start} ${length} query)
    set(compute "${CMAKE_CURRENT_BINARY_DIR}/${target}_query.comp")
    set(spirv "${compute}.spv")
    file(WRITE "${compute}" "#version 450\nlayout(set=0,binding=0,std430) readonly buffer Volume { ivec4 dimensions_edge; uint words[]; } volume;\n${query}\nlayout(set=0,binding=1,std430) buffer Probes { ivec4 data[]; } probes;\nlayout(local_size_x=1) in;\nvoid main() { cached_edge=0; for(uint i=0;i<256;i++) { uint index=(gl_GlobalInvocationID.x*256+i)*3; ivec3 lo,hi; bool hit=occupied(probes.data[index].xyz,lo,hi); probes.data[index+1]=ivec4(lo,int(hit)); probes.data[index+2]=ivec4(hi,0); } }\n")
    add_custom_command(OUTPUT "${spirv}" COMMAND "${LFS_COLLISION_GLSLANG}" -V -S comp "${compute}" -o "${spirv}" DEPENDS "${compute}" "${fragment}" VERBATIM)
    add_custom_target(${target}_query_shader DEPENDS "${spirv}")
    add_dependencies(${target} ${target}_query_shader)
    target_compile_definitions(${target} PRIVATE LFS_COLLISION_QUERY_SPIRV="${spirv}")
endfunction()
