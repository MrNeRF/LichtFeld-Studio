cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/../../../cmake/CollectHipRuntime.cmake")
if(EXPECT_INCOMPLETE)
    lfs_hip_windows_runtime_files(files "${TEST_SDK}")
    message(FATAL_ERROR "Incomplete SDK was unexpectedly accepted")
endif()
lfs_hip_windows_runtime_files(files "${TEST_SDK}")
set(names "")
foreach(path IN LISTS files)
    cmake_path(GET path FILENAME name)
    list(APPEND names "${name}")
endforeach()
if(NOT "amdocl64.dll" IN_LIST names OR NOT "amdhip64_fixture.dll" IN_LIST names)
    message(FATAL_ERROR "An imported legacy OpenCL runtime was omitted: ${names}")
endif()
if("unrelated.dll" IN_LIST names)
    message(FATAL_ERROR "Unrelated SDK DLL was bundled")
endif()
set(LFS_HIP_RUNTIME_FILES "${files}")
set(LFS_HIP_RUNTIME_DEST "${TEST_ROOT}/stage with spaces")
include("${CMAKE_CURRENT_LIST_DIR}/../../../cmake/StageHipRuntime.cmake")
foreach(name IN LISTS names)
    if(NOT EXISTS "${LFS_HIP_RUNTIME_DEST}/${name}")
        message(FATAL_ERROR "Runtime staging omitted ${name}")
    endif()
endforeach()
message(STATUS "PASS imported legacy runtime closure, unrelated DLL exclusion and staging")

# An older SDK without inspection tools must retain conservative dependencies.
set(_fallback "${TEST_ROOT}/sdk without inspection")
file(MAKE_DIRECTORY "${_fallback}/bin")
foreach(name IN LISTS names)
    file(COPY "${TEST_SDK}/bin/${name}" DESTINATION "${_fallback}/bin")
endforeach()
lfs_hip_windows_runtime_files(_fallback_files "${_fallback}")
foreach(name amdhip64_fixture.dll amd_comgr.dll hiprtc_fixture.dll amdocl64.dll)
    if(NOT "${_fallback}/bin/${name}" IN_LIST _fallback_files)
        message(FATAL_ERROR "Conservative fallback omitted ${name}")
    endif()
endforeach()

# Missing mandatory dynamic roots must fail rather than ship a broken package.
file(MAKE_DIRECTORY "${TEST_ROOT}/incomplete-sdk/bin")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_SDK=${TEST_ROOT}/incomplete-sdk"
    -DEXPECT_INCOMPLETE=ON -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE _status OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
if(_status EQUAL 0 OR NOT _stderr MATCHES "HIP packaging requires")
    message(FATAL_ERROR "Incomplete SDK rejection did not report its missing roots: ${_stdout}${_stderr}")
endif()
message(STATUS "PASS conservative fallback and incomplete SDK rejection")