#usda 1.0
(
    defaultPrim = "Parent"
)

def Xform "Parent"
{
    double3 xformOp:scale = (2, 3, 4)
    double3 xformOp:translate = (10, 20, 30)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def ParticleField3DGaussianSplat "Splats"
    {
        float[] opacities = [0.5, 0.5, 0.5]
        quatf[] orientations = [(1, 0, 0, 0), (1, 0, 0, 0), (1, 0, 0, 0)]
        point3f[] positions = [(-0.5, 1, 2), (3, -4, 5.5), (6, 7, -8)]
        float3[] radiance:sphericalHarmonicsCoefficients = [(0.1, 0.2, 0.3), (0.1, 0.2, 0.3), (0.1, 0.2, 0.3)]
        uniform int radiance:sphericalHarmonicsDegree = 0
        float3[] scales = [(1, 1, 1), (1, 1, 1), (1, 1, 1)]
    }
}
