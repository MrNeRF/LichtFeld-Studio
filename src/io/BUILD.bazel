# io module (CMake: src/io/CMakeLists.txt)
#
#   io_cuda          IO CUDA kernels (morton, k-means, image formats, ...)
#   io_rad_quant     RAD encode quantization (IEEE arithmetic, no fast math)
#   lfs_video        video encode/decode (FFmpeg, libplacebo HDR, CUDA)
#   lfs_io           loaders/exporters/.licht project container

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:lfs.bzl", "cc_headers_only", "lfs_cc_library", "lfs_cuda_library")

package(default_visibility = ["//:__subpackages__"])

#-------------------------------------------------------------------------------------
# Headers
#-------------------------------------------------------------------------------------

cc_headers_only(
    name = "third_party_headers",
    deps = [
        "@libarchive//libarchive:archive",
        "@openmesh",
    ],
)

cc_library(
    name = "headers",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.cuh",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    deps = [
        ":third_party_headers",
        "//bazel/deps:ffmpeg_headers",
        "//src/core:headers",
    ],
)

# CMake: lfs_io_cuda (PUBLIC), lfs_video and lfs_io add src/io as include
# directory ("cuda/kmeans.hpp", "formats/...", "video/...").
cc_library(
    name = "io_includes",
    includes = ["."],
    visibility = ["//visibility:private"],
    deps = [":headers"],
)

#-------------------------------------------------------------------------------------
# CUDA
#-------------------------------------------------------------------------------------

# CMake: lfs_io_cuda
lfs_cuda_library(
    name = "io_cuda",
    srcs = [
        "cuda/image_format_kernels.cu",
        "cuda/image_sharpen.cu",
        "cuda/kmeans.cu",
        "cuda/masked_image_fill.cu",
        "cuda/morton_encoding.cu",
    ],
    deps = [
        ":io_includes",
        ":io_splat_decimate_cuda",
        "//src/diagnostics:lfs_diagnostics",
    ],
)

# Reference decimation needs IEEE arithmetic despite the IO CUDA fast-math defaults.
lfs_cuda_library(
    name = "io_splat_decimate_cuda",
    srcs = ["cuda/splat_decimate.cu"],
    copts = [
        "--fmad=false",
        "--ftz=false",
        "--prec-div=true",
        "--prec-sqrt=true",
    ],
    deps = [
        ":io_includes",
        "//src/diagnostics:lfs_diagnostics",
    ],
)

# CMake: lfs_io_rad_quant_cuda. Bit-parity with the CPU PropertyEncoder requires
# IEEE arithmetic: no -use_fast_math, no FMA contraction.
lfs_cuda_library(
    name = "io_rad_quant",
    srcs = ["cuda/rad_encode_quant.cu"],
    copts = ["--fmad=false"],
    fast_math = False,
    deps = [
        ":io_includes",
        "//src/diagnostics:lfs_diagnostics",
    ],
)

#-------------------------------------------------------------------------------------
# lfs_video (FFmpeg + CUDA + libplacebo)
#-------------------------------------------------------------------------------------

lfs_cuda_library(
    name = "video_cuda",
    srcs = ["video/color_convert.cu"],
    deps = [":io_includes"],
)

lfs_cc_library(
    name = "lfs_video",
    srcs = [
        "hdr_libplacebo.cpp",
        "hdr_libplacebo_av.c",
        "hdr_tonemap.cpp",
        "video/cuda_frame_handoff.cpp",
        "video/video_encoder.cpp",
        "video/video_metadata.cpp",
        "video_frame_extractor.cpp",
        "video_player.cpp",
    ],
    deps = [
        ":io_includes",
        ":video_cuda",
        "//bazel/deps:ffmpeg",
        "//src/core:lfs_core",
        "@cuda//:cuda",
        "@cuda//:cuda_runtime",
        "@libplacebo",
        "@spdlog",
    ],
)

