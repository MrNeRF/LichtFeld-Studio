#version 450

// Implicit-GEMM convolution for group-one NCHW tensors. A workgroup computes
// 64 output channels by 64 output pixels and reuses each 16-wide K tile.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint w[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint bias[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

shared float tile_w[64][16];
shared float tile_x[16][64];

void main() {
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint local_linear = ly * 16u + lx;
    const uint ow_size = p[80];
    const uint oh_size = p[81];
    const uint spatial_size = ow_size * oh_size;
    const uint oc_size = p[82];
    const uint ic_size = p[84];
    const uint kh_size = p[85];
    const uint kw_size = p[86];
    const uint kernel_area = kh_size * kw_size;
    const uint k_size = ic_size * kernel_area;
    const uint spatial_origin = gl_WorkGroupID.x * 64u;
    const uint oc_origin = gl_WorkGroupID.y * 64u;
    const uint n = gl_WorkGroupID.z;

    float accum[4][4];
    for (uint row = 0u; row < 4u; ++row)
        for (uint col = 0u; col < 4u; ++col)
            accum[row][col] = 0.0;

    for (uint k_origin = 0u; k_origin < k_size; k_origin += 16u) {
        for (uint index = local_linear; index < 1024u; index += 256u) {
            const uint row = index / 16u;
            const uint inner = index % 16u;
            const uint oc = oc_origin + row;
            const uint k = k_origin + inner;
            if (oc < oc_size && k < k_size) {
                const uint ic = k / kernel_area;
                const uint kernel_index = k % kernel_area;
                const uint kh = kernel_index / kw_size;
                const uint kw = kernel_index % kw_size;
                tile_w[row][inner] = uintBitsToFloat(w[p[99] + oc * p[48] + ic * p[49] + kh * p[50] + kw * p[51]]);
            } else {
                tile_w[row][inner] = 0.0;
            }
        }
        for (uint index = local_linear; index < 1024u; index += 256u) {
            const uint inner = index / 64u;
            const uint col = index % 64u;
            const uint k = k_origin + inner;
            const uint spatial = spatial_origin + col;
            float value = 0.0;
            if (k < k_size && spatial < spatial_size) {
                const uint ic = k / kernel_area;
                const uint kernel_index = k % kernel_area;
                const uint kh = kernel_index / kw_size;
                const uint kw = kernel_index % kw_size;
                const uint oh = spatial / ow_size;
                const uint ow = spatial % ow_size;
                const int ih = int(oh * p[87] + kh * p[89]) - int(p[91]);
                const int iw = int(ow * p[88] + kw * p[90]) - int(p[92]);
                if (ih >= 0 && ih < int(p[93]) && iw >= 0 && iw < int(p[94])) {
                    const uint input_index = p[98] + n * p[32] + ic * p[33] + uint(ih) * p[34] + uint(iw) * p[35];
                    value = uintBitsToFloat(a[input_index]);
                }
            }
            tile_x[inner][col] = value;
        }
        barrier();

        for (uint inner = 0u; inner < 16u; ++inner) {
            for (uint row = 0u; row < 4u; ++row) {
                const float weight = tile_w[ly + row * 16u][inner];
                for (uint col = 0u; col < 4u; ++col)
                    accum[row][col] += weight * tile_x[inner][lx + col * 16u];
            }
        }
        barrier();
    }

    for (uint row = 0u; row < 4u; ++row) {
        const uint oc = oc_origin + ly + row * 16u;
        if (oc >= oc_size) continue;
        const float bias_value = p[95] != 0u ? uintBitsToFloat(bias[p[96] + oc * p[97]]) : 0.0;
        for (uint col = 0u; col < 4u; ++col) {
            const uint spatial = spatial_origin + lx + col * 16u;
            if (spatial >= spatial_size) continue;
            o[(n * oc_size + oc) * spatial_size + spatial] = floatBitsToUint(accum[row][col] + bias_value);
        }
    }
}
