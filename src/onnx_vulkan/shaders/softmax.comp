#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint b[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint c[]; };
layout(std430, set = 0, binding = 3) buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

shared float partial[256];

void main() {
    const uint line = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    const uint lane = gl_LocalInvocationID.x;
    if (line >= p[1]) return;

    const uint axis = p[80];
    const uint rank = p[2];
    const uint axis_size = p[81];
    uint coord[8];
    uint cursor = line;
    for (int i = int(rank) - 1; i >= 0; --i) {
        if (uint(i) == axis) coord[i] = 0u;
        else {
            coord[i] = cursor % p[16u + uint(i)];
            cursor /= p[16u + uint(i)];
        }
    }
    uint input_base = p[82];
    uint output_base = 0u;
    for (uint i = 0u; i < rank; ++i) {
        input_base += coord[i] * p[24u + i];
        output_base += coord[i] * p[32u + i];
    }

    float maximum = -1.0 / 0.0;
    for (uint i = lane; i < axis_size; i += 256u)
        maximum = max(maximum, uintBitsToFloat(a[input_base + i * p[24u + axis]]));
    partial[lane] = maximum;
    barrier();
    for (uint stride = 128u; stride != 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] = max(partial[lane], partial[lane + stride]);
        barrier();
    }
    maximum = partial[0];

    float sum = 0.0;
    for (uint i = lane; i < axis_size; i += 256u) {
        const float value = exp(uintBitsToFloat(a[input_base + i * p[24u + axis]]) - maximum);
        o[output_base + i * p[32u + axis]] = floatBitsToUint(value);
        sum += value;
    }
    partial[lane] = sum;
    barrier();
    for (uint stride = 128u; stride != 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    sum = partial[0];
    memoryBarrierBuffer();
    barrier();
    for (uint i = lane; i < axis_size; i += 256u) {
        const uint output_index = output_base + i * p[32u + axis];
        o[output_index] = floatBitsToUint(uintBitsToFloat(o[output_index]) / sum);
    }
}
