#version 450

// Pre-gather a group-one Conv/ConvTranspose input matrix once when several
// output-channel tiles would otherwise repeat the same coordinate work.
// Two FP16 elements are packed into each uint storage word.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint b[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint c[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

float sample_input(uint element) {
    const uint ow_size = p[80];
    const uint spatial_size = ow_size * p[81];
    const uint kh_size = p[85];
    const uint kw_size = p[86];
    const uint kernel_area = kh_size * kw_size;
    const uint k = element / spatial_size;
    const uint spatial = element % spatial_size;
    const uint ic = k / kernel_area;
    const uint kernel_index = k % kernel_area;
    const uint kh = kernel_index / kw_size;
    const uint kw = kernel_index % kw_size;
    const uint oh = spatial / ow_size;
    const uint ow = spatial % ow_size;
    int ih = -1;
    int iw = -1;
    if (p[100] == 0u) {
        ih = int(oh * p[87] + kh * p[89]) - int(p[91]);
        iw = int(ow * p[88] + kw * p[90]) - int(p[92]);
    } else {
        const int ih_numerator = int(oh) + int(p[91]) - int(kh * p[89]);
        const int iw_numerator = int(ow) + int(p[92]) - int(kw * p[90]);
        if (ih_numerator >= 0 && iw_numerator >= 0 &&
            ih_numerator % int(p[87]) == 0 && iw_numerator % int(p[88]) == 0) {
            ih = ih_numerator / int(p[87]);
            iw = iw_numerator / int(p[88]);
        }
    }
    if (ih < 0 || ih >= int(p[93]) || iw < 0 || iw >= int(p[94])) return 0.0;
    const uint input_index = p[98] + gl_WorkGroupID.y * p[32] + ic * p[33] +
                             uint(ih) * p[34] + uint(iw) * p[35];
    return uintBitsToFloat(a[input_index]);
}

void main() {
    const uint word = gl_GlobalInvocationID.x;
    if (word >= p[1]) return;
    const uint elements_per_batch = p[84] * p[85] * p[86] * p[80] * p[81];
    const uint first = word * 2u;
    const float low = sample_input(first % elements_per_batch);
    const float high = first + 1u < elements_per_batch ? sample_input((first + 1u) % elements_per_batch) : 0.0;
    o[gl_WorkGroupID.y * p[1] + word] = packHalf2x16(vec2(low, high));
}
