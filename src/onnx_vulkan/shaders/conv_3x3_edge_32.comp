#version 450

// Portable FP32 group-one 3x3 convolution over an unpadded NCHW source.
// A 16x16 workgroup computes 32 output channels across an 8x8 spatial tile.
// Loading the 10x10 source footprint once per four input channels reuses each
// source value across neighbouring output pixels instead of reloading it for
// every kernel position. The implicit one-pixel pad uses ONNX edge semantics;
// p[100] optionally folds a Relu immediately before that pad.
//
// Dispatch as:
//   x = ceil(p[80] / 8)
//   y = ceil(p[81] / 8) * ceil(p[82] / 32)
//   z = batch count
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint w[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint bias[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

const uint INPUT_CHANNEL_TILE = 4u;
shared float tile_x[INPUT_CHANNEL_TILE][10][10];
shared float tile_w[32][INPUT_CHANNEL_TILE][3][3];
shared float tile_bias[32];

void main() {
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint local_linear = ly * 16u + lx;
    const uint output_width = p[80];
    const uint output_height = p[81];
    const uint output_channels = p[82];
    const uint input_channels = p[84];
    const uint input_height = p[93];
    const uint input_width = p[94];
    const uint spatial_tiles_y = (output_height + 7u) / 8u;
    const uint channel_block = gl_WorkGroupID.y / spatial_tiles_y;
    const uint spatial_tile_y = gl_WorkGroupID.y - channel_block * spatial_tiles_y;
    const uint output_x_origin = gl_WorkGroupID.x * 8u;
    const uint output_y_origin = spatial_tile_y * 8u;
    const uint channel_origin = channel_block * 32u;
    const uint n = gl_WorkGroupID.z;
    const bool fuse_relu = p[100] != 0u;

    if (local_linear < 32u) {
        const uint oc = channel_origin + local_linear;
        tile_bias[local_linear] = p[95] != 0u && oc < output_channels
            ? uintBitsToFloat(bias[p[96] + oc * p[97]]) : 0.0;
    }
    barrier();

    float accum[2][4];
    for (uint row = 0u; row < 2u; ++row)
        for (uint col = 0u; col < 4u; ++col)
            accum[row][col] = 0.0;

    for (uint input_origin = 0u; input_origin < input_channels;
         input_origin += INPUT_CHANNEL_TILE) {
        for (uint index = local_linear; index < 400u; index += 256u) {
            const uint inner = index / 100u;
            const uint patch_index = index - inner * 100u;
            const uint patch_y = patch_index / 10u;
            const uint patch_x = patch_index - patch_y * 10u;
            const uint ic = input_origin + inner;
            float value = 0.0;
            if (ic < input_channels) {
                const int source_y = int(output_y_origin + patch_y) - 1;
                const int source_x = int(output_x_origin + patch_x) - 1;
                const uint ih = uint(clamp(source_y, 0, int(input_height) - 1));
                const uint iw = uint(clamp(source_x, 0, int(input_width) - 1));
                const uint input_index = p[98] + n * p[32] + ic * p[33] +
                                         ih * p[34] + iw * p[35];
                value = uintBitsToFloat(a[input_index]);
                if (fuse_relu)
                    value = max(value, 0.0);
            }
            tile_x[inner][patch_y][patch_x] = value;
        }

        for (uint index = local_linear; index < 1152u; index += 256u) {
            const uint oc_inner = index / 36u;
            const uint remainder = index - oc_inner * 36u;
            const uint inner = remainder / 9u;
            const uint kernel_index = remainder - inner * 9u;
            const uint kh = kernel_index / 3u;
            const uint kw = kernel_index - kh * 3u;
            const uint oc = channel_origin + oc_inner;
            const uint ic = input_origin + inner;
            tile_w[oc_inner][inner][kh][kw] = oc < output_channels && ic < input_channels
                ? uintBitsToFloat(w[p[99] + oc * p[48] + ic * p[49] +
                                    kh * p[50] + kw * p[51]])
                : 0.0;
        }
        barrier();

        for (uint inner = 0u; inner < INPUT_CHANNEL_TILE; ++inner) {
            for (uint kh = 0u; kh < 3u; ++kh) {
                for (uint kw = 0u; kw < 3u; ++kw) {
                    for (uint row = 0u; row < 2u; ++row) {
                        const float weight = tile_w[ly + row * 16u][inner][kh][kw];
                        for (uint col = 0u; col < 4u; ++col) {
                            const uint spatial = lx + col * 16u;
                            const uint local_y = spatial / 8u;
                            const uint local_x = spatial - local_y * 8u;
                            accum[row][col] += weight *
                                tile_x[inner][local_y + kh][local_x + kw];
                        }
                    }
                }
            }
        }
        barrier();
    }

    for (uint row = 0u; row < 2u; ++row) {
        const uint oc = channel_origin + ly + row * 16u;
        if (oc >= output_channels)
            continue;
        const float bias_value = tile_bias[ly + row * 16u];
        for (uint col = 0u; col < 4u; ++col) {
            const uint spatial = lx + col * 16u;
            const uint oh = output_y_origin + spatial / 8u;
            const uint ow = output_x_origin + spatial % 8u;
            if (oh >= output_height || ow >= output_width)
                continue;
            o[(n * output_channels + oc) * output_height * output_width +
              oh * output_width + ow] = floatBitsToUint(accum[row][col] + bias_value);
        }
    }
}
