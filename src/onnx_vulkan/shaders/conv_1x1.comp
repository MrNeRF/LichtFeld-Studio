#version 450

// Group-one, stride-one, unpadded 1x1 convolution. Treat the spatial plane as
// the N dimension of a matrix multiplication and reuse weights/input tiles.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint w[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint bias[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

shared float tile_w[64][16];
shared float tile_x[16][64];

void main() {
    const uint lx = gl_LocalInvocationID.x;
    const uint ly = gl_LocalInvocationID.y;
    const uint local_linear = ly * 16u + lx;
    const uint spatial_size = p[80] * p[81];
    const uint oc_size = p[82];
    const uint ic_size = p[84];
    const uint spatial_origin = gl_WorkGroupID.x * 64u;
    const uint oc_origin = gl_WorkGroupID.y * 64u;
    const uint n = gl_WorkGroupID.z;

    float accum[4][4];
    for (uint row = 0u; row < 4u; ++row)
        for (uint col = 0u; col < 4u; ++col)
            accum[row][col] = 0.0;

    for (uint ic_origin = 0u; ic_origin < ic_size; ic_origin += 16u) {
        for (uint index = local_linear; index < 1024u; index += 256u) {
            const uint row = index / 16u;
            const uint inner = index % 16u;
            const uint oc = oc_origin + row;
            const uint ic = ic_origin + inner;
            tile_w[row][inner] = oc < oc_size && ic < ic_size
                ? uintBitsToFloat(w[p[99] + oc * p[48] + ic * p[49]]) : 0.0;
        }
        for (uint index = local_linear; index < 1024u; index += 256u) {
            const uint inner = index / 64u;
            const uint col = index % 64u;
            const uint ic = ic_origin + inner;
            const uint spatial = spatial_origin + col;
            if (ic < ic_size && spatial < spatial_size) {
                const uint ih = spatial / p[80];
                const uint iw = spatial % p[80];
                const uint input_index = p[98] + n * p[32] + ic * p[33] + ih * p[34] + iw * p[35];
                tile_x[inner][col] = uintBitsToFloat(a[input_index]);
            } else {
                tile_x[inner][col] = 0.0;
            }
        }
        barrier();

        for (uint inner = 0u; inner < 16u; ++inner) {
            for (uint row = 0u; row < 4u; ++row) {
                const float weight = tile_w[ly + row * 16u][inner];
                for (uint col = 0u; col < 4u; ++col)
                    accum[row][col] += weight * tile_x[inner][lx + col * 16u];
            }
        }
        barrier();
    }

    for (uint row = 0u; row < 4u; ++row) {
        const uint oc = oc_origin + ly + row * 16u;
        if (oc >= oc_size) continue;
        const float bias_value = p[95] != 0u ? uintBitsToFloat(bias[p[96] + oc * p[97]]) : 0.0;
        for (uint col = 0u; col < 4u; ++col) {
            const uint spatial = spatial_origin + lx + col * 16u;
            if (spatial >= spatial_size) continue;
            const uint output_index = (n * oc_size + oc) * spatial_size + spatial;
            o[output_index] = floatBitsToUint(accum[row][col] + bias_value);
        }
    }
}
