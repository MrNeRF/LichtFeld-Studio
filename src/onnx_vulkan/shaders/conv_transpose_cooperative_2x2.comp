#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

// A 2x2, stride-2 ConvTranspose is four dense channel products, one for each
// output parity. Computing those products separately avoids the three zero
// samples per input channel in a generic implicit-GEMM formulation.
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer ABuffer { uint a[]; };
layout(std430, set = 0, binding = 1) readonly buffer BBuffer { uint w[]; };
layout(std430, set = 0, binding = 2) readonly buffer CBuffer { uint bias[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OBuffer { uint o[]; };
layout(std430, set = 0, binding = 4) readonly buffer PBuffer { uint p[]; };

shared float16_t tile_w[1024];
shared float16_t tile_x[2048];
shared float tile_o[4096];
shared float tile_bias[64];

void main() {
    const uint local_index = gl_LocalInvocationID.x;
    const uint subgroup = local_index / 32u;
    const uint lane = local_index % 32u;
    const bool narrow = p[101] != 0u;
    const uint tile_columns = narrow ? 8u : 4u;
    const uint tile_row = subgroup / tile_columns;
    const uint tile_col = subgroup % tile_columns;
    const uint input_width = p[94];
    const uint input_spatial = p[93] * input_width;
    const uint output_width = p[80];
    const uint output_spatial = p[81] * output_width;
    const uint oc_size = p[82];
    const uint k_size = p[84];
    const uint spatial_tile = narrow ? 128u : 64u;
    const uint oc_tile = narrow ? 32u : 64u;
    const uint spatial_origin = gl_WorkGroupID.x * spatial_tile;
    const uint oc_origin = gl_WorkGroupID.y * oc_tile;
    const uint matrix_spatial_origin = spatial_origin + tile_col * 16u;
    const uint matrix_oc_origin = oc_origin + tile_row * 16u;
    const uint parity = gl_WorkGroupID.z & 3u;
    const uint n = gl_WorkGroupID.z >> 2u;
    const uint kh = parity >> 1u;
    const uint kw = parity & 1u;

    if (local_index < oc_tile) {
        const uint oc = oc_origin + local_index;
        tile_bias[local_index] = p[95] != 0u && oc < oc_size
            ? uintBitsToFloat(bias[p[96] + oc * p[97]]) : 0.0;
    }
    barrier();

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> accumulator =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    for (uint k_origin = 0u; k_origin < k_size; k_origin += 16u) {
        const uint weight_elements = oc_tile * 16u;
        for (uint index = local_index; index < weight_elements; index += 512u) {
            const uint row = index / 16u;
            const uint inner = index % 16u;
            const uint oc = oc_origin + row;
            const uint k = k_origin + inner;
            tile_w[index] = oc < oc_size && k < k_size
                ? float16_t(uintBitsToFloat(w[p[99] + k * p[48] + oc * p[49] + kh * p[50] + kw * p[51]]))
                : float16_t(0.0);
        }
        const uint input_elements = 16u * spatial_tile;
        for (uint index = local_index; index < input_elements; index += 512u) {
            const uint inner = index / spatial_tile;
            const uint col = index % spatial_tile;
            const uint k = k_origin + inner;
            const uint spatial = spatial_origin + col;
            tile_x[index] = k < k_size && spatial < input_spatial
                ? float16_t(uintBitsToFloat(a[p[98] + n * p[32] + k * p[33] +
                                             (spatial / input_width) * p[34] +
                                             (spatial % input_width) * p[35]]))
                : float16_t(0.0);
        }
        barrier();
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matrix_w;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matrix_x;
        coopMatLoad(matrix_w, tile_w, tile_row * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(matrix_x, tile_x, tile_col * 16u, spatial_tile, gl_CooperativeMatrixLayoutRowMajor);
        accumulator = coopMatMulAdd(matrix_w, matrix_x, accumulator);
        barrier();
    }

    coopMatStore(accumulator, tile_o, subgroup * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint index = lane; index < 256u; index += 32u) {
        const uint row = index / 16u;
        const uint col = index % 16u;
        const uint oc = matrix_oc_origin + row;
        const uint spatial = matrix_spatial_origin + col;
        if (oc >= oc_size || spatial >= input_spatial) continue;
        const uint ih = spatial / input_width;
        const uint iw = spatial - ih * input_width;
        const uint output_spatial_index = (ih * 2u + kh) * output_width + iw * 2u + kw;
        o[(n * oc_size + oc) * output_spatial + output_spatial_index] = floatBitsToUint(
            tile_o[subgroup * 256u + index] + tile_bias[tile_row * 16u + row]);
    }
}
