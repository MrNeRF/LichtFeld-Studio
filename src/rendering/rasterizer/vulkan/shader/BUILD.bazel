# spv_<program> / glsl_<program>: generated/<program>.spv and radix_sort/<program>.spv,
# vulkan_rasterizer_shaders: all of them, plus shader_variants.inc (target
# shader_variants_inc) and slang_recipes.json (target slang_recipes_json).
vulkan_rasterizer_shaders(
    name = "vulkan_rasterizer_shaders",
    shaders = VULKAN_RASTERIZER_SHADERS,
)

# User-effect package for the runtime compiler in src/visualizer/shaders: the
# API, the custom effect hosts and their imports as Slang IR plus manifest.json
# (user/), staged and installed with the SPIR-V. Reflection stays in
# user_shader_reflection/. Also generates lfs_shader_abi.hpp.
lfs_user_shader_package(
    name = "lfs_user_shader_ir",
    abi_header = "lfs_shader_abi.hpp",
    dir = "user",
    hosts = custom_effect_hosts(VULKAN_RASTERIZER_SHADERS),
    reflection_dir = "user_shader_reflection",
)

# A package with one minimal host for the shader compiler tests
# (LFS_SHADER_TEST_PACKAGE_DIR).
lfs_user_shader_package(
    name = "lfs_user_shader_test_package",
    dir = "user_shader_test_package",
    reflection_dir = "user_shader_test_reflection",
    test_host = "lfs_test_host",
)

# The runtime shader directory: generated/*.spv, radix_sort/*.spv,
# user/*.slang-module and user/manifest.json (CMake installs it to
# share/LichtFeld-Studio/shaders/vulkan_rasterizer).
shader_directory(
    name = "vulkan_rasterizer",
    srcs = [
        ":lfs_user_shader_ir",
        ":vulkan_rasterizer_shaders",
    ],
)

# #include "shader_variants.inc" (src/rendering/rasterizer/vulkan/src/shader_variants.hpp).
cc_library(
    name = "shader_variants",
    includes = ["."],
    textual_hdrs = ["shader_variants.inc"],
)

# #include "lfs_shader_abi.hpp" (src/visualizer/shaders/slang_compiler.cpp).
cc_library(
    name = "lfs_shader_abi",
    hdrs = ["lfs_shader_abi.hpp"],
    includes = ["."],
)
