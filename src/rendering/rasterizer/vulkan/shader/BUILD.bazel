# Vulkan rasterizer shaders (CMake: the "Shader compilation (Slang + GLSL ->
# SPIR-V)" part of src/rendering/rasterizer/vulkan/CMakeLists.txt). Each
# vulkan_slang_shader() line is one _vulkan_add_slang_shader() call; see
# //bazel/shaders:vulkan_rasterizer.bzl for the variants a recipe produces.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel/shaders:shaders.bzl", "shader_directory")
load(
    "//bazel/shaders:vulkan_rasterizer.bzl",
    "custom_effect_hosts",
    "lfs_user_shader_package",
    "vulkan_glsl_shader",
    "vulkan_rasterizer_shaders",
    "vulkan_slang_shader",
)

package(default_visibility = ["//:__subpackages__"])

# Shader sources included by C++ and by the viewport GLSL shaders.
exports_files(glob(["src/slang/*.inc"]))

filegroup(
    name = "slang_srcs",
    srcs = glob([
        "src/slang/*.inc",
        "src/slang/*.slang",
    ]),
)

filegroup(
    name = "radix_sort_srcs",
    srcs = glob([
        "src/radix_sort/*.comp",
        "src/radix_sort/*.glsl",
    ]),
)

# The .inc files shared with C++ (src/rendering/rasterizer/vulkan/src/*.h:
# #include "../shader/src/slang/<name>.inc").
cc_library(
    name = "slang_inc",
    textual_hdrs = glob(["src/slang/*.inc"]),
)

