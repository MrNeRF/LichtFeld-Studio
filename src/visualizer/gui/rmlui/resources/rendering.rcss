div {
    display: block;
}

body {
    font-family: Inter;
    font-size: 14dp;
    color: #cdd6f4;
    left: 0;
    right: 0;
    top: 0;
    height: auto;
    padding: 2dp 6dp;
}

.setting-row {
    display: flex;
    align-items: center;
    padding: 1dp 0;
    min-height: 20dp;
}

.setting-label {
    display: flex;
    align-items: center;
    color: #cdd6f4;
    font-size: 13dp;
}

.prop-label {
    min-width: 80dp;
    text-align: right;
    font-size: 13dp;
    color: #cdd6f4;
    margin-left: 4dp;
    flex-shrink: 0;
}

input[type="checkbox"] {
    width: 13dp;
    height: 13dp;
    border-width: 1dp;
    border-color: #585b70;
    margin: 0 6dp 0 0;
    padding: 0;
}

input[type="checkbox"]:checked {
    background-color: #94e2d5;
    border-color: #94e2d5;
}

.setting-slider {
    flex: 1;
    min-width: 60dp;
}

input[type="range"] slidertrack {
    height: 4dp;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
}

input[type="range"] sliderbar {
    width: 12dp;
    height: 12dp;
    background-color: #89b4fa;
}

input[type="range"] sliderbar:hover {
    background-color: #b4d0fb;
}

input[type="range"] sliderarrowdec,
input[type="range"] sliderarrowinc {
    width: 0;
}

.slider-value {
    display: inline-block;
    width: 45dp;
    text-align: right;
    font-size: 12dp;
    color: #a6adc8;
    margin-left: 4dp;
    flex-shrink: 0;
}

select {
    font-size: 13dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
    padding: 2dp 6dp;
    min-width: 80dp;
}

select:hover {
    border-color: #89b4fa;
}

selectbox {
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
}

selectbox option {
    padding: 2dp 6dp;
    font-size: 13dp;
}

selectbox option:hover {
    background-color: #89b4fa;
}

.color-comp {
    display: inline-block;
    width: 44dp;
    font-size: 12dp;
    color: #a6adc8;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
    padding: 1dp 4dp;
    margin-right: 2dp;
    text-align: right;
    flex-shrink: 0;
}

.color-swatch {
    width: 18dp;
    height: 18dp;
    border-width: 1dp;
    border-color: #45475a;
    cursor: pointer;
    margin-right: 4dp;
    flex-shrink: 0;
}

.color-hex {
    width: 70dp;
    font-size: 12dp;
    padding: 2dp 4dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
    display: none;
}

.color-hex.visible {
    display: inline-block;
}

.color-hex:focus {
    border-color: #89b4fa;
}

.indent {
    margin-left: 20dp;
}

.hidden {
    display: none;
}

.separator {
    height: 1dp;
    margin: 4dp 0;
    background-color: #45475a;
}

.section-header {
    display: flex;
    align-items: center;
    padding: 3dp 0;
    font-weight: bold;
    color: #cdd6f4;
    cursor: pointer;
    font-size: 13dp;
}

.section-header:hover {
    background-color: #313244;
}

.section-arrow {
    display: inline-block;
    width: 14dp;
    font-size: 12dp;
    color: #cdd6f4;
    margin-right: 4dp;
    text-align: center;
}

.section-content.collapsed {
    display: none;
}

.text-disabled {
    color: #a6adc8;
    font-size: 12dp;
    padding: 0 0 0 2dp;
}

scrollbarvertical {
    width: 12dp;
}

scrollbarvertical slidertrack {
    background-color: rgba(30, 30, 46, 128);
}

scrollbarvertical sliderbar {
    background-color: rgba(108, 112, 134, 160);
}

scrollbarvertical sliderbar:hover {
    background-color: rgba(137, 180, 250, 200);
}
