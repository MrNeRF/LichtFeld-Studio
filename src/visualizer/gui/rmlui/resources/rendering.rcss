/* Rendering panel — panel-specific styles only.
 * Shared widget styles are in components.rcss (auto-included via applyTheme). */

body {
    font-family: Inter;
    padding: 0;
    bottom: 0;
}

#content-wrap {
    min-width: 0;
    min-height: 0;
    flex: 1;
    padding: 6dp;
    overflow-x: hidden;
    overflow-y: auto;
}

#content {
    min-width: 0;
    flex-shrink: 0;
}

/* Match the training panel's visible scroll track. */
#content-wrap scrollbarvertical {
    width: 4dp;
}

#content-wrap scrollbarvertical sliderbar {
    min-height: 12dp;
}
.color-picker-popup {
    display: none;
    position: absolute;
    z-index: 100;
    padding: 4dp;
    border-width: 1dp;
}

.color-picker-popup.visible {
    display: block;
}

.rendering-simplify-stats {
    display: flex;
    gap: 8dp;
    margin: 8dp 0 4dp;
}

.rendering-simplify-stat {
    flex-grow: 1;
    min-width: 0;
    padding: 10dp 12dp;
    border-width: 1dp;
    border-radius: 10dp;
}

.rendering-simplify-stat__label {
    display: block;
    margin-bottom: 4dp;
    font-size: 12dp;
    text-transform: uppercase;
    letter-spacing: 0.2dp;
}

.rendering-simplify-stat__value {
    display: block;
    font-size: 16dp;
    font-weight: bold;
}

.rendering-simplify-actions {
    display: flex;
    gap: 8dp;
    margin-top: 8dp;
}

.rendering-simplify-actions > .btn {
    flex-grow: 1;
}

.rendering-simplify-progress {
    position: relative;
    margin-top: 10dp;
}

.rendering-simplify-progress > progress {
    width: 100%;
}

.rendering-simplify-progress > .progress__text {
    position: absolute;
    top: 50%;
    right: 8dp;
    transform: translateY(-50%);
}

.rendering-simplify-stage {
    margin-top: 4dp;
}

.rendering-simplify-error {
    margin-top: 8dp;
}

.rendering-environment-map-shell {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4dp;
    min-width: 0;
}

.rendering-environment-map-picker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4dp 8dp;
    width: 100%;
    min-width: 0;
}

/* On a narrow panel the Browse button wraps under the preset instead of
   running past the panel edge. */
.rendering-environment-map-picker > select {
    flex: 1 1 96dp;
    min-width: 96dp;
}

.rendering-environment-map-path {
    display: block;
    min-width: 0;
}
