/* Shared border roles and shape scale. */

#python-console-toolbar {
    border-bottom-color: @{primary};
}

#content #python-console-toolbar {
    border-bottom-color: @{primary};
}

button {
    border-radius: @{radius.control}dp;
}

#python-console-toolbar button {
    border-radius: @{radius.control}dp;
}

#python-console-toolbar button:active,
#python-console-toolbar button.active {
    border-color: @{primary};
}

button:active,
button.active {
    border-color: @{primary};
}

.run-button {
    border-color: @{success};
}

.stop-button {
    border-color: @{error};
}

.stop-button.disabled {
    border-color: @{error};
}

#python-console-toolbar .run-button {
    border-color: @{success};
}

#python-console-toolbar .stop-button {
    border-color: @{error};
}

#python-console-toolbar .stop-button.disabled {
    border-color: @{error};
}

.popup-menu {
    border-radius: @{radius.surface}dp;
}

#python-splitter {
    border-top-color: @{border};
    border-bottom-color: @{border};
}

#tabbar {
    border-bottom-color: @{border};
}

#tabbar button {
    border-radius: @{radius.control}dp;
}

.pkg-header,
.pkg-row {
    border-bottom-color: @{border};
}

body {
    background-color: @{background};
    color: @{text};
}

#window-frame {
    background-color: @{background};
}

#python-editor-view,
#python-output-terminal,
#python-repl-terminal {
    background-color: @{surface};
    color: @{text};
}

#content #python-console-toolbar,
#tabbar {
    background-color: @{surface};
    border-color: @{border};
}

button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

button:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

button.active,
button:active {
    background-color: @{alpha(primary,0.32)};
    border-color: @{primary};
}

button.disabled {
    background-color: @{blend(surface,background,0.35)};
    border-color: @{border};
    color: @{text_dim};
}

#python-console-toolbar button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

#python-console-toolbar button:hover {
    background-color: @{blend(surface_bright,primary,button.tint_hover)};
    border-color: @{primary};
}

#python-console-toolbar button.disabled {
    background-color: @{blend(surface,background,0.35)};
    border-color: @{border};
    color: @{text_dim};
}

#script-label,
.menu-label,
#tabbar button.active {
    color: @{text};
}

#run-status,
#syntax-status,
#packages-status,
.menu-detail,
.menu-empty,
.pkg-version,
.pkg-path,
#packages-empty {
    color: @{text_dim};
}

#run-status.running {
    color: @{warning};
}

#syntax-status.status-ok {
    color: @{success};
}

#syntax-status.status-error {
    color: @{error};
}

.popup-menu {
    background-color: @{surface};
    border-color: @{border};
}

.menu-item:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

#python-splitter {
    background-color: @{blend(surface,background,0.35)};
    border-color: @{border};
}

#python-splitter:hover {
    background-color: @{blend(surface,background,0.35)};
    border-top-color: @{primary};
}

#tabbar button {
    background-color: @{blend(surface,background,0.35)};
    border-color: @{border};
    color: @{text_dim};
}

#tabbar button:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

#tabbar button.active {
    background-color: @{blend(surface_bright,primary,button.tint_active)};
    border-color: @{primary};
    color: @{text};
}

#packages-panel {
    background-color: @{surface};
    color: @{text};
}

#packages-search {
    background-color: @{background};
    border-color: @{border};
    color: @{text};
}

.pkg-header,
.pkg-row,
.menu-separator {
    border-color: @{border};
}
