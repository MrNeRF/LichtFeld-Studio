body {
    font-family: Inter;
    font-size: 13dp;
    color: #cdd6f4;
}

#window-frame {
    background-color: #1e1e2e;
    border: 1dp #45475a;
}

#title-bar {
    height: 28dp;
    display: flex;
    align-items: center;
    padding: 0 8dp;
    background-color: #313244;
}

#title-text {
    flex: 1;
    font-size: 13dp;
    color: #cdd6f4;
}

#close-btn {
    font-size: 16dp;
    color: #a6adc8;
    cursor: pointer;
    padding: 0 4dp;
}

#close-btn:hover {
    color: #f38ba8;
}

#content-wrap {
    display: flex;
    flex-direction: column;
    padding: 8dp 12dp;
}

.panel-title {
    font-size: 16dp;
    font-weight: bold;
    color: #89b4fa;
    margin-bottom: 6dp;
}

.description {
    color: #cdd6f4;
    margin-bottom: 10dp;
}

.section-label {
    font-size: 12dp;
    color: #a6adc8;
    margin-bottom: 4dp;
    margin-top: 6dp;
}

.info-table {
    margin-bottom: 8dp;
}

.info-row {
    display: flex;
    align-items: center;
    padding: 1dp 0;
}

.info-key {
    width: 120dp;
    color: #a6adc8;
    font-size: 13dp;
}

.info-val {
    color: #cdd6f4;
    font-size: 13dp;
}

.link-row {
    display: flex;
    align-items: center;
    padding: 2dp 0;
}

.link-label {
    color: #cdd6f4;
    margin-right: 6dp;
    font-size: 13dp;
}

.link-url {
    color: #89b4fa;
    cursor: pointer;
    font-size: 13dp;
}

.link-url:hover {
    text-decoration: underline;
}

.footer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 4dp;
}

.footer-text {
    color: #a6adc8;
    font-size: 12dp;
}

.footer-sep {
    color: #585b70;
    font-size: 12dp;
}
