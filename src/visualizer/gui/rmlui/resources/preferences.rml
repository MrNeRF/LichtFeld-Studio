<rml>
<head>
  <link type="text/template" href="floating_window.rml"/>
  <link type="text/rcss" href="preferences.rcss"/>
</head>
<body template="floating-window" data-model="preferences">
  <div class="preferences-layout">
    <div class="preferences-nav">
      <button class="btn preferences-nav-item" data-class-active="show_general" data-event-click="show_general">@tr:preferences.general</button>
      <button class="btn preferences-nav-item" data-class-active="show_appearance" data-event-click="show_appearance">@tr:preferences.appearance</button>
      <button class="btn preferences-nav-item" data-class-active="show_viewport" data-event-click="show_viewport">@tr:preferences.viewport</button>
      <button class="btn preferences-nav-item" data-class-active="show_input" data-event-click="show_input">@tr:preferences.input</button>
      <button class="btn preferences-nav-item" data-class-active="show_interface" data-event-click="show_interface">@tr:preferences.interface</button>
      <button class="btn preferences-nav-item" data-class-active="show_file_associations" data-event-click="show_file_associations" data-if="has_file_associations">@tr:preferences.file_associations</button>
      <button class="btn preferences-nav-item" data-class-active="show_marketplace" data-event-click="show_marketplace">@tr:preferences.marketplace</button>
      <button class="btn preferences-nav-item" data-class-active="show_mcp" data-event-click="show_mcp">@tr:preferences.mcp</button>
      <button class="btn preferences-nav-item" data-class-active="show_portal" data-event-click="show_portal">@tr:preferences.portal</button>
    </div>

    <div class="preferences-main">
      <div class="preferences-input-pages" data-if="show_input">
        <button class="btn preferences-nav-item" data-class-active="show_input_navigation" data-event-click="input_page('navigation')">@tr:preferences.input_navigation</button>
        <button class="btn preferences-nav-item" data-class-active="show_input_shortcuts" data-event-click="input_page('shortcuts')">@tr:preferences.input_shortcuts</button>
        <button class="btn preferences-nav-item" data-class-active="show_input_gamepad" data-event-click="input_page('gamepad')">@tr:preferences.input_gamepad</button>
      </div>
      <div class="preferences-input-pages preferences-gamepad-pages" data-if="show_input_gamepad">
        <button class="btn preferences-nav-item" data-class-active="show_gamepad_controls" data-event-click="gamepad_page('controls')">@tr:preferences.gamepad_controls</button>
        <button class="btn preferences-nav-item" data-class-active="show_gamepad_test" data-event-click="gamepad_page('test')">@tr:preferences.gamepad_diagnostics</button>
      </div>
    <div class="preferences-content">
      <div class="preferences-section" data-if="show_general">
        <div class="section-header text-accent" data-class-is-expanded="language_expanded" data-event-click="toggle_section('language')">
          <span class="section-arrow text-accent" data-class-is-expanded="language_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.language_title</span>
        </div>
        <div class="section-content" data-if="language_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.language_title</span>
            <select class="preferences-select" data-value="language_idx">
              <option data-for="language : languages" data-attr-value="language.index">{{ language.label }}</option>
            </select>
          </div>
        </div>
        <div class="section-header text-accent" data-class-is-expanded="project_location_expanded" data-event-click="toggle_section('project_location')">
          <span class="section-arrow text-accent" data-class-is-expanded="project_location_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.projects</span>
        </div>
        <div class="section-content" data-if="project_location_expanded">
          <div class="preferences-setting preferences-project-location" data-tooltip="preferences.project_location_description">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.project_location</span>
            <div class="preferences-path-control">
              <input class="preferences-select preferences-path-input" type="text" data-value="project_location"
                     data-event-change="project_location_change(ev.value)" />
              <button class="btn btn--primary" data-event-click="confirm_project_location">@tr:common.ok</button>
              <button class="btn btn--secondary" data-event-click="browse_project_location">@tr:common.browse</button>
              <button class="btn btn--secondary" data-event-click="use_default_project_location">@tr:preferences.use_default</button>
            </div>
          </div>
          <span class="preferences-description preferences-setting-hint">{{ project_location_hint }}</span>
          </div>
          <div class="preferences-setting">
            <div class="preferences-row preferences-checkbox-row">
              <span class="preferences-label">@tr:menu.file.auto_save_on_close</span>
              <input type="checkbox" data-checked="auto_save_on_close" />
            </div>
          </div>
          <div class="preferences-setting">
          <div class="preferences-row preferences-checkbox-row" data-tooltip="preferences.embed_dataset_by_default_description">
            <span class="preferences-label">@tr:preferences.embed_dataset_by_default</span>
            <input type="checkbox" data-checked="embed_dataset_by_default" />
          </div>
          </div>
        </div>
        <div class="section-header text-accent" data-class-is-expanded="project_folders_expanded" data-event-click="toggle_section('project_folders')">
          <span class="section-arrow text-accent" data-class-is-expanded="project_folders_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.project_folders</span>
        </div>
        <div class="section-content" data-if="project_folders_expanded">
          <div class="preferences-project-folder" data-for="folder : project_folders">
            <div class="preferences-project-folder-details">
              <span>{{folder.label}}</span>
              <span class="preferences-description">{{folder.path}}</span>
            </div>
            <button class="btn btn--secondary" data-if="folder.can_remove" data-event-click="remove_project_folder(folder.id)">@tr:projects.action.remove_folder</button>
          </div>
          <div class="preferences-project-folder-actions">
            <button class="btn btn--secondary" data-event-click="add_project_folder">@tr:projects.action.add_folder</button>
            <button class="btn btn--secondary" data-event-click="rescan_project_folders">@tr:projects.action.rescan_folders</button>
          </div>
        </div>
        <div class="section-header text-accent" data-class-is-expanded="project_manager_expanded" data-event-click="toggle_section('project_manager')">
          <span class="section-arrow text-accent" data-class-is-expanded="project_manager_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.project_manager_title</span>
        </div>
        <div class="section-content" data-if="project_manager_expanded">
          <div class="preferences-row" data-tooltip="preferences.project_manager_default_view_description">
            <span class="preferences-label">@tr:preferences.project_manager_default_view</span>
            <select class="preferences-select" data-value="project_manager_default_view">
              <option value="remember">@tr:preferences.project_manager_view_remember</option>
              <option value="gallery">@tr:preferences.project_manager_view_grid</option>
              <option value="list">@tr:preferences.project_manager_view_list</option>
            </select>
          </div>
          <div class="preferences-row preferences-checkbox-row" data-tooltip="preferences.project_manager_open_at_startup_description">
            <span class="preferences-label">@tr:preferences.project_manager_open_at_startup</span>
            <input type="checkbox" data-checked="project_manager_open_at_startup" />
          </div>
          <div class="preferences-row preferences-checkbox-row" data-tooltip="preferences.project_manager_remember_state_description">
            <span class="preferences-label">@tr:preferences.project_manager_remember_state</span>
            <input type="checkbox" data-checked="project_manager_remember_state" />
          </div>
        </div>
        <div class="section-header text-accent" data-class-is-expanded="gallery_expanded" data-event-click="toggle_section('gallery')">
          <span class="section-arrow text-accent" data-class-is-expanded="gallery_expanded">&#x25B6;</span>
          <span>@tr:preferences.gallery.title</span>
        </div>
        <div class="section-content" data-if="gallery_expanded">
          <div class="preferences-row"><span class="preferences-label">@tr:preferences.gallery.format</span>
            <select class="preferences-select" data-value="gallery_uploadFormat"><option value="auto">@tr:projects.gallery.format.auto</option><option value="studio">@tr:projects.gallery.format.studio</option><option value="sog">@tr:projects.gallery.format.sog</option><option value="ssog">@tr:projects.gallery.format.ssog</option><option value="spz">@tr:projects.gallery.format.spz</option></select></div>
          <div class="preferences-row"><span class="preferences-label">@tr:preferences.gallery.cache</span><input class="preferences-select" type="text" data-value="gallery_posterCacheMiB" /></div>
          <span class="preferences-description">{{gallery_preferences_error}}</span>
        </div>
      </div>

      <div class="preferences-section" data-if="show_marketplace">
        <div class="section-header text-accent">@tr:preferences.marketplace</div>
        <div class="section-content">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.marketplace_layout</span>
            <select class="preferences-select" data-value="marketplace_view">
              <option value="card">@tr:plugin_marketplace.view.grid</option>
              <option value="list">@tr:plugin_marketplace.view.list</option>
            </select>
          </div>
          <div class="preferences-row preferences-checkbox-row" data-tooltip="preferences.marketplace_git_checkout_description">
            <span class="preferences-label">@tr:plugin_marketplace.install_as_git_checkout</span>
            <input type="checkbox" data-checked="marketplace_git_checkout" data-attrif-disabled="!marketplace_git_available" />
          </div>
          <div class="preferences-description" data-if="!marketplace_git_available">
            @tr:preferences.marketplace_git_unavailable
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_portal">
        <div class="section-header text-accent" data-class-is-expanded="portal_expanded" data-event-click="toggle_section('portal')">
          <span class="section-arrow text-accent" data-class-is-expanded="portal_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.portal</span>
        </div>
        <div class="section-content" data-if="portal_expanded">
          <div class="preferences-row"><span class="preferences-description">{{portal_connection_status}}</span></div>
          <div class="preferences-row" data-if="portal_disconnect_visible"><span class="preferences-label">@tr:portal.preferences.connected_since</span><span class="preferences-description">{{portal_connection_since}}</span></div>
          <div class="preferences-inline-actions">
            <button class="btn btn--primary" data-if="portal_connect_visible" data-event-click="portal_connect">@tr:portal.status.connect</button>
            <button class="btn btn--primary" data-if="portal_turn_on_visible" data-event-click="portal_turn_on">@tr:portal.status.turn_on</button>
            <button class="btn btn--secondary" data-if="portal_disconnect_visible" data-event-click="portal_disconnect">@tr:portal.status.disconnect</button>
            <button class="btn btn--secondary" data-if="portal_linking" data-event-click="portal_cancel">@tr:portal.status.cancel</button>
          </div>
          <div class="preferences-portal-link" data-if="portal_code_visible">
            <div>
              <div class="preferences-description">@tr:portal.preferences.code</div>
              <strong class="preferences-portal-code">{{portal_user_code}}</strong>
              <div class="preferences-inline-actions">
                <button class="btn btn--secondary" data-event-click="portal_copy_code">@tr:portal.preferences.copy_code</button>
                <button class="btn btn--secondary" data-event-click="portal_open">@tr:portal.preferences.open_portal</button>
              </div>
            </div>
            <img class="preferences-portal-qr" data-attr-src="portal_verification_qr" data-attr-alt="portal_qr_alt" />
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_viewport">
        <div class="section-header text-accent">@tr:preferences.viewport_defaults</div>
        <span class="preferences-description">@tr:preferences.viewport_defaults_hint</span>
        <div class="section-header text-accent">@tr:preferences.viewport_style_defaults</div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.coord_axes">
          <span class="preferences-label">@tr:main_panel.show_coord_axes</span>
          <input type="checkbox" class="" data-checked="default_show_coord_axes" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.pivot">
          <span class="preferences-label">@tr:main_panel.show_pivot</span>
          <input type="checkbox" class="" data-checked="default_show_pivot" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.grid">
          <span class="preferences-label">@tr:main_panel.show_grid</span>
          <input type="checkbox" class="" data-checked="default_show_grid" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.camera_frustums">
          <span class="preferences-label">@tr:main_panel.camera_frustums</span>
          <input type="checkbox" class="" data-checked="default_show_camera_frustums" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.selection_outline">
          <span class="preferences-label">@tr:main_panel.selection_outline</span>
          <input type="checkbox" data-checked="default_selection_outline" />
        </div>
        <div data-if="default_selection_outline">
          <div class="preferences-row" data-tooltip="tooltip.selection_outline_color">
            <span class="preferences-label">@tr:main_panel.selection_outline_color</span>
            <div class="preferences-color">
              <div class="color-swatch" data-style-background-color="default_selection_outline_color_swatch" data-event-click="default_color_click('selection_outline_color')"></div>
              <input type="text" class="preferences-select" data-value="default_selection_outline_color" />
            </div>
          </div>
          <div id="picker-selection_outline_color" class="preferences-color-picker" data-if="default_color_editing == 'selection_outline_color'" data-event-mouseup="default_color_commit" data-event-dragend="default_color_commit">
            <color-picker data-attr-red="default_picker_r" data-attr-green="default_picker_g" data-attr-blue="default_picker_b" data-event-change="default_picker_change" />
          </div>
          <div class="preferences-row" data-tooltip="tooltip.selection_outline_opacity">
            <span class="preferences-label">@tr:main_panel.selection_outline_opacity</span>
            <input type="text" class="preferences-select" data-value="default_selection_outline_opacity" />
          </div>
          <div class="preferences-row" data-tooltip="tooltip.selection_outline_width">
            <span class="preferences-label">@tr:main_panel.selection_outline_width</span>
            <input type="text" class="preferences-select" data-value="default_selection_outline_width" />
          </div>
          <div class="preferences-row" data-tooltip="tooltip.selection_outline_threshold">
            <span class="preferences-label">@tr:main_panel.selection_outline_threshold</span>
            <input type="text" class="preferences-select" data-value="default_selection_outline_threshold" />
          </div>
          <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.selection_outline_holes">
            <span class="preferences-label">@tr:main_panel.selection_outline_holes</span>
            <input type="checkbox" data-checked="default_selection_outline_holes" />
          </div>
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.desaturate_unselected">
          <span class="preferences-label">@tr:main_panel.desaturate_unselected</span>
          <input type="checkbox" class="" data-checked="default_desaturate_unselected" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.desaturate_cropping">
          <span class="preferences-label">@tr:main_panel.desaturate_cropping</span>
          <input type="checkbox" class="" data-checked="default_desaturate_cropping" />
        </div>
        <div class="preferences-row preferences-checkbox-row" data-tooltip="tooltip.hide_outside_depth_box">
          <span class="preferences-label">@tr:main_panel.hide_outside_depth_box</span>
          <input type="checkbox" class="" data-checked="default_hide_outside_depth_box" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.axes_size">
          <span class="preferences-label" data-reset-prop="axes_size">@tr:main_panel.axes_size</span>
          <input type="text" class="preferences-select" data-value="default_axes_size" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.grid_opacity">
          <span class="preferences-label" data-reset-prop="grid_opacity">@tr:main_panel.grid_opacity</span>
          <input type="text" class="preferences-select" data-value="default_grid_opacity" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.camera_frustum_scale">
          <span class="preferences-label" data-reset-prop="camera_frustum_scale">@tr:main_panel.camera_frustum_scale</span>
          <input type="text" class="preferences-select" data-value="default_camera_frustum_scale" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.selection_color_preview">
          <span class="preferences-label" data-reset-prop="selection_color_preview">@tr:main_panel.preview</span>
          <div class="preferences-color">
            <div class="color-swatch" data-style-background-color="default_selection_color_preview_swatch" data-event-click="default_color_click('selection_color_preview')"></div>
            <input type="text" class="preferences-select" data-value="default_selection_color_preview" />
          </div>
        </div>
        <div id="picker-selection_color_preview" class="preferences-color-picker" data-if="default_color_editing == 'selection_color_preview'" data-event-mouseup="default_color_commit" data-event-dragend="default_color_commit">
          <color-picker data-attr-red="default_picker_r" data-attr-green="default_picker_g" data-attr-blue="default_picker_b" data-event-change="default_picker_change" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.selection_color_center_marker">
          <span class="preferences-label" data-reset-prop="selection_color_center_marker">@tr:main_panel.center_marker</span>
          <div class="preferences-color">
            <div class="color-swatch" data-style-background-color="default_selection_color_center_marker_swatch" data-event-click="default_color_click('selection_color_center_marker')"></div>
            <input type="text" class="preferences-select" data-value="default_selection_color_center_marker" />
          </div>
        </div>
        <div id="picker-selection_color_center_marker" class="preferences-color-picker" data-if="default_color_editing == 'selection_color_center_marker'" data-event-mouseup="default_color_commit" data-event-dragend="default_color_commit">
          <color-picker data-attr-red="default_picker_r" data-attr-green="default_picker_g" data-attr-blue="default_picker_b" data-event-change="default_picker_change" />
        </div>
        <div class="section-header text-accent">@tr:preferences.viewport_performance_defaults</div>
        <div class="preferences-row" data-tooltip="tooltip.lod_page_pool_splats">
          <span class="preferences-label" data-reset-prop="lod_page_pool_splats">@tr:rendering_panel.lod_page_pool_splats</span>
          <input type="text" class="preferences-select" data-value="default_lod_page_pool_splats" />
        </div>
        <div class="preferences-row" data-tooltip="tooltip.lod_pool_vram_fraction">
          <span class="preferences-label" data-reset-prop="lod_pool_vram_fraction">@tr:rendering_panel.lod_pool_vram_fraction</span>
          <input type="text" class="preferences-select" data-value="default_lod_pool_vram_fraction" />
        </div>
        <span class="preferences-description status-error">{{rendering_defaults_error}}</span>
        <div class="preferences-inline-actions">
          <button class="btn btn--secondary preferences-apply-defaults" data-event-click="apply_viewport_defaults"
                  data-tooltip="rendering_panel.apply_defaults_hint">@tr:preferences.apply_viewport_defaults</button>
        </div>
      </div>

      <div class="preferences-section" data-if="show_appearance">
        <div class="section-header text-accent" data-class-is-expanded="appearance_expanded" data-event-click="toggle_section('appearance')">
          <span class="section-arrow text-accent" data-class-is-expanded="appearance_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:menu.view.theme</span>
        </div>
        <div class="section-content" data-if="appearance_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:menu.view.theme</span>
            <select class="preferences-select" data-value="theme_family_idx">
              <option data-for="family : theme_families" data-attr-value="family.index">{{ family.label }}</option>
            </select>
          </div>
          <div class="preferences-row preferences-theme-variant-row" data-if="theme_has_variants">
            <span class="preferences-label"></span>
            <div class="preferences-theme-variants">
              <button data-for="variant : theme_variants"
                      class="btn preferences-theme-variant"
                      data-class-active="variant.selected"
                      data-event-click="set_theme_variant(variant.mode)">{{ variant.label }}</button>
            </div>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.progress_bar_style</span>
            <select class="preferences-select" data-value="progress_bar_idx">
              <option data-for="style : progress_bar_styles" data-attr-value="style.index">{{ style.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.viewport_chrome_style</span>
            <select class="preferences-select" data-value="viewport_chrome_idx">
              <option data-for="style : viewport_chrome_styles" data-attr-value="style.index">{{ style.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.viewport_toolbar_position</span>
            <select class="preferences-select" data-value="viewport_toolbar_position_idx">
              <option data-for="position : viewport_toolbar_positions" data-attr-value="position.index">{{ position.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:menu.view.ui_scale</span>
            <select class="preferences-select" data-value="scale_idx">
              <option data-for="scale : scales" data-attr-value="scale.index">{{ scale.label }}</option>
            </select>
          </div>
        </div>
        <div class="section-header text-accent">@tr:main_panel.theme_vignette</div>
        <div class="setting-row setting-row--aligned" data-tooltip="tooltip.theme_vignette">
          <span class="setting-row__label-col">@tr:main_panel.theme_vignette</span>
          <label class="setting-row__control-col setting-row__control-col--checkbox">
            <input type="checkbox" data-checked="theme_vignette_enabled" />
          </label>
        </div>
        <div data-if="theme_vignette_enabled">
          <div class="setting-row setting-row--aligned" data-tooltip="tooltip.theme_vignette_intensity">
            <span class="setting-row__label-col">@tr:main_panel.theme_vignette_intensity</span>
            <div class="setting-row__control-col setting-row__control-col--slider">
              <input type="range" class="setting-slider" data-value="theme_vignette_intensity" min="0" max="1" step="0.01" />
              <span class="slider-value">{{theme_vignette_intensity | format_float(2)}}</span>
            </div>
          </div>
          <div class="setting-row setting-row--aligned" data-tooltip="tooltip.theme_vignette_radius">
            <span class="setting-row__label-col">@tr:main_panel.theme_vignette_radius</span>
            <div class="setting-row__control-col setting-row__control-col--slider">
              <input type="range" class="setting-slider" data-value="theme_vignette_radius" min="0" max="1" step="0.01" />
              <span class="slider-value">{{theme_vignette_radius | format_float(2)}}</span>
            </div>
          </div>
          <div class="setting-row setting-row--aligned" data-tooltip="tooltip.theme_vignette_softness">
            <span class="setting-row__label-col">@tr:main_panel.theme_vignette_softness</span>
            <div class="setting-row__control-col setting-row__control-col--slider">
              <input type="range" class="setting-slider" data-value="theme_vignette_softness" min="0" max="1" step="0.01" />
              <span class="slider-value">{{theme_vignette_softness | format_float(2)}}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_appearance">
        <div class="section-header text-accent" data-class-is-expanded="scene_rendering_expanded" data-event-click="toggle_section('scene_rendering')">
          <span class="section-arrow text-accent" data-class-is-expanded="scene_rendering_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.scene_rendering</span>
        </div>
        <div class="section-content" data-if="scene_rendering_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.scene_reconstruction</span>
            <select class="preferences-select" data-value="scene_upscaler_idx" data-attrif-disabled="mcp_safe_mode">
              <option data-for="upscaler : scene_upscalers" data-attr-value="upscaler.index">{{ upscaler.label }}</option>
            </select>
          </div>
          <div class="preferences-row" data-if="scene_upscaler_has_preset">
            <span class="preferences-label">@tr:preferences.scene_reconstruction_preset</span>
            <select class="preferences-select" data-value="scene_upscaler_preset_idx" data-attrif-disabled="mcp_safe_mode">
              <option data-for="preset : scene_upscaler_presets" data-attr-value="preset.index" data-attrif-selected="preset.selected">{{ preset.label }}</option>
            </select>
          </div>
          <span class="preferences-description">@tr:preferences.scene_reconstruction_description</span>
        </div>
      </div>

      <div class="preferences-section" data-if="show_gamepad_controls">
        <div class="section-header text-accent">@tr:gamepad.navigation_title</div>
        <div class="section-content">
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:gamepad.navigation_enabled</span>
            <input type="checkbox" data-checked="gamepad_navigation_enabled" />
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.navigation_device</span>
            <select id="gamepad-navigation-device" class="preferences-select" data-value="gamepad_navigation_id">
              <option data-for="device : gamepad_test_devices" data-attr-value="device.id">{{ device.label }}</option>
            </select>
          </div>
          <span class="preferences-description">@tr:gamepad.navigation_help</span>
          <span class="preferences-description">{{ gamepad_navigation_status }}</span>
          <span class="preferences-description">{{ gamepad_navigation_preset }}</span>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.dead_zone</span>
            <input type="range" data-value="gamepad_dead_zone" min="0.05" max="0.5" step="0.01" />
            <span>{{ gamepad_dead_zone }}</span>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.look_speed</span>
            <input type="range" data-value="gamepad_look_speed" min="0.1" max="5" step="0.1" />
            <span>{{ gamepad_look_speed }}</span>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.move_speed</span>
            <input type="range" data-value="gamepad_move_speed" min="0.1" max="5" step="0.1" />
            <span>{{ gamepad_move_speed }}</span>
          </div>
        </div>
      </div>
      <div class="preferences-section" data-if="show_gamepad_test">
        <div class="section-header text-accent">@tr:gamepad.title</div>
        <div class="section-content">
          <span class="preferences-description">@tr:gamepad.help</span>
          <select id="gamepad-test-device" class="preferences-select" data-value="gamepad_test_id">
            <option data-for="device : gamepad_test_devices" data-attr-value="device.id">{{ device.label }}</option>
          </select>
          <span class="preferences-description">{{ gamepad_test_status }}</span>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.axes</span>
            <span>{{ gamepad_test_axes }}</span>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:gamepad.buttons</span>
            <span>{{ gamepad_test_buttons }}</span>
          </div>
        </div>
      </div>
      <div class="preferences-section" data-if="show_input_navigation">
        <div class="section-header text-accent" data-class-is-expanded="navigation_expanded" data-event-click="toggle_section('navigation')">
          <span class="section-arrow text-accent" data-class-is-expanded="navigation_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.camera_navigation</span>
        </div>
        <div class="section-content" data-if="navigation_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.navigation_mode</span>
            <select class="preferences-select" data-value="navigation_idx">
              <option data-for="mode : navigation_modes" data-attr-value="mode.index">{{ mode.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.new_project_navigation_up</span>
            <select class="preferences-select" data-value="navigation_up_idx">
              <option value="0">@tr:preferences.navigation_up_legacy_y</option>
              <option value="1">@tr:preferences.navigation_up_data_z</option>
            </select>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.new_project_align_grid</span>
            <input type="checkbox" data-checked="new_project_align_grid" />
          </div>
          <span class="preferences-description">@tr:preferences.new_project_navigation_help</span>
          <div class="setting-row setting-row--aligned" data-tooltip="preferences.zoom_speed_tooltip">
            <span class="setting-row__label-col">@tr:preferences.zoom_speed</span>
            <div class="setting-row__control-col setting-row__control-col--slider">
              <input type="range" class="setting-slider" data-value="zoom_speed" min="1" max="100" step="1" />
              <span class="slider-value">{{ zoom_speed | format_int }}</span>
            </div>
          </div>
          <div class="setting-row setting-row--aligned" data-tooltip="preferences.navigation_speed_tooltip">
            <span class="setting-row__label-col">@tr:preferences.navigation_speed</span>
            <div class="setting-row__control-col setting-row__control-col--slider">
              <input type="range" class="setting-slider" data-value="navigation_speed" min="1" max="100" step="1" />
              <span class="slider-value">{{ navigation_speed | format_int }}</span>
            </div>
          </div>
          <div class="preferences-row preferences-checkbox-row" data-tooltip="preferences.camera_browse_repeat_tooltip">
            <span class="preferences-label">@tr:preferences.camera_browse_repeat</span>
            <input type="checkbox" data-checked="camera_browse_repeat" />
          </div>
          <div class="setting-row setting-row--aligned" data-if="camera_browse_repeat">
            <span class="setting-row__label-col">@tr:preferences.camera_browse_repeat_rate</span>
            <div class="setting-row__control-col preferences-repeat-rate">
              <input type="text" class="number-input" data-value="camera_browse_repeat_rate" maxlength="2"
                     data-event-change="camera_repeat_rate_change(ev.value)"
                     data-event-blur="commit_camera_repeat_rate" data-event-escapecancel="cancel_camera_repeat_rate" />
              <button class="num-step-btn" data-event-click="step_camera_repeat_rate(-1)">-</button>
              <button class="num-step-btn" data-event-click="step_camera_repeat_rate(1)">+</button>
            </div>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.remember_camera_navigation</span>
            <input type="checkbox" data-checked="remember_navigation" />
          </div>
        </div>

        <div class="section-header text-accent" data-class-is-expanded="view_snap_expanded" data-event-click="toggle_section('view_snap')">
          <span class="section-arrow text-accent" data-class-is-expanded="view_snap_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.camera_view_snap</span>
        </div>
        <div class="section-content" data-if="view_snap_expanded">
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.enable_axis_view_snap</span>
            <input type="checkbox" data-checked="view_snap" />
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.remember_camera_view_snap</span>
            <input type="checkbox" data-checked="remember_view_snap" />
          </div>
        </div>

      </div>
      <div class="preferences-section" data-if="show_input_shortcuts">
        <div class="section-header text-accent" data-class-is-expanded="key_bindings_expanded" data-event-click="toggle_section('key_bindings')">
          <span class="section-arrow text-accent" data-class-is-expanded="key_bindings_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.key_bindings</span>
        </div>
        <div class="section-content" data-if="key_bindings_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:input_settings.active_profile</span>
            <select id="profile-select" class="preferences-select" data-value="profile_idx"
                    data-class-preferences-capture-disabled="is_capturing">
              <option data-for="profile : profiles" data-attr-value="profile.index">{{ profile.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:input_settings.tool_mode</span>
            <select id="mode-select" class="preferences-select" data-value="mode_idx"
                    data-class-preferences-capture-disabled="is_capturing">
              <option data-for="mode : tool_modes" data-attr-value="mode.index">{{ mode.label }}</option>
            </select>
          </div>
          <span class="preferences-description">@tr:input_settings.select_tool_mode</span>
          <div class="preferences-row preferences-binding-search">
            <input type="text" data-value="binding_search" placeholder="@tr:input_settings.search_commands" data-attrif-disabled="is_capturing" />
            <button class="btn btn--secondary" data-event-click="clear_binding_search" data-attrif-disabled="is_capturing">@tr:input_settings.clear_search</button>
          </div>
          <span class="preferences-description" id="bindings-hint">{{bindings_hint}}</span>
          <span class="preferences-description" data-if="binding_search_empty">@tr:input_settings.no_matches</span>
          <div id="bindings-table" class="preferences-bindings-table">
            <div data-for="row : binding_rows">
              <span class="preferences-binding-section" data-if="row.is_section">{{ row.section_title }}</span>
              <div class="preferences-binding-row" data-if="!row.is_section">
                <span class="preferences-action-name">{{ row.action_name }}</span>
                <span data-attr-class="row.desc_class">{{ row.desc_text }}</span>
                <button data-attr-class="'btn ' + row.button_class + ' preferences-rebind-btn'"
                        data-attr-data-btn-action="row.button_action"
                        data-attr-data-action-id="row.action_id"
                        data-attr-data-mode-id="row.mode_id">{{ row.button_label }}</button>
                <button class="btn btn--secondary preferences-rebind-btn preferences-clear-btn"
                        data-if="row.show_clear"
                        data-btn-action="clear"
                        data-attr-data-action-id="row.action_id"
                        data-attr-data-mode-id="row.mode_id">{{ row.clear_label }}</button>
              </div>
            </div>
          </div>
          <div class="preferences-inline-actions">
            <button class="btn btn--success" data-event-click="save_profile">@tr:input_settings.save_current_profile</button>
            <button class="btn btn--error" data-event-click="reset_default">@tr:input_settings.reset_to_default</button>
          </div>
          <div class="preferences-inline-actions">
            <button class="btn btn--secondary" data-event-click="export_profile">@tr:input_settings.export</button>
            <button class="btn btn--secondary" data-event-click="import_profile">@tr:input_settings.import</button>
          </div>
          <span class="preferences-description">@tr:input_settings.save_hint</span>
          <span class="preferences-description">@tr:input_settings.double_click_hint</span>
          <span class="preferences-description">@tr:preferences.gallery.shortcuts_hint</span>
        </div>
      </div>

      <div class="preferences-section" data-if="show_interface">
        <div class="section-header text-accent" data-class-is-expanded="interface_expanded" data-event-click="toggle_section('interface')">
          <span class="section-arrow text-accent" data-class-is-expanded="interface_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.interface</span>
        </div>
        <div class="section-content" data-if="interface_expanded">
          <span class="preferences-description">@tr:preferences.interface_layout_description</span>
          <span class="preferences-description">@tr:preferences.sidebar_defaults_description</span>
          <div class="preferences-inline-actions">
            <button class="btn btn--secondary" data-event-click="save_startup_sidebar">@tr:preferences.save_startup_sidebar</button>
            <button class="btn btn--secondary" data-event-click="clear_startup_sidebar">@tr:preferences.clear_startup_sidebar</button>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.native_floating_windows</span>
            <input type="checkbox" data-checked="native_floating_windows"/>
          </div>
          <span class="preferences-description">@tr:preferences.native_floating_windows_restart</span>
        </div>
      </div>

      <div class="preferences-section preferences-scene-graph-section" data-if="show_interface">
        <div class="section-header text-accent" data-class-is-expanded="scene_graph_expanded" data-event-click="toggle_section('scene_graph')">
          <span class="section-arrow text-accent" data-class-is-expanded="scene_graph_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.scene_graph</span>
        </div>
        <div class="section-content" data-if="scene_graph_expanded">
          <div class="preferences-row preferences-checkbox-row preferences-interface-option" data-tooltip="preferences.scene_graph_selection_markers_description">
            <span class="preferences-label">@tr:preferences.scene_graph_selection_markers</span>
            <input type="checkbox" data-checked="scene_graph_selection_markers" data-attrif-disabled="mcp_safe_mode" />
          </div>
          <div class="preferences-row" data-tooltip="preferences.drag_format_hint">
            <span class="preferences-label">@tr:preferences.drag_default</span>
            <select class="preferences-select" data-attrif-disabled="mcp_safe_mode" data-value="splat_drag_format"><option value="ply">@tr:preferences.drag_ply</option><option value="spz">@tr:preferences.drag_spz</option></select>
          </div>
          <div class="preferences-row" data-tooltip="preferences.drag_sh_hint">
            <span class="preferences-label">@tr:preferences.drag_sh_limit</span>
            <select class="preferences-select" data-attrif-disabled="mcp_safe_mode" data-value="splat_drag_sh_degree"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
          </div>
          <div class="preferences-row" data-if="splat_drag_format == 'ply'" data-tooltip="preferences.drag_axes_hint">
            <span class="preferences-label">@tr:preferences.drag_up_axis</span>
            <select class="preferences-select" data-attrif-disabled="mcp_safe_mode" data-value="splat_drag_up_axis"><option value="-2">@tr:preferences.drag_axis_default</option><option value="2">@tr:preferences.drag_axis_positive_y</option><option value="-3">@tr:preferences.drag_axis_negative_z</option><option value="3">@tr:preferences.drag_axis_positive_z</option></select>
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_file_associations">
        <div class="section-header text-accent" data-class-is-expanded="file_associations_expanded" data-event-click="toggle_section('file_associations')">
          <span class="section-arrow text-accent" data-class-is-expanded="file_associations_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.file_associations</span>
        </div>
        <div class="section-content" data-if="file_associations_expanded">
          <span class="preferences-description">@tr:preferences.file_associations_description</span>
          <button class="btn btn--secondary" data-event-click="open_default_app_settings">@tr:file_association.menu_register</button>
          <div data-for="row : file_associations">
            <div class="preferences-row preferences-checkbox-row">
              <span class="preferences-label">{{ row.label }}</span>
              <input type="checkbox" data-checked="row.registered"
                     data-event-change="set_file_association(row.extension, row.registered)" />
            </div>
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_mcp">
        <div class="section-header text-accent" data-class-is-expanded="mcp_expanded" data-event-click="toggle_section('mcp')">
          <span class="section-arrow text-accent" data-class-is-expanded="mcp_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.mcp_server</span>
        </div>
        <div class="section-content" data-if="mcp_expanded">
          <span class="preferences-description preferences-warning" data-if="mcp_safe_mode">@tr:preferences.mcp_safe_mode_notice</span>
          <div class="preferences-row preferences-switch-row">
            <span class="preferences-label">@tr:preferences.mcp_enabled</span>
            <button class="preferences-mcp-toggle" data-class-is-on="mcp_enabled" data-event-click="toggle_mcp_enabled" data-attr-title="mcp_status" data-attrif-disabled="mcp_safe_mode" data-class-disabled="mcp_safe_mode">
              <span class="preferences-mcp-switch-track"><span class="preferences-mcp-switch-knob"></span></span>
            </button>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.mcp_expose_network</span>
            <input type="checkbox" data-checked="mcp_expose_network" data-attrif-disabled="mcp_safe_mode" />
          </div>
          <span class="preferences-description preferences-warning">@tr:preferences.mcp_network_warning</span>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_access_token</span>
            <textarea id="mcp-token" class="preferences-value-selectable" data-value="mcp_token_value" rows="2" readonly="readonly"></textarea>
          </div>
          <div class="preferences-inline-actions">
            <button class="btn" data-event-click="copy_mcp_token">@tr:preferences.mcp_copy_token</button>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_port</span>
            <div class="preferences-port-control">
              <input class="preferences-select preferences-port-input" type="text" data-value="mcp_port" maxlength="5"
                     data-event-change="mcp_port_change(ev.value)" data-attrif-disabled="mcp_safe_mode" />
              <button class="btn btn--primary preferences-port-confirm" data-event-click="confirm_mcp_port" data-attrif-disabled="mcp_safe_mode" data-class-disabled="mcp_safe_mode">@tr:common.ok</button>
            </div>
          </div>
          <span class="preferences-description preferences-setting-hint" data-if="mcp_port_override_visible">{{ mcp_port_override_text }}</span>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.mcp_request_logging</span>
            <input type="checkbox" data-checked="mcp_request_logging" data-attrif-disabled="mcp_safe_mode" />
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_status</span>
            <span>{{ mcp_status }}</span>
          </div>
          <div class="preferences-row" data-if="mcp_has_log_file">
            <span class="preferences-label">@tr:preferences.mcp_current_log</span>
            <span class="preferences-value-selectable">{{ mcp_log_file }}</span>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_endpoint</span>
            <textarea id="mcp-endpoints" class="preferences-value-selectable" data-value="mcp_endpoint_value" rows="2" readonly="readonly"></textarea>
          </div>
          <span class="preferences-description preferences-error" data-if="mcp_has_error">{{ mcp_error }}</span>
          <div class="preferences-inline-actions">
            <button class="btn" data-if="mcp_has_log_file" data-event-click="open_mcp_log_folder">@tr:preferences.mcp_open_log_folder</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  </div>
  <div class="preferences-actions">
    <div class="preferences-footer-sidebar"></div>
    <div class="preferences-footer-gutter"></div>
    <div class="preferences-actions-main">
      <button class="btn btn--warning" data-event-click="reset_current_section" data-if="show_section_reset">{{ reset_section_label }}</button>
      <span class="preferences-actions-spacer"></span>
      <button class="btn btn--warning" data-event-click="reset_all_settings">@tr:preferences.reset_all_settings</button>
      <button class="btn btn--primary" data-event-click="accept_and_close">@tr:common.ok</button>
    </div>
  </div>

  <div id="binding-conflict-overlay" class="preferences-conflict-overlay hidden">
    <div class="preferences-conflict-dialog">
      <span class="preferences-conflict-title">@tr:input_settings.conflict_title</span>
      <span id="binding-conflict-message" class="preferences-conflict-message"></span>
      <div class="separator"></div>
      <div class="preferences-conflict-buttons">
        <button class="btn btn--secondary" data-event-click="cancel_conflict">@tr:input_settings.cancel</button>
        <button class="btn btn--error" data-event-click="replace_conflict">@tr:input_settings.replace</button>
      </div>
    </div>
  </div>
</body>
</rml>
