<rml>
<head>
  <link type="text/template" href="floating_window.rml"/>
  <link type="text/rcss" href="preferences.rcss"/>
</head>
<body template="floating-window" data-model="preferences">
  <div class="preferences-layout">
    <div class="preferences-nav">
      <button class="btn preferences-nav-item" data-class-active="show_general" data-event-click="show_general">@tr:preferences.general</button>
      <button class="btn preferences-nav-item" data-class-active="show_appearance" data-event-click="show_appearance">@tr:preferences.appearance</button>
      <button class="btn preferences-nav-item" data-class-active="show_input" data-event-click="show_input">@tr:preferences.input</button>
      <button class="btn preferences-nav-item" data-class-active="show_interface" data-event-click="show_interface">@tr:preferences.interface</button>
      <button class="btn preferences-nav-item" data-class-active="show_mcp" data-event-click="show_mcp">@tr:preferences.mcp</button>
    </div>

    <div class="preferences-content">
      <div class="preferences-section" data-if="show_general">
        <div class="section-header text-accent" data-class-is-expanded="language_expanded" data-event-click="toggle_section('language')">
          <span class="section-arrow text-accent" data-class-is-expanded="language_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.language</span>
        </div>
        <div class="section-content" data-if="language_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.language</span>
            <select class="preferences-select" data-value="language_idx">
              <option data-for="language : languages" data-attr-value="language.index">{{ language.label }}</option>
            </select>
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_appearance">
        <div class="section-header text-accent" data-class-is-expanded="appearance_expanded" data-event-click="toggle_section('appearance')">
          <span class="section-arrow text-accent" data-class-is-expanded="appearance_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:menu.view.theme</span>
        </div>
        <div class="section-content" data-if="appearance_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:menu.view.theme</span>
            <select class="preferences-select" data-value="theme_idx">
              <option data-for="theme : themes" data-attr-value="theme.index">{{ theme.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:menu.view.ui_scale</span>
            <select class="preferences-select" data-value="scale_idx">
              <option data-for="scale : scales" data-attr-value="scale.index">{{ scale.label }}</option>
            </select>
          </div>
        </div>
      </div>

      <div class="preferences-section" data-if="show_input">
        <div class="section-header text-accent" data-class-is-expanded="navigation_expanded" data-event-click="toggle_section('navigation')">
          <span class="section-arrow text-accent" data-class-is-expanded="navigation_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.camera_navigation</span>
        </div>
        <div class="section-content" data-if="navigation_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.navigation_mode</span>
            <select class="preferences-select" data-value="navigation_idx">
              <option data-for="mode : navigation_modes" data-attr-value="mode.index">{{ mode.label }}</option>
            </select>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.remember_camera_navigation</span>
            <input type="checkbox" data-checked="remember_navigation" />
          </div>
        </div>

        <div class="section-header text-accent" data-class-is-expanded="view_snap_expanded" data-event-click="toggle_section('view_snap')">
          <span class="section-arrow text-accent" data-class-is-expanded="view_snap_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.camera_view_snap</span>
        </div>
        <div class="section-content" data-if="view_snap_expanded">
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.enable_axis_view_snap</span>
            <input type="checkbox" data-checked="view_snap" />
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.remember_camera_view_snap</span>
            <input type="checkbox" data-checked="remember_view_snap" />
          </div>
        </div>

        <div class="section-header text-accent" data-class-is-expanded="key_bindings_expanded" data-event-click="toggle_section('key_bindings')">
          <span class="section-arrow text-accent" data-class-is-expanded="key_bindings_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.key_bindings</span>
        </div>
        <div class="section-content" data-if="key_bindings_expanded">
          <div class="preferences-row">
            <span class="preferences-label">@tr:input_settings.active_profile</span>
            <select id="profile-select" class="preferences-select" data-value="profile_idx"
                    data-class-preferences-capture-disabled="is_capturing">
              <option data-for="profile : profiles" data-attr-value="profile.index">{{ profile.label }}</option>
            </select>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:input_settings.tool_mode</span>
            <select id="mode-select" class="preferences-select" data-value="mode_idx"
                    data-class-preferences-capture-disabled="is_capturing">
              <option data-for="mode : tool_modes" data-attr-value="mode.index">{{ mode.label }}</option>
            </select>
          </div>
          <span class="preferences-description">@tr:input_settings.select_tool_mode</span>
          <span class="preferences-description" id="bindings-hint">{{bindings_hint}}</span>
          <div id="bindings-table" class="preferences-bindings-table">
            <div data-for="row : binding_rows">
              <span class="preferences-binding-section" data-if="row.is_section">{{ row.section_title }}</span>
              <div class="preferences-binding-row" data-if="!row.is_section">
                <span class="preferences-action-name">{{ row.action_name }}</span>
                <span data-attr-class="row.desc_class">{{ row.desc_text }}</span>
                <button data-attr-class="'btn ' + row.button_class + ' preferences-rebind-btn'"
                        data-attr-data-btn-action="row.button_action"
                        data-attr-data-action-id="row.action_id"
                        data-attr-data-mode-id="row.mode_id">{{ row.button_label }}</button>
              </div>
            </div>
          </div>
          <div class="preferences-inline-actions">
            <button class="btn btn--success" data-event-click="save_profile">@tr:input_settings.save_current_profile</button>
            <button class="btn btn--error" data-event-click="reset_default">@tr:input_settings.reset_to_default</button>
          </div>
          <div class="preferences-inline-actions">
            <button class="btn btn--secondary" data-event-click="export_profile">@tr:input_settings.export</button>
            <button class="btn btn--secondary" data-event-click="import_profile">@tr:input_settings.import</button>
          </div>
          <span class="preferences-description">@tr:input_settings.save_hint</span>
          <span class="preferences-description">@tr:input_settings.double_click_hint</span>
        </div>
      </div>

      <div class="preferences-section" data-if="show_interface">
        <div class="section-header text-accent" data-class-is-expanded="interface_expanded" data-event-click="toggle_section('interface')">
          <span class="section-arrow text-accent" data-class-is-expanded="interface_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.interface</span>
        </div>
        <div class="section-content" data-if="interface_expanded">
          <span class="preferences-description">@tr:preferences.interface_layout_description</span>
        </div>
      </div>

      <div class="preferences-section" data-if="show_mcp">
        <div class="section-header text-accent" data-class-is-expanded="mcp_expanded" data-event-click="toggle_section('mcp')">
          <span class="section-arrow text-accent" data-class-is-expanded="mcp_expanded">&#x25B6;</span>
          <span class="text-accent">@tr:preferences.mcp_server</span>
        </div>
        <div class="section-content" data-if="mcp_expanded">
          <span class="preferences-description preferences-warning" data-if="mcp_safe_mode">@tr:preferences.mcp_safe_mode_notice</span>
          <div class="preferences-row preferences-switch-row">
            <span class="preferences-label">@tr:preferences.mcp_enabled</span>
            <button class="preferences-mcp-toggle" data-class-is-on="mcp_enabled" data-event-click="toggle_mcp_enabled" data-attr-title="mcp_status" data-attrif-disabled="mcp_safe_mode" data-class-disabled="mcp_safe_mode">
              <span class="preferences-mcp-switch-track"><span class="preferences-mcp-switch-knob"></span></span>
            </button>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.mcp_expose_network</span>
            <input type="checkbox" data-checked="mcp_expose_network" data-attrif-disabled="mcp_safe_mode" />
          </div>
          <span class="preferences-description preferences-warning">@tr:preferences.mcp_network_warning</span>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_port</span>
            <div class="preferences-port-control">
              <input class="preferences-select preferences-port-input" type="text" data-value="mcp_port" maxlength="5"
                     data-event-change="mcp_port_change(ev.value)" data-attrif-disabled="mcp_safe_mode" />
              <button class="btn btn--primary preferences-port-confirm" data-event-click="confirm_mcp_port" data-attrif-disabled="mcp_safe_mode" data-class-disabled="mcp_safe_mode">@tr:common.ok</button>
            </div>
          </div>
          <div class="preferences-row preferences-checkbox-row">
            <span class="preferences-label">@tr:preferences.mcp_request_logging</span>
            <input type="checkbox" data-checked="mcp_request_logging" data-attrif-disabled="mcp_safe_mode" />
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_status</span>
            <span>{{ mcp_status }}</span>
          </div>
          <div class="preferences-row" data-if="mcp_has_log_file">
            <span class="preferences-label">@tr:preferences.mcp_current_log</span>
            <span class="preferences-value-selectable">{{ mcp_log_file }}</span>
          </div>
          <div class="preferences-row">
            <span class="preferences-label">@tr:preferences.mcp_endpoint</span>
            <textarea id="mcp-endpoints" class="preferences-value-selectable" data-value="mcp_endpoint_value" rows="2" readonly="readonly"></textarea>
          </div>
          <span class="preferences-description preferences-error" data-if="mcp_has_error">{{ mcp_error }}</span>
          <div class="preferences-inline-actions">
            <button class="btn" data-if="mcp_has_log_file" data-event-click="open_mcp_log_folder">@tr:preferences.mcp_open_log_folder</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <div class="preferences-actions">
    <div class="preferences-footer-sidebar"></div>
    <div class="preferences-footer-gutter"></div>
    <div class="preferences-actions-main">
      <button class="btn btn--warning" data-event-click="reset_current_section" data-if="show_section_reset">{{ reset_section_label }}</button>
      <span class="preferences-actions-spacer"></span>
      <button class="btn btn--warning" data-event-click="reset_all_settings">@tr:preferences.reset_all_settings</button>
      <button class="btn btn--primary" data-event-click="accept_and_close">@tr:common.ok</button>
    </div>
  </div>

  <div id="binding-conflict-overlay" class="preferences-conflict-overlay hidden">
    <div class="preferences-conflict-dialog">
      <span class="preferences-conflict-title">@tr:input_settings.conflict_title</span>
      <span id="binding-conflict-message" class="preferences-conflict-message"></span>
      <div class="separator"></div>
      <div class="preferences-conflict-buttons">
        <button class="btn btn--secondary" data-event-click="cancel_conflict">@tr:input_settings.cancel</button>
        <button class="btn btn--error" data-event-click="replace_conflict">@tr:input_settings.replace</button>
      </div>
    </div>
  </div>
</body>
</rml>
