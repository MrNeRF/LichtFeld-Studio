<rml>
<head>
  <link type="text/template" href="floating_window.rml"/>
  <link type="text/rcss" href="plugin_marketplace.rcss"/>
</head>
<body template="floating-window" data-model="plugin_marketplace">
  <div id="main-area">
    <div class="mp-intro">
      <span class="mp-warning-note">@tr:plugin_marketplace.warning_body</span>
    </div>

    <!-- Filter / Sort controls -->
    <div class="mp-controls">
      <div class="mp-controls-main">
        <div class="mp-control-group">
          <span class="mp-control-label text-disabled">@tr:plugin_marketplace.filter_label</span>
          <select data-value="filter_idx" class="mp-select">
            <option value="0">@tr:plugin_marketplace.filter.all</option>
            <option value="1">@tr:plugin_marketplace.filter.installed</option>
            <option value="2">@tr:plugin_marketplace.filter.not_installed</option>
          </select>
        </div>
        <div class="mp-control-group">
          <span class="mp-control-label text-disabled">@tr:plugin_marketplace.sort_label</span>
          <select data-value="sort_idx" class="mp-select-sort">
            <option value="0">@tr:plugin_marketplace.sort.popularity_desc</option>
            <option value="1">@tr:plugin_marketplace.sort.popularity_asc</option>
            <option value="2">@tr:plugin_marketplace.sort.name_asc</option>
            <option value="3">@tr:plugin_marketplace.sort.name_desc</option>
          </select>
        </div>
      </div>
      <div class="mp-view-toggle">
        <button id="view-cards-btn" type="button" class="btn btn--secondary mp-view-btn"
                data-class-selected="view_is_card" data-tooltip="plugin_marketplace.view.grid"
                data-event-click="view_cards"><span class="mp-icon-grid"><span></span><span></span><span></span><span></span></span></button>
        <button id="view-list-btn" type="button" class="btn btn--secondary mp-view-btn"
                data-class-selected="view_is_list" data-tooltip="plugin_marketplace.view.list"
                data-event-click="view_list"><span class="mp-icon-list"><span></span><span></span><span></span></span></button>
      </div>
    </div>

    <!-- Manual URL install -->
    <div class="mp-manual-section">
      <button type="button" id="manual-header" class="mp-collapse-toggle">
        <span class="section-arrow" id="manual-arrow">&#x25B6;</span>
        <span class="mp-section-title">@tr:plugin_manager.github_url_or_shorthand</span>
      </button>
      <div id="manual-content" class="section-content collapsed">
        <form id="manual-install-form">
          <div class="mp-manual-row">
            <input type="text" id="manual-url-input" class="mp-url-input" data-value="manual_url" />
            <button id="btn-install-url" type="button" class="btn btn--success mp-install-btn" data-event-click="do_install_url"><span>@tr:plugin_marketplace.button.install</span></button>
          </div>
          <div id="manual-feedback" class="card-feedback hidden">
            <progress id="manual-feedback-progress" class="card-progress hidden" max="1" value="0" />
            <span id="manual-feedback-progress-text" class="card-progress-text hidden"></span>
            <span id="manual-feedback-success" class="status-text status-success hidden"></span>
            <span id="manual-feedback-error" class="status-text status-error hidden"></span>
          </div>
          <input class="submit-proxy" type="submit" />
        </form>

        <!-- Supported formats (collapsible) -->
        <button type="button" id="formats-header" class="mp-collapse-toggle mp-formats-header">
          <span class="section-arrow" id="formats-arrow">&#x25B6;</span>
          <span class="mp-formats-label">@tr:plugin_manager.supported_formats</span>
        </button>
        <div id="formats-content" class="section-content collapsed">
          <div class="mp-format-item">https://github.com/owner/repo</div>
          <div class="mp-format-item">github:owner/repo</div>
          <div class="mp-format-item">owner/repo</div>
        </div>
      </div>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="mp-empty-state hidden">
      <span class="mp-empty-mark">+</span>
      <span class="mp-empty-title">@tr:plugin_marketplace.no_plugins</span>
      <span class="mp-empty-description text-disabled">@tr:plugin_marketplace.edit_list_hint</span>
    </div>

    <!-- Marketplace results (card or list layout, rendered dynamically by the panel controller) -->
    <div id="card-grid" class="card-grid"></div>
  </div>

  <div id="status-bar">
    <span class="mp-status-dot" id="catalog-status-dot"></span>
    <span class="status-item" id="catalog-status">@tr:plugin_marketplace.loading</span>
  </div>

  <!-- Uninstall confirmation overlay -->
  <div id="confirm-overlay" class="confirm-overlay hidden">
    <div id="confirm-dialog" class="confirm-dialog" tabindex="-1">
      <span class="confirm-title">@tr:plugin_manager.button.uninstall</span>
      <span id="confirm-message" class="confirm-message"></span>
      <div class="separator"></div>
      <div class="confirm-buttons">
        <button class="btn btn--secondary" data-event-click="confirm_no"><span>@tr:plugin_marketplace.confirm_uninstall_no</span></button>
        <button class="btn btn--error" data-event-click="confirm_yes"><span>@tr:plugin_marketplace.confirm_uninstall_yes</span></button>
      </div>
    </div>
  </div>

</body>
</rml>
