/* Solid surfaces and semantic chart colors follow the active theme. */
#histogram-toolbar,
#histogram-stats {
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

.control-label,
.range-of-interest-label,
.range-separator,
.compare-axis-marker,
.stat-label,
.axis-metric,
.empty-message {
    color: @{text_dim};
}

.stat-value,
.axis-label,
.empty-title {
    color: @{text};
}

.histogram-bar-fill,
.compare-cell-fill {
    decorator: none;
    background-color: @{primary};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    background-color: @{warning};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
}

.histogram-step-button,
#histogram-close {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.histogram-step-button:hover,
#histogram-close:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

.histogram-step-button:active,
#histogram-close:active {
    background-color: @{alpha(primary,0.32)};
    border-color: @{primary};
}
