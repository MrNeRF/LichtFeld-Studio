/* Solid surfaces and semantic chart colors follow the active theme. */
#histogram-toolbar,
#histogram-stats {
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

.control-label,
.range-of-interest-label,
.range-separator,
.compare-axis-marker,
.histogram-description,
.histogram-context-values,
.stat-label,
.axis-metric,
.empty-message {
    color: @{text_dim};
}

.stat-value,
.axis-label,
#histogram-floating-title,
.empty-title,
.histogram-slider-value {
    color: @{text};
}

.histogram-bar-fill,
.compare-cell-fill {
    decorator: none;
    background-color: @{primary};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    background-color: @{warning};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
}
