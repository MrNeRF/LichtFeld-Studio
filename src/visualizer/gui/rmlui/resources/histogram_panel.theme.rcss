/* Shared border roles and shape scale. */

#histogram-chart {
    border-radius: @{radius.control}dp;
}

#histogram-selection {
    border-radius: @{radius.control}dp;
}

.histogram-bar-fill {
    border-radius: @{radius.control}dp @{radius.control}dp 0 0;
}

#compare-chart {
    border-radius: @{radius.control}dp;
}

#compare-selection {
    border-radius: @{radius.control}dp;
}

.compare-cell-fill {
    border-radius: @{radius.control}dp;
}

/* Solid surfaces and semantic chart colors follow the active theme. */
#histogram-toolbar,
#histogram-stats {
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

.control-label,
.range-of-interest-label,
.range-separator,
.compare-axis-marker,
.stat-label,
.axis-metric,
.empty-message {
    color: @{text_dim};
}

.stat-value,
.axis-label,
.empty-title {
    color: @{text};
}

.histogram-bar-fill,
.compare-cell-fill {
    decorator: none;
    background-color: @{primary};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    background-color: @{warning};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
}

.histogram-bin-scrub .scrub-field {
    decorator: none;
    background-color: @{surface_bright};
}

.histogram-bin-scrub .scrub-field-fill {
    decorator: none;
    background-color: @{alpha(primary,0.4)};
}

.histogram-bin-scrub .scrub-field:hover .scrub-field-fill,
.histogram-bin-scrub .scrub-field.is-dragging .scrub-field-fill {
    background-color: @{alpha(primary,0.55)};
}
