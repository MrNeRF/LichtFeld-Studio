/* Area frames and headers of the screen (layout only; colours live in the theme sheet). */

body {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: Inter;
    font-size: 12dp;
}

.area {
    position: absolute;
    box-sizing: border-box;
    border-radius: 6dp;
    overflow: hidden;
}

.area-header {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 6dp 0 8dp;
    gap: 2dp;
    border-top-left-radius: 6dp;
    border-top-right-radius: 6dp;
    border-bottom-width: 1dp;
}

.editor-switch {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    height: 20dp;
    padding: 0 5dp 0 6dp;
    margin-right: 6dp;
    gap: 3dp;
    border-radius: 4dp;
    cursor: pointer;
}

.editor-icon {
    width: 16dp;
    height: 16dp;
}

.editor-caret,
.hitem-caret {
    width: 0;
    height: 0;
    border-left-width: 3dp;
    border-right-width: 3dp;
    border-top-width: 4dp;
    border-bottom-width: 0;
    margin-top: 1dp;
}

.header-items {
    display: flex;
    flex: 1 1 auto;
    flex-direction: row;
    align-items: center;
    gap: 2dp;
    overflow-x: auto;
    overflow-y: hidden;
    height: 100%;
}

.header-right {
    display: flex;
    flex: 0 0 auto;
    flex-direction: row;
    align-items: center;
    gap: 1dp;
    height: 100%;
}

.hitem {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    height: 20dp;
    padding: 0 7dp;
    gap: 4dp;
    border-radius: 4dp;
    cursor: pointer;
    white-space: nowrap;
}

.hitem.toggle,
.hitem.button,
.hitem.menu.has-icon {
    padding: 0 4dp;
    min-width: 22dp;
    justify-content: center;
}

.hitem.label {
    cursor: default;
    padding: 0 4dp;
}

.hitem-icon {
    width: 16dp;
    height: 16dp;
}

.hitem-label {
    line-height: 20dp;
}

.view-label {
    position: absolute;
    left: 8dp;
    top: 32dp;
    font-size: 11dp;
    line-height: 14dp;
    pointer-events: none;
    z-index: 1;
    padding: 1dp 4dp;
}

/* The category rail of a Properties area: below the header at the left of the
   content, PropertiesEditor::kTabRailDp wide including its 4dp inset. Labels
   read bottom to top; ScreenHost::syncTabRails sizes each tab to its label and
   sets the overflow class, the edges and the disabled scroll buttons. The strip
   has no scrollbar: the wheel and the buttons scroll it. */
.tab-rail {
    position: absolute;
    left: 4dp;
    bottom: 4dp;
    width: 28dp;
    margin-top: 4dp;
    overflow: hidden;
}

.tab-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 3dp;
    overflow: hidden;
}

.tab-rail.overflow .tab-strip {
    top: 22dp;
    bottom: 22dp;
}

.tab-slot {
    flex: 0 0 auto;
}

/* Inactive tabs are recessed; the active one fills the rail and opens toward
   its content. */
.tab {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 25dp;
    min-height: 28dp;
    margin-left: 3dp;
    border-width: 1dp;
    border-radius: 6dp 0 0 6dp;
    white-space: nowrap;
    cursor: pointer;
}

.tab.active {
    width: 28dp;
    margin-left: 0;
    border-right-width: 0;
    font-weight: 600;
}

.tab-label {
    position: absolute;
    display: block;
    white-space: nowrap;
    transform-origin: 0 0;
    transform: rotate(-90deg);
    pointer-events: none;
}

.tab .tab-close {
    position: absolute;
    left: 50%;
    bottom: 2dp;
    margin-left: -8dp;
}

.tab-edge {
    position: absolute;
    right: 0;
    width: 1dp;
    pointer-events: none;
}

.tab-nav {
    display: none;
    position: absolute;
    left: 0;
    width: 28dp;
    height: 20dp;
    padding: 0;
    border-width: 0;
    border-radius: 4dp;
    line-height: 20dp;
    font-size: 10dp;
    text-align: center;
    cursor: pointer;
}

.tab-rail.overflow .tab-nav { display: block; }
.tab-nav[disabled] { cursor: default; }
.tab-scroll-up { top: 0; }
.tab-scroll-down { bottom: 0; }

.tab-close {
    display: block;
    width: 16dp;
    height: 16dp;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 4dp;
    line-height: 16dp;
    text-align: center;
    font-size: 13dp;
    font-weight: bold;
    cursor: pointer;
}
