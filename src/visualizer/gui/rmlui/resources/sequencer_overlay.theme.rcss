/* Shared border roles and shape scale. */

.edit-popup {
    border-radius: @{radius.surface}dp;
}

.overlay-panel {
    border-radius: @{radius.control}dp;
}

/* Theme-dependent sequencer overlay popups. */

.overlay-panel,
.edit-popup {
    background-color: @{sequencer_overlay.surface};
    border-color: @{border};
    border-radius: @{radius.surface}dp;
}

.overlay-text,
.popup-title {
    color: @{text};
}

.overlay-text-dim {
    color: @{text_dim};
}

#pip-preview-window {
    border-color: @{primary};
    border-radius: @{radius.surface}dp;
}

#pip-preview-window.playing {
    border-color: @{error};
}

.popup-sep {
    background-color: @{alpha(border,0.5)};
}
