body,
.row-label,
.field-label,
.toggle-label {
    color: @{text};
}

.section-rule,
.section-rule__label,
.inline-note {
    color: @{text_dim};
}

.section-rule__lead,
.section-rule__line {
    background-color: @{alpha(border,0.65)};
}

.status-section--warning {
    border-color: @{warning};
}

.status-section--warning .status-text {
    color: @{warning};
}

.timeline-segment {
    background-color: @{alpha(primary,0.15)};
    border-color: @{alpha(primary,0.55)};
}

.timeline-segment-remove {
    color: @{text};
    background-color: @{alpha(surface,0.85)};
}

.timeline-segment-remove:hover {
    color: @{error};
}
