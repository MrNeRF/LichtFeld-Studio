<rml>
    <head>
        <link type="text/rcss" href="sequencer.rcss" />
    </head>
    <body id="body" class="docked-panel">
        <div id="panel">
            <div id="floating-header" class="hidden">
                <span id="floating-title">@tr:toolbar.sequencer</span>
                <div id="floating-actions">
                    <div id="btn-close-panel" class="transport-btn text wide floating-header-action" data-tooltip="common.close">
                        <img class="transport-icon" src="../icon/scene/x.png" />
                    </div>
                </div>
            </div>
            <div id="transport-row">
                <div id="playback-controls" class="toolbar-group">
                    <div id="transport">
                        <div id="btn-skip-back" class="transport-btn" data-tooltip="tooltip.seq_first">
                            <img class="transport-icon" src="../icon/sequencer/skip-back.png" />
                        </div>
                        <div id="btn-prev-keyframe" class="transport-btn" data-tooltip="tooltip.seq_prev_keyframe">
                            <img class="transport-icon" src="../icon/sequencer/step-back.png" />
                        </div>
                        <div id="btn-stop" class="transport-btn" data-tooltip="tooltip.seq_stop">
                            <img class="transport-icon" src="../icon/sequencer/stop.png" />
                        </div>
                        <div id="btn-play" class="transport-btn play-btn" data-tooltip="tooltip.seq_play" data-action="sequencer_play_pause">
                            <img id="play-icon" class="transport-icon" src="../icon/sequencer/play.png" />
                        </div>
                        <div id="btn-next-keyframe" class="transport-btn" data-tooltip="tooltip.seq_next_keyframe">
                            <img class="transport-icon" src="../icon/sequencer/step-forward.png" />
                        </div>
                        <div id="btn-skip-forward" class="transport-btn" data-tooltip="tooltip.seq_last">
                            <img class="transport-icon" src="../icon/sequencer/skip-forward.png" />
                        </div>
                        <div id="btn-loop" class="transport-btn" data-tooltip="tooltip.seq_loop_off">
                            <img class="transport-icon" src="../icon/sequencer/loop.png" />
                        </div>
                    </div>
                    <div id="time-display">
                        <span id="current-time">0:00.00</span>
                        <div id="duration-field" data-tooltip="tooltip.seq_clip_duration">
                            <span id="duration" />
                            <input id="duration-input" type="text" />
                        </div>
                    </div>
                    <div id="btn-speed" class="transport-btn text speed-group" data-tooltip="tooltip.seq_speed">
                        <span id="speed-label" class="speed-val">1x</span>
                        <img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                </div>
                <div id="editing-controls" class="toolbar-group">
                    <div id="btn-add" class="transport-btn" data-tooltip="tooltip.seq_add" data-action="sequencer_add_keyframe">
                        <img class="transport-icon" src="../icon/sequencer/plus.png" />
                    </div>
                    <div id="btn-add-reveal" class="transport-btn text"><span id="reveal-button-label" class="transport-label">@tr:sequencer.add_reveal</span></div>
                    <div id="btn-snap" class="transport-btn toggle" data-tooltip="tooltip.seq_snap">
                        <img class="transport-icon" src="../icon/magnet.png" />
                    </div>
                    <div id="btn-snap-options" class="transport-btn text menu-button" data-tooltip="tooltip.seq_snap_options">
                        <img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                </div>
                <div id="view-controls" class="toolbar-group">
                    <div id="btn-camera-path" class="transport-btn toggle" data-tooltip="tooltip.seq_camera_path">
                        <img class="transport-icon" src="../icon/sequencer/camera-path.png" />
                    </div>
                    <div id="btn-follow" class="transport-btn toggle" data-tooltip="tooltip.seq_follow">
                        <img class="transport-icon" src="../icon/sequencer/follow.png" />
                    </div>
                    <div id="btn-film-strip" class="transport-btn toggle" data-tooltip="tooltip.seq_film_strip">
                        <img class="transport-icon" src="../icon/sequencer/film-strip.png" />
                    </div>
                    <div id="btn-preview" class="transport-btn toggle" data-tooltip="tooltip.seq_pip_preview">
                        <img class="transport-icon" src="../icon/sequencer/preview.png" />
                    </div>
                    <div id="btn-preview-options" class="transport-btn text menu-button" data-tooltip="tooltip.seq_preview_options">
                        <img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                    <div id="btn-equirect" class="transport-btn text menu-button" data-tooltip="tooltip.seq_projection">
                        <img class="transport-icon" src="../icon/world.png" /><img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                    <div id="btn-camera-aspect" class="transport-btn text menu-button" data-tooltip="tooltip.seq_camera_aspect">
                        <img class="transport-icon" src="../icon/bounds.png" /><span id="camera-aspect-label">16:9</span><img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                </div>
                <div id="file-controls" class="toolbar-group">
                    <div id="btn-path-menu" class="transport-btn text menu-button" data-tooltip="tooltip.seq_path_menu">
                        <img class="transport-icon" src="../icon/scene/camera.png" />
                        <img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                    <div id="btn-load-sequence" class="transport-btn text menu-button" data-tooltip="tooltip.seq_ply_menu">
                        <img class="transport-icon" src="../icon/sequencer/film-strip.png" />
                        <span class="transport-label">PLY</span>
                        <img class="menu-chevron" src="../icon/dropdown-arrow.png" />
                    </div>
                    <div id="sequence-fps-field" class="sequence-fps-field hidden" data-tooltip="tooltip.seq_sequence_fps">
                        <span class="transport-label">@tr:sequencer.ply_fps</span>
                        <span id="sequence-fps-display">24</span>
                        <input id="sequence-fps-input" type="text" />
                    </div>
                </div>
                <div id="output-controls" class="toolbar-group">
                    <div id="btn-export" class="transport-btn text primary" data-tooltip="tooltip.seq_export">
                        <img class="transport-icon export-icon" src="../icon/sequencer/export.png" />
                        <span class="transport-label export-label">@tr:scene.export</span>
                    </div>
                    <div id="btn-dock-toggle" class="transport-btn text wide" data-tooltip="tooltip.seq_undock">
                        <img class="transport-icon" src="../icon/arrows-maximize.png" />
                    </div>
                </div>
            </div>
            <div id="header">
                <div id="timeline">
                    <div id="ruler" data-tooltip="tooltip.seq_ruler" />
                    <div id="track-area">
                        <div id="track-bar">
                            <span id="hint" />
                        </div>
                        <div id="reveal-strip" />
                        <div id="sequence-strip" />
                        <div id="keyframes" />
                        <div id="playhead">
                            <div id="playhead-handle" />
                        </div>
                        <div id="timeline-scrollbar" data-tooltip="tooltip.seq_timeline_scroll">
                            <div id="timeline-scrollbar-thumb" />
                        </div>
                    </div>
                </div>
            </div>
            <div id="easing-stripe">
                <div id="easing-segments" />
                <div id="easing-curves" />
                <div id="easing-indicators" />
            </div>
            <div id="film-strip-panel">
                <div id="film-strip-groove">
                    <div id="film-strip-gaps" />
                    <div id="film-strip-thumbs" />
                    <div id="film-strip-dividers" />
                    <div id="film-strip-markers" />
                    <div id="film-strip-sprockets-top" />
                    <div id="film-strip-sprockets-bottom" />
                </div>
            </div>
            <div id="reveal-settings" class="hidden">
                <span>@tr:sequencer.reveal_start</span><input id="reveal-start" type="text" />
                <span>@tr:sequencer.reveal_end</span><input id="reveal-end" type="text" />
                <span data-tooltip="sequencer.reveal_softness_hint">@tr:sequencer.reveal_softness</span><input id="reveal-softness" type="text" data-tooltip="sequencer.reveal_softness_hint" />
                <div id="btn-remove-reveal" class="transport-btn text"><span class="transport-label">@tr:common.remove</span></div>
            </div>
        </div>
        <div id="panel-guides">
            <div id="guide-playhead" class="timeline-guide playhead" />
            <div id="guide-selected" class="timeline-guide selected" />
            <div id="guide-hovered" class="timeline-guide hovered" />
            <div id="guide-strip-hover" class="timeline-guide strip-hover" />
        </div>
        <div id="timeline-tooltip" />
    </body>
</rml>
