/* Export panel styles */

#content-wrap {
    min-width: 0;
    overflow-x: hidden;
}

#minimize-btn,
#maximize-btn {
    display: none;
}

/* The format rail sets a stable height even when the scene has no splats. */
.ep-layout {
    display: flex;
    gap: 16dp;
    align-items: flex-start;
}

.ep-format-column {
    width: 262dp;
    flex-shrink: 0;
}

.ep-details-column {
    flex: 1;
    min-width: 0;
}

.ep-section {
    margin-bottom: 4dp;
}

.ep-section .setting-row--aligned {
    min-width: 0;
}

.ep-section-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    padding: 4dp 8dp;
    margin-bottom: 0;
}

/* ── Format list ─────────────────────────────────────── */

.ep-format-list {
    margin-top: 2dp;
}

.ep-format-option {
    display: flex;
    align-items: center;
    min-height: 41dp;
    padding: 2dp 8dp;
    cursor: pointer;
    transition: background-color 0.1s quadratic-out;
}

.ep-format-dot {
    width: 8dp;
    height: 8dp;
    border-width: 1dp;
    border-radius: 5dp;
    margin-right: 8dp;
    flex-shrink: 0;
}

.ep-format-name {
    display: block;
    font-size: 12dp;
    font-weight: bold;
}

.ep-format-copy {
    flex: 1;
    min-width: 0;
}

.ep-format-description {
    display: block;
    font-size: 12dp;
    margin-top: 2dp;
}

.ep-details-description {
    margin-bottom: 12dp;
}

/* ── Model list ──────────────────────────────────────── */

.ep-model-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.ep-toggle-row {
    display: flex;
    gap: 4dp;
}

.ep-small-btn {
    font-size: 12dp;
    padding: 1dp 8dp;
}

.ep-model-list {
    border-width: 1dp;
    border-radius: 2dp;
    max-height: 210dp;
    overflow-y: auto;
    padding: 8dp;
}

.ep-model-row {
    display: flex;
    align-items: center;
    padding: 2dp 4dp;
    min-height: 20dp;
}

.ep-model-row.is-group .ep-model-name {
    font-weight: bold;
}

.ep-model-row .setting-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
}

.ep-model-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12dp;
}

.ep-model-count {
    font-size: 12dp;
    margin-left: 6dp;
    flex-shrink: 0;
}

.ep-empty-state {
    padding: 16dp 0 2dp;
}

.ep-empty-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 8dp;
}

.ep-empty-hint {
    display: block;
    font-size: 12dp;
    margin-bottom: 8dp;
}

/* ── Action area ─────────────────────────────────────── */

.ep-error {
    display: block;
    font-size: 12dp;
    margin-bottom: 4dp;
}

.ep-error.hidden {
    display: none;
}

.ep-buttons {
    display: flex;
    gap: 6dp;
    justify-content: flex-end;
    border-top-width: 1dp;
    padding-top: 12dp;
    margin-top: 8dp;
}

.ep-action-btn {
    box-sizing: border-box;
    width: 78dp;
    min-width: 78dp;
    min-height: 24dp;
    text-align: center;
}

/* ── Progress section ──────────────────────────────── */

@keyframes ep-pulse {
    from { background-color: #89b4fa; }
    to   { background-color: #b4d0fb; }
}

.ep-progress-wrap {
    position: relative;
    margin: 6dp 0;
}

.ep-progress-wrap.is-exporting .ep-progress fill {
    animation: ep-pulse 1.2s quadratic-in-out infinite alternate;
}

.ep-stage-text {
    display: block;
    font-size: 12dp;
    margin-bottom: 6dp;
}
