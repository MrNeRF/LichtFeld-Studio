.watchdirs-toolbar {
    display: flex;
    margin: 10dp 0;
}

.watchdirs-list {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    max-height: 240dp;
    overflow-y: auto;
}

.watchdirs-row {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-width: 0;
}

.watchdirs-path {
    flex: 1;
}

.watchdirs-remove {
    flex-shrink: 0;
}

.watchdirs-status {
    display: block;
    margin-top: 10dp;
    font-size: 11dp;
}
