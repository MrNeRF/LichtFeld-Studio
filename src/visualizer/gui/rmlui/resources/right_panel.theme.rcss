/* Shared border roles and shape scale. */

#splitter-grip {
    border-radius: @{radius.control}dp;
}

.tab-nav {
    border-radius: @{radius.control}dp;
}

.tab {
    border-radius: @{radius.control}dp 0 0 @{radius.control}dp;
}

.tab-close {
    border-radius: @{radius.control}dp;
}

/* Theme-dependent right panel chrome. */

#tab-bar {
    background-color: transparent;
}

.tab-nav {
    background-color: @{right_panel.tab_nav_bg};
    color: @{text_dim};
}

.tab-nav:hover,
.tab-nav:focus-visible {
    background-color: @{right_panel.tab_nav_hover};
    color: @{text};
}

.tab-nav:disabled {
    background-color: transparent;
    color: @{right_panel.tab_nav_disabled};
}

.tab-close { color: @{text_dim}; }
.tab-close:hover,
.tab-close:focus-visible {
    background-color: @{right_panel.tab_hover};
    color: @{text};
}

#splitter {
    background-color: transparent;
}

#splitter:hover {
    background-color: @{right_panel.splitter_hover};
}

#splitter.dragging {
    background-color: @{right_panel.splitter_active};
}

.tab {
    background-color: @{alpha(surface_bright,0.36)};
    color: @{text_dim};
    border-color: @{border};
}

.tab:hover {
    @{right_panel.tab_hover_decor};
}

.tab:focus-visible {
    @{right_panel.tab_hover_decor};
    color: @{text};
    border-color: @{primary};
    border-left-color: @{primary};
}

.tab.active {
    decorator: none;
    background-color: transparent;
    color: @{text};
    border-color: @{primary};
}

#left-border {
    @{chrome.right_panel_edge_shape};
}

#resize-handle:hover,
#resize-handle.hover {
    background-color: @{right_panel.resize_hover};
}

#resize-handle.dragging {
    background-color: @{right_panel.resize_active};
}

.tab-edge { background-color: @{right_panel.tab_active_border}; }
#splitter-grip { background-color: @{border}; }
#splitter:hover #splitter-grip,
#splitter.dragging #splitter-grip { background-color: @{text}; }
