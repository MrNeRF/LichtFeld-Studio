/* Theme-dependent right panel chrome. */

#splitter {
    background-color: @{right_panel.splitter_bg};
}

#splitter:hover {
    background-color: @{right_panel.splitter_hover};
}

#splitter.dragging {
    background-color: @{right_panel.splitter_active};
}

.tab {
    background-color: transparent;
    color: @{text_dim};
    @{right_panel.tab_shape};
    border-color: @{right_panel.tab_border};
    border-bottom-color: @{right_panel.tab_bottom_border};
}

.tab-label {
    @{right_panel.tab_label_shape};
}

.tab:hover {
    @{right_panel.tab_hover_decor};
}

.tab:focus-visible {
    @{right_panel.tab_hover_decor};
    color: @{text};
    border-color: @{right_panel.tab_active_border};
    border-bottom-color: @{right_panel.tab_active_bottom_border};
}

.tab.active {
    @{right_panel.tab_active_decor};
    color: @{text};
    border-color: @{right_panel.tab_active_border};
    border-bottom-color: @{right_panel.tab_active_bottom_border};
}

.tab-close {
    color: @{text_dim};
}

.tab-close:hover,
.tab-close:focus-visible {
    background-color: @{right_panel.tab_hover};
    color: @{text};
}

.tab-nav {
    background-color: @{right_panel.tab_nav_bg};
    color: @{text_dim};
}

.tab-nav:hover {
    background-color: @{right_panel.tab_nav_hover};
    color: @{text};
}

.tab-nav.disabled,
.tab-nav.disabled:hover {
    background-color: transparent;
    color: @{right_panel.tab_nav_disabled};
    opacity: 0.55;
}

#left-border {
    background-color: @{right_panel.border};
}

#tab-separator {
    background-color: @{right_panel.separator};
}

#resize-handle:hover,
#resize-handle.hover {
    background-color: @{right_panel.resize_hover};
}

#resize-handle.dragging {
    background-color: @{right_panel.resize_active};
}
