/* Asset Manager theme-dependent styles */

/* ── Window ────────────────────────────────────────────── */

#asset-floating-title {
    color: @{text};
}

#asset-popup {
    @{panel.body_decor};
    color: @{text};
    border-color: @{border};
}

/* ── Quick Look ──────────────────────────────────────────── */

.asset-quick-look {
    background-color: @{modal.backdrop};
}

.asset-quick-look-card {
    background-color: @{surface};
}

.asset-size-menu {
    background-color: @{surface};
    color: @{text};
    border-color: @{border};
}

/* ── Toolbar ─────────────────────────────────────────────── */

.asset-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-button:hover {
    background-color: @{lighten(surface_bright,0.06)};
    border-color: @{primary};
    color: @{text};
}

.asset-button:active {
    background-color: @{alpha(primary,0.24)};
    border-color: @{primary};
}

#asset-popup-toolbar {
    background-color: @{alpha(surface,0.72)};
    border-bottom-color: @{border};
}

.asset-panel-close {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-panel-close:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

.asset-panel-close:active {
    background-color: @{alpha(primary,0.32)};
    border-color: @{primary};
}

.asset-search-box {
    background-color: @{surface_bright};
    border-color: @{border};
}

.asset-search-box input[type="text"] {
    color: @{text};
}

.asset-icon-grid > span,
.asset-icon-list > span {
    background-color: @{text};
}

.asset-refresh-button img,
.asset-toolbar-view img,
.asset-folder-menu img,
.asset-card-menu img {
    image-color: @{alpha(text,0.90)};
}

.inspector-more img,
.inspector-disclosure,
.asset-list-header-gallery-icon {
    image-color: @{alpha(text,0.90)};
}

.asset-refresh-button:hover img,
.asset-toolbar-view:hover img,
.asset-folder-menu:hover img,
.asset-card-menu:hover img,
.inspector-more:hover img {
    image-color: @{text};
}

.asset-add-folder-glyph {
    color: @{text};
}

.asset-import-button {
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{blend(surface,primary,button.tint_normal)};
    color: @{text};
}

.asset-import-button:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{blend(surface,primary,button.tint_hover)};
}

.asset-import-button:active {
    background-color: @{blend(surface,primary,button.tint_active)};
    border-color: @{blend(surface,primary,button.tint_active)};
}

.asset-sort-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-view-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-view-button.is-active {
    background-color: @{lighten(surface_bright,0.06)};
    color: @{text};
    border-color: @{primary};
}

/* ── Sidebar ─────────────────────────────────────────────── */

#asset-sidebar {
    background-color: @{alpha(background,0.32)};
    border-bottom-color: @{border};
}

.asset-sidebar-global {
    border-bottom-color: @{border};
}

.asset-sidebar-title {
    color: @{text_dim};
}

.asset-sidebar-title .section-arrow {
    color: @{alpha(text_dim,0.72)};
}

.asset-sidebar-title:hover .section-arrow,
.asset-sidebar-title .section-arrow.is-expanded {
    color: @{text};
}

.asset-filter-row:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

.asset-filter-row.is-drag-over,
.asset-filter-row.is-active {
    background-color: @{alpha(primary,0.20)};
}

.asset-filter-row.is-active .asset-row-label {
    color: @{primary};
}

.asset-row-label {
    color: @{text};
}

.asset-row-count {
    color: @{text_dim};
}

.asset-folder-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-folder-menu:hover {
    background-color: @{alpha(surface_bright,0.94)};
}

.asset-resize-handle:hover,
.asset-resize-handle:active,
.asset-resize-handle:focus {
    background-color: @{alpha(primary,0.45)};
}

.asset-resize-handle--horizontal,
.asset-resize-handle--horizontal:hover,
.asset-resize-handle--horizontal:active,
.asset-resize-handle--horizontal:focus {
    background-color: transparent;
}

.asset-resize-handle--horizontal .asset-resize-handle-line { background-color: @{border}; }
.asset-resize-handle--horizontal:hover .asset-resize-handle-line,
.asset-resize-handle--horizontal:active .asset-resize-handle-line,
.asset-resize-handle--horizontal.dragging .asset-resize-handle-line { background-color: @{primary}; }

/* ── Gallery ─────────────────────────────────────────────── */

#asset-gallery {
    background-color: @{alpha(surface,0.58)};
}

.asset-gallery-header {
    border-bottom-color: @{border};
}

.asset-gallery-subtitle {
    color: @{text_dim};
}

.asset-gallery-notice {
    color: @{warning};
}

.asset-gallery-scan-status {
    color: @{text_dim};
}

.asset-loading-label {
    color: @{text_dim};
}

.asset-loading-track {
    background-color: @{statusbar.progress_bg};
}

.asset-loading-fill {
    background-color: @{primary};
}

.asset-gallery-scroll::-webkit-scrollbar-track {
    background: @{blend(surface,background,0.35)};
}

.asset-gallery-scroll::-webkit-scrollbar-thumb {
    background: @{border};
}

.asset-gallery-scroll::-webkit-scrollbar-thumb:hover {
    background: @{lighten(border,0.12)};
}

/* ── Asset Cards ─────────────────────────────────────────── */

.asset-card {
    background-color: @{surface_bright};
    border-color: @{border};
}

.asset-card:hover,
.asset-list-row:hover {
    border-color: @{primary};
}

.asset-card.is-selected,
.asset-list-row.is-selected {
    border-color: @{primary};
    background-color: @{alpha(primary,0.12)};
}

.asset-card.is-missing,
.asset-list-row.is-missing {
    border-color: @{error};
}

.asset-card-thumb {
    border-bottom-color: @{border};
}

.asset-thumbnail-placeholder {
    background-color: @{darken(primary,0.40)};
}

.asset-thumb-project {
    background-color: @{alpha(info,0.14)};
}

.asset-card-title {
    color: @{text};
}

.asset-card-meta {
    color: @{text_dim};
}

.asset-card-menu {
    background-color: @{alpha(surface_bright,0.88)};
    border-color: transparent;
}

.asset-card-menu:hover {
    background-color: @{surface_bright};
}

.asset-list-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-list-menu img {
    image-color: @{alpha(text,0.90)};
}

.asset-list-menu:hover {
    background-color: @{surface_bright};
}

.asset-list-menu:hover img {
    image-color: @{text};
}

.asset-list-header {
    background-color: @{blend(surface_bright,background,0.18)};
    border-color: @{border};
    color: @{text_dim};
}

.asset-list-header .asset-list-sort {
    background-color: transparent;
    color: @{text_dim};
    border-radius: 0;
}

.asset-list-header .asset-list-sort:hover {
    background-color: @{surface_bright};
    color: @{text};
}

.asset-list-row {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-list-column-handle:hover {
    border-right-color: @{primary};
    background-color: @{alpha(primary,0.18)};
}

.asset-list-primary {
    color: @{text};
}

/* ── Inspector ───────────────────────────────────────────── */

.asset-inspector {
    background-color: @{surface};
    border-left-color: @{border};
    color: @{text};
}

.asset-inspector-content {
    background-color: @{surface};
}

.parameter-row {
    border-bottom-color: @{border};
}

.parameter-label {
    color: @{text_dim};
}

.parameter-value {
    color: @{text};
}

.asset-info-header {
    border-bottom-color: @{border};
}

.asset-info-empty-text {
    color: @{text_dim};
}

.gallery-progress { background-color: @{statusbar.progress_bg}; }
.gallery-progress-fill { background-color: @{primary}; }

.gallery-remote { border-color: @{text_dim}; }

.asset-list-sort { color: @{text_dim}; }
.asset-list-sort:hover, .asset-list-sort:focus { background-color: @{surface_bright}; color: @{text}; }

.contents-tag { color: @{text_dim}; background-color: @{surface_bright}; }
.contents-row--pending { color: @{text_dim}; }
.contents-remove img { image-color: @{text}; }

.gallery-activity > img { image-color: @{text_dim}; opacity: 0.35; }
.gallery-activity > progress, .gallery-activity > progress fill { image-color: @{primary}; }

.gallery-activity > progress, .gallery-activity > progress fill { background-color: transparent; border-width: 0; }

.gallery-activity > progress, .gallery-activity > progress fill { decorator: none; }
