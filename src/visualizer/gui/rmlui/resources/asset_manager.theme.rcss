/* Asset Manager theme-dependent styles */

/* ── Window ────────────────────────────────────────────── */

#asset-floating-title {
    color: @{text};
}

#asset-popup {
    background-color: @{surface};
    color: @{text};
    border-color: @{border};
}

/* ── Toolbar ─────────────────────────────────────────────── */

.asset-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-button:hover {
    background-color: @{lighten(surface_bright,0.06)};
    border-color: @{primary};
    color: @{text};
}

.asset-button:active {
    background-color: @{alpha(primary,0.24)};
    border-color: @{primary};
}

#asset-popup-toolbar {
    background-color: @{blend(surface,background,0.5)};
    border-bottom-color: @{border};
}

.asset-panel-close {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-panel-close:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

.asset-panel-close:active {
    background-color: @{alpha(primary,0.32)};
    border-color: @{primary};
}

.asset-search-box {
    background-color: @{surface_bright};
    border-color: @{border};
}

.asset-search-icon {
    color: @{text_dim};
}

.asset-search-box input[type="text"] {
    color: @{text};
}

.asset-icon-grid > span,
.asset-icon-list > span {
    background-color: @{text};
}

.asset-refresh-button img,
.asset-folder-menu img,
.asset-card-menu img {
    image-color: @{alpha(text,0.90)};
}

.asset-refresh-button:hover img,
.asset-folder-menu:hover img,
.asset-card-menu:hover img {
    image-color: @{text};
}

.asset-add-folder-glyph {
    color: @{text};
}

.asset-import-button {
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{blend(surface,primary,button.tint_normal)};
    color: @{text};
}

.asset-import-button:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{blend(surface,primary,button.tint_hover)};
}

.asset-import-button:active {
    background-color: @{blend(surface,primary,button.tint_active)};
    border-color: @{blend(surface,primary,button.tint_active)};
}

.asset-sort-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-view-button {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-view-button.is-active {
    background-color: @{lighten(surface_bright,0.06)};
    color: @{text};
    border-color: @{primary};
}

.asset-button-label {
    color: @{text};
}

.asset-header-action {
    color: @{text};
    background-color: @{surface_bright};
    border-color: @{border};
}

.asset-header-action:hover {
    background-color: @{lighten(surface_bright,0.12)};
    border-color: @{primary};
}

#asset-viewport-edge {
    background-color: @{right_panel.border};
}

/* ── Sidebar ─────────────────────────────────────────────── */

#asset-sidebar {
    background-color: @{blend(surface,background,0.35)};
    border-bottom-color: @{border};
}

#sidebar-resize-handle {
    background-color: @{alpha(primary,0.12)};
    border-top-color: @{alpha(primary,0.26)};
    border-bottom-color: @{alpha(background,0.55)};
}

#sidebar-resize-handle:hover {
    background-color: @{alpha(primary,0.30)};
}

#sidebar-resize-handle.dragging {
    background-color: @{alpha(primary,0.46)};
}

.asset-sidebar-global {
    border-bottom-color: @{border};
}

.asset-sidebar-title,
.asset-info-section-title {
    color: @{text_dim};
}

.asset-sidebar-title .section-arrow {
    color: @{alpha(text_dim,0.72)};
}

.asset-sidebar-title:hover .section-arrow,
.asset-sidebar-title .section-arrow.is-expanded {
    color: @{text};
}

.asset-filter-row:hover {
    background-color: @{lighten(surface_bright,0.06)};
}

.asset-filter-row.is-active {
    background-color: @{alpha(primary,0.20)};
}

.asset-filter-row.is-active .asset-row-label {
    color: @{primary};
}

.asset-row-label {
    color: @{text};
}

.asset-row-count {
    color: @{text_dim};
}

.asset-folder-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-folder-menu:hover {
    background-color: @{alpha(surface_bright,0.94)};
}

/* ── Gallery ─────────────────────────────────────────────── */

#asset-gallery {
    background-color: @{surface};
}

.asset-gallery-header {
    border-bottom-color: @{border};
}

.asset-gallery-title {
    color: @{text};
}

.asset-gallery-subtitle {
    color: @{text_dim};
}

.asset-gallery-notice {
    color: @{warning};
}

.asset-gallery-scan-status {
    color: @{text_dim};
}

.asset-gallery-scroll::-webkit-scrollbar-track {
    background: @{blend(surface,background,0.35)};
}

.asset-gallery-scroll::-webkit-scrollbar-thumb {
    background: @{border};
}

.asset-gallery-scroll::-webkit-scrollbar-thumb:hover {
    background: @{lighten(border,0.12)};
}

/* ── Asset Cards ─────────────────────────────────────────── */

.asset-card {
    background-color: @{surface_bright};
    border-color: @{border};
}

.asset-card:hover,
.asset-list-row:hover {
    border-color: @{primary};
}

.asset-card.is-selected,
.asset-card.is-multi-selected,
.asset-list-row.is-selected,
.asset-list-row.is-multi-selected {
    border-color: @{primary};
    background-color: @{alpha(primary,0.12)};
}

.asset-card.is-missing,
.asset-list-row.is-missing {
    border-color: @{error};
}

.asset-card-thumb {
    border-bottom-color: @{border};
}

.asset-card-placeholder {
    color: @{text_dim};
}

.asset-thumb-project {
    background-color: @{alpha(info,0.14)};
}

.asset-card-title,
.asset-info-name {
    color: @{text};
}

.asset-card-meta {
    color: @{text_dim};
}

.asset-card-button {
    color: @{text};
    background-color: @{lighten(surface_bright,0.06)};
    border-color: @{border};
}

.asset-card-button:hover {
    background-color: @{lighten(surface_bright,0.12)};
    border-color: @{primary};
}

.asset-card-menu {
    background-color: @{alpha(surface_bright,0.88)};
    border-color: transparent;
}

.asset-card-menu:hover {
    background-color: @{surface_bright};
}

.asset-list-header {
    background-color: @{blend(surface_bright,background,0.18)};
    border-color: @{border};
    color: @{text_dim};
}

.asset-list-row {
    background-color: @{surface_bright};
    border-color: @{border};
    color: @{text};
}

.asset-list-primary {
    color: @{text};
}

/* ── Info Panel ──────────────────────────────────────────── */

#asset-info-panel {
    background-color: @{blend(surface,background,0.35)};
    border-top-color: @{border};
}

#bottom-panel-resize-handle {
    background-color: @{alpha(primary,0.12)};
    border-top-color: @{alpha(primary,0.26)};
    border-bottom-color: @{alpha(background,0.55)};
}

#bottom-panel-resize-handle:hover {
    background-color: @{alpha(primary,0.30)};
}

#bottom-panel-resize-handle.dragging {
    background-color: @{alpha(primary,0.46)};
}

.asset-info-tabs {
    border-bottom-color: @{border};
}

.asset-info-tab {
    color: @{text_dim};
    border-bottom-color: transparent;
}

.asset-info-tab:hover {
    color: @{text};
}

.asset-info-tab.is-active {
    color: @{primary};
    border-bottom-color: @{primary};
}

.asset-info-name {
    color: @{text};
}

.asset-info-section-title {
    color: @{text_dim};
}

.parameter-row {
    border-bottom-color: @{border};
}

.parameter-label {
    color: @{text_dim};
}

.parameter-value {
    color: @{text};
}

.asset-info-header {
    border-bottom-color: @{border};
}

.asset-info-warning {
    background-color: @{alpha(error,0.10)};
    border-color: @{error};
}

.asset-artifact-type,
.asset-info-empty-text {
    color: @{text_dim};
}
