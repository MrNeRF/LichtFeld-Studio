/* Plugin Marketplace theme overrides. */

/* ── Intro and controls ──────────────────────────────────── */

.mp-warning-note {
    color: @{warning};
}

.mp-intro > .mp-warning-note {
    background-color: @{alpha(warning,0.10)};
    border-left-color: @{warning};
}

.mp-controls,
.mp-manual-section,
.mp-empty-state {
    background-color: @{alpha(surface_bright,0.36)};
    border-color: @{alpha(border,0.75)};
}

.mp-control-label,
.mp-empty-description,
.card-description,
.card-tags,
.card-startup-label,
.plugin-list-option-label {
    color: @{text_dim};
}

.mp-select,
.mp-select-sort,
.mp-url-input {
    background-color: @{surface};
    border-color: @{border};
}

.mp-url-input:focus,
.mp-url-input:focus-visible {
    border-color: @{primary};
}

/* Hover only changes the control's icon or label, never its surrounding row. */
.mp-select:hover,
.mp-select-sort:hover {
    border-color: @{border};
}

.mp-controls selectarrow:hover {
    image-color: @{primary};
    background-color: transparent;
}

.mp-view-btn {
    color: @{text_dim};
    background-color: transparent;
    border-color: @{border};
}

.mp-view-btn:hover {
    color: @{text};
    background-color: @{alpha(primary,0.10)};
    border-color: @{alpha(primary,0.60)};
}

.mp-view-btn.selected,
.mp-view-btn.selected:hover {
    color: @{text};
    background-color: @{alpha(primary,0.22)};
    border-color: @{primary};
}

.mp-icon-grid > span,
.mp-icon-list > span {
    background-color: @{text};
}

.mp-collapse-toggle:hover,
.mp-collapse-toggle:focus-visible {
    color: @{primary};
    background-color: transparent;
}

.mp-collapse-toggle:hover .section-arrow,
.mp-collapse-toggle:hover .mp-section-title,
.mp-collapse-toggle:hover .mp-formats-label,
.mp-collapse-toggle:focus-visible .section-arrow,
.mp-collapse-toggle:focus-visible .mp-section-title,
.mp-collapse-toggle:focus-visible .mp-formats-label {
    color: @{primary};
}

.mp-formats-label {
    color: @{text_dim};
}

.mp-format-item {
    color: @{text_dim};
}

/* ── Empty state ──────────────────────────────────────────── */

.mp-empty-mark {
    color: @{primary};
    border-color: @{alpha(primary,0.60)};
    background-color: @{alpha(primary,0.08)};
}

.mp-empty-title {
    color: @{text};
}

/* ── Result cards ─────────────────────────────────────────── */

.plugin-card {
    background-color: @{surface};
    border-color: @{alpha(border,0.88)};
}

.plugin-card.card--in-progress {
    border-color: @{primary};
}

.plugin-card.card--success {
    border-color: @{success};
}

.plugin-card.card--error {
    border-color: @{error};
}

.card-name,
.plugin-list-name,
.mp-section-title,
.confirm-title {
    color: @{text};
}

.card-version,
.card-local,
.plugin-list-version {
    color: @{info};
}

.card-repo {
    color: @{text_dim};
}

.mp-project-link {
    color: @{primary};
}

.mp-project-link:hover,
.mp-project-link:focus-visible {
    color: @{text};
}

.mp-stars {
    color: @{text_dim};
}

.mp-star-icon {
    color: @{warning};
}

.card-metrics {
    color: @{warning};
}

.card-info .separator {
    background-color: @{alpha(border,0.65)};
}

.card-feedback {
    background-color: @{alpha(surface_bright,0.55)};
    border-color: @{alpha(border,0.78)};
}

.card-progress {
    background-color: @{surface};
    border-color: @{border};
}

.card-progress-text {
    color: @{text_dim};
}

/* ── List rows ────────────────────────────────────────────── */

.plugin-list-row {
    background-color: @{surface};
    border-color: @{alpha(border,0.78)};
}

.plugin-list-row.card--in-progress {
    border-left-color: @{primary};
}

.plugin-list-row.card--success {
    border-left-color: @{success};
}

.plugin-list-row.card--error {
    border-left-color: @{error};
}

.plugin-list-details {
    border-top-color: @{alpha(border,0.65)};
}

.plugin-list-disclosure {
    color: @{text_dim};
}

.plugin-list-disclosure:hover,
.plugin-list-disclosure:focus-visible {
    color: @{text};
    background-color: transparent;
}

.plugin-list-summary-status.status-success {
    color: @{success};
}

.plugin-list-summary-status.status-error {
    color: @{error};
}

.plugin-list-summary-status.status-muted {
    color: @{text_dim};
}

/* ── Catalog status ───────────────────────────────────────── */

#status-bar {
    background-color: @{alpha(surface,0.78)};
    border-top-color: @{border};
}

.mp-status-dot {
    background-color: @{info};
}

.mp-status-dot.status-success {
    background-color: @{success};
}

.mp-status-dot.status-warning {
    background-color: @{warning};
}

/* ── Confirmation dialog ──────────────────────────────────── */

.confirm-overlay {
    background-color: @{alpha(background,0.60)};
}

.confirm-dialog {
    color: @{text};
    background-color: @{surface};
    border-color: @{border};
    box-shadow: @{layered_shadow.3};
}

.confirm-message {
    color: @{text};
}

.confirm-dialog .separator {
    background-color: @{alpha(border,0.70)};
}
