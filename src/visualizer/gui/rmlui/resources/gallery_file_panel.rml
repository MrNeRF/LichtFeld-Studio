<rml><head><link type="text/template" href="floating_window.rml"/><link type="text/rcss" href="gallery_file_panel.rcss"/></head>
<body template="floating-window" data-model="gallery_file">
  <div class="gallery-file-content">
    <span class="gallery-file-name text-muted" data-attr-title="file_name">{{file_name}}</span>
    <div class="gallery-file-fields" data-if="is_publish">
      <span class="gallery-explanation">@tr:projects.gallery.review.prepared_copy</span>
      <label for="gallery-file-title">{{g_review_title}}</label>
      <input id="gallery-file-title" type="text" maxlength="120" data-value="title" data-attr-title="title"/>
      <label for="gallery-file-description">{{g_review_description}}</label>
      <textarea id="gallery-file-description" rows="3" maxlength="5000" data-value="description" data-attr-title="description"/>
      <div class="gallery-file-fields" data-if="show_format">
        <div class="setting-row"><span>{{g_review_upload_as}}</span><select data-value="upload_format"><option value="studio">{{g_format_studio}}</option><option value="sog">{{g_format_sog}}</option><option value="ssog">{{g_format_ssog}}</option><option value="spz">{{g_format_spz}}</option></select></div>
        <span class="text-muted">{{format_hint}}</span>
        <span class="text-muted" data-attr-title="estimate">{{estimate}}</span>
        <label class="gallery-cover-option"><input type="checkbox" data-checked="use_cover" data-attrif-disabled="!can_cover"/><span>@tr:projects.gallery.review.use_cover</span></label>
        <span class="text-muted">{{includes}}</span>
        <span class="text-muted">{{eligibility_reason}}</span>
      </div>
    </div>
    <div class="gallery-file-fields" data-if="is_pull">
      <span class="gallery-explanation">@tr:projects.gallery.review.viewing_copy</span>
      <label>{{g_info_folder}}</label><input type="text" data-value="pull_folder" data-attr-title="pull_folder"/>
      <label>{{g_info_filename}}</label><input type="text" data-value="pull_name" data-attr-title="pull_name"/>
    </div>
    <div class="gallery-conflict" data-if="is_conflict">
      <span class="text-muted">@tr:projects.gallery.conflict.choose_parts</span>
      <div class="gallery-choice-row" data-for="part : choices">
        <div class="gallery-choice-description"><span class="gallery-choice-title" data-attr-title="part.label">{{part.label}}</span><span class="text-muted gallery-choice-difference" data-attr-title="part.difference">{{part.difference}}</span></div>
        <div class="gallery-segmented">
          <button class="btn btn--secondary" data-class-is-active="part.choice == 'mine'" data-event-click="choose(part.id, 'mine')" title="@tr:projects.gallery.conflict.mine">@tr:projects.gallery.conflict.mine</button>
          <button class="btn btn--secondary" data-class-is-active="part.choice == 'gallery'" data-event-click="choose(part.id, 'gallery')" title="@tr:projects.gallery.conflict.portal">@tr:projects.gallery.conflict.portal</button>
          <button class="btn btn--secondary" data-if="part.can_both" data-class-is-active="part.choice == 'both'" data-event-click="choose(part.id, 'both')" title="@tr:projects.gallery.conflict.both">@tr:projects.gallery.conflict.both</button>
        </div>
      </div>
      <span class="status-warning">{{checkpoint_warning}}</span>
      <span class="text-muted">@tr:projects.gallery.conflict.backup_first</span>
    </div>
    <div class="gallery-replacement" data-if="is_replacement">
      <span class="status-warning gallery-file-name" data-attr-title="replacement_warning">{{replacement_warning}}</span>
      <span class="text-muted">@tr:projects.gallery.replacement.question</span>
      <div class="gallery-choice-row"><div class="gallery-choice-description"><span>@tr:projects.gallery.replacement.replace</span><span class="text-muted">@tr:projects.gallery.replacement.replace_hint</span></div><button class="btn btn--primary" data-attrif-disabled="!can_submit" data-event-click="replacement('replace')" title="@tr:projects.gallery.replacement.replace_button">@tr:projects.gallery.replacement.replace_button</button></div>
      <div class="gallery-choice-row"><div class="gallery-choice-description"><span>@tr:projects.gallery.replacement.leave</span><span class="text-muted">@tr:projects.gallery.replacement.leave_hint</span></div><button class="btn btn--secondary" data-attrif-disabled="!can_submit" data-event-click="replacement('keep')" title="@tr:projects.gallery.replacement.keep_button">@tr:projects.gallery.replacement.keep_button</button></div>
      <div class="gallery-choice-row"><div class="gallery-choice-description"><span>@tr:projects.gallery.replacement.find</span><span class="text-muted">@tr:projects.gallery.replacement.find_hint</span></div><button class="btn btn--secondary" data-event-click="replacement('locate')" title="@tr:projects.gallery.local.locate">@tr:projects.gallery.local.locate</button></div>
    </div>
    <span class="text-muted">{{quota}}</span><span class="status-warning">{{warning}}</span>
    <span class="text-muted" data-if="!is_publish">{{connection_reason}}</span>
    <span class="status-info" data-if="waiting">@tr:projects.gallery.dialog.waiting</span>
    <span class="status-error" data-if="has_error">{{error}}</span>
    <div class="gallery-file-actions">
      <button class="btn btn--secondary" data-event-click="cancel" data-attr-title="cancel_label">{{cancel_label}}</button>
      <button class="btn btn--secondary" data-if="show_local_apply" data-attrif-disabled="!can_submit" data-event-click="apply_local" title="@tr:projects.gallery.conflict.apply_local">@tr:projects.gallery.conflict.apply_local</button>
      <button class="btn btn--primary" data-if="!is_replacement" data-attrif-disabled="!can_submit" data-event-click="submit" data-attr-title="submit_label">{{submit_label}}</button>
    </div>
  </div>
</body></rml>
