<rml>
<head>
    <link type="text/template" href="floating_window.rml"/>
    <link type="text/rcss" href="history_panel.rcss"/>
</head>
<body template="floating-window">
    <div class="history-toolbar">
        <button id="history-undo" type="button" class="btn btn--secondary" data-action="undo" data-tooltip="common.undo">@tr:common.undo</button>
        <button id="history-redo" type="button" class="btn btn--secondary" data-action="redo" data-tooltip="common.redo">@tr:common.redo</button>
        <span class="history-spacer"></span>
        <button id="history-clear" type="button" class="btn btn--ghost">@tr:debug_info.clear_history</button>
    </div>
    <div class="history-tabs">
        <button id="history-undo-tab" type="button" class="btn btn--ghost"></button>
        <button id="history-redo-tab" type="button" class="btn btn--ghost"></button>
    </div>
    <div id="history-scroll">
        <div id="history-empty" class="text-muted"></div>
        <div id="history-rows"></div>
    </div>
    <div class="history-footer">
        <span id="history-page" class="text-muted"></span>
        <span class="history-spacer"></span>
        <button id="history-newer" type="button" class="btn btn--ghost">@tr:logging.newer</button>
        <button id="history-older" type="button" class="btn btn--ghost">@tr:logging.older</button>
    </div>
    <div id="history-feedback" class="status-error"></div>
</body>
</rml>
