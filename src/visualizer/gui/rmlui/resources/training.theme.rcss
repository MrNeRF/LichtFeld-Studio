/* Training panel theme overrides. */

.training-panel-title {
    color: @{text};
    border-top-color: @{panel.primary_border_soft};
}

.training-panel-title-icon {
    image-color: @{primary};
}

#training-search-container {
    background-color: @{surface};
    border-color: @{border};
}

#training-search-input {
    color: @{text};
}

#training-search-icon {
    image-color: @{text_dim};
}

#training-search-clear img {
    image-color: @{text_dim};
}

#training-search-clear:hover img,
#training-search-clear:focus-visible img {
    image-color: @{text};
}

.training-subsection-title {
    color: @{text_dim};
    border-top-color: @{panel.primary_border_faint};
}

.loss-graph-wrap {
    background-color: @{background};
}

.loss-tick {
    color: @{text_dim};
}

.mask-settings-group {
    border-left-color: @{panel.primary_accent};
}

.mask-settings-divider {
    background-color: @{panel.primary_border_faint};
}
