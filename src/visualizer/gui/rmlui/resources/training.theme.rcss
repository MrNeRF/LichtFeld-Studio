/* Training panel theme overrides. */

.training-panel-title {
    color: @{text};
    border-top-color: @{panel.primary_border_soft};
}

.training-panel-title-icon {
    image-color: @{primary};
}

#training-search-container {
    background-color: @{surface};
    border-color: @{border};
}

#training-search-input {
    color: @{text};
}

#training-search-icon {
    image-color: @{text_dim};
}

#training-search-clear img {
    image-color: @{text_dim};
}

#training-search-clear:hover img,
#training-search-clear:focus-visible img {
    image-color: @{text};
}

.loss-graph-wrap {
    background-color: @{background};
}

.loss-tick {
    color: @{text_dim};
}

.mask-settings-group,
.sharpen-settings-group {
    border-left-color: @{panel.primary_accent};
}

.mask-settings-divider {
    background-color: @{panel.primary_border_faint};
}

/* Densification VRAM: green with room left, red when full. */
.densify-vram progress fill { decorator: none; }
.densify-vram--level-0 progress fill { background-color: @{blend(surface,success,0.7)}; }
.densify-vram--level-1 progress fill { background-color: @{blend(surface,blend(success,warning,0.5),0.7)}; }
.densify-vram--level-2 progress fill { background-color: @{blend(surface,warning,0.7)}; }
.densify-vram--level-3 progress fill { background-color: @{blend(surface,blend(warning,error,0.5),0.7)}; }
.densify-vram--level-4 progress fill { background-color: @{blend(surface,error,0.7)}; }
