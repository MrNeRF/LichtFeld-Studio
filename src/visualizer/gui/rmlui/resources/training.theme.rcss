/* Training panel theme overrides. */

.training-toolbar-action img {
    image-color: @{text};
}

.training-status-badge {
    color: @{text_dim};
    background-color: @{surface_bright};
    border-color: @{border};
}

.training-status-badge.is-ready {
    color: @{text};
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{primary};
}

.training-status-badge.is-active,
.training-status-badge.is-complete {
    color: @{success};
    background-color: @{blend(surface,success,button.tint_normal)};
    border-color: @{success};
}

.training-status-badge.is-paused {
    color: @{warning};
    background-color: @{blend(surface,warning,button.tint_normal)};
    border-color: @{warning};
}

.training-status-badge.is-error {
    color: @{error};
    background-color: @{blend(surface,error,button.tint_normal)};
    border-color: @{error};
}

.training-panel-block > .section-header {
    border-top-color: @{panel.primary_border_faint};
}

.training-panel-title {
    color: @{text};
    border-top-color: @{panel.primary_border_soft};
}

.training-panel-title-icon {
    image-color: @{primary};
}

#training-search-container {
    background-color: @{surface};
    border-color: @{border};
}

#training-search-input {
    color: @{text};
}

#training-search-icon {
    image-color: @{text_dim};
}

#training-search-clear img {
    image-color: @{text_dim};
}

#training-search-clear:hover img,
#training-search-clear:focus-visible img {
    image-color: @{text};
}

.training-subsection-title {
    color: @{text_dim};
    border-top-color: @{panel.primary_border_faint};
}

.loss-graph-wrap {
    background-color: @{background};
}

.loss-tick {
    color: @{text_dim};
}

.mask-settings-group {
    border-left-color: @{panel.primary_accent};
}

.mask-settings-divider {
    background-color: @{panel.primary_border_faint};
}
