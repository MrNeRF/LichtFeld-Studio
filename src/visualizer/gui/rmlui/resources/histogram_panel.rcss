/* Fixed controls and statistics surround a scrollable chart region. */
#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#histogram-shell {
    flex: 1;
    padding: 6dp 8dp;
    display: flex;
    flex-direction: column;
    gap: 6dp;
    overflow-x: hidden;
    overflow-y: hidden;
    min-width: 0;
    min-height: 0;
}

#histogram-toolbar {
    position: relative;
    flex-shrink: 0;
    padding-bottom: 6dp;
    border-bottom-width: 1dp;
}

.histogram-toolbar-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6dp 14dp;
    min-width: 0;
}

.histogram-dock-toggle.btn {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    margin-left: auto;
    min-width: 64dp;
    height: 24dp;
    padding: 0 12dp;
}

.histogram-toolbar-item {
    display: flex;
    align-items: center;
    gap: 6dp;
    flex: 0 0 auto;
    height: 24dp;
}

.control-label,
.range-of-interest-label {
    font-size: 12dp;
    white-space: nowrap;
    flex-shrink: 0;
}

.histogram-select {
    flex: 0 0 auto;
    width: 88dp;
    min-width: 0;
    height: 24dp;
    box-sizing: border-box;
}

/* The popup is independent of the compact selected-value control. */
.histogram-select selectbox {
    min-width: 180dp;
}

#histogram-compare-field {
    width: 56dp;
}

.histogram-bin-scrub {
    display: flex;
    align-items: center;
    width: 64dp;
    height: 24dp;
}

.histogram-bin-scrub .setting-slider,
.histogram-bin-scrub .scrub-field {
    width: 64dp;
    min-width: 64dp;
    height: 24dp;
    margin: 0;
}

.histogram-bin-scrub .scrub-field-display,
.histogram-bin-scrub .scrub-field-input {
    text-align: center;
    line-height: 22dp;
}

.histogram-bin-scrub .scrub-field-input[type="text"] {
    height: 22dp;
    padding: 0;
}

.histogram-log-control input[type="checkbox"] {
    margin: 0;
}

#histogram-empty {
    flex: 1;
    min-height: 0;
}

.empty-card {
    box-sizing: border-box;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6dp;
    padding: 18dp;
    text-align: center;
}

.empty-title {
    font-size: 14dp;
    font-weight: bold;
}

.empty-message {
    max-width: 420dp;
    font-size: 12dp;
    line-height: 1.45;
}

#histogram-content {
    overflow-x: hidden;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

#histogram-card,
#compare-card {
    flex: 1 0 auto;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

#histogram-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 4dp 14dp;
    flex-shrink: 0;
    padding-top: 6dp;
    border-top-width: 1dp;
}

.histogram-stat {
    display: flex;
    align-items: baseline;
    gap: 6dp;
    min-width: 0;
    font-size: 12dp;
}

/* Selection is distinct from the distribution summary. */
.histogram-selection-stat {
    margin-left: auto;
}

.stat-value {
    font-weight: bold;
}

#histogram-range-of-interest,
#compare-range-of-interest {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6dp 8dp;
    flex-shrink: 0;
}

.histogram-range-controls,
.compare-range-controls {
    display: flex;
    align-items: center;
    gap: 6dp;
    flex: 0 0 auto;
}

/* Override shared .number-input flex: 1 so bounds never span the panel. */
.range-input[type="text"] {
    flex: 0 0 88dp;
    width: 88dp;
    min-width: 72dp;
    height: 24dp;
    padding: 0 4dp;
    line-height: 22dp;
    text-align: center;
}

.range-separator,
.compare-axis-marker {
    font-size: 12dp;
    flex-shrink: 0;
}

.range-reset.btn {
    box-sizing: border-box;
    padding: 0 8dp;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48dp;
    height: 24dp;
}

#histogram-chart {
    position: relative;
    flex: 1;
    min-height: 128dp;
    border-width: 1dp;
    border-radius: 4dp;
    overflow: hidden;
}

.histogram-grid-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1dp;
    pointer-events: none;
}

.histogram-grid-line--top-16 {
    top: 16%;
}

.histogram-grid-line--top-36 {
    top: 36%;
}

.histogram-grid-line--top-56 {
    top: 56%;
}

.histogram-grid-line--top-76 {
    top: 76%;
}

#histogram-bars {
    position: absolute;
    left: 8dp;
    right: 8dp;
    top: 8dp;
    bottom: 8dp;
    display: flex;
    align-items: flex-end;
    cursor: crosshair;
}

#histogram-selection {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2dp;
    border-width: 1dp;
    border-radius: 2dp;
    pointer-events: none;
}

.histogram-bar {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-end;
    position: relative;
}

.histogram-bar-fill {
    width: 100%;
    min-height: 1dp;
    border-radius: 2dp 2dp 0 0;
}

#histogram-axis {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#compare-empty {
    min-height: 0;
}

.compare-empty-card {
    min-height: 0;
}

#compare-content {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    flex: 1 0 auto;
    min-height: 0;
}

#compare-chart-shell {
    display: flex;
    gap: 6dp;
    flex: 1 0 auto;
    min-height: 260dp;
}

#compare-y-axis {
    width: 52dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 8dp;
    padding-bottom: 28dp;
    gap: 6dp;
}

#compare-chart-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6dp;
    min-width: 0;
    min-height: 0;
}

#compare-chart {
    position: relative;
    flex: 1;
    min-height: 240dp;
    border-width: 1dp;
    border-radius: 4dp;
    overflow: hidden;
}

#compare-cells {
    position: absolute;
    left: 8dp;
    right: 8dp;
    top: 8dp;
    bottom: 8dp;
    cursor: crosshair;
}

#compare-selection {
    position: absolute;
    min-width: 2dp;
    min-height: 2dp;
    border-width: 1dp;
    border-radius: 2dp;
    pointer-events: none;
}

.compare-cell {
    position: absolute;
    left: 0%;
    top: 0%;
    width: 0%;
    height: 0%;
    padding: 1dp;
    box-sizing: border-box;
}

.compare-cell-fill {
    width: 100%;
    height: 100%;
    min-width: 1dp;
    min-height: 1dp;
    border-radius: 4dp;
}

#compare-axis {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12dp;
}

#compare-y-axis-values {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
}

.axis-metric {
    flex-shrink: 0;
    font-size: 12dp;
    letter-spacing: 0.25dp;
    text-transform: uppercase;
}

.axis-label {
    font-size: 12dp;
}

#histogram-empty.hidden,
#histogram-content.hidden,
#histogram-stats.hidden,
#histogram-card.hidden,
#compare-card.hidden,
#compare-empty.hidden,
#compare-content.hidden,
#histogram-selection.hidden,
#compare-selection.hidden,
.hidden {
    display: none;
}
