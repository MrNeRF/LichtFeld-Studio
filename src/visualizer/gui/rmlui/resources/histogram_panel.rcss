/* Layout is shared by docked and floating histogram panels. */
#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#histogram-shell {
    flex: 1;
    padding: 8dp 10dp;
    display: flex;
    flex-direction: column;
    gap: 8dp;
    overflow-x: hidden;
    overflow-y: auto;
    min-width: 0;
    min-height: 0;
}

#histogram-floating-header {
    min-height: 28dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8dp;
    flex-shrink: 0;
}

#histogram-floating-title {
    font-size: 12dp;
    font-weight: bold;
}

.histogram-panel-actions {
    display: flex;
    align-items: center;
    gap: 6dp;
    flex-shrink: 0;
}

.histogram-panel-action {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 64dp;
}

#histogram-toolbar {
    flex-shrink: 0;
    padding-bottom: 8dp;
    border-bottom-width: 1dp;
}

.histogram-toolbar-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8dp 16dp;
    min-width: 0;
}

.histogram-toolbar-item {
    display: flex;
    align-items: center;
    gap: 6dp;
    min-width: 0;
    min-height: 26dp;
}

.histogram-toolbar-item--select {
    flex: 0 1 230dp;
}

.histogram-toolbar-item--slider {
    flex: 0 1 190dp;
}

.histogram-toolbar-item--compare-bins {
    flex: 0 1 170dp;
}

.histogram-toolbar-item--action {
    margin-left: auto;
}

.control-label,
.range-of-interest-label {
    font-size: 12dp;
    white-space: nowrap;
    flex-shrink: 0;
}

.histogram-select {
    flex: 1;
    min-width: 100dp;
    height: 26dp;
}

.histogram-toggle-control {
    display: flex;
    align-items: center;
}

.histogram-toggle-control input[type="checkbox"] {
    margin-right: 0;
}

.histogram-setting-slider {
    flex: 1;
    min-width: 64dp;
    margin-top: 0;
    position: static;
    top: auto;
}

.histogram-slider-value {
    min-width: 24dp;
    text-align: right;
    font-size: 12dp;
}

#histogram-context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4dp 16dp;
    flex-shrink: 0;
    font-size: 12dp;
}

.histogram-description {
    flex: 1 1 220dp;
}

.histogram-context-values {
    display: flex;
    flex-wrap: wrap;
    gap: 4dp 16dp;
}

#histogram-empty {
    flex: 1;
    min-height: 0;
}

.empty-card {
    height: 100%;
    min-height: 180dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8dp;
    padding: 18dp;
    text-align: center;
}

.empty-title {
    font-size: 14dp;
    font-weight: bold;
}

.empty-message {
    max-width: 420dp;
    font-size: 12dp;
    line-height: 1.45;
}

#histogram-content {
    display: flex;
    flex-direction: column;
    flex: 1 0 230dp;
    min-width: 0;
    min-height: 230dp;
}

#histogram-card,
#compare-card {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

#histogram-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6dp 20dp;
    flex-shrink: 0;
    padding-top: 8dp;
    border-top-width: 1dp;
}

.histogram-stat {
    display: flex;
    align-items: baseline;
    gap: 6dp;
    min-width: 0;
    font-size: 12dp;
}

.stat-value {
    font-weight: bold;
}

#histogram-range-of-interest,
#compare-range-of-interest {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6dp 8dp;
    flex-shrink: 0;
}

.histogram-range-controls,
.compare-range-controls {
    display: flex;
    align-items: center;
    gap: 6dp;
    flex: 0 0 auto;
}

/* Override shared .number-input flex: 1 so bounds never span the panel. */
.range-input[type="text"] {
    flex: 0 0 88dp;
    width: 88dp;
    min-width: 72dp;
    height: 24dp;
}

.range-separator,
.compare-axis-marker {
    font-size: 12dp;
    flex-shrink: 0;
}

.range-reset {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48dp;
    height: 24dp;
}

#histogram-chart {
    position: relative;
    flex: 1;
    min-height: 128dp;
    border-width: 1dp;
    border-radius: 4dp;
    overflow: hidden;
}

.histogram-grid-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1dp;
    pointer-events: none;
}

.histogram-grid-line--top-16 {
    top: 16%;
}

.histogram-grid-line--top-36 {
    top: 36%;
}

.histogram-grid-line--top-56 {
    top: 56%;
}

.histogram-grid-line--top-76 {
    top: 76%;
}

#histogram-bars {
    position: absolute;
    left: 14dp;
    right: 14dp;
    top: 14dp;
    bottom: 14dp;
    display: flex;
    align-items: flex-end;
    cursor: crosshair;
}

#histogram-selection {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2dp;
    border-width: 1dp;
    border-radius: 2dp;
    pointer-events: none;
}

.histogram-bar {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: flex-end;
    position: relative;
}

.histogram-bar-fill {
    width: 100%;
    min-height: 1dp;
    border-radius: 2dp 2dp 0 0;
}


#histogram-axis {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

#compare-card {
    flex: 1;
    min-height: 320dp;
    border-width: 1dp;
}

#compare-empty {
    min-height: 220dp;
}

.compare-empty-card {
    min-height: 220dp;
}

#compare-content {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    flex: 1;
    min-height: 0;
}

#compare-chart-shell {
    display: flex;
    gap: 10dp;
    flex: 1;
    min-height: 260dp;
}

#compare-y-axis {
    width: 88dp;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 2dp;
    padding-bottom: 22dp;
    gap: 8dp;
}

#compare-chart-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8dp;
    min-width: 0;
    min-height: 0;
}

#compare-chart {
    position: relative;
    flex: 1;
    min-height: 240dp;
    border-width: 1dp;
    border-radius: 4dp;
    overflow: hidden;
}

#compare-cells {
    position: absolute;
    left: 14dp;
    right: 14dp;
    top: 14dp;
    bottom: 14dp;
    cursor: crosshair;
}

#compare-selection {
    position: absolute;
    min-width: 2dp;
    min-height: 2dp;
    border-width: 1dp;
    border-radius: 2dp;
    pointer-events: none;
}

.compare-cell {
    position: absolute;
    left: 0%;
    top: 0%;
    width: 0%;
    height: 0%;
    padding: 1dp;
    box-sizing: border-box;
}

.compare-cell-fill {
    width: 100%;
    height: 100%;
    min-width: 1dp;
    min-height: 1dp;
    border-radius: 4dp;
}


#compare-axis {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12dp;
}

#compare-y-axis-values {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
}

.axis-metric {
    flex-shrink: 0;
    font-size: 12dp;
    letter-spacing: 0.25dp;
    text-transform: uppercase;
}

.axis-label {
    font-size: 12dp;
}


#histogram-floating-header.hidden,
#histogram-context.hidden,
#histogram-empty.hidden,
#histogram-content.hidden,
#histogram-stats.hidden,
#histogram-card.hidden,
#compare-card.hidden,
#compare-empty.hidden,
#compare-content.hidden,
#histogram-selection.hidden,
#compare-selection.hidden,
.hidden {
    display: none;
}
