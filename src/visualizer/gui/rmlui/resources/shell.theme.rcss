/* Theme-dependent shell frame colors. */

#menu-region {
    @{chrome.menu_decor};
}

#right-panel-region {
    @{panel.body_decor};
}

#status-region {
    @{chrome.status_decor};
}

#left-resize-region { background-color: @{dock.resize_hover}; }
#left-resize-region.active { background-color: @{dock.resize_active}; }
