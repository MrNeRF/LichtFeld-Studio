<rml>
<head>
  <link type="text/template" href="docked_panel.rml"/>
  <link type="text/rcss" href="histogram_panel.rcss"/>
</head>
<body template="docked-panel" data-model="histogram_panel">
  <div id="histogram-shell">
    <div id="histogram-toolbar">
      <div class="histogram-toolbar-row">
        <label class="histogram-toolbar-item" for="histogram-field">
          <span class="control-label">{{ field_label }}</span>
          <select id="histogram-field" class="histogram-select" data-value="metric_id" data-attr-title="metric_description">
            <option data-for="option : metric_options" data-attr-value="option.value">{{ option.label }}</option>
          </select>
        </label>
        <label class="histogram-toolbar-item" for="histogram-compare-field">
          <span class="control-label">{{ compare_with_label }}</span>
          <select id="histogram-compare-field" class="histogram-select" data-value="compare_metric_id">
            <option data-for="option : compare_metric_options" data-attr-value="option.value">{{ option.label }}</option>
          </select>
        </label>
        <div class="histogram-toolbar-item histogram-bin-control hidden" data-reset-row="1" data-class-hidden="!show_histogram_bins_control">
          <label class="control-label" for="scrub-histogram-bin-count" data-reset-prop="histogram_bin_count">{{ histogram_bins_label }}</label>
          <div class="histogram-bin-scrub">
            <input id="histogram-bin-input" type="range" class="setting-slider" data-value="histogram_bin_count" min="16" max="128" step="1" />
          </div>
        </div>
        <div class="histogram-toolbar-item histogram-bin-control hidden" data-reset-row="1" data-class-hidden="!show_compare_bins_controls">
          <label class="control-label" for="scrub-compare-x-bin-count" data-reset-prop="compare_x_bin_count">{{ compare_x_bins_label }}</label>
          <div class="histogram-bin-scrub">
            <input id="x-bin-input" type="range" class="setting-slider" data-value="compare_x_bin_count" min="8" max="48" step="1" />
          </div>
        </div>
        <div class="histogram-toolbar-item histogram-bin-control hidden" data-reset-row="1" data-class-hidden="!show_compare_bins_controls">
          <label class="control-label" for="scrub-compare-y-bin-count" data-reset-prop="compare_y_bin_count">{{ compare_y_bins_label }}</label>
          <div class="histogram-bin-scrub">
            <input id="y-bin-input" type="range" class="setting-slider" data-value="compare_y_bin_count" min="8" max="48" step="1" />
          </div>
        </div>
        <label class="histogram-toolbar-item histogram-log-control">
          <input id="histogram-log-scale" type="checkbox" data-checked="log_scale_enabled" />
          <span class="control-label">{{ log_scale_label }}</span>
        </label>
        <button id="histogram-dock-toggle" class="btn btn--secondary histogram-dock-toggle"
                data-event-click="toggle_dock_mode()"><span class="btn-label">{{ dock_toggle_label }}</span></button>
      </div>
    </div>

    <div id="histogram-empty" data-class-hidden="!show_empty_state">
      <div class="empty-card">
        <span class="empty-title">{{ empty_title }}</span>
        <span class="empty-message">{{ empty_message }}</span>
      </div>
    </div>

    <div id="histogram-content"
         data-class-hidden="!show_chart">
      <div id="histogram-card" class="hidden" data-class-hidden="!show_histogram_card">

        <div id="histogram-range-of-interest">
          <span class="range-of-interest-label" data-attr-title="range_text">{{ range_of_interest_label }}</span>
          <div class="histogram-range-controls">
            <input id="range-min-input" type="text" class="number-input range-input" data-value="range_min_str" data-attrif-disabled="!range_inputs_ready" />
            <span class="range-separator">–</span>
            <input id="range-max-input" type="text" class="number-input range-input" data-value="range_max_str" data-attrif-disabled="!range_inputs_ready" />
            <button class="btn btn--secondary range-reset"
                    data-event-click="reset_range()"
                    data-attrif-disabled="!has_custom_range"><span class="btn-label">{{ reset_range_label }}</span></button>
          </div>
        </div>

        <div id="histogram-chart">
          <div class="histogram-grid-line histogram-grid-line--top-16"></div>
          <div class="histogram-grid-line histogram-grid-line--top-36"></div>
          <div class="histogram-grid-line histogram-grid-line--top-56"></div>
          <div class="histogram-grid-line histogram-grid-line--top-76"></div>

          <div id="histogram-bars" tab-index="0" data-style-gap="histogram_bar_gap_style">
            <div id="histogram-selection"
                 data-class-hidden="!show_selection_overlay"
                 data-style-left="selection_left_style"
                 data-style-width="selection_width_style"></div>
            <div class="histogram-bar"
                 data-for="bin : bins"
                 data-class-selected="bin.selected"
                 data-attr-title="bin.tooltip">
              <div class="histogram-bar-fill"
                   data-style-height="bin.height_style"
                   data-style-opacity="bin.opacity_style"></div>
            </div>
          </div>
        </div>

        <div id="histogram-axis">
          <span class="axis-label">{{ axis_min }}</span>
          <span class="axis-label">{{ axis_max }}</span>
        </div>
      </div>

      <div id="compare-card" class="hidden" data-class-hidden="!show_compare_card">
        <div id="compare-empty" class="hidden" data-class-hidden="!show_compare_empty_state">
          <div class="empty-card compare-empty-card">
            <span class="empty-title">{{ compare_empty_title }}</span>
            <span class="empty-message">{{ compare_empty_message }}</span>
          </div>
        </div>

        <div id="compare-content" class="hidden" data-class-hidden="!show_compare_chart">

          <div id="compare-range-of-interest">
            <span class="range-of-interest-label" data-attr-title="range_text">{{ range_of_interest_label }}</span>
            <div class="compare-range-controls">
              <span class="compare-axis-marker">X</span>
              <input id="compare-range-x-min-input" type="text" class="number-input range-input" data-value="range_min_str" data-attrif-disabled="!range_inputs_ready" />
              <span class="range-separator">–</span>
              <input id="compare-range-x-max-input" type="text" class="number-input range-input" data-value="range_max_str" data-attrif-disabled="!range_inputs_ready" />
            </div>
            <div class="compare-range-controls">
              <span class="compare-axis-marker">Y</span>
              <input id="compare-range-y-min-input" type="text" class="number-input range-input" data-value="compare_y_range_min_str" data-attrif-disabled="!compare_y_range_inputs_ready" />
              <span class="range-separator">–</span>
              <input id="compare-range-y-max-input" type="text" class="number-input range-input" data-value="compare_y_range_max_str" data-attrif-disabled="!compare_y_range_inputs_ready" />
            </div>
            <button class="btn btn--secondary range-reset"
                    data-event-click="reset_compare_range()"
                    data-attrif-disabled="!compare_has_custom_range"><span class="btn-label">{{ reset_range_label }}</span></button>
          </div>

          <div id="compare-chart-shell">
            <div id="compare-y-axis">
              <div id="compare-y-axis-values">
                <span class="axis-label">{{ compare_y_axis_max }}</span>
                <span class="axis-label">{{ compare_y_axis_min }}</span>
              </div>
            </div>

            <div id="compare-chart-column">
              <div id="compare-chart">
                <div id="compare-cells" tab-index="0">
                  <div id="compare-selection" class="hidden"
                       data-class-hidden="!show_compare_selection_overlay"
                       data-style-left="compare_selection_left_style"
                       data-style-top="compare_selection_top_style"
                       data-style-width="compare_selection_width_style"
                       data-style-height="compare_selection_height_style"></div>
                  <div class="compare-cell"
                       data-for="bin : compare_bins"
                       data-class-selected="bin.selected"
                       data-attr-style="bin.style_attr"
                       data-attr-title="bin.tooltip">
                    <div class="compare-cell-fill"
                         data-style-opacity="bin.opacity_style"></div>
                  </div>
                </div>
              </div>

              <div id="compare-axis">
                <span class="axis-label">{{ compare_x_axis_min }}</span>
                <span class="axis-metric">{{ compare_x_metric_label }}</span>
                <span class="axis-label">{{ compare_x_axis_max }}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="histogram-stats" data-class-hidden="!show_chart">
      <div class="histogram-stat">
        <span class="stat-label">{{ samples_label }}</span>
        <span class="stat-value">{{ sample_count }}</span>
      </div>
      <div class="histogram-stat">
        <span class="stat-label">{{ mean_label }}</span>
        <span class="stat-value">{{ mean_text }}</span>
      </div>
      <div class="histogram-stat">
        <span class="stat-label">{{ median_label }}</span>
        <span class="stat-value">{{ median_text }}</span>
      </div>
      <div class="histogram-stat">
        <span class="stat-label">{{ p95_label }}</span>
        <span class="stat-value">{{ p95_text }}</span>
      </div>
      <div class="histogram-stat">
        <span class="stat-label">{{ peak_bin_label }}</span>
        <span class="stat-value">{{ peak_text }}</span>
      </div>
      <div class="histogram-stat histogram-selection-stat">
        <span class="stat-label">{{ marked_label }}</span>
        <span class="stat-value">{{ marked_range_text }}</span>
      </div>
      <div class="histogram-stat" data-class-hidden="!has_marked_range">
        <span class="stat-label">{{ count_label }}</span>
        <span class="stat-value">{{ marked_count_text }}</span>
      </div>
    </div>
  </div>
</body>
</rml>
