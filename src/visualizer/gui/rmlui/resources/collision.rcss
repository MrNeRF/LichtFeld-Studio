/* Collision authoring panel. RmlPanelHost loads this sibling stylesheet. */
.collision-row {
    display: flex;
    align-items: center;
    margin: 5dp 0;
}

.collision-row span {
    width: 58%;
    flex-shrink: 0;
}

.collision-row input, .collision-row select {
    width: 40%;
}

.collision-row input[type="checkbox"] {
    width: 16dp;
    height: 16dp;
}

.collision-actions {
    display: flex;
    flex-wrap: wrap;
    margin: 8dp 0;
}

.collision-actions button {
    margin: 3dp;
    padding: 5dp;
}

#collision-status {
    margin: 8dp 0;
}

h3 {
    display: block;
    margin: 10dp 0 5dp;
    font-weight: bold;
}

p {
    display: block;
    margin: 5dp 0;
}

.collision-row input[type="range"] { width: 38%; }
.collision-row .collision-value { width: 12%; text-align: right; }
.collision-row .collision-value { flex-shrink: 1; }
#scale-summary { color: #9aaabb; font-size: 11dp; }
#advanced { margin-top: 8dp; border-top: 1dp #465063; }

#job-progress { margin: 8dp 0; }
#job-progress progress { display: block; width: 100%; height: 8dp; background: #273241; }
#job-progress progress fill { background: #66aaff; }
#progress-time { color: #aabbcf; }

.collision-scrub span { width: 48%; }
