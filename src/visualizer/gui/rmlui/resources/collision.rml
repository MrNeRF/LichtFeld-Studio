<rml>
<head>
  <link type="text/template" href="floating_window.rml"/>
  <link type="text/rcss" href="rendering.rcss"/>
</head>
<body template="floating-window">
  <p>@tr:collision.sources</p>
  <p><span>@tr:collision.target</span> <span id="collision-target">@tr:collision.new_node</span></p>
  <div class="collision-row" data-tooltip="collision.tip_preset"><span>@tr:collision.scene_type</span><select id="preset"><option value="0">@tr:collision.indoor</option><option value="1" selected="selected">@tr:collision.outdoor</option><option value="2">@tr:collision.object</option></select></div>
  <button id="apply-preset" class="btn btn--secondary" data-tooltip="collision.tip_preset">@tr:collision.apply_preset</button>
  <h3>@tr:collision.cluster_filter</h3>
  <div class="collision-row" data-tooltip="collision.tip_cluster"><span>@tr:collision.cluster_enable</span><input id="cluster" type="checkbox"/></div>
  <div class="collision-row" data-tooltip="collision.tip_resolution"><span>@tr:collision.resolution</span><input id="cluster-resolution" type="text" value="1"/></div>
  <div class="collision-row" data-tooltip="collision.tip_opacity"><span>@tr:collision.opacity</span><input id="cluster-opacity" type="text" value="0.999"/></div>
  <div class="collision-row" data-tooltip="collision.tip_contribution"><span>@tr:collision.contribution</span><input id="cluster-min" type="text" value="0.1"/></div>
  <h3>@tr:collision.voxelization</h3>
  <div class="collision-row" data-tooltip="collision.tip_voxel"><span>@tr:collision.voxel_size</span><input id="voxel-size" type="text" value="0.05"/></div>
  <div class="collision-row" data-tooltip="collision.tip_opacity"><span>@tr:collision.opacity</span><input id="opacity" type="text" value="0.1"/></div>
  <div class="collision-row" data-tooltip="collision.tip_shape"><span>@tr:collision.shape</span><select id="shape"><option value="0" selected="selected">@tr:collision.smooth</option><option value="1">@tr:collision.faces</option></select></div>
  <h3>@tr:collision.fill_carve</h3>
  <div class="collision-row" data-tooltip="collision.tip_external"><span>@tr:collision.external</span><input id="external-fill" type="checkbox"/></div>
  <div class="collision-row" data-tooltip="collision.tip_external"><span>@tr:collision.external_size</span><input id="external-size" type="text" value="1.6"/></div>
  <div class="collision-row" data-tooltip="collision.tip_floor"><span>@tr:collision.floor</span><input id="floor-fill" type="checkbox" checked="checked"/></div>
  <div class="collision-row" data-tooltip="collision.tip_floor"><span>@tr:collision.floor_size</span><input id="floor-size" type="text" value="1.6"/></div>
  <div class="collision-row" data-tooltip="collision.tip_carve"><span>@tr:collision.carve_height</span><input id="carve-height" type="text" value="0"/></div>
  <div class="collision-row" data-tooltip="collision.tip_carve"><span>@tr:collision.carve_radius</span><input id="carve-radius" type="text" value="0.2"/></div>
  <h3>@tr:collision.seed</h3>
  <p>@tr:collision.seed_hint</p>
  <div class="collision-row"><span>X</span><input id="seed-x" type="text" value="0"/></div>
  <div class="collision-row"><span>Y</span><input id="seed-y" type="text" value="0"/></div>
  <div class="collision-row"><span>Z</span><input id="seed-z" type="text" value="0"/></div>
  <button id="camera-seed" class="btn btn--secondary" data-tooltip="collision.seed_hint">@tr:collision.camera_seed</button>
  <div class="collision-actions">
    <button id="generate" class="btn btn--primary" data-tooltip="collision.regenerate_hint">@tr:collision.generate</button>
    <button id="generate-new" class="btn btn--secondary">@tr:collision.generate_new</button>
    <button id="cancel" class="btn btn--secondary">@tr:common.cancel</button>
  </div>
  <p>@tr:collision.regenerate_hint</p>
  <div class="collision-actions">
    <button id="show-voxels" class="btn btn--secondary" data-tooltip="collision.tip_voxel_view">@tr:collision.voxel_surface</button>
    <button id="show-mesh" class="btn btn--secondary" data-tooltip="collision.tip_shape">@tr:collision.mesh</button>
    <button id="edit-splats" class="btn btn--secondary" data-tooltip="collision.tip_edit">@tr:collision.edit</button>
  </div>
  <h3>@tr:collision.walk_test</h3>
  <p>@tr:collision.walk_hint</p>
  <div class="collision-row" data-tooltip="collision.tip_player"><span>@tr:collision.head_height</span><input id="walk-height" type="text" value="1.8"/></div>
  <div class="collision-row" data-tooltip="collision.tip_player"><span>@tr:collision.player_radius</span><input id="walk-radius" type="text" value="0.2"/></div>
  <div class="collision-row" data-tooltip="collision.tip_speed"><span>@tr:collision.speed</span><input id="walk-speed" type="text" value="2.5"/></div>
  <div class="collision-row" data-tooltip="collision.tip_step"><span>@tr:collision.step_height</span><input id="walk-step" type="text" value="0.25"/></div>
  <div class="collision-actions">
    <button id="walk" class="btn btn--primary" data-tooltip="collision.walk_hint">@tr:collision.enter_walk</button>
    <button id="exit-walk" class="btn btn--secondary">@tr:collision.exit_walk</button>
  </div>
  <p id="collision-status">@tr:collision.initial_status</p>
</body>
</rml>
