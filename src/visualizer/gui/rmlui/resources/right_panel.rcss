body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 13dp;
}

#splitter {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 6dp;
    cursor: resize-vertical;
}

#splitter:hover {
    cursor: resize-vertical;
}

#tab-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 28dp;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
}

.tab {
    display: inline-block;
    padding: 6dp 14dp;
    white-space: nowrap;
    cursor: pointer;
    border-top-left-radius: 4dp;
    border-top-right-radius: 4dp;
}
