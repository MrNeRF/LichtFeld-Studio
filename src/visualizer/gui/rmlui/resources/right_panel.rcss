body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#resize-handle {
    position: absolute;
    left: -4dp;
    top: 0;
    width: 8dp;
    height: 100%;
    z-index: 10;
    cursor: resize-horizontal;
}

#left-border {
    display: none;
}

#splitter {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 6dp;
    cursor: resize-vertical;
}

#splitter:hover {
    cursor: resize-vertical;
}

/* The shared panel_tabs stylesheet owns the common geometry. These right-panel
   overrides preserve the immediate selection feedback required by its cached
   context and leave the new bottom dock's transition behavior untouched. */
.tab {
    box-sizing: border-box;
    border-width: 1dp;
    border-bottom-width: 2dp;
    transition: none;
}
