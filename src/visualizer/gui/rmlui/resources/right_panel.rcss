body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#resize-handle {
    position: absolute;
    left: -4dp;
    top: 0;
    width: 8dp;
    height: 100%;
    z-index: 10;
    cursor: resize-horizontal;
}

#left-border {
    display: none;
}

#splitter {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 6dp;
    cursor: resize-vertical;
}

#splitter:hover {
    cursor: resize-vertical;
}

#tab-bar.with-scroll #tab-strip-viewport { right: 60dp; }
#tab-bar.with-scroll #tab-scroll-right { right: 30dp; }
#tab-picker {
    position: absolute;
    right: 0;
    top: 0;
    width: 28dp;
    min-width: 28dp;
    height: 28dp;
    z-index: 3;
}
#tab-picker selectvalue { visibility: hidden; }
#tab-picker selectarrow { margin-right: 4dp; }
#tab-picker selectbox { right: 0; min-width: 200dp; max-height: 400dp; overflow-y: auto; }

/* The shared panel_tabs stylesheet owns the common geometry. These right-panel
   overrides preserve the immediate selection feedback required by its cached
   context and leave the new bottom dock's transition behavior untouched. */
.tab {
    box-sizing: border-box;
    border-width: 1dp;
    border-bottom-width: 2dp;
    transition: none;
}
