body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#resize-handle {
    position: absolute;
    left: -4dp;
    top: 0;
    width: 8dp;
    height: 100%;
    z-index: 10;
    cursor: resize-horizontal;
}

#left-border {
    display: none;
}

#splitter {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 6dp;
    cursor: resize-vertical;
}

#splitter:hover {
    cursor: resize-vertical;
}

/* Categories sit beside the content, with an open edge on the active tab. */
#tab-bar {
    position: absolute;
    left: 8px;
    width: 28dp;
}

#tab-strip-viewport {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 3dp;
    overflow: hidden;
}

.tab {
    position: relative;
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 28dp;
    min-height: 28dp;
    margin: 0;
    padding: 0;
    border-width: 1dp;
    border-radius: 5dp 0 0 5dp;
    white-space: nowrap;
    cursor: pointer;
    tab-index: auto;
    nav: auto;
}

.tab.active {
    border-right-width: 0;
}

.tab-label {
    position: absolute;
    display: block;
    left: 27dp;
    top: 9dp;
    height: 26dp;
    line-height: 26dp;
    white-space: nowrap;
    transform-origin: 0 0;
    transform: rotate(90deg);
    pointer-events: none;
}

.tab-close {
    position: absolute;
    bottom: 3dp;
    left: 5dp;
    width: 16dp;
    height: 16dp;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3dp;
    background-color: transparent;
    line-height: 16dp;
    text-align: center;
    font-size: 13dp;
    cursor: pointer;
    tab-index: auto;
    nav: auto;
}
