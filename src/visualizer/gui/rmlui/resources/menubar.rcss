div {
    display: block;
}

body {
    font-family: Inter;
    font-size: 14dp;
    width: 100%;
    display: flex;
    flex-direction: column;
    background-color: transparent;
    padding: 0;
    margin: 0;
    overflow: hidden;
}

#menu-items {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
}

.menu-label {
    padding: 8dp 12dp;
}

#bottom-border {
    display: none;
}
