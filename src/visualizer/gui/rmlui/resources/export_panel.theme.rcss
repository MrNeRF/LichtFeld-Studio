/* Export panel theme overrides. */

.ep-section-title {
    color: @{text};
    background-color: @{alpha(text,0.04)};
}

.ep-format-option:hover {
    background-color: @{alpha(primary,0.16)};
}

.ep-format-option.selected {
    background-color: @{alpha(primary,0.25)};
}

.ep-format-dot {
    border-color: @{border};
}

.ep-format-option.selected .ep-format-dot {
    background-color: @{primary};
    border-color: @{primary};
}

.ep-format-name,
.ep-model-name {
    color: @{text};
}

.ep-model-count,
.ep-format-description,
.ep-empty-hint,
.ep-stage-text {
    color: @{text_dim};
}

.ep-model-list input[type="checkbox"].is-partial {
    background-color: @{primary};
    border-color: @{primary};
    decorator: none;
}

.ep-error {
    color: @{error};
}

.ep-model-header {
    background-color: @{alpha(text,0.04)};
}

.ep-model-list,
.ep-buttons {
    border-color: @{border};
}

.ep-empty-title {
    color: @{text};
}

.ep-model-header .ep-section-title {
    background-color: transparent;
}
