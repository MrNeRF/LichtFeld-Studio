body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "JetBrains Mono";
    background-color: rgb(30, 30, 30);
}

#window-frame,
#content-wrap,
#content,
#terminal-view {
    width: 100%;
    height: 100%;
}

#window-frame {
    background-color: rgb(30, 30, 30);
}

#content-wrap {
    overflow: hidden;
}

#content {
    overflow: hidden;
}

#terminal-view {
    display: block;
    overflow: hidden;
    white-space: pre;
}

.terminal-row {
    white-space: pre;
    overflow: hidden;
}
