/* Theme-dependent modal overlay styles. */

.modal-backdrop {
    background-color: @{modal.backdrop};
}

.modal-dialog {
    background-color: @{modal.surface};
    border-color: @{modal.border};
    border-radius: @{num(size.window_rounding)}dp;
}

.modal-title,
.modal-content {
    color: @{text};
}

.modal-sep {
    background-color: @{alpha(border,0.5)};
}

.dim-text {
    color: @{text_dim};
}

.error-text {
    color: @{error};
}

.warning-text {
    color: @{warning};
}

.modal-dialog.style-info {
    border-color: @{success};
}

.modal-dialog.style-warning {
    border-color: @{warning};
}

.modal-dialog.style-error {
    border-color: @{error};
}

.details-block {
    background-color: @{alpha(border,0.25)};
    color: @{text_dim};
}

.modal-note { color: @{text_dim}; }
.modal-dialog.form-modal { background-color: @{alpha(surface,1)}; border-color: @{border}; }
.form-modal .btn[disabled] { background-color: @{surface_bright}; color: @{text_dim}; border-color: @{border}; opacity: 0.5; cursor: default; }

/* Forms share field surfaces and borders in every theme. */
.form-modal input[type="text"], .form-modal select, .form-modal textarea {
    color: @{text};
    background-color: @{surface};
    border-color: @{border};
    padding: 0 8dp;
}
.form-modal input[type="text"]:focus, .form-modal select:focus,
.form-modal select:hover, .form-modal textarea:focus {
    border-color: @{primary};
    box-shadow: none;
}
