/* Shared theme styles for documents hosted by RmlPanelHost. */

body {
    color: @{text};
    background-color: @{surface};
}

#search-container {
    background-color: @{surface};
    border-color: @{border};
}

#search-icon,
#filter-clear img {
    image-color: @{text_dim};
}

#filter-input {
    color: @{text};
}

#filter-clear:hover img {
    image-color: @{text};
}

.tree-row.even {
    background-color: @{row_even};
}

.tree-row.odd {
    background-color: @{row_odd};
}

.tree-row:hover {
    background-color: @{panel.row_hover};
    border-left-color: @{primary};
}

.tree-row.selected {
    background-color: @{panel.row_selected};
}

.tree-row.selected:hover {
    background-color: @{panel.row_selected_hover};
    border-left-color: @{primary_dim};
}

.tree-row.drop-target {
    border-width: 1dp;
    border-color: @{primary};
}

.expand-toggle,
.node-name.training-disabled,
.row-icon.type-icon,
.section-arrow,
.is-hint,
.hero-eyebrow,
.stat-label,
.footer-label,
.axis-metric,
#histogram-bin-count,
#compare-bin-count,
.control-label,
.hero-description,
.empty-message,
.footer-hint {
    color: @{text_dim};
}

.node-name,
.is-label,
.is-action-name,
.is-binding-desc,
.hero-title,
.stat-value,
#histogram-summary,
#compare-summary,
.axis-label,
.footer-value,
#histogram-floating-title,
.empty-title {
    color: @{text};
}

.rename-input {
    color: @{text};
    background-color: @{surface};
    border-width: 1dp;
    border-color: @{primary};
}

.row-icon,
.histogram-history-icon {
    image-color: @{text};
}

.scene-tab {
    color: @{text_dim};
    background-color: @{panel.tab_inactive_bg};
    border-color: @{border};
}

.scene-tab:hover,
.scene-tab:focus-visible {
    color: @{text};
    border-color: @{panel.tab_hover_border};
    background-color: @{panel.tab_hover_bg};
}

.scene-tab.active {
    color: @{text};
    background-color: @{panel.tab_active_bg};
    border-color: @{panel.tab_active_border};
    border-bottom-color: @{primary};
}

.scene-chip {
    color: @{text};
    background-color: @{surface_bright};
    border-color: @{border};
}

.scene-chip--accent {
    color: @{text};
    background-color: @{panel.chip_accent_bg};
    border-color: @{panel.chip_accent_border};
}

.is-section-title {
    color: @{primary};
}

.is-binding-section {
    color: @{primary};
    background-color: @{panel.primary_bg_soft};
}

.is-binding-desc.is-capturing {
    color: @{warning};
}

#histogram-hero {
    @{panel.histogram_hero_decor};
    border-color: @{border};
}

.stat-card,
#histogram-card,
#compare-card,
.empty-card,
#histogram-footer {
    background-color: @{panel.histogram_surface};
    border-color: @{border};
}

#histogram-chart,
#compare-chart {
    background-color: @{panel.histogram_chart_bg};
    border-color: @{border};
}

.histogram-grid-line {
    background-color: @{panel.histogram_grid};
}

#histogram-docked-controls {
    border-left-color: @{panel.histogram_toolbar_divider};
}

#histogram-docked-controls .histogram-toolbar-item {
    background-color: @{panel.histogram_toolbar_item};
    border-color: @{panel.histogram_toolbar_divider};
}

#histogram-docked-controls .histogram-toolbar-item--action {
    background-color: transparent;
    border-width: 0;
}

#histogram-docked-controls .histogram-select {
    background-color: @{panel.histogram_toolbar_select};
    border-color: @{panel.histogram_toolbar_divider};
}

.histogram-slider-value {
    color: @{text};
}

.histogram-bar-fill,
.compare-cell-fill {
    @{panel.histogram_fill_decor};
}

.histogram-bar.selected .histogram-bar-fill,
.compare-cell.selected .compare-cell-fill {
    @{panel.histogram_fill_selected_decor};
}

#histogram-selection,
#compare-selection {
    border-color: @{warning};
    background-color: @{panel.histogram_selection_fill};
    decorator: none;
}

.histogram-history-btn:disabled .histogram-history-icon {
    image-color: @{panel.histogram_history_icon_disabled};
}

.footer-history-actions {
    background-color: @{panel.histogram_footer_chip};
    border-color: @{panel.histogram_toolbar_divider};
}

.training-panel-title {
    color: @{text};
    border-top-color: @{panel.primary_border_soft};
}

.training-panel-title-icon {
    image-color: @{primary};
}

.training-subsection-title {
    color: @{text_dim};
    border-top-color: @{panel.primary_border_faint};
}

.loss-graph-wrap {
    background-color: @{background};
}

.loss-tick {
    color: @{text_dim};
}

.color-picker-popup {
    background-color: @{surface};
    border-color: @{border};
}

.mask-settings-group {
    border-left-color: @{panel.primary_accent};
}

.mask-settings-divider {
    background-color: @{panel.primary_border_faint};
}
