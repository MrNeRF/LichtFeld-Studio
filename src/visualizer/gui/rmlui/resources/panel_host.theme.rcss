/* Shared theme styles for documents hosted by RmlPanelHost.
 * Panel-specific selectors belong in the panel's sibling *.theme.rcss file. */

body {
    color: @{text};
    @{panel.host_body_decor};
}

body.native-panel #window-shadow-ambient,
body.native-panel #window-shadow-key,
body.window-minimized #window-shadow-ambient,
body.window-minimized #window-shadow-key,
body.window-maximized #window-shadow-ambient,
body.window-maximized #window-shadow-key {
    display: none;
}
body.native-panel,
body.window-minimized,
body.window-maximized {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    decorator: none;
}

button.window-control {
    color: @{text_dim};
    background-color: transparent;
}
button.window-control:hover {
    background-color: @{menu.hover};
}
