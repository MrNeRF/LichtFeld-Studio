/* Training panel — panel-specific styles only.
 * Shared row/label typography lives in components.rcss so training and rendering
 * cannot drift visually. */

body {
    font-family: Inter;
    padding: 0;
    bottom: 0;
}

#content-wrap {
    min-width: 0;
    min-height: 0;
    flex: 1;
    padding: 6dp;
    overflow-x: hidden;
    overflow-y: hidden;
}

#content {
    min-width: 0;
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.training-panel-layout {
    min-width: 0;
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

#controls {
    flex-shrink: 0;
}

.training-preparation-status {
    display: flex;
    align-items: center;
    padding: 10dp 8dp;
    margin-bottom: 6dp;
    border-radius: 4dp;
    background-color: #89b4fa14;
}

.training-preparation-label {
    display: block;
    flex: 1;
    min-width: 0;
    white-space: normal;
    text-align: left;
    color: #cdd6f4;
    font-size: 12dp;
}

.training-preparation-indicator {
    width: 8dp;
    height: 8dp;
    flex-shrink: 0;
    margin-right: 8dp;
    border-radius: 4dp;
    background-color: #89b4fa;
}

.training-preparation-indicator.is-active {
    animation: training-preparation-pulse 0.8s quadratic-in-out infinite alternate;
}

@keyframes training-preparation-pulse {
    from { opacity: 1; }
    to { opacity: 0.35; }
}

#training-search-container {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 4dp 6dp;
    margin: 6dp 0 4dp;
    border-width: 1dp;
    flex-shrink: 0;
}

.training-scroll-region {
    min-width: 0;
    min-height: 0;
    flex: 1;
    overflow-x: hidden;
    overflow-y: auto;
    padding-bottom: 6dp;
    padding-right: 4dp;
}

/* A narrow scrollbar in its own gutter: the padding keeps it clear of the controls at every UI scale. */
.training-scroll-region scrollbarvertical {
    width: 4dp;
}

.training-scroll-region scrollbarvertical sliderbar {
    min-height: 12dp;
}

.training-telemetry {
    min-width: 0;
    flex-shrink: 0;
}

#training-search-input {
    flex-grow: 1;
    min-width: 0;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

#training-search-input:focus,
#training-search-input:focus-visible {
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

#training-search-icon {
    width: 13dp;
    height: 13dp;
    margin-right: 4dp;
    flex-shrink: 0;
}

#training-search-clear {
    width: 12dp;
    height: 12dp;
    margin-left: 4dp;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    cursor: pointer;
    flex-shrink: 0;
}

#training-search-clear img {
    width: 12dp;
    height: 12dp;
}

.training-panel-title {
    display: flex;
    align-items: center;
    gap: 6dp;
    margin-top: 2dp;
    padding: 6dp 0 0;
    border-top-width: 1dp;
    font-size: 12dp;
    font-weight: bold;
}

.training-panel-title--secondary {
    margin-top: 8dp;
}

.training-panel-title-icon {
    width: 14dp;
    height: 14dp;
    flex-shrink: 0;
}

.training-panel-block {
    margin-top: 4dp;
}

.training-subsection {
    margin-top: 0;
}

.training-subsection-title {
    padding-top: 6dp;
    border-top-width: 1dp;
    margin-bottom: 4dp;
    font-size: 12dp;
    font-weight: bold;
}

.training-panel-block > .training-subsection:first-child {
    margin-top: 0;
}

.training-panel-block > .training-subsection:first-child > .training-subsection-title {
    padding-top: 0;
    border-top-width: 0;
}

.training-subsection > .section-header {
    margin-top: 0;
}

.training-panel-block > .training-subsection:first-child > .section-header {
}

/* The lock belongs to the iterations label, so the field keeps the width of every other number field. */
.prop-label--with-action {
    display: flex;
    align-items: center;
}

.prop-label__text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.prop-label--with-action > .steps-scale-lock-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18dp;
    height: 18dp;
    margin-left: 4dp;
    padding: 0;
    flex-shrink: 0;
    box-sizing: border-box;
    line-height: 0;
}

.prop-label--with-action > .steps-scale-lock-btn img {
    display: block;
    width: 12dp;
    height: 12dp;
}

.loss-graph-wrap {
    display: flex;
    align-items: stretch;
    gap: 4dp;
    height: 78dp;
    min-width: 0;
    overflow: hidden;
}

.loss-graph-ticks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 42dp;
    flex-shrink: 0;
    padding: 6dp 0 6dp 0;
}

.loss-tick {
    font-size: 12dp;
    text-align: right;
    white-space: nowrap;
}

loss-graph {
    display: block;
    flex: 1;
    min-width: 0;
    height: 78dp;
}

#loss-graph-container {
    margin-top: 4dp;
    min-width: 0;
}

.training-progress-wrap {
    position: relative;
}

#loss-label {
    margin-bottom: 2dp;
    min-width: 0;
}

.training-status-line {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.color-picker-popup {
    display: none;
    position: absolute;
    z-index: 100;
    padding: 4dp;
    border-width: 1dp;
}

.color-picker-popup.visible {
    display: block;
}

.mask-settings-group {
    margin: 3dp 0 6dp 8dp;
    padding: 2dp 0 2dp 8dp;
    border-left-width: 1dp;
}

.mask-settings-divider {
    height: 1dp;
    margin: 4dp 0 2dp;
}
