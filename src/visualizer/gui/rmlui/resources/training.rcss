/* Training panel — panel-specific styles only.
 * Shared row/label typography lives in components.rcss so training and rendering
 * cannot drift visually. */

body {
    font-family: Inter;
    padding: 0;
    bottom: 0;
}

#content-wrap {
    min-width: 0;
    min-height: 0;
    flex: 1;
    padding: 6dp;
    overflow-x: hidden;
    overflow-y: hidden;
}

#content {
    min-width: 0;
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.training-panel-layout {
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
}

#controls {
    flex-shrink: 0;
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-x: hidden;
}

.training-actions-group {
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.training-toolbar {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 6dp;
    width: 100%;
    min-width: 0;
}

.training-toolbar > .training-actions-group {
    flex: 1 1 auto;
    width: auto;
}

.training-action-row {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    gap: 4dp;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.training-start-feedback,
.training-action-status {
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    white-space: normal;
    word-break: break-word;
    overflow-x: hidden;
}

#training-controls-header {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 16dp;
    margin-top: 3dp;
    margin-bottom: 1dp;
}

.training-status-badge {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    height: auto;
    padding: 0;
    border-width: 0;
    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 0.3dp;
    line-height: 14dp;
    text-transform: uppercase;
    white-space: nowrap;
}

.training-status-badge-label {
    display: inline-block;
    white-space: nowrap;
}

.training-start-feedback {
    max-height: 120dp;
    overflow-y: auto;
    margin-bottom: 6dp;
}

.training-toolbar-action {
    display: inline-flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    gap: 4dp;
    box-sizing: border-box;
    height: 28dp;
    min-width: 74dp;
    max-width: 96dp;
    padding: 3dp 7dp;
    margin: 0;
    line-height: 20dp;
    white-space: nowrap;
}

.training-toolbar-action img {
    width: 14dp;
    height: 14dp;
    flex-shrink: 0;
}

.training-toolbar-action span {
    white-space: nowrap;
}

#training-search-container {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 4dp 6dp;
    margin: 6dp 0 4dp;
    border-width: 1dp;
    flex-shrink: 0;
}

.training-scroll-region {
    min-width: 0;
    min-height: 0;
    flex: 1;
    overflow-x: hidden;
    overflow-y: auto;
    padding-bottom: 6dp;
}

/* Keep the scroll position legible without taking meaningful panel width. */
.training-scroll-region scrollbarvertical {
    width: 4dp;
}

.training-scroll-region scrollbarvertical sliderbar {
    min-height: 12dp;
}

.training-telemetry {
    min-width: 0;
    flex-shrink: 0;
}

#training-search-input {
    flex-grow: 1;
    min-width: 0;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

#training-search-input:focus,
#training-search-input:focus-visible {
    background-color: transparent;
    border-width: 0;
    box-shadow: none;
}

#training-search-icon {
    width: 13dp;
    height: 13dp;
    margin-right: 4dp;
    flex-shrink: 0;
}

#training-search-clear {
    width: 12dp;
    height: 12dp;
    margin-left: 4dp;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    cursor: pointer;
    flex-shrink: 0;
}

#training-search-clear img {
    width: 12dp;
    height: 12dp;
}

.training-panel-title {
    display: flex;
    align-items: center;
    gap: 6dp;
    margin-top: 2dp;
    padding: 6dp 0 0;
    border-top-width: 1dp;
    font-size: 12dp;
    font-weight: bold;
}

.training-panel-title--secondary {
    margin-top: 8dp;
}

.training-panel-title-icon {
    width: 14dp;
    height: 14dp;
    flex-shrink: 0;
}

.training-panel-block {
    margin-top: 4dp;
}

.training-panel-block > .section-header {
    margin-top: 4dp;
    padding-top: 6dp;
    border-top-width: 1dp;
}

.training-subsection {
    margin-top: 0;
}

.training-subsection-title {
    padding-top: 6dp;
    border-top-width: 1dp;
    margin-bottom: 4dp;
    font-size: 12dp;
    font-weight: bold;
}

.training-panel-block > .training-subsection:first-child {
    margin-top: 0;
}

.training-panel-block > .training-subsection:first-child > .training-subsection-title {
    padding-top: 0;
    border-top-width: 0;
}

.training-subsection > .section-header {
    margin-top: 0;
}

.training-panel-block > .training-subsection:first-child > .section-header {
}

.steps-scale-lock-row > .steps-scale-lock-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22dp;
    height: 20dp;
    padding: 2dp;
    flex-shrink: 0;
    box-sizing: border-box;
    line-height: 0;
}

.steps-scale-lock-row > .steps-scale-lock-btn img {
    display: block;
    width: 14dp;
    height: 14dp;
}

.loss-graph-wrap {
    display: flex;
    align-items: stretch;
    gap: 4dp;
    height: 78dp;
    min-width: 0;
    overflow: hidden;
}

.loss-graph-ticks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 42dp;
    flex-shrink: 0;
    padding: 6dp 0 6dp 0;
}

.loss-tick {
    font-family: "JetBrains Mono";
    font-size: 12dp;
    text-align: right;
    white-space: nowrap;
}

loss-graph {
    display: block;
    flex: 1;
    min-width: 0;
    height: 78dp;
}

#loss-graph-container {
    margin-top: 4dp;
    min-width: 0;
}

.training-progress-wrap {
    position: relative;
}

#loss-label {
    margin-bottom: 2dp;
    min-width: 0;
}

.training-status-line {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.color-picker-popup {
    display: none;
    position: absolute;
    z-index: 100;
    padding: 4dp;
    border-width: 1dp;
}

.color-picker-popup.visible {
    display: block;
}

.mask-settings-group {
    margin: 3dp 0 6dp 8dp;
    padding: 2dp 0 2dp 8dp;
    border-left-width: 1dp;
}

.mask-settings-divider {
    height: 1dp;
    margin: 4dp 0 2dp;
}

/* Measure natural localized button widths with the same styles and dp scale.
   Hidden probes stay outside the toolbar so compact mode cannot affect them. */
#training-toolbar-measure {
    position: absolute;
    visibility: hidden;
    pointer-events: none;
    height: 0;
    overflow: hidden;
    white-space: nowrap;
}
#measure-action-gap { display: inline-block; width: 4dp; }
#measure-action-max { display: inline-block; width: 96dp; }
#training-toolbar-measure .btn {
    flex: 0 0 auto;
    max-width: none;
    tab-index: none;
    nav: none;
}
.training-toolbar.is-compact .training-toolbar-action span {
    display: none;
}
.training-toolbar.is-compact .training-toolbar-action {
    flex: 0 0 28dp;
    min-width: 28dp;
    max-width: 28dp;
    width: 28dp;
    padding: 3dp 6dp;
    gap: 0;
}

/* Advanced is a top-level title, not an inset subsection header. */
#hdr-advanced-params {
    box-sizing: border-box;
    width: 100%;
    margin: 8dp 0 0;
    padding: 5dp 6dp;
    gap: 6dp;
}
#hdr-advanced-params > .section-arrow {
    flex: 0 0 10dp;
    margin: 0;
}
