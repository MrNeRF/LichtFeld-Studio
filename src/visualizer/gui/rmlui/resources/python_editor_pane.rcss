body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "JetBrains Mono";
    background-color: rgb(30, 30, 30);
    color: rgb(229, 229, 229);
}

#window-frame,
#content-wrap,
#content,
#python-editor-view {
    width: 100%;
    height: 100%;
}

#window-frame {
    background-color: rgb(30, 30, 30);
}

#content-wrap,
#content,
#python-editor-view {
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#python-editor-view {
    display: block;
    background-color: rgb(30, 30, 30);
}
