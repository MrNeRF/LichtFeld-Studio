<rml>
<head>
    <link type="text/rcss" href="statusbar.rcss"/>
</head>
<body id="body" data-model="status_bar" data-class-safe-mode="safe_mode">
  <div id="status-row">
    <div id="status-left">
        <span id="safe-mode-badge" class="hidden" data-class-hidden="!safe_mode" data-attr-title="safe_mode_text">{{ safe_mode_text }}</span>
        <span id="mode-text" data-style-color="mode_color">{{ mode_text }}</span>
        <div id="training-section" class="hidden" data-class-hidden="!show_training">
            <span class="separator section-sep">|</span>
            <div id="progress-group" class="status-item">
                <div id="progress-container">
                    <div id="progress-fill" data-style-width="progress_width"></div>
                    <div id="progress-markers"></div>
                    <span id="progress-text">{{ progress_text }}</span>
                </div>
            </div>
            <div id="step-metric" class="status-item">
                <span id="step-label" class="dim metric-label">{{ step_label }}</span>
                <span id="step-value">{{ step_value }}</span>
            </div>
            <div id="loss-metric" class="status-item">
                <span class="separator">|</span>
                <span id="loss-label" class="dim metric-label">{{ loss_label }}</span>
                <span id="loss-value">{{ loss_value }}</span>
            </div>
            <div id="eval-metric" class="status-item hidden" data-class-hidden="!show_eval_metrics">
                <span class="separator">|</span>
                <span id="eval-metrics-value" class="dim">{{ eval_metrics_value }}</span>
            </div>
            <div id="gaussians-metric" class="status-item">
                <span class="separator">|</span>
                <span id="gaussians-label" class="dim metric-label">{{ gaussians_label }}</span>
                <span id="gaussians-value">{{ gaussians_value }}</span>
            </div>
            <div id="time-metric" class="status-item">
                <span class="separator">|</span>
                <span id="time-value">{{ time_value }}</span>
                <span id="eta-label" class="dim metric-label">{{ eta_label }}</span>
                <span id="eta-value">{{ eta_value }}</span>
            </div>
        </div>
        <div id="splat-section" class="hidden" data-class-hidden="!show_splats">
            <span class="separator">|</span>
            <span id="splat-text" data-style-color="splat_color">{{ splat_text }}</span>
        </div>
        <div id="split-section" class="hidden" data-class-hidden="!show_split">
            <span class="separator">|</span>
            <span id="split-mode" data-style-color="split_mode_color">{{ split_mode }}</span>
            <span id="split-detail" class="dim">{{ split_detail }}</span>
        </div>
        <div id="wasd-section" class="hidden" data-class-hidden="!show_wasd">
            <span class="separator wasd-sep" data-style-color="wasd_sep_color">|</span>
            <span id="wasd-text" data-style-color="wasd_color">{{ wasd_text }}</span>
        </div>
        <div id="zoom-section" class="hidden" data-class-hidden="!show_zoom">
            <span class="separator zoom-sep" data-style-color="zoom_sep_color">|</span>
            <span id="zoom-text" data-style-color="zoom_color">{{ zoom_text }}</span>
        </div>
        <div id="status-message-section" class="hidden" data-class-hidden="!show_status_message">
            <span class="separator">|</span>
            <span id="status-message" data-style-color="status_message_color">{{ status_message_text }}</span>
        </div>
    </div>
    <div id="status-right">
        <div id="mcp-chip" data-attr-title="mcp_tooltip" data-style-color="mcp_color" data-class-expanded="mcp_details_expanded">
            <span>{{ mcp_summary }}</span>
            <div id="mcp-popup" class="hidden" data-class-hidden="!mcp_details_expanded">
                <div id="mcp-popup-header">
                    <div id="mcp-popup-title" data-style-color="mcp_color">{{ mcp_summary }}</div>
                    <button id="mcp-toggle" data-class-is-on="mcp_server_enabled" data-attr-title="mcp_toggle_label" data-attrif-disabled="safe_mode">
                        <span class="mcp-switch-track"><span class="mcp-switch-knob"></span></span>
                    </button>
                </div>
                <div id="mcp-details">{{ mcp_details }}</div>
                <div id="mcp-counters">
                    <span>{{ mcp_total_text }}</span>
                    <span class="mcp-success">{{ mcp_success_text }}</span>
                    <span class="mcp-error">{{ mcp_error_text }}</span>
                </div>
                <div id="mcp-actions">
                    <button id="mcp-preferences" class="btn btn--primary mcp-edit-button">{{ mcp_preferences_label }}</button>
                </div>
            </div>
        </div>
        <div id="account-chip" data-class-warning="account_membership_required" data-attr-title="account_tooltip" data-style-color="account_color">
            <span id="account-label">{{ account_label }}</span>
            <span id="account-tier" class="hidden" data-class-hidden="!account_show_tier">{{ account_tier }}</span>
        </div>
        <span id="gpu-model" class="dim hidden" data-class-hidden="!show_gpu_model">{{ gpu_model_text }}</span>
        <img id="gpu-icon" data-class-active="gpu_panel_active" title="@tr:ui.perf_hud_tooltip" src="../icon/gpu.png" />
        <div id="lfs-mem-group" class="status-item">
            <span id="lfs-mem" data-style-color="lfs_mem_color">{{ lfs_mem_text }}</span>
            <span class="separator thin">|</span>
        </div>
        <span id="gpu-mem" data-style-color="gpu_mem_color">{{ gpu_mem_text }}</span>
        <div id="fps-group" class="status-item">
            <span id="fps-value" data-style-color="fps_color">{{ fps_value }}</span>
            <span id="fps-label" class="dim">{{ fps_label }}</span>
        </div>
        <span id="git-commit" class="dim">{{ git_commit }}</span>
    </div>
  </div>
</body>
</rml>
