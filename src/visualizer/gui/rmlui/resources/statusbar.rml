<rml>
<head>
    <link type="text/rcss" href="statusbar.rcss"/>
</head>
<body id="body" data-model="status_bar" data-class-safe-mode="safe_mode" data-class-has-notice="show_status_message || preview_reduced">
  <div id="status-row">
    <div id="status-left">
        <span id="safe-mode-badge" class="hidden" data-class-hidden="!safe_mode" data-attr-title="safe_mode_text">{{ safe_mode_text }}</span>
        <span id="mode-text" data-class-hidden="!pref_activity" data-style-color="mode_color">{{ mode_text }}</span>
        <div id="training-section" class="hidden" data-class-hidden="!show_training || (!pref_activity && !pref_training_progress && !pref_training_loss && !pref_gaussians && !pref_elapsed)">
            <span class="separator section-sep">|</span>
            <div id="progress-group" class="status-item" data-class-hidden="!pref_activity">
                <div id="progress-container" data-class-miner="progress_miner" data-class-tessle="progress_tessle">
                    <div id="progress-wall"></div>
                    <div id="progress-fill" data-style-width="progress_width"></div>
                    <div id="progress-debris"></div>
                    <div id="progress-markers"></div>
                    <img class="progress-figure" src="../icon/mining/miner-raised.png" data-style-left="progress_width" data-class-hidden="!miner_raised"/>
                    <img class="progress-figure" src="../icon/mining/miner-raised-step-a.png" data-style-left="progress_width" data-class-hidden="!miner_step_a"/>
                    <img class="progress-figure" src="../icon/mining/miner-strike.png" data-style-left="progress_width" data-class-hidden="!miner_strike"/>
                    <img class="progress-figure" src="../icon/mining/miner-raised-step-b.png" data-style-left="progress_width" data-class-hidden="!miner_step_b"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-1.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_1"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-2.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_2"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-3.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_3"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-4.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_4"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-5.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_5"/>
                    <img class="progress-figure smoke" src="../icon/mining/miner-smoke-6.png" data-style-left="progress_width" data-class-hidden="!miner_smoke_6"/>
                    <img id="tessle-figure" src="../icon/tessle/open.png" data-attr-src="tessle_sprite" data-style-left="tessle_left" data-class-hidden="!progress_tessle"/>
                    <span id="progress-text" data-class-progress-text--miner="progress_miner" data-class-progress-text--tessle="progress_tessle" data-style-left="progress_text_left">{{ progress_text }}</span>
                </div>
            </div>
            <div id="step-metric" class="status-item" data-class-hidden="!pref_training_progress">
                <span id="step-label" class="dim metric-label">{{ step_label }}</span>
                <span id="step-value">{{ step_value }}</span>
            </div>
            <div id="loss-metric" class="status-item" data-class-hidden="!pref_training_loss">
                <span class="separator">|</span>
                <span id="loss-label" class="dim metric-label">{{ loss_label }}</span>
                <span id="loss-value">{{ loss_value }}</span>
            </div>
            <div id="eval-metric" class="status-item hidden" data-class-hidden="!show_eval_metrics || !pref_training_loss">
                <span class="separator">|</span>
                <span id="eval-metrics-value" class="dim">{{ eval_metrics_value }}</span>
            </div>
            <div id="gaussians-metric" class="status-item" data-class-hidden="!pref_gaussians">
                <span class="separator">|</span>
                <span id="gaussians-label" class="dim metric-label">{{ gaussians_label }}</span>
                <span id="gaussians-value">{{ gaussians_value }}</span>
            </div>
            <div id="time-metric" class="status-item" data-class-hidden="!pref_elapsed && !pref_training_progress">
                <span class="separator">|</span>
                <span id="time-value" data-class-hidden="!pref_elapsed">{{ time_value }}</span>
                <span id="eta-label" data-class-hidden="!pref_training_progress" class="dim metric-label">{{ eta_label }}</span>
                <span id="eta-value" data-class-hidden="!pref_training_progress">{{ eta_value }}</span>
            </div>
        </div>
        <div id="splat-section" class="hidden" data-class-hidden="!show_splats || !pref_gaussians">
            <span class="separator">|</span>
            <span id="splat-text" data-style-color="splat_color">{{ splat_text }}</span>
        </div>
        <div id="split-section" class="hidden" data-class-hidden="!show_split || !pref_camera">
            <span class="separator">|</span>
            <span id="split-mode" data-style-color="split_mode_color">{{ split_mode }}</span>
            <span id="split-detail" class="dim">{{ split_detail }}</span>
        </div>
        <div class="status-item" data-class-hidden="!pref_renderer || renderer_text == ''"><span class="separator">|</span><span>{{ renderer_text }}</span></div>
        <div class="status-item" data-class-hidden="!pref_camera || camera_text == ''"><span class="separator">|</span><span>{{ camera_text }}</span></div>
        <div class="status-item" data-class-hidden="!pref_selected || selected_text == ''"><span class="separator">|</span><span>{{ selected_text }}</span></div>
        <div class="status-item" data-class-hidden="!pref_training_speed || training_speed_text == ''"><span class="separator">|</span><span>{{ training_speed_text }}</span></div>
        <div id="wasd-section" class="hidden" data-class-hidden="!show_wasd">
            <span class="separator wasd-sep" data-style-color="wasd_sep_color">|</span>
            <span id="wasd-text" data-style-color="wasd_color">{{ wasd_text }}</span>
        </div>
        <div id="zoom-section" class="hidden" data-class-hidden="!show_zoom">
            <span class="separator zoom-sep" data-style-color="zoom_sep_color">|</span>
            <span id="zoom-text" data-style-color="zoom_color">{{ zoom_text }}</span>
        </div>
        <div id="preview-reduced-section" class="hidden" data-class-hidden="!preview_reduced">
            <span class="separator">|</span>
            <span>{{ preview_reduced_text }}</span>
        </div>
        <div id="status-message-section" class="hidden" data-class-hidden="!show_status_message">
            <span class="separator">|</span>
            <span id="status-message" data-style-color="status_message_color">{{ status_message_text }}</span>
        </div>
    </div>
    <div id="status-right">
        <div id="mcp-chip" data-class-hidden="!pref_mcp" data-attr-title="mcp_tooltip" data-style-color="mcp_color" data-class-expanded="mcp_details_expanded">
            <span id="mcp-summary">{{ mcp_summary }}</span>
            <span id="mcp-compact">@tr:status_bar.mcp_name</span>
            <div id="mcp-popup" class="hidden" data-class-hidden="!mcp_details_expanded">
                <div id="mcp-popup-header">
                    <div id="mcp-popup-title" data-style-color="mcp_color">{{ mcp_summary }}</div>
                    <button id="mcp-toggle" data-class-is-on="mcp_server_enabled" data-attr-title="mcp_toggle_label" data-attrif-disabled="safe_mode" data-class-disabled="safe_mode">
                        <span class="mcp-switch-track"><span class="mcp-switch-knob"></span></span>
                    </button>
                </div>
                <div id="mcp-details">{{ mcp_details }}</div>
                <div id="mcp-counters">
                    <span>{{ mcp_total_text }}</span>
                    <span class="mcp-success">{{ mcp_success_text }}</span>
                    <span class="mcp-error">{{ mcp_error_text }}</span>
                </div>
                <div id="mcp-actions">
                    <button id="mcp-preferences" class="btn btn--primary mcp-edit-button">{{ mcp_preferences_label }}</button>
                </div>
            </div>
        </div>
        <span id="gpu-model" class="dim hidden" data-class-hidden="!show_gpu_model">{{ gpu_model_text }}</span>
        <img id="gpu-icon" data-class-hidden="!pref_vram && !pref_gpu_utilization" data-class-active="gpu_panel_active" title="@tr:ui.perf_hud_tooltip" src="../icon/gpu.png" />
        <div id="lfs-mem-group" class="status-item" data-class-hidden="!pref_vram">
            <span id="lfs-mem" data-style-color="lfs_mem_color">{{ lfs_mem_text }}</span>
            <span class="separator thin">|</span>
        </div>
        <span id="gpu-mem" data-class-hidden="!pref_vram" data-style-color="gpu_mem_color">{{ gpu_mem_text }}</span>
        <div id="fps-group" class="status-item" data-class-hidden="!pref_fps">
            <span id="fps-label" class="dim">{{ fps_label }}:</span>
            <div class="fps-metric hidden" data-tooltip="status_bar.ui_fps_tooltip"><span class="fps-caption dim">{{ fps_ui_label }}</span><span id="fps-value" class="fps-number">{{ fps_value }}</span></div>
            <div class="fps-metric" data-tooltip="status_bar.view_fps_tooltip"><span class="fps-caption dim hidden">{{ fps_view_label }}</span><span id="fps-view-value" class="fps-number" data-style-color="fps_color">{{ fps_view_value }}</span></div>
        </div>
        <span class="status-item" data-class-hidden="!pref_portal || portal_text == ''">{{ portal_text }}</span>
        <span class="status-item" data-class-hidden="!pref_gpu_utilization || gpu_utilization_text == ''">{{ gpu_utilization_text }}</span>
        <span class="status-item" data-class-hidden="!pref_frame_time || frame_time_text == ''">{{ frame_time_text }}</span>
        <span id="git-commit" class="dim hidden">{{ git_commit }}</span>
    </div>
  </div>
</body>
</rml>
