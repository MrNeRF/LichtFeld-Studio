<rml>
<head>
  <link type="text/template" href="floating_window.rml"/>
  <link type="text/rcss" href="asset_manager.rcss"/>
</head>

<body template="floating-window" data-model="asset_manager">
  <div id="asset-popup">
    <div id="asset-popup-toolbar">
      <div class="asset-search-box">
        <span class="asset-search-icon">Search</span>
        <input type="text" placeholder="Search assets..." data-value="search_query" data-event-change="on_search" />
      </div>

      <button class="asset-sort-button" data-event-click="cycle_sort_mode">
        <span>{{sort_label}}</span>
      </button>

      <div class="asset-view-toggle">
        <button class="asset-view-button" data-class-is-active="is_gallery_view" data-event-click="set_view_mode('gallery')">Gallery</button>
        <button class="asset-view-button" data-class-is-active="is_list_view" data-event-click="set_view_mode('list')">List</button>
      </div>

      <div class="asset-import-dropdown">
        <button class="asset-import-button" data-event-click="toggle_import_menu">Import ▼</button>
        <div class="asset-import-menu" data-class-is-visible="import_menu_open">
          <div class="asset-import-menu-item" data-event-click="on_import_asset">Import Asset...</div>
          <div class="asset-import-menu-item" data-event-click="on_import_dataset">Import Dataset...</div>
          <div class="asset-import-menu-item" data-event-click="on_import_checkpoint">Import Checkpoint...</div>
        </div>
      </div>
    </div>

    <div id="asset-popup-summary">
      <span><span>{{asset_count}}</span> assets</span>
      <span><span>{{project_count}}</span> projects</span>
      <span><span>{{scene_count}}</span> scenes</span>
      <span><span>{{selected_count}}</span> selected</span>
    </div>

    <div id="asset-popup-content">
      <div id="asset-sidebar">
        <div class="asset-sidebar-section">
          <div class="asset-sidebar-title">PROJECTS</div>
          <div data-for="project : projects">
            <div class="asset-filter-row" data-class-is-active="project.id == selected_project_id" data-attr-data-project-id="project.id">
              <span class="asset-row-label">{{project.name}}</span>
              <span class="asset-row-count">{{project.scene_count}}</span>
            </div>
          </div>
        </div>

        <div class="asset-sidebar-section" data-if="selected_project_id">
          <div class="asset-sidebar-title">SCENES</div>
          <div data-for="scene : scenes">
            <div class="asset-filter-row" data-class-is-active="scene.id == selected_scene_id" data-attr-data-scene-id="scene.id">
              <span class="asset-row-label">{{scene.name}}</span>
              <span class="asset-row-count">{{scene.asset_count}}</span>
            </div>
          </div>
        </div>

        <div class="asset-sidebar-section">
          <div class="asset-sidebar-title">FILTERS</div>
          <div class="asset-filter-hint">Select none to show all</div>
          <div data-for="filter : filters">
            <div class="asset-filter-checkbox-row" data-event-click="toggle_filter(filter.id)">
              <input type="checkbox" data-checked="filter.is_selected" />
              <span class="asset-row-label">{{filter.label}}</span>
              <span class="asset-row-count">{{filter.count}}</span>
            </div>
          </div>
        </div>


      </div>

      <div id="asset-gallery">
        <div class="asset-gallery-header">
          <span class="asset-gallery-title" data-if="is_gallery_view">Gallery</span>
          <span class="asset-gallery-title" data-if="is_list_view">List</span>
          <span class="asset-gallery-subtitle">Cataloged assets with direct load for splats and checkpoints</span>
        </div>

        <div class="asset-gallery-scroll">
          <div class="asset-card-grid" data-if="is_gallery_view">
            <div data-for="asset : assets">
              <div class="asset-card" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists" data-attr-data-asset-id="asset.id" data-asset-action="select">
                <div data-attr-class="'asset-card-thumb ' + asset.thumb_class">
                  <div class="asset-card-overlay">
                    <span data-attr-class="'asset-pill ' + asset.pill_class">{{asset.type_label}}</span>
                  </div>
                </div>
                <div class="asset-card-body">
                  <div class="asset-card-title-row">
                    <span class="asset-card-title">{{asset.display_name}}</span>
                    <span class="asset-favorite" data-if="asset.is_favorite">*</span>
                  </div>
                  <div class="asset-card-subtitle">{{asset.display_subtitle}}</div>
                  <div class="asset-card-meta">
                    <span>{{asset.role_label}}</span>
                    <span data-if="asset.points_label">{{asset.points_label}}</span>
                    <span>{{asset.size_label}}</span>
                  </div>
                  <div class="asset-card-tags" data-if="asset.tags_label">
                    <span class="asset-card-tag">{{asset.tags_label}}</span>
                  </div>
                  <div class="asset-card-actions">
                    <button class="asset-card-button" data-if="asset.can_load" data-attr-data-asset-id="asset.id" data-asset-action="load">Load</button>
                    <button class="asset-card-button is-danger" data-attr-data-asset-id="asset.id" data-asset-action="remove">Remove</button>
                  </div>
                </div>
                <button class="asset-card-menu" data-attr-data-asset-id="asset.id" data-asset-action="menu">&#x22EE;</button>
                <div class="asset-card-dropdown" data-class-is-visible="asset.menu_open">
                  <div class="asset-dropdown-item" data-attr-data-asset-id="asset.id" data-asset-action="rename">Rename</div>
                  <div class="asset-dropdown-item has-submenu" data-attr-data-asset-id="asset.id">
                    <span>Move to Project</span>
                    <span class="submenu-arrow">&#x203A;</span>
                    <div class="asset-dropdown-submenu">
                      <div class="asset-dropdown-item" data-attr-data-asset-id="asset.id" data-asset-action="create_project">+ New project</div>
                      <div class="asset-submenu-divider"></div>
                      <div data-for="proj : move_menu_projects">
                        <div class="asset-dropdown-item project-option" data-attr-data-asset-id="asset.id" data-attr-data-project-id="proj.id" data-asset-action="move_to_existing_project">{{proj.name}}</div>
                      </div>
                    </div>
                  </div>
                  <div class="asset-dropdown-item" data-attr-data-asset-id="asset.id" data-asset-action="show_in_folder">Show in Folder</div>
                  <div class="asset-dropdown-item is-danger" data-attr-data-asset-id="asset.id" data-asset-action="remove_from_menu">Remove</div>
                </div>
              </div>
            </div>
          </div>

          <div class="asset-list-view" data-if="is_list_view">
            <div class="asset-list-header">
              <span class="asset-col asset-col-name">Name</span>
              <span class="asset-col asset-col-type">Type</span>
              <span class="asset-col asset-col-role">Role</span>
              <span class="asset-col asset-col-project">Project</span>
              <span class="asset-col asset-col-scene">Scene</span>
              <span class="asset-col asset-col-run">Run</span>
              <span class="asset-col asset-col-size">Size</span>
              <span class="asset-col asset-col-modified">Modified</span>
              <span class="asset-col asset-col-status">Status</span>
            </div>
            <div data-for="asset : assets">
              <div class="asset-list-row" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists" data-attr-data-asset-id="asset.id" data-asset-action="select">
                <span class="asset-col asset-col-name">
                  <span class="asset-list-primary">{{asset.display_name}}</span>
                  <span class="asset-list-secondary">{{asset.display_subtitle}}</span>
                </span>
                <span class="asset-col asset-col-type">{{asset.type_label}}</span>
                <span class="asset-col asset-col-role">{{asset.role_label}}</span>
                <span class="asset-col asset-col-project">{{asset.project_name}}</span>
                <span class="asset-col asset-col-scene">{{asset.scene_name}}</span>
                <span class="asset-col asset-col-run">{{asset.run_name}}</span>
                <span class="asset-col asset-col-size">{{asset.size_label}}</span>
                <span class="asset-col asset-col-modified">{{asset.modified_label}}</span>
                <span class="asset-col asset-col-status">{{asset.status_label}}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="asset-info-panel">
        <div class="asset-info-tabs">
          <div class="asset-info-tab" data-class-is-active="show_info_tab" data-asset-tab="info">Info</div>
          <div class="asset-info-tab" data-class-is-active="show_parameters_tab" data-asset-tab="parameters">Parameters</div>
        </div>

        <div class="asset-info-content">
          <div data-if="show_selection_none">
            <div class="asset-info-empty">
              <span class="asset-info-empty-text">Select an item to view details</span>
            </div>
          </div>

          <div data-if="show_selection_multiple">
            <div class="asset-info-empty">
              <span class="asset-info-empty-text">{{selected_count_text}}</span>
            </div>
          </div>

          <div data-if="show_selection_asset">
            <div class="asset-info-header">
              <span class="asset-info-name">{{selected_asset_name}}</span>
              <span class="asset-info-favorite" data-if="selected_asset_is_favorite">*</span>
              <span data-attr-class="'asset-pill ' + selected_asset_pill_class">{{selected_asset_type_label}}</span>
            </div>

            <div data-if="show_info_tab">
              <div class="asset-info-section">
                <div class="asset-info-section-title">Asset Details</div>
                <div class="parameter-row" data-if="selected_asset_project_name">
                  <span class="parameter-label">Project</span>
                  <span class="parameter-value">{{selected_asset_project_name}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_scene_name">
                  <span class="parameter-label">Scene</span>
                  <span class="parameter-value">{{selected_asset_scene_name}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_run_name">
                  <span class="parameter-label">Run</span>
                  <span class="parameter-value">{{selected_asset_run_name}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Type</span>
                  <span class="parameter-value">{{selected_asset_type}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Role</span>
                  <span class="parameter-value">{{selected_asset_role}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Path</span>
                  <span class="parameter-value asset-path-value">{{selected_asset_path}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Size</span>
                  <span class="parameter-value">{{selected_asset_size}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_points">
                  <span class="parameter-label">Points</span>
                  <span class="parameter-value">{{selected_asset_points}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_resolution">
                  <span class="parameter-label">Resolution</span>
                  <span class="parameter-value">{{selected_asset_resolution}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_duration">
                  <span class="parameter-label">Duration</span>
                  <span class="parameter-value">{{selected_asset_duration}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Created</span>
                  <span class="parameter-value">{{selected_asset_created}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Modified</span>
                  <span class="parameter-value">{{selected_asset_modified}}</span>
                </div>
              </div>

              <div class="asset-info-section" data-if="selected_asset_has_dataset_metadata">
                <div class="asset-info-section-title">Dataset Details</div>
                <div class="parameter-row">
                  <span class="parameter-label">Images</span>
                  <span class="parameter-value">{{selected_asset_dataset_image_count}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Image Root</span>
                  <span class="parameter-value">{{selected_asset_dataset_image_root}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Masks</span>
                  <span class="parameter-value">{{selected_asset_dataset_masks}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Sparse Model</span>
                  <span class="parameter-value">{{selected_asset_dataset_sparse_model}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Cameras</span>
                  <span class="parameter-value">{{selected_asset_dataset_camera_count}}</span>
                </div>
              </div>

              <div class="asset-info-section">
                <div class="asset-info-section-title">Tags</div>
                <div class="asset-info-tags">
                  <div data-for="tag : selected_asset_tags">
                    <div class="asset-info-tag-row">
                      <span class="asset-card-tag">{{tag.value}}</span>
                      <button class="asset-tag-remove" data-event-click="on_remove_tag(tag.value)">Remove</button>
                    </div>
                  </div>
                </div>
                <div class="asset-tag-editor">
                  <input type="text" placeholder="Add tag..." data-value="pending_tag_name" data-event-change="on_pending_tag_change" />
                  <button class="asset-info-button" data-event-click="on_add_tag">Add Tag</button>
                </div>
              </div>

              <div class="asset-info-section" data-if="selected_asset_has_geometry_metadata">
                <div class="asset-info-section-title">Geometry Metadata</div>
                <div class="parameter-row">
                  <span class="parameter-label">Bounding Box</span>
                  <span class="parameter-value">{{selected_asset_bounding_box}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Center</span>
                  <span class="parameter-value">{{selected_asset_center}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Scale</span>
                  <span class="parameter-value">{{selected_asset_scale}}</span>
                </div>
              </div>

              <div class="asset-info-section asset-info-warning" data-if="selected_asset_file_missing">
                <div class="asset-info-section-title">File Not Found</div>
                <div class="parameter-row">
                  <span class="parameter-label">Expected Path</span>
                  <span class="parameter-value">{{selected_asset_expected_path}}</span>
                </div>
                <button class="asset-info-button" data-event-click="on_locate_file">Locate File</button>
              </div>

              <div class="asset-info-section">
                <div class="asset-info-section-title">Actions</div>
                <div class="asset-info-actions">
                  <button class="asset-info-button asset-info-button-primary" data-if="selected_asset_can_load" data-event-click="on_load_selected">Load</button>
                  <button class="asset-info-button is-danger" data-event-click="on_remove_from_catalog">Remove</button>
                </div>
              </div>
            </div>

            <div data-if="show_parameters_tab">
              <div class="asset-info-section" data-if="selected_asset_has_runs">
                <div class="asset-info-section-title">Training Runs</div>
                <div data-for="run : selected_asset_runs">
                  <div class="asset-run-row" data-attr-data-run-id="run.id">
                    <span class="asset-run-name">{{run.name}}</span>
                    <span class="asset-run-status">{{run.status}}</span>
                    <span class="asset-run-summary">{{run.summary}}</span>
                  </div>
                </div>
              </div>

              <div class="asset-info-section" data-if="selected_asset_has_training_provenance">
                <div class="asset-info-section-title">Training Summary</div>
                <div class="parameter-row">
                  <span class="parameter-label">Gaussians</span>
                  <span class="parameter-value">{{selected_asset_gaussian_count}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Images</span>
                  <span class="parameter-value">{{selected_asset_image_count}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">SH Degree</span>
                  <span class="parameter-value">{{selected_asset_sh_degree}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Strategy</span>
                  <span class="parameter-value">{{selected_asset_strategy}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Steps Scaler</span>
                  <span class="parameter-value">{{selected_asset_steps_scaler}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Iterations</span>
                  <span class="parameter-value">{{selected_asset_iterations}}</span>
                </div>
              </div>
              <div class="asset-info-empty" data-if="selected_asset_show_no_training">
                <span class="asset-info-empty-text">No training provenance recorded for this asset</span>
              </div>
            </div>
          </div>

          <div data-if="show_selection_run">
            <div class="asset-info-header">
              <span class="asset-info-name">{{selected_run_name}}</span>
              <span class="asset-pill asset-pill-run">RUN</span>
            </div>

            <div data-if="show_info_tab">
              <div class="asset-info-section">
                <div class="asset-info-section-title">Run Details</div>
                <div class="parameter-row">
                  <span class="parameter-label">Status</span>
                  <span class="parameter-value">{{selected_run_status}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Started</span>
                  <span class="parameter-value">{{selected_run_started}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Completed</span>
                  <span class="parameter-value">{{selected_run_completed}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">Duration</span>
                  <span class="parameter-value">{{selected_run_duration}}</span>
                </div>
              </div>
            </div>

            <div data-if="show_parameters_tab">
              <div class="asset-info-section">
                <div class="asset-info-section-title">Training Summary</div>
                <div data-for="param : selected_run_parameters">
                  <div class="parameter-row">
                    <span class="parameter-label">{{param.name}}</span>
                    <span class="parameter-value">{{param.value}}</span>
                  </div>
                </div>
              </div>

              <div class="asset-info-section">
                <div class="asset-info-section-title">Artifacts</div>
                <div data-for="artifact : selected_run_artifacts">
                  <div class="asset-artifact-row" data-attr-data-asset-id="artifact.id" data-asset-action="artifact">
                    <span class="asset-artifact-name">{{artifact.name}}</span>
                    <span class="asset-artifact-type">{{artifact.type}}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div data-if="show_selection_scene">
            <div class="asset-info-header">
              <span class="asset-info-name">{{selected_scene_name}}</span>
              <span class="asset-pill asset-pill-scene">SCENE</span>
            </div>

            <div class="asset-info-section">
              <div class="asset-info-section-title">Scene Details</div>
              <div class="parameter-row">
                <span class="parameter-label">Project</span>
                <span class="parameter-value">{{selected_scene_project_name}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Assets</span>
                <span class="parameter-value">{{selected_scene_asset_count}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Created</span>
                <span class="parameter-value">{{selected_scene_created}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Modified</span>
                <span class="parameter-value">{{selected_scene_modified}}</span>
              </div>
            </div>

            <div class="asset-info-section">
              <div class="asset-info-section-title">Scene Assets</div>
              <div data-for="scene_asset : selected_scene_assets">
                <div class="asset-artifact-row" data-attr-data-asset-id="scene_asset.id" data-asset-action="scene_asset">
                  <span class="asset-artifact-name">{{scene_asset.name}}</span>
                  <span class="asset-artifact-type">{{scene_asset.type}}</span>
                </div>
              </div>
            </div>
          </div>

          <div data-if="show_selection_project">
            <div class="asset-info-header">
              <span class="asset-info-name">{{selected_project_name}}</span>
              <span class="asset-pill asset-pill-project">PROJECT</span>
            </div>

            <div class="asset-info-section">
              <div class="asset-info-section-title">Project Details</div>
              <div class="parameter-row">
                <span class="parameter-label">Scenes</span>
                <span class="parameter-value">{{selected_project_scene_count}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Total Assets</span>
                <span class="parameter-value">{{selected_project_total_assets}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Path</span>
                <span class="parameter-value">{{selected_project_path}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Created</span>
                <span class="parameter-value">{{selected_project_created}}</span>
              </div>
              <div class="parameter-row">
                <span class="parameter-label">Modified</span>
                <span class="parameter-value">{{selected_project_modified}}</span>
              </div>
            </div>

            <div class="asset-info-section">
              <div class="asset-info-section-title">Scenes</div>
              <div data-for="proj_scene : selected_project_scenes">
                <div class="asset-artifact-row" data-attr-data-scene-id="proj_scene.id">
                  <span class="asset-artifact-name">{{proj_scene.name}}</span>
                  <span class="asset-artifact-type">{{proj_scene.asset_count}}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="asset-popup-footer">
      <div class="asset-batch-summary">
        <span class="asset-batch-title">{{selected_count_text}}</span>
        <span class="asset-batch-subtitle" data-if="has_selection">{{selected_total_text}}</span>
        <span class="asset-batch-subtitle" data-if="!has_selection">Ctrl/Cmd-click cards to select multiple</span>
      </div>
    </div>
  </div>
</body>
</rml>
