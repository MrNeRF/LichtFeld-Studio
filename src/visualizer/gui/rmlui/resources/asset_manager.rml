<rml>
<head>
  <link type="text/template" href="docked_panel.rml"/>
  <link type="text/rcss" href="asset_manager.rcss"/>
</head>

<body template="docked-panel" data-model="asset_manager">
  <div id="asset-floating-header" class="hidden" data-class-hidden="!is_floating">
    <span id="asset-floating-title">{{panel_label}}</span>
    <div class="asset-panel-actions">
      <button class="asset-button asset-button--text asset-panel-action" data-event-click="close_panel"><span class="asset-button-text">{{close_label}}</span></button>
    </div>
  </div>

  <div id="asset-shell" data-class-is-floating="is_floating">
    <div id="asset-popup">
      <div id="asset-popup-toolbar">
        <div class="toolbar-row toolbar-row-primary">
          <div class="asset-search-box">
            <span class="asset-search-icon">{{search_icon_label}}</span>
            <input id="asset-search-input" type="text" placeholder="{{search_placeholder}}" data-value="search_query" />
          </div>

          <button class="asset-button asset-button--text asset-button--primary asset-import-button" data-event-click="on_import_project"><span class="asset-button-text">{{import_project_label}}</span></button>
          <button class="asset-button asset-button--icon gallery-toolbar-button" data-event-click="open_gallery" data-attr-title="gallery_tooltip"><img src="../icon/gallery-cloud.png"/><span class="gallery-count-overlay">{{gallery_overlay}}</span></button>
          <button class="asset-button asset-button--icon asset-panel-close" type="button" data-event-click="close_panel" data-tooltip="common.close"><span class="asset-button-glyph">&#215;</span></button>
        </div>

        <div class="toolbar-row toolbar-row-secondary">
          <button class="asset-button asset-button--text asset-sort-button" data-event-click="cycle_sort_mode">
            <span class="asset-button-text">{{sort_label}}</span>
          </button>

        </div>
      </div>

      <div id="asset-main-row" data-style-min-height="main_min_height">
        <div id="asset-sidebar" data-style-height="sidebar_height">
          <div class="asset-sidebar-inner">
          <div id="asset-sidebar-local-scroll"><div id="asset-sidebar-local-content">
          <div class="asset-sidebar-global">
            <div class="asset-filter-row" data-class-is-active="all_assets_selected" data-folder-id="__all__">
              <span class="asset-row-label">{{all_assets_label}}</span>
              <span class="asset-row-count">{{all_assets_count}}</span>
            </div>
          </div>
          <div class="asset-sidebar-section">
            <div class="asset-sidebar-title" style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;" data-event-click="toggle_folders_collapsed">
              <div style="display: flex; align-items: center; gap: 4dp;">
                <span class="section-arrow" data-class-is-expanded="!folders_collapsed">&#x25B6;</span>
                <span>{{folders_title}}</span>
              </div>
              <button class="asset-button asset-button--small-icon asset-folder-menu" data-event-click="add_asset_folder"><span class="asset-add-folder-glyph">+</span></button>
            </div>
            <div class="section-content collapsed" data-class-collapsed="!folders_expanded">
              <div data-for="folder : folders">
                <div class="asset-filter-row" data-class-is-active="folder.id == selected_folder_id" data-attr-data-folder-id="folder.id">
                  <span class="asset-row-label">{{folder.name}}</span>
                  <div class="asset-folder-row-right">
                    <span class="asset-row-count">{{folder.project_count}}</span>
                    <button class="asset-button asset-button--small-icon asset-folder-menu" data-if="folder.can_manage" data-attr-data-folder-id="folder.id" data-folder-action="menu"><img src="../icon/more-horizontal.png" /></button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          </div></div>
          <div class="asset-sidebar-section" id="asset-sidebar-gallery">
            <div class="asset-sidebar-title gallery-sidebar-heading" data-attr-title="gallery_quota">
              <span>{{g_sidebar_title}}</span>
              <span class="text-muted gallery-account-label" data-if="gallery_signed_in">{{gallery_account}}</span>

              <button class="btn btn--secondary gallery-refresh" data-event-click="gallery_refresh" data-tooltip="asset_manager.gallery.sidebar.refresh">↻</button>
            </div>
            <div class="text-muted gallery-checked">{{gallery_checked}}</div>
            <div class="asset-filter-row" data-class-is-active="selected_folder_id == '__gallery__'" data-folder-id="__gallery__"><span class="asset-row-label">{{g_sidebar_published}}</span><span class="asset-row-count">{{gallery_published_count}}</span></div>
            <div class="asset-filter-row" data-class-is-active="selected_folder_id == '__gallery_attention__'" data-folder-id="__gallery_attention__"><span class="asset-row-label">{{g_sidebar_attention}}</span><span class="asset-row-count">{{gallery_attention_count}}</span></div>
            <div class="asset-filter-row" data-folder-id="__gallery_transfers__"><span class="asset-row-label">{{g_sidebar_transfers}}</span><span class="asset-row-count">{{gallery_transfer_count}}</span></div>
          </div>

          </div>
        </div>

        <div id="sidebar-resize-handle"></div>

      <div id="asset-gallery">
        <div id="asset-results-header" class="asset-gallery-header">
          <div class="asset-gallery-header-row">
            <div class="asset-gallery-header-copy">
              <div class="asset-view-toggle asset-view-toggle-icons">
                <button class="asset-button asset-button--icon asset-view-button asset-view-icon-button" data-class-is-active="is_gallery_view" data-event-click="set_view_mode('gallery')" data-tooltip="asset_manager.gallery.action.grid"><span class="asset-icon-grid"><span></span><span></span><span></span><span></span></span></button>
                <button class="asset-button asset-button--icon asset-view-button asset-view-icon-button" data-class-is-active="is_list_view" data-event-click="set_view_mode('list')" data-tooltip="asset_manager.gallery.action.list"><span class="asset-icon-list"><span></span><span></span><span></span></span></button>
              </div>
              <span class="asset-gallery-subtitle" data-if="asset_results_summary_visible">{{asset_results_summary}}</span>
            </div>

            <div class="asset-gallery-header-actions">
              <button class="btn btn--secondary" data-if="gallery_update_all_visible" data-attr-disabled="!gallery_update_all_enabled" data-event-click="gallery_update_all">{{gallery_update_all_label}}</button>
              <span class="asset-gallery-scan-status" data-if="has_scan_status">{{scan_status}}</span>
              <button class="asset-button asset-button--icon asset-view-button asset-refresh-button" data-class-is-stop="scan_active" data-event-click="refresh_catalog" data-attr-data-tooltip="refresh_action_tooltip"><img data-if="!scan_active" src="../icon/sequencer/rotate-cw.png" /><span class="asset-button-text" data-if="scan_active">{{stop_scan_label}}</span></button>
            </div>
          </div>
          <div class="gallery-completion" data-if="gallery_has_toast">
            <span>{{gallery_toast}}</span>
            <button class="btn btn--secondary" data-if="gallery_toast_portal" data-event-click="gallery_toast_portal">{{g_action_open}}</button>
            <button class="btn btn--secondary" data-if="gallery_toast_portal" data-event-click="gallery_toast_copy">{{g_action_copy}}</button>
            <button class="btn btn--secondary" data-if="gallery_toast_open" data-event-click="gallery_toast_open">{{g_action_open_local}}</button>
          </div>
          <div class="gallery-empty" data-if="gallery_empty">@tr:asset_manager.gallery.empty.published</div>
          <div class="gallery-empty" data-if="gallery_local_empty">
            <button class="btn btn--secondary" data-event-click="add_asset_folder">@tr:asset_manager.action.add_folder</button>
            <span data-if="gallery_empty_pull">@tr:asset_manager.gallery.empty.pull</span>
          </div>
          <div class="asset-gallery-notice" data-if="has_catalog_notice">{{catalog_notice}}</div>
          <div class="asset-gallery-notice" data-if="gallery_has_notice">{{gallery_notice}}</div>
          <div class="gallery-actions">
            <button class="btn btn--secondary" data-if="gallery_has_recovery" data-event-click="gallery_open_recovery">{{g_action_open_recovery}}</button>
            <button class="btn btn--secondary" data-if="gallery_has_undo" data-event-click="gallery_undo">{{g_action_undo}}</button>
          </div>
        </div>

          <div id="asset-gallery-scroll" class="asset-gallery-scroll" tabindex="0">
            <div class="asset-scroll-shell asset-scroll-shell-gallery" data-if="is_gallery_view">
              <div id="asset-card-grid" class="asset-card-grid">
                <div class="asset-virtual-spacer asset-card-top-spacer" data-style-height="asset_gallery_top_spacer_height"></div>
                <div class="asset-card-grid-window">
                  <div class="asset-card-slot" data-style-width="asset_card_slot_width" data-for="asset : assets">
                    <div class="asset-card" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists" data-class-is-draggable="asset.can_load || asset.remote_only" data-attr-data-asset-id="asset.id" data-asset-action="select">
                      <div class="asset-card-thumb asset-thumb-project" data-class-gallery-remote="asset.remote_only" data-style-decorator="asset.thumbnail_decorator">
                        <span class="gallery-stored" data-if="asset.gallery_stored" data-attr-title="asset.gallery_stored_label">✓</span>
                        <span class="gallery-badge" data-attr-class="'gallery-badge ' + asset.gallery_tone" data-attr-title="asset.gallery_tooltip"><img data-attr-src="asset.gallery_icon"/></span>
                        <span class="asset-card-placeholder" data-if="asset.shows_placeholder">{{asset.placeholder_label}}</span>
                      </div>
                      <div class="asset-card-body">
                        <div class="asset-card-title-row">
                          <span class="asset-card-title">{{asset.display_name}}</span>
                        </div>
                        <div class="asset-card-meta">
                          <span>{{asset.gallery_label}}</span>
                          <span data-if="asset.gallery_has_bytes" data-attr-title="asset.gallery_bytes">{{asset.gallery_detail}}</span>
                          <span data-if="!asset.gallery_has_bytes">{{asset.size_label}}</span>
                        </div>
                        <div class="gallery-card-transfer" data-if="asset.gallery_active" data-attr-title="asset.gallery_tooltip">
                          <div class="gallery-progress"><div class="gallery-progress-fill" data-class-is-indeterminate="asset.gallery_indeterminate" data-style-width="asset.gallery_progress_width"></div></div>
                        </div>
                        <div class="asset-card-actions">
                          <button class="btn btn--primary gallery-card-action" data-class-is-persistent="asset.gallery_action_persistent" data-if="asset.gallery_has_action" data-attr-data-asset-id="asset.id" data-asset-action="gallery">{{asset.gallery_action_label}}</button>
                          <button class="btn btn--secondary gallery-file-action" data-if="asset.gallery_can_pause" data-attr-data-asset-id="asset.id" data-asset-action="gallery:pause_transfer">{{g_action_pause}}</button>
                          <button class="btn btn--secondary gallery-file-action" data-if="asset.gallery_can_cancel" data-attr-data-asset-id="asset.id" data-asset-action="gallery:cancel_transfer">{{g_action_cancel}}</button>
                        </div>
                      </div>
                      <button class="asset-button asset-button--small-icon asset-card-menu" data-attr-data-asset-id="asset.id" data-asset-action="menu"><img src="../icon/more-vertical.png" /></button>
                    </div>
                  </div>
                </div>
                <div class="asset-virtual-spacer asset-card-bottom-spacer" data-style-height="asset_gallery_bottom_spacer_height"></div>
              </div>
            </div>

            <div class="asset-scroll-shell asset-scroll-shell-list" data-class-is-wide="asset_list_wide" data-class-show-folder="asset_list_show_folder" data-if="is_list_view">
              <div class="asset-list-header">
                <span class="asset-col asset-col-name">{{col_name_label}}</span>
                <span class="asset-col asset-col-folder">{{col_folder_label}}</span>
                <span class="asset-col asset-col-size">{{col_size_label}}</span>
                <span class="asset-col asset-col-modified">{{col_modified_label}}</span>
                <span class="asset-col asset-col-gallery">{{col_gallery_label}}</span>
              </div>
              <div id="asset-list-view" class="asset-list-view">
                <div class="asset-virtual-spacer asset-list-top-spacer" data-style-height="asset_list_top_spacer_height"></div>
                <div class="asset-list-window">
                  <div data-for="asset : assets">
                    <div class="asset-list-row" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists" data-class-is-draggable="asset.can_load || asset.remote_only" data-attr-data-asset-id="asset.id" data-asset-action="select">
                      <span class="asset-col asset-col-name">
                        <span class="asset-list-primary">{{asset.display_name}}<span class="gallery-stored-list" data-if="asset.gallery_stored" data-attr-title="asset.gallery_stored_label">✓</span></span><span class="asset-list-secondary text-muted" data-attr-title="asset.gallery_tooltip">{{asset.gallery_label}} {{asset.gallery_detail}}</span>
                      </span>
                      <span class="asset-col asset-col-folder">{{asset.folder_name}}</span>
                      <span class="asset-col asset-col-size">{{asset.size_label}}</span>
                      <span class="asset-col asset-col-modified">{{asset.saved_label}}</span>
                      <span class="asset-col asset-col-gallery" data-attr-title="asset.gallery_tooltip">
                        <img class="gallery-list-icon" data-attr-src="asset.gallery_icon" data-attr-class="'gallery-list-icon ' + asset.gallery_tone"/>
                        <span data-if="!asset.gallery_has_controls">{{asset.gallery_label}}</span>
                        <button class="btn btn--secondary gallery-file-action" data-if="asset.gallery_has_action" data-attr-data-asset-id="asset.id" data-asset-action="gallery">{{asset.gallery_action_label}}</button>
                        <button class="btn btn--secondary gallery-file-action" data-if="asset.gallery_can_pause" data-attr-data-asset-id="asset.id" data-asset-action="gallery:pause_transfer" data-attr-title="g_action_pause">Ⅱ</button>
                        <button class="btn btn--secondary gallery-file-action" data-if="asset.gallery_can_cancel" data-attr-data-asset-id="asset.id" data-asset-action="gallery:cancel_transfer" data-attr-title="g_action_cancel">×</button>
                      </span>
                      <div class="gallery-list-progress gallery-progress" data-if="asset.gallery_active"><div class="gallery-progress-fill" data-class-is-indeterminate="asset.gallery_indeterminate" data-style-width="asset.gallery_progress_width"></div></div>
                    </div>
                  </div>
                </div>
                <div class="asset-virtual-spacer asset-list-bottom-spacer" data-style-height="asset_list_bottom_spacer_height"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="bottom-panel-resize-handle" data-event-mousedown="on_bottom_panel_resize_start" data-class-dragging="bottom_panel_resize_dragging"></div>

      <div id="asset-info-panel" data-style-height="bottom_panel_height">
          <div class="asset-info-tabs">
            <div class="asset-info-tab" data-class-is-active="true">{{info_tab_label}}</div>
          </div>

          <div class="asset-info-content">
            <div data-if="show_selection_none">
              <div class="asset-info-empty">
                <span class="asset-info-empty-text">{{select_item_hint}}</span>
              </div>
            </div>

            <div data-if="show_selection_multiple">
              <div class="asset-info-empty">
                <span class="asset-info-empty-text">{{gallery_multi_summary}}</span><button class="btn btn--primary" data-if="gallery_can_publish_many" data-event-click="gallery_publish_many">{{gallery_publish_many}}</button><button class="btn btn--secondary" data-if="gallery_can_update_many" data-event-click="gallery_update_many">{{gallery_update_many}}</button>
              </div>
            </div>

            <div data-if="show_selection_asset">
              <div class="asset-info-header">
                <span class="asset-info-name">{{selected_asset_name}}</span>
              </div>

              <div class="asset-info-section">
                <div class="asset-info-section-title">{{asset_details_title}}</div>
                <div class="parameter-row" data-if="selected_asset_has_folder">
                  <span class="parameter-label">{{prop_folder_label}}</span>
                  <span class="parameter-value">{{selected_asset_folder_name}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">{{prop_size_label}}</span>
                  <span class="parameter-value">{{selected_asset_size}}</span>
                </div>
                <div data-if="gallery_remote">
                  <div class="parameter-row"><span class="parameter-label">{{g_info_format}}</span><span class="parameter-value">{{gallery_selected_format}}</span></div>
                  <div class="parameter-row"><span class="parameter-label">{{g_review_visibility}}</span><span class="parameter-value">{{gallery_selected_visibility}}</span></div>
                  <p class="text-muted">{{g_state_remote_only}}</p>
                </div>
                <div class="parameter-row" data-if="!gallery_remote">
                  <span class="parameter-label">{{prop_path_label}}</span>
                  <span class="parameter-value asset-path-value">{{selected_asset_path}}</span>
                </div>
                <div class="parameter-row" data-if="!gallery_remote">
                  <span class="parameter-label">{{prop_created_label}}</span>
                  <span class="parameter-value">{{selected_asset_created}}</span>
                </div>
                <div class="parameter-row" data-if="!gallery_remote">
                  <span class="parameter-label">{{prop_modified_label}}</span>
                  <span class="parameter-value">{{selected_asset_modified}}</span>
                </div>
              </div>

              <div class="asset-info-section asset-info-warning" data-if="selected_asset_can_locate">
                <div class="asset-info-section-title">{{locate_section_title}}</div>
                <div class="parameter-row">
                  <span class="parameter-label">{{prop_expected_path_label}}</span>
                  <span class="parameter-value">{{selected_asset_expected_path}}</span>
                </div>
                <div class="parameter-row" data-if="selected_asset_has_relocation_candidate">
                  <span class="parameter-label">{{found_at_label}}</span>
                  <span class="parameter-value asset-path-value">{{selected_asset_relocation_candidate}}</span>
                </div>
                <button class="asset-button asset-button--text asset-info-button" data-if="selected_asset_has_relocation_candidate" data-event-click="on_use_found_location"><span class="asset-button-text">{{use_found_location_label}}</span></button>
                <button class="asset-button asset-button--text asset-info-button" data-event-click="on_locate_file"><span class="asset-button-text">{{locate_file_button_label}}</span></button>
              </div>

              <div class="asset-info-section" data-if="!gallery_supported"><p>@tr:asset_manager.gallery.error.portal_version</p></div>
              <div class="asset-info-section" id="asset-info-gallery" data-if="gallery_linked">
                <div class="section-header"><span>{{g_sidebar_title}}</span><span class="text-muted">{{gallery_selected_state}}</span></div>
                <p class="text-muted">{{gallery_exchange_summary}}</p>
              </div>
            </div>

            <div data-if="show_selection_folder">
              <div class="asset-info-header">
                <span class="asset-info-name">{{selected_folder_name}}</span>
              </div>

              <div class="asset-info-section">
                <div class="asset-info-section-title">{{folder_details_title}}</div>
                <div class="parameter-row">
                  <span class="parameter-label">{{prop_path_label}}</span>
                  <span class="parameter-value asset-path-value">{{selected_folder_path}}</span>
                </div>
                <div class="parameter-row">
                  <span class="parameter-label">{{prop_assets_label}}</span>
                  <span class="parameter-value">{{selected_folder_asset_count}}</span>
                </div>
              </div>

          </div>
        </div>
      </div>
    </div>
    <div id="asset-viewport-edge"></div>
  </div>
</body>
</rml>
