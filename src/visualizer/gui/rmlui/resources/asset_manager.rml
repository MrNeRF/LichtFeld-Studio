<rml>
<head>
  <link type="text/template" href="docked_panel.rml"/>
  <link type="text/rcss" href="asset_manager.rcss"/>
</head>

<body template="docked-panel" data-model="asset_manager">
  <div id="asset-floating-header" class="hidden" data-class-hidden="!is_floating">
    <span id="asset-floating-title">{{panel_label}}</span>
    <div class="asset-panel-actions">
      <button class="asset-button asset-button--text asset-panel-action" data-event-click="close_panel">
        <span class="asset-button-text">{{close_label}}</span>
      </button>
    </div>
  </div>

  <div id="asset-shell" class="asset-shell"
       data-class-is-compact="is_compact"
       data-class-is-narrow="is_narrow"
       data-class-is-medium="is_medium"
       data-class-is-wide="is_wide"
       data-class-is-floating="is_floating"
       data-class-inspector-expanded="inspector_expanded">
    <div id="asset-popup">
      <div id="asset-popup-toolbar">
        <div class="toolbar-row toolbar-row-primary">
          <div class="asset-search-box">
            <span class="asset-search-icon">{{search_icon_label}}</span>
            <input id="asset-search-input" type="text" data-attr-placeholder="search_placeholder" data-value="search_query"/>
          </div>
          <button class="asset-button asset-button--text asset-toolbar-filter" data-event-click="open_filter_menu">
            <span class="asset-button-text">{{active_filter_label}}</span>
          </button>
          <button class="asset-button asset-button--text asset-sort-button" data-event-click="cycle_sort_mode">
            <span class="asset-button-text">{{sort_label}}</span>
          </button>
          <button class="asset-button asset-button--text asset-toolbar-view" data-event-click="open_view_menu">
            <span class="asset-button-text">{{view_menu_label}}</span>
          </button>
          <div class="asset-view-toggle asset-view-toggle-icons">
            <button class="asset-button asset-button--icon asset-view-button"
                    data-class-is-active="is_gallery_view"
                    data-event-click="set_view_mode('gallery')"
                    data-tooltip="projects.gallery.action.grid"
                    aria-label="{{view_menu_label}}">
              <span class="asset-icon-grid"><span></span><span></span><span></span><span></span></span>
            </button>
            <button class="asset-button asset-button--icon asset-view-button"
                    data-class-is-active="is_list_view"
                    data-event-click="set_view_mode('list')"
                    data-tooltip="projects.gallery.action.list"
                    aria-label="{{view_menu_label}}">
              <span class="asset-icon-list"><span></span><span></span><span></span></span>
            </button>
          </div>
          <input id="asset-thumbnail-slider" class="asset-thumbnail-slider" type="range" min="112" max="320" step="8"
                 data-value="thumbnail_size" data-tooltip="projects.toolbar.thumbnail_size"
                 aria-label="{{thumbnail_size_label}}"/>
          <button class="asset-button asset-button--text asset-check-gallery"
                  data-event-click="gallery_refresh"
                  data-attr-title="check_gallery_tooltip"
                  aria-label="{{check_gallery_label}}">
            <span class="asset-check-gallery-icon" aria-hidden="true">&#x21BB;</span>
            <span class="asset-button-text">{{check_gallery_label}}</span>
            <span class="gallery-checked">{{gallery_checked}}</span>
          </button>
          <button class="asset-button asset-button--text asset-button--primary asset-import-button"
                  data-event-click="on_import_project" data-attr-title="import_project_tooltip">
            <span class="asset-button-text">{{import_project_label}}</span>
          </button>
          <button class="asset-button asset-button--icon asset-button--toolbar24 asset-add-existing-icon"
                  data-event-click="on_import_project" data-attr-title="import_project_tooltip"
                  data-tooltip="projects.tooltip.add_existing"
                  aria-label="{{import_project_label}}">
            <span class="asset-button-glyph">+</span>
          </button>
          <button class="asset-button asset-button--icon asset-panel-close" type="button"
                  data-event-click="close_panel" data-tooltip="common.close" aria-label="{{close_label}}">
            <span class="asset-button-glyph">&#215;</span>
          </button>
        </div>
      </div>

      <div id="asset-main-row" data-style-min-height="main_min_height">
        <nav id="asset-sidebar" class="asset-navigator" data-style-width="navigator_style_width">
          <div class="asset-navigator-scope">
            <select id="asset-scope-select" data-value="selected_folder_id" aria-label="{{panel_label}}">
              <option value="__all__">{{scope_all_label}}</option>
              <option value="__recent__">{{scope_recent_label}}</option>
              <option value="__gallery__">{{scope_published_label}}</option>
            </select>
          </div>
          <div class="asset-sidebar-inner">
            <div id="asset-sidebar-local-scroll">
              <div id="asset-sidebar-local-content">
                <div class="asset-sidebar-global">
                  <button class="asset-button asset-button--text asset-filter-row" type="button" data-class-is-active="all_assets_selected" data-folder-id="__all__">
                    <span class="asset-row-label">{{scope_all_label}}</span><span class="asset-row-count">{{all_assets_count}}</span>
                  </button>
                  <button class="asset-button asset-button--text asset-filter-row" type="button" data-class-is-active="selected_folder_id == '__recent__'" data-folder-id="__recent__">
                    <span class="asset-row-label">{{scope_recent_label}}</span>
                  </button>
                </div>
                <div class="asset-sidebar-section">
                  <div class="asset-sidebar-title">
                    <button class="asset-button asset-button--text asset-sidebar-title-main" type="button" data-sidebar-action="toggle_folders" data-event-click="toggle_folders_collapsed">
                    <span class="section-arrow" data-class-is-expanded="!folders_collapsed">&#x25B6;</span>
                    <span>{{folders_title}}</span>
                    </button>
                    <button class="asset-button asset-button--small-icon asset-folder-menu"
                            data-event-click="add_asset_folder" data-tooltip="projects.action.add_folder"
                            aria-label="{{import_project_label}}"><span class="asset-add-folder-glyph">+</span></button>
                  </div>
                  <div class="section-content collapsed" data-class-collapsed="!folders_expanded">
                  <div data-for="folder : folders">
                      <div class="asset-filter-row" data-class-is-active="folder.id == selected_folder_id" data-attr-data-folder-id="folder.id">
                        <button class="asset-button asset-button--text asset-row-main" type="button" data-attr-data-folder-id="folder.id">
                        <span class="asset-row-label">{{folder.name}}</span>
                        </button>
                        <div class="asset-folder-row-right">
                          <span class="asset-row-count">{{folder.project_count}}</span>
                          <button class="asset-button asset-button--small-icon asset-folder-menu" data-if="folder.can_manage"
                                  data-attr-data-folder-id="folder.id" data-folder-action="menu"
                                  data-tooltip="common.more" aria-label="{{view_menu_label}}">
                            <img src="../icon/more-horizontal.png"/>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="asset-sidebar-section asset-sidebar-gallery" id="asset-sidebar-gallery">
              <div class="asset-sidebar-title gallery-sidebar-heading" data-attr-title="gallery_quota">
                <span>{{g_sidebar_title}}</span>
                <button class="asset-button asset-button--small-icon gallery-refresh" data-event-click="gallery_refresh"
                        data-tooltip="projects.gallery.sidebar.refresh" aria-label="{{check_gallery_label}}">&#x21BB;</button>
              </div>
              <div class="gallery-account-row">
                <span class="text-muted gallery-account-label" data-if="gallery_signed_in">{{gallery_account}}</span>
                <span class="text-muted gallery-account-label" data-if="!gallery_signed_in">{{g_sidebar_sign_in_hint}}</span>
                <button class="asset-button asset-button--text gallery-sign-in" data-if="!gallery_signed_in"
                        data-event-click="gallery_sign_in"><span class="asset-button-text">{{g_sidebar_sign_in}}</span></button>
              </div>
              <div class="text-muted gallery-checked" data-if="gallery_signed_in">{{gallery_checked}}</div>
              <button class="asset-button asset-button--text asset-filter-row" type="button" data-class-is-active="selected_folder_id == '__gallery__'" data-folder-id="__gallery__">
                <span class="asset-row-label">{{g_sidebar_published}}</span><span class="asset-row-count">{{gallery_published_count}}</span>
              </button>
              <button class="asset-button asset-button--text asset-filter-row" type="button" data-class-is-active="selected_folder_id == '__gallery_attention__'" data-folder-id="__gallery_attention__">
                <span class="asset-row-label">{{g_sidebar_attention}}</span><span class="asset-row-count">{{gallery_attention_count}}</span>
              </button>
            </div>
          </div>
        </nav>
        <div class="asset-resize-handle asset-resize-handle--vertical" data-resize="navigator" tabindex="0" aria-label="{{resize_navigator_label}}"></div>

        <div class="asset-results-stack">
        <section id="asset-gallery">
          <div id="asset-results-header" class="asset-gallery-header">
            <div class="asset-gallery-header-row">
              <div class="asset-gallery-header-copy">
                <span class="asset-gallery-subtitle">{{asset_results_summary}}</span>
                <span class="asset-gallery-empty-search" data-if="asset_search_empty">
                  {{no_search_results_label}} <button class="btn btn--secondary" data-event-click="clear_search">{{clear_search_label}}</button>
                </span>
              </div>
              <div class="asset-gallery-header-actions">
                <span class="asset-gallery-scan-status" data-if="has_scan_status">{{scan_status}}</span>
                <button class="asset-button asset-button--icon asset-view-button asset-refresh-button"
                        data-class-is-stop="scan_active" data-event-click="refresh_catalog"
                        data-attr-data-tooltip="refresh_action_tooltip" aria-label="{{refresh_action_tooltip}}">
                  <span class="asset-refresh-glyph" data-if="!scan_active">&#x21BB;</span>
                  <span class="asset-button-text" data-if="scan_active">{{stop_scan_label}}</span>
                </button>
              </div>
            </div>
            <div class="gallery-completion" data-if="gallery_has_toast">
              <span>{{gallery_toast}}</span>
              <button class="btn btn--secondary" data-if="gallery_toast_portal" data-event-click="gallery_toast_portal">{{g_action_open}}</button>
              <button class="btn btn--secondary" data-if="gallery_toast_portal" data-event-click="gallery_toast_copy">{{g_action_copy}}</button>
              <button class="btn btn--secondary" data-if="gallery_toast_open" data-event-click="gallery_toast_open">{{g_action_open_local}}</button>
            </div>
            <div class="asset-gallery-notice" data-if="has_catalog_notice">{{catalog_notice}}</div>
            <div class="asset-gallery-notice" data-if="gallery_has_notice">{{gallery_notice}}</div>
            <div class="gallery-empty" data-if="no_folders">{{no_folders_label}} <button class="btn btn--secondary" data-event-click="add_asset_folder">@tr:projects.action.add_folder</button></div>
            <div class="gallery-empty" data-if="empty_folder">{{empty_folder_label}}</div>
            <div class="gallery-empty" data-if="gallery_empty">@tr:projects.gallery.empty.published</div>
            <div class="gallery-empty" data-if="gallery_local_empty"><button class="btn btn--secondary" data-event-click="add_asset_folder">@tr:projects.action.add_folder</button></div>
          </div>
          <div class="asset-list-header" data-if="is_list_view"
               data-class-is-wide="asset_list_wide"
               data-class-show-folder="asset_list_show_folder"
               data-class-gallery-compact="asset_list_gallery_compact">
            <span class="asset-list-thumb asset-list-header-spacer" aria-hidden="true"></span>
            <span class="asset-col asset-col-name" data-style-width="asset_list_name_width"><span class="asset-list-header-label">{{col_name_label}}</span><span class="asset-list-column-handle" data-resize="list-column:name"></span></span>
            <span class="asset-col asset-col-gallery" data-style-width="asset_list_gallery_width"><span class="asset-list-header-label">{{col_gallery_label}}</span><span class="asset-list-column-handle" data-resize="list-column:gallery"></span></span>
            <span class="asset-col asset-col-size" data-style-width="asset_list_size_width"><span class="asset-list-header-label">{{col_size_label}}</span><span class="asset-list-column-handle" data-resize="list-column:size"></span></span>
            <span class="asset-col asset-col-modified" data-style-width="asset_list_modified_width"><span class="asset-list-header-label">{{col_modified_label}}</span><span class="asset-list-column-handle" data-resize="list-column:modified"></span></span>
            <span class="asset-col asset-col-folder" data-style-width="asset_list_folder_width"><span class="asset-list-header-label">{{col_folder_label}}</span><span class="asset-list-column-handle" data-resize="list-column:folder"></span></span>
          </div>

          <div id="asset-gallery-scroll" class="asset-gallery-scroll" tabindex="0">
            <div class="asset-scroll-shell asset-scroll-shell-gallery" data-if="is_gallery_view">
              <div id="asset-card-grid" class="asset-card-grid">
                <div class="asset-virtual-spacer asset-card-top-spacer" data-style-height="asset_gallery_top_spacer_height"></div>
                <div class="asset-card-grid-window">
                  <div class="asset-card-slot" data-style-width="asset_card_slot_width" data-for="asset : assets">
                    <div class="asset-card" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists"
                         data-class-is-draggable="asset.can_load || asset.remote_only" data-attr-data-asset-id="asset.id" data-asset-action="select">
                      <div class="asset-card-thumb asset-thumb-project" data-class-gallery-remote="asset.remote_only"
                           data-style-decorator="asset.thumbnail_decorator" data-style-height="asset_card_thumbnail_height">
                        <span class="gallery-badge" data-if="asset.gallery_has_badge" data-attr-class="'gallery-badge ' + asset.gallery_tone"
                              data-attr-title="asset.gallery_tooltip"><img data-attr-src="asset.gallery_icon"/></span>
                        <span class="asset-card-placeholder" data-if="asset.shows_placeholder">{{asset.placeholder_label}}</span>
                      </div>
                      <div class="asset-card-body">
                        <div class="asset-card-title-row"><span class="asset-card-title" data-attr-title="asset.display_name">{{asset.display_name}}</span></div>
                        <div class="asset-card-meta">
                          <span data-if="asset.gallery_has_bytes" data-attr-title="asset.gallery_bytes">{{asset.gallery_detail}}</span>
                          <span data-if="!asset.gallery_has_bytes">{{asset.size_label}}</span>
                          <span data-if="!asset.has_problem">{{asset.gallery_label}}</span>
                          <span data-if="asset.has_problem">{{asset.health_label}}</span>
                        </div>
                        <div class="gallery-card-transfer" data-if="asset.gallery_active" data-attr-title="asset.gallery_tooltip">
                          <div class="gallery-progress"><div class="gallery-progress-fill" data-class-is-indeterminate="asset.gallery_indeterminate" data-style-width="asset.gallery_progress_width"></div></div>
                        </div>
                      </div>
                      <button class="asset-button asset-button--small-icon asset-card-menu" data-attr-data-asset-id="asset.id"
                              data-asset-action="menu" data-tooltip="common.more" aria-label="{{view_menu_label}}">
                        <img src="../icon/more-vertical.png"/>
                      </button>
                    </div>
                  </div>
                </div>
                <div class="asset-virtual-spacer asset-card-bottom-spacer" data-style-height="asset_gallery_bottom_spacer_height"></div>
              </div>
            </div>
            <div class="asset-scroll-shell asset-scroll-shell-list" data-if="is_list_view"
                 data-class-is-wide="asset_list_wide"
                 data-class-show-folder="asset_list_show_folder"
                 data-class-gallery-compact="asset_list_gallery_compact">
              <div id="asset-list-view" class="asset-list-view">
                <div class="asset-virtual-spacer asset-list-top-spacer" data-style-height="asset_list_top_spacer_height"></div>
                <div class="asset-list-window">
                  <div data-for="asset : assets">
                    <div class="asset-list-row" data-class-is-selected="asset.is_selected" data-class-is-missing="!asset.exists"
                         data-class-is-draggable="asset.can_load || asset.remote_only" data-attr-data-asset-id="asset.id" data-asset-action="select">
                      <div class="asset-list-thumb asset-thumb-project" data-style-decorator="asset.thumbnail_decorator">
                        <span class="asset-card-placeholder" data-if="asset.shows_placeholder">{{asset.placeholder_label}}</span>
                      </div>
                      <span class="asset-col asset-col-name" data-style-width="asset_list_name_width">
                        <span class="asset-list-primary" data-attr-title="asset.display_name">{{asset.display_name}}</span>
                        <span class="asset-list-secondary text-muted" data-attr-title="asset.gallery_tooltip">{{asset.gallery_label}}</span>
                      </span>
                      <span class="asset-col asset-col-gallery" data-style-width="asset_list_gallery_width" data-attr-title="asset.gallery_tooltip">
                        <img class="gallery-list-icon" data-if="asset.gallery_has_badge" data-attr-src="asset.gallery_icon"
                             data-attr-class="'gallery-list-icon ' + asset.gallery_tone"/>
                        <span data-if="!asset.has_problem">{{asset.gallery_label}}</span><span data-if="asset.has_problem">{{asset.health_label}}</span>
                      </span>
                      <span class="asset-col asset-col-size" data-style-width="asset_list_size_width">{{asset.size_label}}</span>
                      <span class="asset-col asset-col-modified" data-style-width="asset_list_modified_width">{{asset.saved_label}}</span>
                      <span class="asset-col asset-col-folder" data-style-width="asset_list_folder_width">{{asset.folder_name}}</span>
                      <div class="gallery-list-progress gallery-progress" data-if="asset.gallery_active">
                        <div class="gallery-progress-fill" data-class-is-indeterminate="asset.gallery_indeterminate" data-style-width="asset.gallery_progress_width"></div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="asset-virtual-spacer asset-list-bottom-spacer" data-style-height="asset_list_bottom_spacer_height"></div>
              </div>
            </div>
          </div>
        </section>

        <div class="asset-resize-handle asset-resize-handle--vertical inspector-resize-handle" data-resize="inspector"
             tabindex="0" aria-label="{{resize_inspector_label}}"></div>
        <aside id="asset-inspector" class="asset-inspector" data-style-width="inspector_style_width" data-style-height="inspector_style_height">
          <div class="inspector-strip" data-event-click="toggle_inspector">
            <span class="inspector-strip-name" data-attr-title="selected_asset_name">{{selected_asset_name}}</span>
            <span class="inspector-strip-meta" data-if="show_selection_asset">{{selected_asset_size}}</span>
            <span class="inspector-strip-meta" data-if="show_selection_asset">{{selected_health_label}}</span>
            <button class="btn btn--primary inspector-strip-open" data-if="show_selection_asset"
                    data-attr-data-asset-id="selected_asset_id" data-event-click="on_load_asset">{{open_button_label}}</button>
          </div>
          <div class="asset-resize-handle asset-resize-handle--horizontal" data-resize="inspector-height"
               tabindex="0" aria-label="{{resize_inspector_height_label}}"></div>
          <div id="asset-inspector-content" class="asset-inspector-content">
            <div class="asset-info-empty" data-if="show_selection_none">{{select_item_hint}}</div>
            <div class="asset-info-empty inspector-multi" data-if="show_selection_multiple">
              {{gallery_multi_summary}}
              <button class="btn btn--primary" data-if="gallery_can_publish_many" data-event-click="gallery_publish_many">{{gallery_publish_many}}</button>
              <button class="btn btn--secondary" data-if="gallery_can_update_many" data-event-click="gallery_update_many">{{gallery_update_many}}</button>
            </div>
            <div data-if="show_selection_asset">
              <div class="asset-info-asset-layout">
                <div class="asset-info-details">
                  <div class="inspector-header asset-info-header">
                    <span class="inspector-title">{{selected_asset_name}}</span>
                    <span class="inspector-path" data-attr-title="selected_asset_path">{{selected_asset_path}}</span>
                    <div class="inspector-actions"><button class="btn btn--primary" data-attr-data-asset-id="selected_asset_id" data-event-click="on_load_asset">{{open_button_label}}</button></div>
                  </div>
                  <div class="inspector-section inspector-problem" data-if="selected_has_problem">
                    <div class="inspector-section-title">{{problem_title}}</div>
                    <div class="parameter-row"><span class="parameter-label">{{selected_health_label}}</span><span class="parameter-value">{{selected_fix_label}}</span></div>
                    <button class="btn btn--secondary" data-if="selected_asset_can_locate" data-event-click="on_locate_file">{{locate_file_button_label}}</button>
                  </div>
                  <div class="inspector-section"><div class="inspector-section-title">{{project_section_title}}</div>
                    <div class="parameter-row" data-if="selected_asset_has_folder"><span class="parameter-label">{{prop_folder_label}}</span><span class="parameter-value">{{selected_asset_folder_name}}</span></div>
                    <div class="parameter-row"><span class="parameter-label">{{prop_size_label}}</span><span class="parameter-value">{{selected_asset_size}}</span></div>
                    <div class="parameter-row"><span class="parameter-label">{{prop_modified_label}}</span><span class="parameter-value">{{selected_asset_modified}}</span></div>
                  </div>
                  <div class="inspector-section" data-if="gallery_linked"><div class="inspector-section-title">{{gallery_section_title}}</div>
                    <div class="parameter-row"><span class="parameter-label">{{g_sidebar_title}}</span><span class="parameter-value">{{gallery_selected_state}}</span></div>
                    <p class="text-muted">{{gallery_exchange_summary}}</p>
                  </div>
                  <div class="inspector-section"><div class="inspector-section-title">{{file_section_title}}</div>
                    <div class="parameter-row"><span class="parameter-label">{{prop_path_label}}</span><span class="parameter-value inspector-ellipsis" data-attr-title="selected_asset_path">{{selected_asset_path}}</span></div>
                    <div class="parameter-row" data-if="selected_asset_can_locate"><span class="parameter-label">{{prop_expected_path_label}}</span><span class="parameter-value inspector-ellipsis">{{selected_asset_expected_path}}</span></div>
                  </div>
                  <div class="inspector-section"><div class="inspector-section-title">{{operations_section_title}}</div>
                    <div class="inspector-operations"><span class="inspector-history-empty text-muted" data-tooltip="projects.action.save_history">@tr:projects.action.save_history</span></div>
                  </div>
                </div>
              </div>
            </div>
            <div data-if="show_selection_folder">
              <div class="inspector-header"><span class="inspector-title">{{selected_folder_name}}</span><span class="inspector-path">{{selected_folder_path}}</span></div>
              <div class="inspector-section"><div class="inspector-section-title">{{folder_details_title}}</div>
                <div class="parameter-row"><span class="parameter-label">{{prop_assets_label}}</span><span class="parameter-value">{{selected_folder_asset_count}}</span></div>
              </div>
            </div>
          </div>
        </aside>
        </div>
      </div>

      <div class="asset-quick-look" data-if="quick_look_visible">
        <div class="asset-quick-look-card">
          <div class="asset-quick-look-heading">
            <span class="inspector-title">{{selected_asset_name}}</span>
            <button class="asset-button asset-button--small-icon" data-event-click="close_quick_look"
                    data-tooltip="common.close" aria-label="{{close_label}}">&#215;</button>
          </div>
          <div class="asset-quick-look-thumb asset-thumb-project"
               data-style-decorator="quick_look_thumbnail">
            <span class="asset-card-placeholder" data-if="!quick_look_has_thumbnail">{{quick_look_placeholder}}</span>
          </div>
          <div class="asset-quick-look-facts">
            <span>{{selected_asset_size}}</span><span>{{selected_asset_modified}}</span>
            <span class="text-muted" data-attr-title="selected_asset_path">{{selected_asset_path}}</span>
          </div>
        </div>
      </div>

      <div class="asset-tray" data-if="has_gallery_transfers" data-style-height="tray_height">
        <div class="asset-tray-heading"><span class="asset-tray-label">{{g_sidebar_transfers}}</span><span class="asset-tray-detail">{{gallery_tooltip}}</span></div>
        <div class="asset-tray-list">
          <div class="asset-tray-row" data-for="transfer : transfer_rows">
            <span class="asset-tray-direction">{{transfer.direction}}</span>
            <span class="asset-tray-title" data-attr-title="transfer.title">{{transfer.title}}</span>
            <span class="asset-tray-phase">{{transfer.phase}}</span>
            <span class="asset-tray-bytes">{{transfer.bytes}}</span>
            <div class="asset-tray-progress"><span data-style-width="transfer.progress_width"></span></div>
            <div class="asset-tray-actions">
              <button class="btn btn--secondary" data-if="transfer.can_pause" data-event-click="transfer_pause(transfer.id)">{{g_action_pause}}</button>
              <button class="btn btn--secondary" data-if="transfer.can_resume" data-event-click="transfer_resume(transfer.id)">{{g_action_resume}}</button>
              <button class="btn btn--secondary" data-if="transfer.can_cancel" data-event-click="transfer_cancel(transfer.id)">{{g_action_cancel}}</button>
            </div>
          </div>
        </div>
        <div id="asset-tray-resize-handle" class="asset-resize-handle asset-resize-handle--horizontal" data-resize="tray" tabindex="0" aria-label="{{resize_transfers_tray_label}}"></div>
      </div>
    </div>
  </div>
</body>
</rml>
