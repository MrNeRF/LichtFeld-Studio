            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
                   data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
                   data-event-change="pv_change(row.id, ev.value)"
                   data-event-blur="pv_blur(row.id, row.text)"
                   data-event-escapecancel="pv_escape(row.id)" />
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>
          <div class="setting-row" data-for="row : pv_refinement_igs_rows" data-if="dep_igs"
               data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-if="row.kind == 'number'"
                   data-pv-input="1" data-value="row.text" data-attr-data-pv-id="row.id"
                   data-event-focus="pv_focus(row.id)"
                   data-event-change="pv_change(row.id, ev.value)"
                   data-event-blur="pv_blur(row.id, row.text)"
                   data-event-escapecancel="pv_escape(row.id)" />
            <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
                   data-event-click="pv_value_change(row.id, !row.checked)" />
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bilateral Grid subsection (conditional) -->

    <!-- Losses subsection -->
    <div class="training-subsection" data-if="pv_section_losses_visible">
      <div class="section-header text-accent" id="hdr-losses" data-event-click="toggle_section('losses')">
        <span class="section-arrow text-accent" id="arrow-losses">&#x25B6;</span>
        <span class="text-accent">{{pv_header_losses}}</span>
      </div>
      <div class="section-content collapsed" id="sec-losses">
        <div data-class-disabled-overlay="adv_disabled">
          <div class="setting-row" data-tooltip="training.tooltip.lambda_dssim" data-if="pv_show_lambda_dssim">
            <span class="prop-label">{{label_lambda_dssim}}</span>
            <input type="range" class="setting-slider" data-value="lambda_dssim" min="0" max="1" step="0.01" />
            <span class="slider-value">{{lambda_dssim | format_float(3)}}</span>
          </div>
          <div class="setting-row" data-for="row : pv_loss_numbers_rows"
               data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
                   data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
                   data-event-change="pv_change(row.id, ev.value)"
                   data-event-blur="pv_blur(row.id, row.text)"
                   data-event-escapecancel="pv_escape(row.id)" />
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Initialization subsection -->
    <div class="training-subsection" data-if="pv_section_init_visible">
      <div class="section-header text-accent" id="hdr-init" data-event-click="toggle_section('init')">
        <span class="section-arrow text-accent" id="arrow-init">&#x25B6;</span>
        <span class="text-accent">{{pv_header_init}}</span>
      </div>
      <div class="section-content collapsed" id="sec-init">
        <div data-class-disabled-overlay="adv_disabled">
          <div class="setting-row" data-tooltip="training.tooltip.init_opacity" data-if="pv_show_init_opacity">
            <span class="prop-label">{{label_init_opacity}}</span>
            <input type="range" class="setting-slider" data-value="init_opacity" min="0.01" max="1" step="0.01" />
            <span class="slider-value">{{init_opacity | format_float(3)}}</span>
          </div>
          <div class="setting-row" data-for="row : pv_init_main_rows"
               data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-if="row.kind == 'number'"
                   data-pv-input="1" data-value="row.text" data-attr-data-pv-id="row.id"
                   data-event-focus="pv_focus(row.id)"
                   data-event-change="pv_change(row.id, ev.value)"
                   data-event-blur="pv_blur(row.id, row.text)"
                   data-event-escapecancel="pv_escape(row.id)" />
            <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
                   data-event-click="pv_value_change(row.id, !row.checked)" />
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>

        </div>
      </div>
    </div>

    <!-- Random initialization parameters -->
<div class="training-panel-block" data-if="pv_section_random_init_visible &amp;&amp; (dep_random)">
<div class="section-header text-accent" id="hdr-random-init" data-event-click="toggle_section('random_init')"><span class="section-arrow" id="arrow-random-init">&#x25BC;</span><span>{{pv_header_random_init}}</span></div>
<div class="section-content" id="sec-random-init"><div data-class-disabled-overlay="live_disabled">
<div data-class-disabled-overlay="adv_disabled">          <div data-if="dep_random">
            <div class="setting-row" data-for="row : pv_init_random_rows"
                 data-attr-data-tooltip="row.tooltip_key">
              <span class="prop-label">{{row.label}}</span>
              <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
                     data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
                     data-event-change="pv_change(row.id, ev.value)"
                     data-event-blur="pv_blur(row.id, row.text)"
                     data-event-escapecancel="pv_escape(row.id)" />
              <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
              <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
            </div></div></div>
</div></div></div>
    <div class="training-subsection" data-if="pv_section_sparsity_visible &amp;&amp; dep_sparsity">
      <div class="section-header text-accent" id="hdr-sparsity" data-event-click="toggle_section('sparsity')">
        <span class="section-arrow text-accent" id="arrow-sparsity">&#x25B6;</span>
        <span class="text-accent">{{pv_header_sparsity}}</span>
      </div>
      <div class="section-content collapsed" id="sec-sparsity">
      <div data-class-disabled-overlay="adv_disabled">

<div data-if="dep_sparsity">
        <div class="setting-row" data-for="row : pv_sparsity_rows"
             data-attr-data-tooltip="row.tooltip_key">
          <span class="prop-label">{{row.label}}</span>
          <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
                 data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
                 data-event-change="pv_change(row.id, ev.value)"
                 data-event-blur="pv_blur(row.id, row.text)"
                 data-event-escapecancel="pv_escape(row.id)" />
          <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
          <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
        </div>
        <div class="setting-row" data-tooltip="training.tooltip.prune_ratio" data-if="pv_show_prune_ratio">
          <span class="prop-label">{{label_prune_ratio}}</span>
          <input type="range" class="setting-slider" data-value="prune_ratio" min="0" max="1" step="0.01" />
          <span class="slider-value">{{prune_ratio | format_float(3)}}</span>
        </div>
      </div>
    </div>
</div>

      </div>

    <!-- Save Steps subsection -->
    <div class="training-subsection" data-if="pv_show_save_steps">
      <div class="section-header text-accent" id="hdr-save-steps" data-event-click="toggle_section('save_steps')" data-tooltip="training.tooltip.save_steps">
        <span class="section-arrow text-accent" id="arrow-save-steps">&#x25B6;</span>
        <span class="text-accent">{{pv_header_save_steps}}</span>
      </div>
      <div class="section-content collapsed" id="sec-save-steps">
        <div data-if="save_edit_mode">
          <div class="setting-row" data-tooltip="training.tooltip.save_step_input">
            <input type="text" id="num-new_step" class="number-input" data-value="new_step_str" />
            <button class="num-step-btn" data-event-mousedown="num_step('new_step', -1)">-</button>
            <button class="num-step-btn" data-event-mousedown="num_step('new_step', 1)">+</button>
            <button class="btn btn--secondary" data-tooltip="training.tooltip.save_step_add" data-event-click="action('add_step')">{{label_add}}</button>
          </div>
          <div class="separator"></div>
          <div data-for="step : save_steps_list">
            <div class="setting-row">
              <span class="number-input">{{step}}</span>
              <button class="btn btn--secondary" data-tooltip="training.tooltip.save_step_remove" data-event-click="remove_step(it_index)">{{label_remove}}</button>
            </div>
          </div>
          <span class="status-text status-muted" data-if="no_save_steps">{{label_no_save_steps}}</span>
        </div>
        <div data-if="save_readonly_mode">
          <span class="status-text status-info" data-if="has_save_steps">{{save_steps_display}}</span>
          <span class="status-text status-muted" data-if="no_save_steps_ro">{{label_no_save_steps}}</span>
        </div>
      </div>
    </div>

    <!-- Auto-placed registry parameters -->
    <div class="training-subsection" data-if="pv_section_advanced_registry_visible">
      <div class="section-header text-accent" id="hdr-advanced-registry" data-event-click="toggle_section('advanced_registry')">
        <span class="section-arrow text-accent" id="arrow-advanced-registry">&#x25B6;</span>
        <span class="text-accent">{{pv_header_advanced_registry}}</span>
      </div>
      <div class="section-content collapsed" id="sec-advanced-registry">
        <div data-class-disabled-overlay="adv_disabled">
          <div class="setting-row" data-for="row : pv_advanced_registry_rows"
               data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-if="row.kind == 'number'"
                   data-pv-input="1" data-value="row.text" data-attr-data-pv-id="row.id"
                   data-event-focus="pv_focus(row.id)"
                   data-event-change="pv_change(row.id, ev.value)"
                   data-event-blur="pv_blur(row.id, row.text)"
                   data-event-escapecancel="pv_escape(row.id)" />
            <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
                   data-event-click="pv_value_change(row.id, !row.checked)" />
            <select data-if="row.kind == 'select'" data-value="row.value"
                    data-event-change="pv_value_change(row.id, ev.value)">
              <option data-for="item : pv_advanced_registry_options" data-if="item.prop_id == row.id"
                      data-attr-value="item.value" data-attr-data-tooltip="item.tooltip_key">{{item.label}}</option>
            </select>
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  </div><!-- /training-scroll-region -->

  <div id="color-picker-popup" class="color-picker-popup">
    <color-picker id="color-picker-el"
      data-attr-red="picker_r" data-attr-green="picker_g" data-attr-blue="picker_b"
      data-event-change="picker_change" />
    <div class="color-popup-fields">
      <div class="color-rgb-row">
        <input type="text" class="color-channel" data-value="bg_color_r" />
        <input type="text" class="color-channel" data-value="bg_color_g" />
        <input type="text" class="color-channel" data-value="bg_color_b" />
      </div>
    </div>
  </div>

  </div>
</body>
</rml>
