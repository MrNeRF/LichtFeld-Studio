<rml>
<head>
  <link type="text/template" href="docked_panel.rml"/>
  <link type="text/rcss" href="training.rcss"/>
</head>
<body template="docked-panel" data-model="training">

  <!-- No trainer / no params messages -->
  <span class="status-text status-muted" data-if="show_no_trainer">{{label_no_trainer}}</span>
  <span class="status-text status-muted" data-if="show_no_params">{{label_no_params}}</span>

  <div class="training-panel-layout" data-if="show_main">

  <!-- ── Controls ──────────────────────────────────────── -->
  <div id="controls">
    <div id="training-toolbar-measure" aria-hidden="true">
      <span id="measure-start" class="btn training-toolbar-action training-toolbar-action--primary"><img src="../icon/sequencer/play.png" /><span>{{btn_start}}</span></span>
      <span id="measure-pause" class="btn training-toolbar-action training-toolbar-action--primary"><img src="../icon/sequencer/pause.png" /><span>{{label_pause}}</span></span>
      <span id="measure-resume" class="btn training-toolbar-action training-toolbar-action--primary"><img src="../icon/sequencer/play.png" /><span>{{label_resume}}</span></span>
      <span id="measure-switch_edit" class="btn training-toolbar-action training-toolbar-action--primary"><img src="../icon/adjustments.png" /><span>{{label_toolbar_edit}}</span></span>
      <span id="measure-reset" class="btn training-toolbar-action"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></span>
      <span id="measure-stop" class="btn training-toolbar-action"><img src="../icon/sequencer/stop.png" /><span>{{label_toolbar_stop}}</span></span>
      <span id="measure-clear" class="btn training-toolbar-action"><img src="../icon/scene/trash.png" /><span>{{label_clear}}</span></span>
      <span id="measure-save_project" class="btn training-toolbar-action training-toolbar-action--save"><img src="../icon/archive.png" /><span>{{label_toolbar_save}}</span></span>
      <span id="measure-action-gap"></span><span id="measure-status-gap"></span>
    </div>
    <div id="training-toolbar" class="training-toolbar">

    <div class="training-actions-group" data-if="show_ctrl_ready">

      <div class="training-action-row">
        <button class="btn btn--success training-toolbar-action training-toolbar-action--primary" data-attrif-disabled="start_blocked" data-attr-aria-label="btn_start" data-tooltip="training.tooltip.btn_start" data-event-click="action('start')"><img src="../icon/sequencer/play.png" /><span>{{btn_start}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_reset" data-if="show_reset_ready" data-attr-aria-label="label_reset" data-attr-title="label_reset" data-event-click="action('reset')"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_clear" data-attr-aria-label="label_clear" data-attr-title="label_clear" data-event-click="action('clear')"><img src="../icon/scene/trash.png" /><span>{{label_clear}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_starting">
      <div class="training-action-row">
        <button class="btn btn--warning training-toolbar-action training-toolbar-action--primary" data-attr-aria-label="label_pause" data-tooltip="training.tooltip.btn_pause" data-event-click="action('pause')"><img src="../icon/sequencer/pause.png" /><span>{{label_pause}}</span></button>
        <button class="btn btn--error training-toolbar-action" data-tooltip="training.tooltip.btn_stop" data-attr-aria-label="label_stop" data-attr-title="label_stop" data-event-click="action('stop')"><img src="../icon/sequencer/stop.png" /><span>{{label_toolbar_stop}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_running">
      <div class="training-action-row">
        <button class="btn btn--warning training-toolbar-action training-toolbar-action--primary" data-attr-aria-label="label_pause" data-tooltip="training.tooltip.btn_pause" data-event-click="action('pause')"><img src="../icon/sequencer/pause.png" /><span>{{label_pause}}</span></button>
        <button class="btn btn--primary training-toolbar-action training-toolbar-action--save" data-attr-aria-label="label_toolbar_save" data-tooltip="training.tooltip.btn_save_project" data-if="show_project_save" data-event-click="action('save_project')"><img src="../icon/archive.png" /><span>{{label_toolbar_save}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_paused">
      <div class="training-action-row">
        <button class="btn btn--success training-toolbar-action training-toolbar-action--primary" data-attr-aria-label="label_resume" data-tooltip="training.tooltip.btn_resume" data-event-click="action('resume')"><img src="../icon/sequencer/play.png" /><span>{{label_resume}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_reset" data-attr-aria-label="label_reset" data-attr-title="label_reset" data-event-click="action('reset')"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></button>
        <button class="btn btn--error training-toolbar-action" data-tooltip="training.tooltip.btn_stop" data-attr-aria-label="label_stop" data-attr-title="label_stop" data-event-click="action('stop')"><img src="../icon/sequencer/stop.png" /><span>{{label_toolbar_stop}}</span></button>
        <button class="btn btn--primary training-toolbar-action training-toolbar-action--save" data-attr-aria-label="label_toolbar_save" data-tooltip="training.tooltip.btn_save_project" data-if="show_project_save" data-event-click="action('save_project')"><img src="../icon/archive.png" /><span>{{label_toolbar_save}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_completed">
      <div class="training-action-row">
        <button class="btn btn--success training-toolbar-action training-toolbar-action--primary" data-attr-aria-label="label_toolbar_edit" data-tooltip="training.tooltip.btn_switch_edit" data-event-click="action('switch_edit')"><img src="../icon/adjustments.png" /><span>{{label_toolbar_edit}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_reset" data-attr-aria-label="label_reset" data-attr-title="label_reset" data-event-click="action('reset')"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_clear" data-attr-aria-label="label_clear" data-attr-title="label_clear" data-event-click="action('clear')"><img src="../icon/scene/trash.png" /><span>{{label_clear}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_stopped">
      <div class="training-action-row">
        <button class="btn btn--success training-toolbar-action training-toolbar-action--primary" data-attr-aria-label="label_toolbar_edit" data-tooltip="training.tooltip.btn_switch_edit" data-event-click="action('switch_edit')"><img src="../icon/adjustments.png" /><span>{{label_toolbar_edit}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_reset" data-attr-aria-label="label_reset" data-attr-title="label_reset" data-event-click="action('reset')"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_clear" data-attr-aria-label="label_clear" data-attr-title="label_clear" data-event-click="action('clear')"><img src="../icon/scene/trash.png" /><span>{{label_clear}}</span></button>
      </div>
    </div>
    <div class="training-actions-group" data-if="show_ctrl_error">
      <div class="training-action-row">
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_reset" data-attr-aria-label="label_reset" data-attr-title="label_reset" data-event-click="action('reset')"><img src="../icon/reset.png" /><span>{{label_toolbar_reset}}</span></button>
        <button class="btn btn--secondary training-toolbar-action" data-tooltip="training.tooltip.btn_clear" data-attr-aria-label="label_clear" data-attr-title="label_clear" data-event-click="action('clear')"><img src="../icon/scene/trash.png" /><span>{{label_clear}}</span></button>
      </div>
    </div>
<div id="training-controls-header">
      <span class="training-status-badge is-ready" data-if="show_ctrl_ready"><span class="training-status-badge-label">@tr:status.ready</span></span>
      <span class="training-status-badge is-active" data-if="show_ctrl_starting"><span class="training-status-badge-label">@tr:runtime.task_starting</span></span>
      <span class="training-status-badge is-active" data-if="show_ctrl_running"><span class="training-status-badge-label">@tr:training_panel.running</span></span>
      <span class="training-status-badge is-paused" data-if="show_ctrl_paused"><span class="training-status-badge-label">@tr:status.paused</span></span>
      <span class="training-status-badge is-complete" data-if="show_ctrl_completed"><span class="training-status-badge-label">@tr:status.complete</span></span>
      <span class="training-status-badge is-complete" data-if="show_ctrl_stopped"><span class="training-status-badge-label">@tr:status.stopped</span></span>
      <span class="training-status-badge is-error" data-if="show_ctrl_error"><span class="training-status-badge-label">@tr:status.error</span></span>
      <span class="training-status-badge is-active" data-if="show_ctrl_stopping"><span class="training-status-badge-label">@tr:status.stopping</span></span>
      <span class="training-status-badge is-active" data-if="show_ctrl_saving"><span class="training-status-badge-label">@tr:training.status_saving</span></span>
      <span class="training-status-badge is-active" data-if="show_ctrl_restoring"><span class="training-status-badge-label">@tr:training.status_restoring</span></span>
    </div></div>
    <div class="training-start-feedback" id="training-error-feedback" data-if="show_ctrl_error">
      <span class="training-action-status status-text status-error">{{error_message}}</span>
    </div>
<div class="training-start-feedback" data-if="start_blocked">
        <span class="training-action-status status-text status-error">{{start_error}}</span>
        <span class="training-action-status status-text status-error">{{start_conflicts}}</span>
        <span class="training-action-status status-text status-muted">{{start_fix_hint}}</span>
      </div>
    <span class="training-action-status status-text status-success" data-if="show_project_saved">{{label_project_saved}}</span>
  </div>

  <!-- ── Training Parameters ── -->
  <div id="training-search-container">
    <img id="training-search-icon" src="../icon/scene/search.png" />
    <input id="training-search-input" type="text" data-value="pv_search_query" />
    <button id="training-search-clear" type="button"
            data-if="pv_search_active" data-event-click="pv_search_clear">
      <img src="../icon/scene/x.png" />
    </button>
  </div>

  <!-- Training telemetry remains visible while parameter rows scroll independently. -->
  <div class="section-gap training-telemetry" data-if="show_training_telemetry">
    <span class="status-text text-default training-status-line">{{status_iteration}}</span>
    <span class="status-text text-default training-status-line">{{status_gaussians}}</span>
    <div class="training-progress-wrap">
      <progress id="training-progress" max="1" data-attr-value="progress_value" />
      <span class="progress__text">{{progress_text}}</span>
    </div>
    <div id="loss-graph-container">
      <span id="loss-label" class="status-text text-default training-status-line">{{loss_label}}</span>
      <div class="loss-graph-wrap">
        <div class="loss-graph-ticks">
          <span id="loss-tick-max" class="loss-tick">{{loss_tick_max}}</span>
          <span id="loss-tick-mid" class="loss-tick">{{loss_tick_mid}}</span>
          <span id="loss-tick-min" class="loss-tick">{{loss_tick_min}}</span>
        </div>
        <loss-graph id="loss-graph-el" />
      </div>
    </div>
    <div id="psnr-graph-container" data-if="dep_eval">
      <span id="psnr-label" class="status-text text-default training-status-line">{{psnr_label}}</span>
      <div class="loss-graph-wrap">
        <div class="loss-graph-ticks">
          <span id="psnr-tick-max" class="loss-tick">{{psnr_tick_max}}</span>
          <span id="psnr-tick-mid" class="loss-tick">{{psnr_tick_mid}}</span>
          <span id="psnr-tick-min" class="loss-tick">{{psnr_tick_min}}</span>
        </div>
        <loss-graph id="psnr-graph-el" />
      </div>
    </div>
  </div>

  <div class="training-scroll-region">
  <div class="training-panel-title" data-if="pv_section_basic_params_visible">
    <img class="training-panel-title-icon" src="../icon/settings.png" />
    <span>{{pv_header_basic_params}}</span>
  </div>
  <div class="training-panel-block" data-if="pv_section_basic_params_visible">

    <!-- Structural params (disabled when training started) -->
    <div data-class-disabled-overlay="struct_disabled">
      <div class="setting-row" data-tooltip="training.tooltip.strategy" data-if="pv_show_strategy">
        <span class="prop-label">{{label_strategy}}</span>
        <select data-value="strategy">
          <option value="mrnf" data-tooltip="training.tooltip.opt.strategy.mrnf">{{label_strategy_mrnf}}</option>
          <option value="igs+" data-tooltip="training.tooltip.opt.strategy.igs_plus">{{label_strategy_igs_plus}}</option>
          <option value="mcmc" data-tooltip="training.tooltip.opt.strategy.mcmc">{{label_strategy_mcmc}}</option>
        </select>
      </div>
      <div class="setting-row" data-if="pv_show_backend" data-tooltip="training.tooltip.backend">
        <label class="prop-label" for="training-backend">@tr:training.backend</label>
        <select id="training-backend" data-value="training_backend">
          <option data-for="backend : training_backend_options" data-attr-value="backend.id">{{backend.label}}</option>
        </select>
      </div>
      <span class="status-text status-muted" data-if="pv_show_backend">{{backend_notice}}</span>
      <div class="setting-row"
           data-for="row : pv_basic_struct_rows"
           data-attr-data-tooltip="row.tooltip_key"
           data-class-steps-scale-lock-row="row.id == 'iterations'">
        <span class="prop-label">{{row.label}}</span>
        <input type="text" class="number-input" data-if="row.kind == 'number'"
               data-pv-input="1" data-value="row.text" data-attr-data-pv-id="row.id"
               data-event-focus="pv_focus(row.id)"
               data-event-change="pv_change(row.id, ev.value)"
               data-event-blur="pv_blur(row.id, row.text)"
               data-event-escapecancel="pv_escape(row.id)" />
        <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
               data-event-click="pv_value_change(row.id, !row.checked)" />
        <select data-if="row.kind == 'select'" data-value="row.value"
                data-event-change="pv_value_change(row.id, ev.value)">
          <option data-for="item : pv_basic_struct_options" data-if="item.prop_id == row.id" data-attr-value="item.value"
                  data-attr-data-tooltip="item.tooltip_key">{{item.label}}</option>
        </select>
        <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, -1)">-</button>
        <button class="num-step-btn" data-if="row.kind == 'number'" data-event-mousedown="pv_step(row.id, 1)">+</button>
        <button type="button"
                class="icon-btn steps-scale-lock-btn"
                data-if="row.id == 'iterations'"
                data-class-selected="steps_scaling_lock_selected"
                data-attr-title="steps_scaling_lock_tooltip"
                data-event-click="toggle_step_scaling_lock">
          <img data-attr-src="steps_scaling_lock_icon" />
        </button>
      </div>
      <div class="setting-row" data-for="row : pv_basic_background_rows"
           data-if="dep_mrnf"
           data-attr-data-tooltip="row.tooltip_key">
        <span class="prop-label">{{row.label}}</span>
        <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
               data-event-change="pv_value_change(row.id, row.checked)" />
      </div>

    </div>
  </div>
  <div class="training-panel-block" data-if="pv_section_camera_visible">
    <div class="section-header text-accent" id="hdr-camera" data-event-click="toggle_section('camera')">
      <span class="section-arrow text-accent" id="arrow-camera">&#x25BC;</span>
      <span class="text-accent">{{pv_header_camera}}</span>
    </div>
    <div class="section-content" id="sec-camera">
      <div data-class-disabled-overlay="live_disabled"><div class="setting-row" data-for="row : pv_basic_exposure_correction_rows" data-attr-data-tooltip="row.tooltip_key"><span class="prop-label">{{row.label}}</span><input type="checkbox" data-checked="row.checked" data-event-click="pv_value_change(row.id, !row.checked)" /></div>
        <div class="setting-row" data-for="row : pv_basic_undistort_rows"
          data-attr-data-tooltip="row.tooltip_key">
          <span class="prop-label">{{row.label}}</span>
          <input type="checkbox" data-checked="row.checked"
            data-event-click="pv_value_change(row.id, !row.checked)" />
        </div>
        <div class="setting-row" data-for="row : pv_basic_mip_filter_rows"
          data-attr-data-tooltip="row.tooltip_key" data-class-disabled-overlay="gut_mip_filter_disabled">
          <span class="prop-label">{{row.label}}</span>
          <input type="checkbox" data-checked="row.checked"
            data-event-click="pv_value_change(row.id, !row.checked)" />
        </div>
      </div>
    </div>
  </div>
  <div class="training-panel-block" data-if="pv_section_masking_visible">
    <div class="section-header text-accent" id="hdr-masking" data-event-click="toggle_section('masking')">
      <span class="section-arrow text-accent" id="arrow-masking">&#x25BC;</span>
      <span class="text-accent">{{pv_header_masking}}</span>
    </div>
    <div class="section-content" id="sec-masking">
      <div data-class-disabled-overlay="live_disabled">
        <div class="setting-row" data-for="row : pv_basic_live_start_rows"
          data-attr-data-tooltip="row.tooltip_key">
          <span class="prop-label">{{row.label}}</span>
          <input type="checkbox" data-if="row.kind == 'checkbox'" data-checked="row.checked"
            data-event-click="pv_value_change(row.id, !row.checked)" />
          <select data-if="row.kind == 'select'" data-value="row.value"
            data-event-change="pv_value_change(row.id, ev.value)">
            <option data-for="item : pv_basic_live_start_options" data-if="item.prop_id == row.id" data-attr-value="item.value"
              data-attr-data-tooltip="item.tooltip_key">{{item.label}}</option>
          </select>
        </div>
        <div class="mask-settings-group" data-if="dep_mask_mode">
          <div class="setting-row" data-for="row : pv_mask_invert_rows"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="checkbox" data-checked="row.checked"
              data-event-click="pv_value_change(row.id, !row.checked)" />
          </div>
          <div class="setting-row" data-for="row : pv_mask_threshold_rows" data-if="dep_mask_threshold"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
              data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
              data-event-change="pv_change(row.id, ev.value)"
              data-event-blur="pv_blur(row.id, row.text)"
              data-event-escapecancel="pv_escape(row.id)" />
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
            <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
          </div>
          <div class="setting-row" data-for="row : pv_mask_alpha_rows"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="checkbox" data-checked="row.checked"
              data-event-click="pv_value_change(row.id, !row.checked)" />
          </div>
          <div class="mask-settings-divider" data-if="dep_mask_segment"></div>
          <div data-if="dep_mask_segment">
            <div class="setting-row" data-for="row : pv_mask_penalties_rows"
              data-attr-data-tooltip="row.tooltip_key">
              <span class="prop-label">{{row.label}}</span>
              <input type="text" class="number-input" data-pv-input="1" data-value="row.text"
                data-attr-data-pv-id="row.id" data-event-focus="pv_focus(row.id)"
                data-event-change="pv_change(row.id, ev.value)"
                data-event-blur="pv_blur(row.id, row.text)"
                data-event-escapecancel="pv_escape(row.id)" />
              <button class="num-step-btn" data-event-mousedown="pv_step(row.id, -1)">-</button>
              <button class="num-step-btn" data-event-mousedown="pv_step(row.id, 1)">+</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Advanced Parameters ── -->
  <div class="training-panel-title training-panel-title--secondary section-header" id="hdr-advanced-params" data-event-click="toggle_section('advanced_params')" data-if="pv_section_advanced_params_visible"><span id="arrow-advanced-params" class="section-arrow">&#x25B6;</span>
    <img class="training-panel-title-icon" src="../icon/adjustments.png" />
    <span>{{pv_header_advanced_params}}</span>
  </div>
  <div class="training-panel-block section-content collapsed" id="sec-advanced-params" data-if="pv_section_advanced_params_visible">
<div id="advanced-feature-activations" data-if="pv_section_features_visible" data-class-disabled-overlay="live_disabled">
<div class="setting-row" data-for="row : pv_basic_depth_toggle_rows"
           data-attr-data-tooltip="row.tooltip_key" data-class-disabled-overlay="gut_depth_supervision_disabled">
          <span class="prop-label">{{row.label}}</span>
          <input type="checkbox" data-checked="row.checked"
            data-event-click="pv_value_change(row.id, !row.checked)" />
        </div>
<div class="setting-row" data-for="row : pv_basic_normal_toggle_rows"
           data-attr-data-tooltip="row.tooltip_key" data-class-disabled-overlay="gut_normal_supervision_disabled">
          <span class="prop-label">{{row.label}}</span>
          <input type="checkbox" data-checked="row.checked"
            data-event-click="pv_value_change(row.id, !row.checked)" />
        </div>
<div class="setting-row" data-for="row : pv_basic_bilateral_toggle_rows"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="checkbox" data-checked="row.checked"
              data-event-click="pv_value_change(row.id, !row.checked)" />
          </div>
<div class="setting-row" data-for="row : pv_basic_ppisp_toggle_rows"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="checkbox" data-checked="row.checked"
              data-event-click="pv_value_change(row.id, !row.checked)" />
          </div>
<div class="setting-row" data-for="row : pv_basic_sparsity_toggle_rows"
           data-attr-data-tooltip="row.tooltip_key">
        <span class="prop-label">{{row.label}}</span>
        <input type="checkbox" data-checked="row.checked"
               data-event-click="pv_value_change(row.id, !row.checked)" />
      </div>
<div class="setting-row" data-for="row : pv_dataset_eval_rows"
            data-attr-data-tooltip="row.tooltip_key">
            <span class="prop-label">{{row.label}}</span>
            <input type="checkbox" data-checked="row.checked"
              data-event-click="pv_value_change(row.id, !row.checked)" />
          </div>
<div class="setting-row" data-for="row : pv_feature_random_rows" data-attr-data-tooltip="row.tooltip_key"><span class="prop-label">{{row.label}}</span><input type="checkbox" data-checked="row.checked" data-event-click="pv_value_change(row.id, !row.checked)" /></div>
</div>
<div class="training-panel-block" data-if="pv_section_depth_visible &amp;&amp; (dep_depth_loss)">
