.log-search-box input[type="text"], .log-controls select {
    background-color: @{surface_bright}; color: @{text}; border-color: @{border};
    border-radius: @{num(size.frame_rounding)}dp;
}
.log-search-box input[type="text"]:hover, .log-controls select:hover { border-color: @{alpha(primary, 0.5)}; }
.log-search-box input[type="text"]:focus, .log-search-box input[type="text"]:focus-visible {
    border-color: @{primary}; background-color: @{surface_bright}; color: @{text};
}
.log-search-bar .btn, .log-actions .btn, .log-footer .btn { border-radius: @{num(size.frame_rounding)}dp; }
.log-column-header { background-color: @{surface_bright}; border-bottom-color: @{border}; }
.log-row { border-bottom-color: @{alpha(border, 0.4)}; }
.log-row:hover { background-color: @{alpha(surface_bright, 0.6)}; }
.log-footer { border-top-color: @{border}; }
.log-level { color: @{text_dim}; }
.log-row--info .log-level { color: @{info}; }
.log-row--debug .log-level, .log-row--performance .log-level { color: @{primary}; }
.log-row--warn .log-level { color: @{warning}; }
.log-row--error .log-level, .log-row--critical .log-level { color: @{error}; }
