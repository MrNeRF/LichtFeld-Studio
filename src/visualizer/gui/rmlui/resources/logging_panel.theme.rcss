.log-search-box input[type="text"], .log-settings-bar input[type="text"], .log-field select {
    background-color: @{surface_bright}; color: @{text}; border-color: @{border};
    border-radius: @{num(size.frame_rounding)}dp;
}
.log-search-box input[type="text"]:hover, .log-settings-bar input[type="text"]:hover,
.log-field select:hover { border-color: @{alpha(primary, 0.5)}; }
.log-search-box input[type="text"]:focus, .log-search-box input[type="text"]:focus-visible {
    border-color: @{primary}; background-color: @{surface_bright}; color: @{text};
}
.log-settings-bar input[type="text"]:focus, .log-settings-bar input[type="text"]:focus-visible { border-color: @{primary}; }
#log-scroll scrollbarvertical sliderbar, #log-scroll scrollbarhorizontal sliderbar { background-color: @{alpha(text_dim, 0.55)}; }
#log-scroll scrollbarvertical sliderbar:hover, #log-scroll scrollbarhorizontal sliderbar:hover { background-color: @{primary}; }
.log-filter-bar .btn, .log-actions .btn, .log-footer .btn { border-radius: @{num(size.frame_rounding)}dp; }
.log-column-header { background-color: @{surface_bright}; border-bottom-color: @{border}; }
.log-row { border-bottom-color: @{alpha(border, 0.4)}; }
.log-row:hover { background-color: @{alpha(surface_bright, 0.6)}; }
.log-footer { border-top-color: @{border}; }
.log-level { color: @{text_dim}; }
.log-row--info .log-level { color: @{info}; }
.log-row--debug .log-level, .log-row--performance .log-level { color: @{primary}; }
.log-row--warn .log-level { color: @{warning}; }
.log-row--error .log-level, .log-row--critical .log-level { color: @{error}; }

.log-settings-bar { border-bottom-color: @{border}; }

.log-row.is-selected, .log-row.is-selected:hover { background-color: @{alpha(primary, 0.18)}; }
