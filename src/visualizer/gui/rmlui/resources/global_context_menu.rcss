body {
    font-family: Inter;
    display: block;
    margin: 0;
    padding: 0;
    overflow: visible;
    width: 100%;
    height: 100%;
}

#backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.context-menu-item.has-icon {
    display: flex;
    align-items: center;
    gap: 8dp;
}

.context-menu-item.has-shortcut {
    display: flex;
    align-items: center;
    gap: 8dp;
}

.context-menu-item.has-shortcut .context-menu-text {
    flex: 1 1 auto;
}

.context-menu-shortcut {
    flex: 0 0 auto;
    margin-left: 24dp;
    font-size: 11dp;
    white-space: nowrap;
}

.context-menu-icon {
    width: 16dp;
    height: 16dp;
    flex: 0 0 16dp;
}

.context-menu-label {
    white-space: normal;
}
