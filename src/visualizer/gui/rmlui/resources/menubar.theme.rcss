/* Shared border roles and shape scale. */

.menu-gallery-progress {
    border-radius: 5dp;
}

.menu-gallery-progress-track {
    border-radius: 2dp;
}

.menu-gallery-progress-fill {
    border-radius: 2dp;
}

.menu-toolbar-btn {
    border-color: transparent;
    border-radius: 6dp;
}

.menu-window-btn {
    border-radius: 0;
}

.dropdown-popup {
    border-radius: 4dp;
}

.submenu-popup {
    border-radius: 4dp;
}

/* Theme-dependent menu bar styles. */

body {
    color: @{text};
}

#menu-row {
    @{chrome.menu_decor};
}

#menu-left {
    background-color: transparent;
}

#menu-items {
    background-color: transparent;
}

#menu-right {
    background-color: transparent;
}

#project-title {
    color: @{text_dim};
}

#project-title .project-dirty {
    color: @{text};
}

#menu-toolbar {
    background-color: transparent;
}

.menu-gallery-progress:hover {
    background-color: @{menu.hover};
}

.menu-gallery-progress-track {
    background-color: @{border};
}

.menu-gallery-progress-fill {
    background-color: @{primary};
}

.menu-label:hover {
    background-color: @{menu.hover};
}

.menu-label.active {
    background-color: @{menu.active};
}

#bottom-border {
    background-color: @{menu.bottom_border};
}

.dropdown-popup {
    background-color: @{menu.popup_background};
    border-color: @{border};
}

.menu-item:hover {
    background-color: @{menu.hover};
}

.menu-item.active {
    background-color: @{menu.hover};
}

.menu-item.disabled {
    color: @{text_dim};
}

.menu-item.disabled:hover {
    background-color: transparent;
}

.menu-item .shortcut {
    color: @{text_dim};
}

.menu-separator {
    background-color: @{menu.border};
}

.menu-toolbar-btn:hover {
    background-color: @{menu.hover};
}

.menu-toolbar-btn img,
.menu-window-utility-btn img {
    image-color: @{menu.toolbar_icon};
}

.menu-window-btn:hover {
    background-color: @{menu.hover};
}

.menu-window-close:hover {
    background-color: #c42b1c;
}

.menu-window-close:hover .window-close-line {
    background-color: #ffffff;
}

.menu-window-separator,
.menu-toolbar-separator {
    background-color: @{menu.border};
}

.menu-window-utility-btn.selected {
    @{menu.toolbar_selected_decor};
}

.menu-toolbar-btn.selected {
    @{menu.toolbar_selected_decor};
    border-color: @{primary};
}

.menu-toolbar-btn.selected img,
.menu-window-utility-btn.selected img {
    image-color: @{menu.toolbar_selected_icon};
}
