/* Rendering panel theme overrides. */

.rendering-simplify-stat__value {
    color: @{text};
}

.rendering-simplify-stat__label {
    color: @{text_dim};
}

.rendering-simplify-stat {
    background-color: @{alpha(background,0.74)};
    border-color: @{alpha(text_dim,0.14)};
}

.rendering-simplify-error {
    color: @{error};
}

.selection-groups__title {
    color: @{text_dim};
    border-top-color: @{panel.primary_border_faint};
}

.group-row:hover {
    background-color: @{alpha(border,0.30)};
}

.group-row.active {
    background-color: @{alpha(border,0.50)};
}
