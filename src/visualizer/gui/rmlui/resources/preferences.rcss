/* This compact utility panel does not need a directional drop shadow. */
body.floating-panel {
    box-shadow: none;
}

.preferences-section {
    margin-bottom: 8dp;
}

.preferences-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4dp;
    margin-bottom: 12dp;
}

.preferences-tab {
    flex: 1 1 120dp;
    min-width: 112dp;
}

.preferences-tab.active {
    border-width: 2dp;
    font-weight: bold;
}

.preferences-section-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 6dp;
}

.preferences-description {
    display: block;
    font-size: 12dp;
    line-height: 18dp;
    opacity: 0.8;
}

.preferences-group {
    border-top-width: 1dp;
    border-top-color: #49536a;
    margin-top: 10dp;
    padding-top: 8dp;
}

.preferences-group:first-child {
    border-top-width: 0;
    margin-top: 0;
    padding-top: 0;
}

.preferences-group-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 6dp;
}

.preferences-row {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12dp;
    margin-bottom: 5dp;
}

.preferences-label {
    flex: 1 1 auto;
    min-width: 100dp;
    max-width: 190dp;
    font-size: 12dp;
    white-space: normal;
}

.preferences-select {
    flex: 0 0 200dp;
    width: 200dp;
    min-width: 140dp;
    margin-left: auto;
}

.preferences-checkbox-row input {
    margin-left: auto;
}

.preferences-actions {
    display: flex;
    align-items: center;
    gap: 6dp;
    justify-content: flex-end;
    margin-top: 12dp;
    padding-top: 12dp;
    border-top-width: 1dp;
    border-top-color: #49536a;
}

.preferences-actions-spacer {
    flex: 1;
}
