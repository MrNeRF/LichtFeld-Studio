.preferences-section {
    margin-bottom: 8dp;
}

.preferences-section-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 6dp;
}

.preferences-row {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12dp;
    margin-bottom: 5dp;
}

.preferences-label {
    flex: 1 1 auto;
    min-width: 100dp;
    max-width: 190dp;
    font-size: 12dp;
    white-space: normal;
}

.preferences-select {
    flex: 0 0 200dp;
    width: 200dp;
    min-width: 140dp;
    margin-left: auto;
}

.preferences-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 6dp;
}
