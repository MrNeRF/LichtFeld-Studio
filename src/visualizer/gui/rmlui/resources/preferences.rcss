/* This compact utility panel does not need a directional drop shadow. */
body.floating-panel {
    box-shadow: none;
}

#content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

.preferences-layout {
    display: flex;
    flex: 1;
    min-height: 0;
}

.preferences-nav {
    display: flex;
    flex: 0 0 150dp;
    flex-direction: column;
    gap: 4dp;
    margin-right: 14dp;
    padding-right: 12dp;
    border-right-width: 1dp;
}

.preferences-nav-item {
    text-align: left;
    white-space: nowrap;
}

.preferences-content {
    flex: 1;
    min-width: 0;
    min-height: 0;
}

.preferences-section {
    margin-bottom: 8dp;
}

.preferences-description {
    display: block;
    font-size: 12dp;
    line-height: 18dp;
    opacity: 0.8;
}

.preferences-row {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12dp;
    margin-bottom: 5dp;
}

.preferences-label {
    flex: 1 1 auto;
    min-width: 100dp;
    max-width: 190dp;
    font-size: 12dp;
    white-space: normal;
}

.preferences-select {
    flex: 0 0 200dp;
    width: 200dp;
    min-width: 140dp;
    margin-left: auto;
}

.preferences-checkbox-row input {
    margin-left: auto;
}

.preferences-actions {
    flex: 0 0 auto;
    display: flex;
}

.preferences-footer-sidebar {
    flex: 0 0 150dp;
    padding-right: 12dp;
    border-right-width: 1dp;
}

.preferences-footer-gutter {
    flex: 0 0 14dp;
    border-top-width: 1dp;
}

.preferences-actions-main {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6dp;
    justify-content: flex-end;
    padding-top: 12dp;
    border-top-width: 1dp;
}

.preferences-actions-spacer {
    flex: 1;
}
