/* Theme-dependent global context menu styles. */

.context-menu {
    background-color: @{overlay.surface};
    border-color: @{overlay.border};
    border-radius: @{num(size.window_rounding)}dp;
}

.context-menu-item {
    color: @{text};
}

.context-menu-icon {
    image-color: @{text};
}

.context-menu-check {
    color: @{primary};
}

.context-menu-item:hover .context-menu-icon {
    image-color: #ffffff;
}

.context-menu-label {
    color: @{text_dim};
}

.context-menu-separator {
    background-color: @{alpha(border,0.5)};
}

.context-menu-shortcut {
    color: @{text_dim};
}

.context-menu-item:hover .context-menu-shortcut {
    color: @{alpha(text,0.8)};
}
