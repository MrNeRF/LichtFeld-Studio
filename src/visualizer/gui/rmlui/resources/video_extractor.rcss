body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.video-extractor-window {
    min-width: 0;
    min-height: 0;
    position: relative;
}

#content-wrap {
    padding: 6dp 8dp 10dp;
    overflow-y: auto;
    min-height: 0;
}

#action-footer {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    flex-shrink: 0;
    padding: 8dp 8dp 10dp;
    border-top-width: 1dp;
}

#content {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

.video-extractor-window .btn {
    height: 22dp;
    min-height: 22dp;
    padding: 0 8dp;
    line-height: 20dp;
    text-align: center;
    box-sizing: border-box;
    white-space: nowrap;
    flex-shrink: 0;
}

#preview-shell {
    height: 360dp;
    min-height: 360dp;
    display: flex;
    align-items: center;
    justify-content: center;
    border-width: 1dp;
    overflow: hidden;
}

#preview-image {
    decorator: none;
}

#transport-row {
    display: flex;
    align-items: center;
    gap: 16dp;
    min-height: 32dp;
}

.transport-btn {
    width: 20dp;
    height: 24dp;
    min-width: 20dp;
    min-height: 24dp;
    padding: 3dp 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-width: 0;
    cursor: pointer;
}

.transport-btn img {
    width: 15dp;
    height: 15dp;
}

.transport-btn--primary img {
    width: 18dp;
    height: 18dp;
}

#time-label {
    margin-left: 10dp;
    min-width: 130dp;
}

#rotation-value {
    min-width: 28dp;
    text-align: center;
}

.hdr-badge {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4dp;
    padding: 2dp 8dp;
    font-weight: 600;
    letter-spacing: 0.3dp;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 18dp;
    height: 18dp;
    flex-shrink: 0;
}

#hdr-badge-type {
    font-weight: 400;
    letter-spacing: 0.1dp;
}

#hdr-badge-label {
    font-weight: 600;
    letter-spacing: 0.3dp;
}

#timeline {
    position: relative;
    height: 20dp;
    min-height: 20dp;
    border-width: 1dp;
    cursor: pointer;
    overflow: hidden;
}

#timeline-segments {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.timeline-segment {
    position: absolute;
    top: 0;
    bottom: 0;
    border-width: 0 1dp;
}

.timeline-segment-remove {
    display: none;
    position: absolute;
    top: 0;
    right: 2dp;
    width: 12dp;
    height: 12dp;
    line-height: 12dp;
    text-align: center;
    cursor: pointer;
}

.timeline-segment:hover .timeline-segment-remove {
    display: block;
}

#timeline-progress {
    pointer-events: none;
    position: absolute;
    left: 0;
    bottom: 0;
    height: 4dp;
}

#timeline-playhead {
    pointer-events: none;
    position: absolute;
    top: 0;
    width: 2dp;
    height: 20dp;
    margin-left: -1dp;
}

.timeline-handle {
    position: absolute;
    top: 0;
    width: 3dp;
    height: 20dp;
}

.timeline-handle--start {
    left: -1dp;
}

.timeline-handle--end {
    right: -2dp;
}

#timeline-markers {
    pointer-events: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4dp;
    height: 8dp;
}

.timeline-marker {
    position: absolute;
    bottom: 0;
    width: 1dp;
    height: 7dp;
}

.timeline-marker-band {
    position: absolute;
    bottom: 0;
    height: 7dp;
}

#trim-row,
.settings-row,
.action-row,
.status-row {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-height: 24dp;
    min-width: 0;
}

.row-label,
.field-label {
    flex-shrink: 0;
}

.field-label {
    width: 112dp;
}

#masking-options .field-label {
    width: auto;
    white-space: nowrap;
}

.time-input {
    width: 80dp;
    min-width: 80dp;
    height: 22dp;
}

.inline-note {
    min-width: 0;
}

.inline-warning {
    min-width: 0;
}

.section {
    display: flex;
    flex-direction: column;
    gap: 5dp;
    min-width: 0;
}

.section-rule {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-height: 14dp;
}

.section-rule__lead {
    width: 12dp;
    height: 1dp;
    flex-shrink: 0;
}

.section-rule__label {
    flex-shrink: 0;
}

.section-rule__line {
    flex: 1;
    height: 1dp;
    min-width: 0;
}

.file-list {
    display: flex;
    flex-direction: column;
    gap: 3dp;
    min-width: 0;
}

.file-row {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-height: 23dp;
    min-width: 0;
}

.batch-video-list {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    max-height: 150dp;
    overflow-y: auto;
    min-width: 0;
}

.batch-video-item {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-height: 24dp;
    padding: 2dp 6dp;
    border-width: 1dp;
    cursor: pointer;
    text-align: left;
}

.batch-video-item__name {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.batch-video-item__status {
    flex-shrink: 0;
    white-space: nowrap;
}

.path-value {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.browse-btn {
    min-width: 62dp;
}

.mini-btn {
    min-width: 38dp;
}

.video-extractor-window .action-btn {
    min-width: 150dp;
    height: 30dp;
    min-height: 30dp;
    line-height: 28dp;
}

.wide-select {
    width: 180dp;
    min-width: 180dp;
    height: 24dp;
    min-height: 24dp;
    line-height: 22dp;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

/* Wider select variants for sharpness options which have longer labels */
#sharpness-algorithm-select,
#sharpness-mode-select {
    width: 250dp;
    min-width: 250dp;
}

.compact-select {
    width: 80dp;
    min-width: 80dp;
    height: 24dp;
    min-height: 24dp;
    line-height: 22dp;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.wide-select selectvalue,
.compact-select selectvalue {
    height: 22dp;
    line-height: 22dp;
    margin-right: 20dp;
    padding: 0 0 0 8dp;
}

.wide-select selectarrow,
.compact-select selectarrow {
    width: 20dp;
    height: 22dp;
    line-height: 22dp;
}

.inline-control {
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 24dp;
    min-width: 0;
}

.value-slider {
    width: 112dp;
    min-width: 112dp;
    height: 24dp;
    min-height: 24dp;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.value-slider slidertrack {
    height: 6dp;
    margin-top: 9dp;
}

.value-slider sliderprogress {
    height: 6dp;
    margin-top: 0;
}

.value-slider sliderbar {
    width: 14dp;
    height: 14dp;
    margin-top: 5dp;
    border-width: 1dp;
}

.value-readout {
    width: 70dp;
    min-width: 70dp;
    line-height: 24dp;
}

.interval-control {
    gap: 6dp;
}

.interval-label,
.interval-unit {
    flex-shrink: 0;
    white-space: nowrap;
}

.fps-input {
    width: 64dp;
    min-width: 64dp;
    text-align: center;
}

.interval-input {
    width: 42dp;
    min-width: 42dp;
    text-align: center;
}

.video-extractor-window input[type="text"] {
    height: 24dp;
    min-height: 24dp;
    line-height: 22dp;
    margin: 0;
    padding: 0 6dp;
    box-sizing: border-box;
}

.dimension-input {
    width: 72dp;
    min-width: 72dp;
}

#window-candidates-select {
    width: 160dp;
    min-width: 160dp;
}

.pattern-input {
    width: 200dp;
    min-width: 200dp;
}

.status-row {
    min-height: 30dp;
    flex-wrap: wrap;
}

.status-section {
    display: none;
    align-items: center;
    gap: 8dp;
    min-height: 28dp;
    padding: 0 8dp;
    border-width: 1dp;


    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
}

.status-section progress {
    width: 120dp;
    height: 10dp;
}

#progress-section {
    flex: 1;
}

#progress-section progress {
    flex: 1;
    width: auto;
    min-width: 120dp;
}

.status-text {

    min-width: 0;
    word-break: break-word;
}

.toggle-label {
    display: flex;
    align-items: center;
    gap: 6dp;
    cursor: pointer;
}

.sharpness-options {
    display: flex;
    flex-direction: column;
    gap: 5dp;
}

.sharpness-options.hidden {
    display: none;
}

/* ── Overwrite confirmation overlay ────────────────────── */

.extractor-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 50;
}

.extractor-overlay.hidden {
    display: none;
}

.confirm-dialog {
    border-width: 1dp;
    padding: 16dp;
    min-width: 280dp;
    max-width: 440dp;
}

.confirm-message {
    display: block;
    text-align: center;
    margin-bottom: 8dp;
}

.confirm-buttons {
    display: flex;
    justify-content: center;
    gap: 8dp;
    margin-top: 8dp;
}

.confirm-buttons .btn {
    min-width: 100dp;
}

.pattern-input {
    flex: 1;
    min-width: 0;
}

.naming-note {
    margin-top: 4dp;
}
