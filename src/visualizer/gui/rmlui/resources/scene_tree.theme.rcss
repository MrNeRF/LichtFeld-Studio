/* Scene tree theme overrides. */

body {
    border-color: @{right_panel.border};
}

#search-container {
    background-color: @{surface};
    border-color: @{border};
}

#search-icon,
#filter-clear img {
    image-color: @{text_dim};
}

#filter-input {
    color: @{text};
}

#filter-clear:hover img,
#filter-clear:focus-visible img {
    image-color: @{text};
}

.tree-row.even {
    background-color: @{row_even};
}

.tree-row.odd {
    background-color: @{row_odd};
}

.tree-row:hover {
    background-color: @{panel.row_hover};
    border-left-color: @{primary};
}

.tree-row.selected {
    background-color: @{panel.row_selected};
}

.tree-row.selected:hover {
    background-color: @{panel.row_selected_hover};
    border-left-color: @{primary_dim};
}

.tree-row.drop-target {
    border-color: @{primary};
    background-color: @{panel.row_hover};
}

.tree-drag-ghost {
    background-color: @{surface};
    border-color: @{primary};
    color: @{text};
}

.tree-insert-line {
    background-color: @{primary};
}

.expand-toggle,
.node-name.training-disabled,
.section-arrow {
    color: @{text_dim};
}

.expand-toggle:hover,
.node-name {
    color: @{text};
}

.row-icon {
    image-color: @{text};
}

.row-icon.type-icon.splat        { image-color: @{alpha(info,0.90)}; }
.row-icon.type-icon.group        { image-color: @{alpha(text_dim,0.80)}; }
.row-icon.type-icon.ply_sequence { image-color: @{alpha(info,0.86)}; }
.row-icon.type-icon.dataset      { image-color: @{alpha(primary,0.90)}; }
.row-icon.type-icon.camera       { image-color: @{alpha(text_dim,0.78)}; }
.row-icon.type-icon.camera_group { image-color: @{alpha(primary_dim,0.80)}; }
.row-icon.type-icon.cropbox      { image-color: @{alpha(warning,0.90)}; }
.row-icon.type-icon.transform    { image-color: @{alpha(warning,0.90)}; }
.row-icon.type-icon.ellipsoid    { image-color: @{alpha(info,0.90)}; }
.row-icon.type-icon.pointcloud   { image-color: @{alpha(secondary,0.80)}; }
.row-icon.type-icon.mesh         { image-color: @{alpha(success,0.90)}; }

.row-icon.trash-icon {
    image-color: @{alpha(error,0.82)};
}

.row-icon.training-toggle-icon {
    image-color: @{alpha(primary,0.90)};
}

.row-icon.training-toggle-icon.training-disabled {
    image-color: @{alpha(warning,0.72)};
}

.row-icon.training-toggle-icon.training-mixed {
    image-color: @{warning};
}

.training-mixed-mark {
    background-color: @{warning};
}

.row-icon.training-toggle-icon:hover {
    image-color: @{text};
}

.row-icon.trash-icon:hover {
    image-color: @{error};
}

.row-icon.trash-icon.trash-disabled,
.row-icon.trash-icon.trash-disabled:hover {
    image-color: @{alpha(text_dim,0.50)};
}

.tree-row.selected .row-icon.trash-icon {
    image-color: @{error};
}

.tree-row.selected .row-icon.trash-icon.trash-disabled {
    image-color: @{alpha(text_dim,0.55)};
}

.rename-input {
    color: @{text};
    background-color: @{surface};
    border-color: @{primary};
}

.scene-tab {
    color: @{text};
    background-color: @{panel.tab_active_bg};
    border-color: @{panel.tab_active_border};
    border-bottom-color: @{primary};
}

.selection-action-bar {
    color: @{text_dim};
    background-color: @{alpha(surface,0.82)};
    border-top-color: @{border};
}

.selection-action-button:hover {
    background-color: @{alpha(primary,0.18)};
}

.selection-action-button.disabled:hover {
    background-color: transparent;
}

#selection-visibility-icon {
    image-color: @{success};
}

#selection-visibility-icon.selection-hidden {
    image-color: @{text_dim};
}

#selection-training-icon {
    image-color: @{primary};
}

#selection-training-icon.training-disabled {
    image-color: @{warning};
}

#selection-delete-icon {
    image-color: @{error};
}

#selection-clear-icon {
    image-color: @{text_dim};
}

.scene-chip {
    color: @{text};
    background-color: @{surface_bright};
    border-color: @{border};
}

.scene-chip--accent {
    color: @{text};
    background-color: @{panel.chip_accent_bg};
    border-color: @{panel.chip_accent_border};
}

.tree-checkbox {
    color: @{text};
    border-color: @{alpha(text_dim,0.75)};
    background-color: @{alpha(surface_bright,0.85)};
}

.tree-checkbox.checked {
    color: @{surface};
    border-color: @{primary};
    background-color: @{primary};
}

.tree-checkbox.mixed {
    color: @{surface};
    border-color: @{warning};
    background-color: @{warning};
}

.tree-row.selection-partial {
    background-color: @{alpha(primary,0.10)};
}
