body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#dock-grip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 4dp;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.dock-grip-bar {
    width: 100%;
    height: 1dp;
}
