body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#dock-grip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 4dp;
    box-sizing: border-box;
    border-top-width: 1dp;
    pointer-events: none;
}
