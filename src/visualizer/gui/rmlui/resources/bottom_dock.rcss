body {
    position: relative;
    width: 100%;
    height: 100%;
    font-family: Inter;
    font-size: 12dp;
    nav: auto;
}

#dock-grip {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 4dp;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

.dock-grip-bar {
    width: 36dp;
    height: 1dp;
}

#bottom-dock-toggle {
    right: 2dp;
}

.dock-toggle-chevron {
    display: inline-block;
    width: 6dp;
    height: 6dp;
    border-width: 0 1dp 1dp 0;
    transform: rotate(45deg);
    pointer-events: none;
}

.collapsed .dock-toggle-chevron {
    transform: rotate(225deg);
}

.collapsed #tab-strip-viewport,
.collapsed #tab-scroll-left,
.collapsed #tab-scroll-right,
.collapsed #dock-grip {
    display: none;
}
