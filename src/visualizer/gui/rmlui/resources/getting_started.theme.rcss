/* Shared border roles and shape scale. */

.card-body {
    border-radius: @{radius.surface}dp;
}

/* Getting started panel theme overrides. */

.card-body {
    background-color: @{surface};
    border-color: @{border};
}

.video-card:hover .card-body,
.video-card:focus-visible .card-body {
    border-color: @{primary};
    background-color: @{components.title_surface};
}

.play-icon {
    color: @{primary};
}

.card-title {
    color: @{text};
}

.guide-footer {
    border-top-color: @{border};
}

.guide-tab {
    color: @{text_dim};
    background-color: @{panel.tab_inactive_bg};
    border-color: @{border};
}

.guide-tab:hover,
.guide-tab:focus-visible {
    color: @{text};
    background-color: @{panel.tab_hover_bg};
    border-color: @{primary};
}

.guide-tab.active {
    color: @{text};
    background-color: @{panel.tab_active_bg};
    border-color: @{primary};
    font-weight: 600;
}
