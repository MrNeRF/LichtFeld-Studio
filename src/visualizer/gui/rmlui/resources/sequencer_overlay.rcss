body {
    display: block;
    margin: 0;
    padding: 0;
    overflow: visible;
    width: 100%;
    height: 100%;
}

.overlay-panel {
    position: absolute;
    padding: 8dp 8dp;
}

#pip-preview {
    width: 180dp;
    height: 120dp;
}

#pip-title {
    display: block;
    font-size: 12dp;
    margin-bottom: 4dp;
}

#pip-border {
    display: block;
    width: 100%;
    height: 100%;
    border-width: 2dp;
    border-color: rgba(100, 160, 255, 150);
    border-radius: 4dp;
}

#kf-edit-overlay {
    width: 200dp;
}

#kf-edit-label {
    display: block;
    font-size: 13dp;
    margin-bottom: 2dp;
}

#kf-edit-delta {
    display: block;
    font-size: 12dp;
    margin-bottom: 4dp;
}

#kf-edit-buttons {
    display: flex;
    gap: 4dp;
    margin-top: 4dp;
}

.btn {
    display: inline-block;
    padding: 4dp 10dp;
    font-size: 12dp;
    border-radius: 3dp;
    cursor: pointer;
    text-align: center;
    flex: 1;
    transition: background-color 0.12s quadratic-out;
}

.btn--primary {
    background-color: rgba(100, 160, 255, 200);
    color: #ffffff;
}

.btn--primary:hover {
    background-color: rgba(120, 180, 255, 220);
}

.btn--secondary {
    background-color: rgba(80, 80, 100, 180);
    color: #cdd6f4;
}

.btn--secondary:hover {
    background-color: rgba(100, 100, 120, 200);
}
