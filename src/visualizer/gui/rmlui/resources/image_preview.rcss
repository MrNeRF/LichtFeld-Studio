/* Image Preview Panel */

#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#content {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

/* -- Main Area -- */

#preview-toolbar, .preview-tool-group, #sampled-color-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4dp;
}

#preview-toolbar {
    flex-shrink: 0;
    padding: 6dp;
    gap: 6dp 10dp;
    border-bottom-width: 1dp;
}

#preview-toolbar .btn, #sampled-color-controls .btn {
    box-sizing: border-box;
    display: inline-block;
    height: 28dp;
    line-height: 26dp;
    padding: 0 8dp;
}

#preview-toolbar [disabled], #sampled-color-controls [disabled] {
    tab-index: none;
    pointer-events: auto;
}

#sampled-color-controls, #shortcut-help {
    flex-shrink: 0;
    padding: 6dp 10dp;
    border-bottom-width: 1dp;
}

#preview-message {
    flex-shrink: 0;
    padding: 0 10dp;
    font-size: 12dp;
}

#sampled-color-controls.hidden, #shortcut-help.hidden {
    display: none;
}

#main-area {
    display: flex;
    flex: 1;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

/* -- Filmstrip -- */

#filmstrip {
    box-sizing: border-box;
    width: 96dp;
    overflow-y: auto;
    padding: 6dp;
    flex-shrink: 0;
    min-height: 0;
    border-right-width: 1dp;
}

#filmstrip.hidden {
    display: none;
}

.filmstrip-virtual-spacer {
    width: 80dp;
    flex-shrink: 0;
}

.thumb-row {
    height: 64dp;
    flex-shrink: 0;
}

.thumb-item {
    box-sizing: border-box;
    display: block;
    width: 100%;
    height: 54dp;
    padding: 0;
    margin: 2dp 0;
    cursor: pointer;
    border-width: 1.5dp;
    border-color: transparent;
    border-radius: 3dp;
    opacity: 0.85;
    position: relative;
    overflow: hidden;
    transition: opacity 0.12s quadratic-out;
}

.thumb-item:hover {
    opacity: 1;
}

.thumb-item.selected {
    opacity: 1;
}

.thumb-index {
    display: block;
    position: absolute;
    bottom: 1dp;
    left: 3dp;
    font-size: 12dp;
}

/* -- Image Area -- */

#image-container {
    flex: 1;
    overflow: hidden;
    position: relative;
    min-width: 0;
    min-height: 0;
}

#image-container.picker-active {
    cursor: pipette;
}

#image-viewport {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
    clip: always;
}

.image-layer {
    position: absolute;
    display: block;
    decorator: none;
    opacity: 1;
    z-index: 0;
}

.image-layer.preview-active { z-index: 1; }

.image-layer.hidden {
    display: none;
}

#mask-overlay {
    position: absolute;
    display: none;
    decorator: none;
    z-index: 2;
}

#mask-overlay.visible {
    display: block;
}

#no-image-text {
    font-size: 12dp;
    z-index: 3;
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    display: block;
    transform: translateY(-50%);
    text-align: center;
    pointer-events: none;
}

#no-image-text.hidden {
    display: none;
}

#preview-state-text {
    box-sizing: border-box;
    display: block;
    width: 100%;
    padding: 0 24dp;
    line-height: 18dp;
    text-align: center;
}

/* -- Nav Arrows -- */

.nav-arrow {
    box-sizing: border-box;
    display: block;
    position: absolute;
    top: 50%;
    margin-top: -16dp;
    width: 32dp;
    height: 32dp;
    border-radius: 16dp;
    border-width: 1dp;
    font-size: 14dp;
    text-align: center;
    line-height: 30dp;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.15s quadratic-out;
}

.nav-arrow:hover {
    opacity: 1;
}

.nav-arrow.hidden {
    display: none;
}

#nav-prev {
    left: 8dp;
}

#nav-next {
    right: 8dp;
}

/* -- Sidebar -- */

#sidebar {
    box-sizing: border-box;
    width: 200dp;
    overflow-y: auto;
    flex-shrink: 0;
    min-height: 0;
    border-left-width: 1dp;
}

#sidebar.hidden {
    display: none;
}

.sidebar-header-ip {
    padding: 10dp 12dp 8dp;
    border-bottom-width: 1dp;
}

.sidebar-header-label-ip {
    display: block;
    font-size: 12dp;
    letter-spacing: 0.2dp;
    margin-bottom: 2dp;
}

#sidebar-filename {
    display: block;
    font-size: 12dp;
    overflow: hidden;
}

.section-label-ip {
    display: block;
    font-size: 12dp;
    letter-spacing: 0.2dp;
    margin-bottom: 6dp;
}

.sidebar-section-ip {
    padding: 8dp 12dp;
    border-bottom-width: 1dp;
}

.meta-row {
    display: flex;
    margin-bottom: 4dp;
}

.meta-item {
    flex: 1;
}

.meta-key {
    display: block;
    font-size: 12dp;
    letter-spacing: 0.2dp;
    margin-bottom: 1dp;
}

.meta-val {
    display: block;
    font-size: 12dp;
}

.meta-val-accent {
    display: block;
    font-size: 12dp;
}

.meta-full-ip {
    margin-top: 4dp;
}

.meta-path-row {
    display: flex;
    align-items: center;
}

.meta-path-row .meta-key {
    flex: 1;
}

.btn-copy {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28dp;
    height: 28dp;
    padding: 0;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 3dp;
    cursor: pointer;
    background-color: transparent;
}

.btn-copy-icon {
    width: 14dp;
    height: 14dp;
}

.meta-val-secondary {
    display: block;
    font-size: 12dp;
    overflow: hidden;
}

#sidebar-mask-name {
    display: block;
    font-size: 12dp;
    margin-bottom: 2dp;
}

.sidebar-check-row {
    display: flex;
    align-items: center;
    margin-top: 3dp;
    margin-bottom: 2dp;
}

.sidebar-check-row label {
    font-size: 12dp;
    margin-left: 4dp;
    cursor: pointer;
}

.hidden {
    display: none;
}

/* -- Status Bar -- */

#status-bar {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    height: 28dp;
    padding: 0 10dp;
    flex-shrink: 0;
    border-top-width: 1dp;
    overflow: hidden;
    white-space: nowrap;
}

.status-item {
    font-size: 12dp;
    margin-right: 16dp;
    letter-spacing: 0.2dp;
    flex-shrink: 0;
}

#view-controls {
    display: flex;
    align-items: center;
    gap: 4dp;
    margin-right: 0;
    flex-wrap: wrap;
}

#view-controls.hidden {
    display: none;
}

.view-btn {
    box-sizing: border-box;
    display: block;
    width: 28dp;
    height: 28dp;
    padding: 0;
    border-width: 1dp;
    border-radius: 3dp;
    cursor: pointer;
    font-size: 12dp;
    text-align: center;
    line-height: 26dp;
    transition: background-color 0.12s quadratic-out, border-color 0.12s quadratic-out,
                color 0.12s quadratic-out, opacity 0.12s quadratic-out;
}

.view-btn--icon {
    display: flex;
    align-items: center;
    justify-content: center;
}

.view-btn--icon img {
    width: 14dp;
    height: 14dp;
}

.view-btn:disabled, .view-btn[disabled] {
    opacity: 0.35;
    cursor: default;
}

.status-keys {
    display: flex;
    flex: 1 1 0;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    min-width: 0;
    height: auto;
    margin-right: 12dp;
    overflow: visible;
    gap: 0 8dp;
}

.hk {
    display: flex;
    align-items: center;
    height: 18dp;
    gap: 2dp;
}

.hk-key {
    font-size: 12dp;
    padding: 1dp 3dp;
    border-radius: 2dp;
    letter-spacing: 0.3dp;
}

.hk-label {
    font-size: 12dp;
    letter-spacing: 0.3dp;
}

.status-position {
    font-size: 12dp;
    margin-left: auto;
    letter-spacing: 0.2dp;
    flex-shrink: 0;
}
