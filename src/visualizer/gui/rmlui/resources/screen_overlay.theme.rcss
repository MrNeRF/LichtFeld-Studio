#active-outline {
    border-radius: 0;
}

#divider-highlight {
    border-radius: 1dp;
}

#corner-hint.top-left {
    border-top-left-radius: @{radius.surface}dp;
}

#corner-hint.top-right {
    border-top-right-radius: @{radius.surface}dp;
}

#corner-hint.bottom-left {
    border-bottom-left-radius: @{radius.surface}dp;
}

#corner-hint.bottom-right {
    border-bottom-right-radius: @{radius.surface}dp;
}

#split-new {
    border-radius: @{radius.surface}dp;
}

#join-target {
    border-radius: @{radius.surface}dp;
}

#swap-source,
#swap-target {
    border-radius: @{radius.surface}dp;
}

/* Theme colours of the area gesture previews. */

#active-outline {
    border-color: @{primary};
}

#divider-highlight {
    background-color: @{alpha(primary,0.75)};
}

#corner-hint {
    border-color: @{primary};
}

#split-new {
    background-color: @{alpha(primary,0.12)};
    border-color: @{primary};
}

#split-new.denied {
    background-color: @{alpha(error,0.12)};
    border-color: @{error};
}

#split-line {
    background-color: @{primary};
}

#join-target {
    background-color: @{alpha(background,0.55)};
    border-color: @{primary};
}

#join-target.denied {
    background-color: @{alpha(error,0.10)};
    border-color: @{error};
}

#join-arrow {
    border-top-color: @{primary};
    border-right-color: @{primary};
}

#join-target.denied #join-arrow {
    border-top-color: @{error};
    border-right-color: @{error};
}

#swap-source {
    background-color: @{alpha(primary,0.10)};
    border-color: @{primary};
}

#swap-target {
    background-color: @{alpha(primary,0.18)};
    border-color: @{primary};
}

#swap-target.denied {
    background-color: @{alpha(error,0.10)};
    border-color: @{error};
}
