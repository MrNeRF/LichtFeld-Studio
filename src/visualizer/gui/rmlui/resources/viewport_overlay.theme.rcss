/* Theme-dependent viewport overlay controls. */

.toolbar-container {
    background-color: @{toolbar.background};
    border-radius: @{num(size.window_rounding)}dp;
}

.crop-roi-popover {
    color: @{text};
    background-color: @{toolbar.background};
    border-color: @{overlay.border};
}

.crop-roi-popover-title {
    color: @{text};
}

.viewport-frame-border {
    background-color: @{menu.background};
}

.left-dock-resize-indicator {
    background-color: @{alpha(info,0.30)};
}

.left-dock-resize-indicator.active {
    background-color: @{alpha(info,0.50)};
}

.viewport-split-divider {
    background-color: @{menu.background};
}

.toolbar-vertical {
    background-color: transparent;
    border-radius: 0;
}

.viewport-gizmo-controls .icon-btn {
    background-color: @{toolbar.background};
}

.toolbar-separator {
    background-color: @{alpha(border,0.39)};
}

.viewport-transform-panel {
    background-color: @{toolbar.background};
    border-color: @{overlay.border};
}

.viewport-export-status {
    background-color: @{toolbar.background};
    border-color: @{overlay.border};
    color: @{text};
}

.viewport-transform-meta__tool,
.viewport-transform-axis-label {
    color: @{text};
}

.viewport-transform-axis--split {
    border-color: @{alpha(border,0.30)};
}

.viewport-transform-option-group,
.viewport-transform-tool-group,
.viewport-selection-tool-group {
    background-color: @{toolbar.sub_background};
    border-color: @{alpha(border,0.39)};
}

.icon-btn img {
    image-color: @{viewport.icon_dim};
}

.icon-btn:hover {
    background-color: @{viewport.hover_bg};
}

.toolbar-vertical .icon-btn:hover,
.toolbar-hcenter .icon-btn:hover,
.viewport-gizmo-controls .icon-btn:hover {
    background-color: @{alpha(primary,0.16)};
    border-color: @{alpha(primary,0.42)};
}

.icon-btn.selected {
    background-color: @{primary};
}

.toolbar-vertical .icon-btn.selected,
.toolbar-hcenter .icon-btn.selected,
.viewport-gizmo-controls .icon-btn.selected {
    border-color: @{alpha(text,0.25)};
}

.icon-btn.selected:hover {
    background-color: @{viewport.selected_hover};
}

.toolbar-vertical .icon-btn.selected:hover,
.toolbar-hcenter .icon-btn.selected:hover,
.viewport-gizmo-controls .icon-btn.selected:hover {
    border-color: @{alpha(text,0.35)};
}

.icon-btn.selected img {
    image-color: @{background};
}

.icon-btn.disabled,
.icon-btn.disabled:hover,
.icon-btn.disabled:active {
    background-color: transparent;
    border-color: transparent;
}

.icon-btn.disabled img {
    image-color: @{text_dim};
}

.viewport-metrics-card {
    background-color: @{viewport.metrics_bg};
    border-color: @{viewport.metrics_border};
}

.viewport-lod-stats-card {
    background-color: @{viewport.metrics_bg};
    border-color: @{viewport.metrics_border};
}

.viewport-lod-stats-title,
.viewport-lod-stats-value {
    color: @{text};
}

.viewport-lod-stats-label {
    color: @{text_dim};
}

.viewport-metrics-label {
    color: @{text_dim};
}

.viewport-metrics-value {
    color: @{text};
}

.vram-hud-card {
    background-color: @{viewport.metrics_bg};
    border-color: @{viewport.metrics_border};
}

.vram-hud-title,
.vram-hud-summary-value,
.vram-hud-tree-row span {
    color: @{text};
}

.vram-hud-iteration,

.vram-hud-throughput,

.vram-hud-summary-label,

.vram-hud-device,

.vram-hud-counter-label,

.vram-hud-row-header span,

.vram-hud-tree-row em,

.vram-hud-empty,

.vram-hud-expand-toggle {
    color: @{text_dim};
}

.vram-hud-counter-value {
    color: @{text};
}

.vram-hud-tree-row.has-children:hover {
    background-color: @{viewport.hover_bg};
}

.vram-hud-expand-toggle:hover {
    color: @{text};
}

.vram-hud-tree-row.scope-delta .vram-hud-col-delta {
    color: @{primary};
}

.vram-hud-tree-row.scope-timer .vram-hud-col-time {
    color: @{primary};
}

.vram-hud-tabs {
    border-bottom-color: @{alpha(border,0.39)};
}

.vram-hud-tab {
    background-color: transparent;
    color: @{text_dim};
}

.vram-hud-tab:hover {
    color: @{text};
    background-color: @{viewport.hover_bg};
}

.vram-hud-tab.active {
    color: @{text};
    background-color: @{viewport.metrics_bg};
}

.vram-hud-counters-header {
    color: @{text_dim};
}

.vram-hud-counters-empty {
    color: @{text_dim};
}

.perf-hud-tracking-off,
.perf-hud-ledger-header {
    background-color: @{viewport.metrics_bg};
    border-color: @{alpha(border,0.39)};
    color: @{text};
}

.perf-hud-enable-tracking {
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{blend(surface,primary,button.tint_normal)};
    color: @{text};
}

.perf-hud-enable-tracking:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{blend(surface,primary,button.tint_hover)};
}

.perf-hud-ledger-header-detail,
.perf-hud-ledger-note,
.perf-hud-ledger-disclosure,
.perf-hud-ledger-row-header {
    color: @{text_dim};
}

.perf-hud-ledger-process,
.perf-hud-ledger-name,
.perf-hud-ledger-allocated {
    color: @{text};
}

.perf-hud-ledger-row.root {
    border-top-color: @{alpha(border,0.39)};
}

.perf-hud-ledger-row.has-children:hover {
    background-color: @{viewport.hover_bg};
}

.perf-hud-ledger-toggle {
    color: @{text_dim};
}

.perf-hud-ledger-share {
    background-color: @{statusbar.progress_bg};
}

.perf-hud-ledger-share-fill {
    background-color: @{primary};
}

.perf-hud-ledger-closure.closed,
.perf-hud-ledger-row.closed .perf-hud-ledger-badge,
.perf-hud-ledger-row.exact .perf-hud-ledger-badge {
    border-color: @{success};
    color: @{success};
}

.perf-hud-ledger-closure.gap,
.perf-hud-ledger-row.gap .perf-hud-ledger-badge,
.perf-hud-ledger-row.slack .perf-hud-ledger-badge,
.perf-hud-ledger-row.over-budget .perf-hud-ledger-badge {
    border-color: @{warning};
    color: @{warning};
}

.perf-hud-ledger-closure.over,
.perf-hud-ledger-row.over .perf-hud-ledger-badge,
.perf-hud-ledger-row.estimate .perf-hud-ledger-badge,
.perf-hud-ledger-row.degenerate .perf-hud-ledger-badge {
    border-color: @{error};
    color: @{error};
}

.perf-hud-ledger-over-banner {
    background-color: @{alpha(error,0.12)};
    border-color: @{error};
    color: @{error};
}

.perf-hud-ledger-row.nested .perf-hud-ledger-name,
.perf-hud-ledger-row.nested .perf-hud-ledger-allocated,
.perf-hud-ledger-row.nested .perf-hud-ledger-badge {
    color: @{text_dim};
}

.perf-hud-ledger-row.unjustified .perf-hud-ledger-name,
.perf-hud-ledger-row.unjustified .perf-hud-ledger-allocated {
    color: @{warning};
}

.vram-hud-allocs-summary-label,
.vram-hud-allocs-summary-value,
.vram-hud-allocs-pct {
    color: @{text_dim};
}

.vram-hud-allocs-name,
.vram-hud-allocs-bytes {
    color: @{text};
}

.vram-hud-allocs-row {
    background-color: @{viewport.metrics_bg};
    border-radius: 3dp;
}

.vram-hud-anno-summary-label,
.vram-hud-anno-cat,
.vram-hud-anno-row-header span {
    color: @{text_dim};
}

.vram-hud-anno-summary-value,
.vram-hud-anno-name,
.vram-hud-anno-bytes,
.vram-hud-anno-peak {
    color: @{text};
}

.vram-hud-anno-wall,
.vram-hud-anno-gpu,
.vram-hud-anno-calls {
    color: @{text_dim};
}

.vram-hud-anno-row {
    background-color: @{viewport.metrics_bg};
    border-radius: 3dp;
}

.vram-hud-summary {
    border-bottom-width: 1dp;
    border-bottom-color: @{alpha(border,0.39)};
}

.vram-hud-filter-input {
    background-color: @{viewport.metrics_bg};
    border-color: @{alpha(border,0.39)};
    color: @{text};
}

.vram-hud-filter-input:focus {
    border-color: @{primary};
}

.vram-hud-filter-clear {
    background-color: @{viewport.metrics_bg};
    border-color: @{alpha(border,0.39)};
    color: @{text_dim};
}

.vram-hud-filter-clear:hover {
    background-color: @{viewport.hover_bg};
    color: @{text};
}

.vram-hud-resize {
    background-color: @{alpha(border,0.39)};
}

.vram-hud-resize:hover {
    background-color: @{primary};
}

.viewport-status-backdrop {
    background-color: @{viewport.status_backdrop};
}

.viewport-status-panel {
    background-color: @{viewport.panel_bg};
    border-color: @{viewport.panel_border};
    border-radius: @{num(size.window_rounding)}dp;
}

.viewport-status-title {
    color: @{text};
}

.viewport-status-path,
.viewport-status-stage {
    color: @{text_dim};
}

.perf-hud-strip {
    background-color: @{viewport.panel_bg};
    border-color: @{viewport.panel_border};
    color: @{text};
}
.perf-hud-strip-rate, .perf-hud-strip-value { color: @{text_dim}; }
.perf-hud-meter-track { background-color: @{statusbar.progress_bg}; }
.perf-hud-meter-fill { background-color: @{primary}; }
.perf-hud-meter-fill.process { background-color: @{primary}; }
.perf-hud-meter-fill.other { background-color: @{alpha(text_dim,0.45)}; }
.perf-hud-meter-fill.free { background-color: @{alpha(text_dim,0.20)}; }
.perf-hud-strip-badge { color: @{success}; }
.perf-hud-strip-meter.warn .perf-hud-meter-fill,
.perf-hud-meter-fill.warn { background-color: @{warning}; }
.perf-hud-strip-meter.crit .perf-hud-meter-fill,
.perf-hud-meter-fill.crit { background-color: @{error}; }
.perf-hud-core-bar { background-color: @{primary}; }

.perf-hud-sparkline .histogram-bar-fill {
    background-color: @{primary};
}
.perf-hud-meter-track {
    background-color: @{statusbar.progress_bg};
}
