/* Shared border roles and shape scale. */

.project-drop-overlay {
    border-radius: @{radius.surface}dp;
}

.project-drop-card {
    border-radius: @{radius.surface}dp;
}

.toolbar-vertical .icon-btn {
    border-color: transparent;
    border-radius: @{radius.control}dp;
}

.viewport-gizmo-controls .icon-btn {
    border-radius: @{radius.control}dp;
}

.toolbar-hcenter .icon-btn {
    border-color: transparent;
    border-radius: @{radius.control}dp;
}

.crop-roi-popover {
    border-radius: @{radius.control}dp;
}

#depth-view-block .viewport-depth-axis > .viewport-depth-step-btn {
    border-radius: @{radius.control}dp;
}

.viewport-transform-panel {
    border-radius: @{radius.surface}dp;
}

#selection-block .viewport-selection-panel {
    border-radius: @{radius.control}dp;
}

#depth-view-block .viewport-depth-panel {
    border-radius: @{radius.control}dp;
}

#gt-compare-mode-block .viewport-gt-compare-panel {
    border-radius: @{radius.control}dp;
}

.viewport-transform-panel.viewport-export-panel {
    border-radius: @{radius.control}dp;
}

#transform-block .viewport-transform-panel {
    border-radius: @{radius.control}dp;
}

.viewport-transform-tool-group,
.viewport-selection-tool-group {
    border-radius: @{radius.control}dp;
}

.viewport-transform-option-group {
    border-radius: @{radius.control}dp;
}

.viewport-transform-option {
    border-radius: @{radius.control}dp;
}

.viewport-export-status {
    border-radius: @{radius.control}dp;
}

.viewport-transform-action {
    border-radius: @{radius.control}dp;
}

.viewport-transfer-queue {
    border-radius: @{radius.surface}dp;
}

.viewport-transfer-progress {
    border-radius: @{radius.control}dp;
}

.viewport-lod-stats-card {
    border-radius: @{radius.surface}dp;
}

.viewport-metrics-card {
    border-radius: @{radius.surface}dp;
}

.vram-hud-card {
    border-radius: @{radius.surface}dp;
}

.vram-hud-tab {
    border-radius: 0;
}

.perf-hud-tracking-off {
    border-radius: @{radius.control}dp;
}

.perf-hud-enable-tracking {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-header {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-closure {
    border-radius: @{radius.surface}dp;
}

.perf-hud-ledger-over-banner {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-row {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-share {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-share-fill {
    border-radius: @{radius.control}dp;
}

.perf-hud-ledger-badge {
    border-radius: @{radius.control}dp;
}

#vram-hud-filter {
    border-radius: @{radius.control}dp;
}

.vram-hud-filter-clear {
    border-radius: @{radius.control}dp;
}

.perf-hud-strip {
    border-radius: @{radius.control}dp;
}

.perf-hud-meter-track {
    border-radius: @{radius.control}dp;
}

.vram-hud-legend-swatch {
    border-radius: @{radius.control}dp;
}

.comparison-name {
    border-radius: @{radius.control}dp;
}

.gamepad-indicator-dot {
    border-radius: @{radius.round}dp;
}

/* Theme-dependent viewport overlay controls. */

.toolbar-container {
    @{chrome.toolbar_decor};
    border-radius: @{radius.surface}dp;
}

.crop-roi-popover {
    color: @{text};
    background-color: @{toolbar.background};
    border-color: @{border};
}

.crop-roi-popover-title {
    color: @{text};
}

.viewport-frame-border {
    background-color: @{menu.background};
}

.left-dock-resize-indicator {
    background-color: @{alpha(info,0.30)};
}

.left-dock-resize-indicator.active {
    background-color: @{alpha(info,0.50)};
}

.viewport-split-divider {
    background-color: @{menu.background};
}

.empty-state-icon {
    image-color: @{overlay.icon};
}

.empty-state-title {
    color: @{overlay.text};
}

.empty-state-subtitle {
    color: @{overlay.text_dim};
}

.empty-state-import {
    color: @{alpha(overlay.text_dim,0.5)};
}

.project-drop-overlay {
    background-color: @{alpha(primary,0.10)};
    border-color: @{primary};
}

.project-drop-card {
    color: @{text};
    background-color: @{toolbar.background};
    border-color: @{primary};
}

.project-drop-label {
    color: @{text_dim};
}

.toolbar-vertical {
    @{viewport.toolbar_glass_decor};
    border-width: 1dp;
    border-color: @{border};
    border-radius: @{radius.surface}dp;
    box-shadow: @{viewport.toolbar_shadow};
}

.toolbar-drag-line {
    background-color: @{viewport.icon_disabled};
}

.toolbar-drag-handle:hover .toolbar-drag-line,
.toolbar-dragging .toolbar-drag-line {
    background-color: @{viewport.toolbar_text};
}

.toolbar-hcenter .toolbar-container {
    @{viewport.toolbar_glass_decor};
    border-width: 1dp;
    border-color: @{border};
    border-radius: @{radius.surface}dp;
    box-shadow: @{viewport.toolbar_shadow};
}

.viewport-gizmo-controls .icon-btn {
    @{viewport.gizmo_decor};
    border-color: @{border};
    opacity: 1;
}

.viewport-gizmo-controls .icon-btn img {
    image-color: @{viewport.gizmo_icon};
}

.toolbar-separator {
    background-color: @{alpha(border,0.39)};
}

.viewport-transform-panel {
    @{viewport.toolbar_glass_decor};
    color: @{viewport.toolbar_text};
    border-color: @{border};
    box-shadow: @{viewport.toolbar_shadow};
}

.viewport-export-status {
    background-color: @{toolbar.background};
    border-color: @{border};
    color: @{text};
}

.viewport-transform-meta__tool,
.viewport-transform-axis-label {
    color: @{viewport.toolbar_text};
}

.viewport-transform-axis--split {
    border-color: @{border};
}

.viewport-transform-option-group,
.viewport-transform-tool-group,
.viewport-selection-tool-group {
    background-color: @{alpha(surface,0.42)};
    border-color: @{border};
}

.icon-btn img {
    image-color: @{viewport.icon_dim};
}

.icon-btn:hover {
    background-color: @{viewport.hover_bg};
}

.toolbar-vertical .icon-btn:hover,
.toolbar-hcenter .icon-btn:hover {
    background-color: @{alpha(primary,0.16)};
    border-color: @{primary};
}

.viewport-gizmo-controls .icon-btn:hover {
    @{viewport.gizmo_hover_decor};
    border-color: @{primary};
}

.viewport-gizmo-controls .icon-btn:hover img {
    image-color: @{viewport.gizmo_hover_icon};
}

.icon-btn.selected {
    @{controls.selected_decor};
}

.toolbar-hcenter .icon-btn.selected {
    @{viewport.toolbar_selected_decor};
    border-color: @{border};
}

.toolbar-hcenter .icon-btn.selected img {
    image-color: @{viewport.toolbar_selected_icon};
}

.toolbar-vertical .icon-btn.selected {
    @{viewport.toolbar_selected_decor};
    border-color: @{border};
}

.toolbar-vertical .icon-btn.selected img {
    image-color: @{viewport.toolbar_selected_icon};
}

.viewport-gizmo-controls .icon-btn.selected {
    @{viewport.gizmo_selected_decor};
    border-color: @{primary};
}

.viewport-gizmo-controls .icon-btn.selected img {
    image-color: @{viewport.gizmo_selected_icon};
}

.icon-btn.selected:hover {
    background-color: @{viewport.selected_hover};
}

.toolbar-hcenter .icon-btn.selected:hover {
    @{viewport.toolbar_selected_decor};
    border-color: @{border};
}

.viewport-transform-panel .icon-btn.selected {
    @{viewport.toolbar_selected_decor};
    border-color: @{border};
}

.viewport-transform-panel .icon-btn.selected img {
    image-color: @{viewport.toolbar_selected_icon};
}

.toolbar-vertical .icon-btn.selected:hover {
    @{viewport.toolbar_selected_decor};
    border-color: @{border};
}

.viewport-gizmo-controls .icon-btn.selected:hover {
    @{viewport.gizmo_selected_hover_decor};
    border-color: @{primary};
}

.viewport-gizmo-controls .icon-btn.selected:hover img {
    image-color: @{viewport.gizmo_selected_hover_icon};
}

.icon-btn.selected img {
    image-color: @{controls.selected_icon};
}

.icon-btn.disabled,
.icon-btn.disabled:hover,
.icon-btn.disabled:active {
    background-color: transparent;
    border-color: transparent;
}

.icon-btn.disabled img {
    image-color: @{viewport.icon_disabled};
}

.viewport-gizmo-controls .icon-btn.disabled,
.viewport-gizmo-controls .icon-btn.disabled:hover,
.viewport-gizmo-controls .icon-btn.disabled:active {
    @{viewport.gizmo_decor};
    border-color: @{border};
    opacity: 1;
}

.viewport-gizmo-controls .icon-btn.disabled img {
    image-color: @{viewport.gizmo_disabled_icon};
}

.viewport-metrics-card {
    background-color: @{viewport.metrics_bg};
    border-color: @{primary};
}

.viewport-lod-stats-card {
    background-color: @{viewport.metrics_bg};
    border-color: @{primary};
}

.viewport-lod-stats-title,
.viewport-lod-stats-value {
    color: @{text};
}

.viewport-lod-stats-label {
    color: @{text_dim};
}

.viewport-metrics-label {
    color: @{text_dim};
}

.viewport-metrics-value {
    color: @{text};
}

.viewport-metrics-reason {
    color: @{text_dim};
}

.vram-hud-card {
    background-color: @{surface};
    border-color: @{primary};
    color: @{text};
}

.vram-hud-title,
.vram-hud-summary-value,
.vram-hud-tree-row span {
    color: @{text};
}

.vram-hud-iteration,

.vram-hud-throughput,

.vram-hud-summary-label,

.vram-hud-device,

.vram-hud-counter-label,

.vram-hud-row-header span,

.vram-hud-tree-row em,

.vram-hud-empty,

.vram-hud-expand-toggle {
    color: @{text_dim};
}

.vram-hud-counter-value {
    color: @{text};
}

.vram-hud-tree-row.has-children:hover {
    background-color: @{viewport.hover_bg};
}

.vram-hud-expand-toggle:hover {
    color: @{text};
}

.vram-hud-tree-row.scope-delta .vram-hud-col-delta {
    color: @{primary};
}

.vram-hud-tree-row.scope-timer .vram-hud-col-time {
    color: @{primary};
}

.vram-hud-tabs {
    border-bottom-color: @{border};
}

.vram-hud-tab {
    background-color: transparent;
    color: @{text_dim};
}

.vram-hud-tab:hover {
    color: @{text};
    background-color: @{viewport.hover_bg};
}

.vram-hud-tab.active {
    color: @{text};
    background-color: @{viewport.metrics_bg};
}

.vram-hud-counters-header {
    color: @{text_dim};
}

.vram-hud-counters-empty {
    color: @{text_dim};
}

.perf-hud-tracking-off,
.perf-hud-ledger-header {
    background-color: @{viewport.metrics_bg};
    border-color: @{border};
    color: @{text};
}

.perf-hud-enable-tracking {
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{primary};
    color: @{text};
}

.perf-hud-enable-tracking:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{primary};
}

.perf-hud-ledger-header-detail,
.perf-hud-ledger-note,
.perf-hud-ledger-disclosure,
.perf-hud-ledger-row-header {
    color: @{text_dim};
}

.perf-hud-ledger-process,
.perf-hud-ledger-name,
.perf-hud-ledger-allocated {
    color: @{text};
}

.perf-hud-ledger-row.root {
    border-top-color: @{border};
}

.perf-hud-ledger-row.has-children:hover {
    background-color: @{viewport.hover_bg};
}

.perf-hud-ledger-toggle {
    color: @{text_dim};
}

.perf-hud-ledger-share {
    background-color: @{statusbar.progress_bg};
}

.perf-hud-ledger-share-fill {
    background-color: @{primary};
}

.perf-hud-ledger-closure.closed,
.perf-hud-ledger-row.closed .perf-hud-ledger-badge,
.perf-hud-ledger-row.exact .perf-hud-ledger-badge {
    border-color: @{success};
    color: @{success};
}

.perf-hud-ledger-closure.gap,
.perf-hud-ledger-row.gap .perf-hud-ledger-badge,
.perf-hud-ledger-row.slack .perf-hud-ledger-badge,
.perf-hud-ledger-row.over-budget .perf-hud-ledger-badge {
    border-color: @{warning};
    color: @{warning};
}

.perf-hud-ledger-closure.over,
.perf-hud-ledger-row.over .perf-hud-ledger-badge,
.perf-hud-ledger-row.estimate .perf-hud-ledger-badge,
.perf-hud-ledger-row.degenerate .perf-hud-ledger-badge {
    border-color: @{error};
    color: @{error};
}

.perf-hud-ledger-over-banner {
    background-color: @{alpha(error,0.12)};
    border-color: @{error};
    color: @{error};
}

.perf-hud-ledger-row.nested .perf-hud-ledger-name,
.perf-hud-ledger-row.nested .perf-hud-ledger-allocated,
.perf-hud-ledger-row.nested .perf-hud-ledger-badge {
    color: @{text_dim};
}

.perf-hud-ledger-row.unjustified .perf-hud-ledger-name,
.perf-hud-ledger-row.unjustified .perf-hud-ledger-allocated {
    color: @{warning};
}

.vram-hud-allocs-summary-label,
.vram-hud-allocs-summary-value,
.vram-hud-allocs-pct {
    color: @{text_dim};
}

.vram-hud-allocs-name,
.vram-hud-allocs-bytes {
    color: @{text};
}

.vram-hud-allocs-row {
    background-color: @{viewport.metrics_bg};
    border-radius: @{radius.control}dp;
}

.vram-hud-anno-summary-label,
.vram-hud-anno-cat,
.vram-hud-anno-row-header span {
    color: @{text_dim};
}

.vram-hud-anno-summary-value,
.vram-hud-anno-name,
.vram-hud-anno-bytes,
.vram-hud-anno-peak {
    color: @{text};
}

.vram-hud-anno-wall,
.vram-hud-anno-gpu,
.vram-hud-anno-calls {
    color: @{text_dim};
}

.vram-hud-anno-row {
    background-color: @{viewport.metrics_bg};
    border-radius: @{radius.control}dp;
}

.vram-hud-summary {
    border-bottom-width: 1dp;
    border-bottom-color: @{border};
}

.vram-hud-filter-input {
    background-color: @{viewport.metrics_bg};
    border-color: @{border};
    color: @{text};
}

.vram-hud-filter-input:focus {
    border-color: @{primary};
}

.vram-hud-filter-clear {
    background-color: @{viewport.metrics_bg};
    border-color: @{border};
    color: @{text_dim};
}

.vram-hud-filter-clear:hover {
    background-color: @{viewport.hover_bg};
    color: @{text};
}

.vram-hud-resize {
    background-color: @{alpha(border,0.39)};
}

.vram-hud-resize:hover {
    background-color: @{primary};
}

.viewport-transfer-queue {
    background-color: @{surface};
    border-color: @{border};
    color: @{text};
}
.viewport-transfer-row, .viewport-transfer-footer { border-color: @{border}; }
.viewport-transfer-detail { color: @{text_dim}; }
.viewport-transfer-progress { background-color: @{statusbar.progress_bg}; }
.viewport-transfer-fill { background-color: @{primary}; }

.viewport-status-backdrop {
    background-color: @{viewport.status_backdrop};
}

.viewport-status-panel {
    background-color: @{viewport.panel_bg};
    border-color: @{border};
    border-radius: @{radius.surface}dp;
}

.viewport-status-title {
    color: @{text};
}

.viewport-status-path,
.viewport-status-stage {
    color: @{text_dim};
}

.perf-hud-strip {
    background-color: @{viewport.panel_bg};
    border-color: @{border};
    color: @{text};
}
.perf-hud-strip-rate, .perf-hud-strip-value { color: @{text_dim}; }
.perf-hud-meter-track { background-color: @{statusbar.progress_bg}; }
.perf-hud-meter-fill { background-color: @{primary}; }
.perf-hud-meter-fill.process { background-color: @{primary}; }
.perf-hud-meter-fill.other { background-color: @{alpha(text_dim,0.45)}; }
.perf-hud-meter-fill.free { background-color: @{alpha(text_dim,0.20)}; }
.perf-hud-strip-badge { color: @{success}; }
.perf-hud-strip-meter.warn .perf-hud-meter-fill,
.perf-hud-meter-fill.warn { background-color: @{warning}; }

.vram-hud-timeline-toolbar button, .vram-hud-timeline-legend button { background-color: @{surface_bright}; color: @{text}; border-width: 1dp; border-color: @{border}; }
.vram-hud-timeline-toolbar button:hover, .vram-hud-timeline-legend button:hover { background-color: @{primary_dim}; }
.vram-hud-timeline-tooltip, .vram-hud-export-path { color: @{text_dim}; }
.vram-hud-crosshair { background-color: @{text}; }
.vram-hud-timeline-axis { color: @{text_dim}; }
.vram-hud-timeline-axis span { background-color: @{surface}; }
.vram-hud-timeline-x-axis { color: @{text_dim}; }
.vram-hud-timeline-capacity { color: @{text_dim}; }
.vram-hud-marker { color: @{warning}; }
.vram-hud-health { color: @{warning}; }
.vram-hud-section-title { color: @{text}; }
.vram-hud-mover-row:hover { background-color: @{surface_bright}; }
.vram-hud-delta-positive { color: @{error}; }
.vram-hud-delta-negative { color: @{success}; }
.vram-hud-mover-spark span { background-color: @{primary}; }
.vram-hud-peak-bar { background-color: @{surface_bright}; }
.vram-hud-owner-0 { background-color: @{primary}; }
.vram-hud-owner-1 { background-color: @{secondary}; }
.vram-hud-owner-2 { background-color: @{info}; }
.vram-hud-owner-3 { background-color: @{success}; }
.vram-hud-owner-4 { background-color: @{warning}; }
.vram-hud-owner-5 { background-color: @{primary_dim}; }
.vram-hud-owner-6 { background-color: @{error}; }
.vram-hud-owner-7 { background-color: @{text_dim}; }
.vram-hud-owner-8 { background-color: @{border}; }
.vram-hud-owner-9 { background-color: @{warning}; }
.perf-hud-strip-meter.crit .perf-hud-meter-fill,
.perf-hud-meter-fill.crit { background-color: @{error}; }
.perf-hud-core-bar { background-color: @{primary}; }

.perf-hud-sparkline .histogram-bar-fill {
    background-color: @{primary};
}
.perf-hud-meter-track {
    background-color: @{statusbar.progress_bg};
}

.toolbar-hcenter .align-toolbar {
    decorator: none;
    background-color: @{alpha(toolbar.background,1.0)};
    color: @{text};
}

.gamepad-navigation-indicator { background-color: @{alpha(surface,0.9)}; color: @{text}; }
.gamepad-indicator-label, .gamepad-indicator-panel, .gamepad-indicator-status { color: @{text_dim}; }
.gamepad-indicator-dot { background-color: @{text_dim}; }
.gamepad-navigation-indicator.is-ready .gamepad-indicator-dot { background-color: @{success}; }
.gamepad-navigation-indicator.needs-action .gamepad-indicator-dot { background-color: @{warning}; }

.viewport-gt-color-scale {
    border-color: @{overlay.border};
}

.side-dock-toggle {
    color: @{overlay.icon};
    background-color: transparent;
    border-color: transparent;
}
.side-dock-grip { background-color: @{alpha(overlay.icon,0.55)}; }
.side-dock-toggle:hover,
.side-dock-toggle:focus-visible { background-color: @{alpha(overlay.icon,0.12)}; }
.side-dock-toggle:active { background-color: @{alpha(overlay.icon,0.20)}; }
