/* Shared border roles and shape scale. */

.dock-grip-bar {
    border-radius: 2dp;
}

#tab-bar {
    background-color: @{surface};
}

.dock-grip-bar {
    background-color: transparent;
}

#dock-grip.hover .dock-grip-bar,
#dock-grip.active .dock-grip-bar {
    background-color: @{primary};
}

.dock-toggle-chevron {
    border-color: @{text_dim};
}

#bottom-dock-toggle:hover .dock-toggle-chevron,
#bottom-dock-toggle:focus-visible .dock-toggle-chevron {
    border-color: @{text};
}
