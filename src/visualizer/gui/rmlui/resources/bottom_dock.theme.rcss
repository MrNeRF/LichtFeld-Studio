/* Shared border roles and shape scale. */

.dock-grip-bar {
    border-radius: 2dp;
}

#tab-bar {
    background-color: @{surface};
}

.dock-grip-bar {
    background-color: transparent;
}

#dock-grip.hover .dock-grip-bar {
    background-color: @{right_panel.resize_hover};
}

#dock-grip.active .dock-grip-bar {
    background-color: @{right_panel.resize_active};
}
