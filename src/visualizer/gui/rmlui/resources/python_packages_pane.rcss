body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: Inter;
    background-color: rgb(30, 30, 30);
    color: rgb(229, 229, 229);
}

#window-frame,
#content-wrap,
#content {
    width: 100%;
    height: 100%;
}

#window-frame {
    background-color: rgb(30, 30, 30);
}

#content-wrap,
#content {
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#content {
    display: flex;
    flex-direction: column;
}

#packages-toolbar {
    display: flex;
    align-items: center;
    padding-bottom: 6dp;
    min-width: 0;
    flex-shrink: 0;
}

#packages-refresh {
    height: 24dp;
    min-width: 72dp;
    padding: 0 10dp;
    margin-right: 6dp;
    text-align: center;
    flex-shrink: 0;
}

#packages-search {
    height: 24dp;
    flex: 1;
    min-width: 120dp;
    margin-right: 6dp;
}

#packages-status {
    display: block;
    min-width: 64dp;
    text-align: right;
    color: rgb(150, 150, 150);
    flex-shrink: 0;
}

#packages-table {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-width: 0;
    min-height: 0;
}

.pkg-header,
.pkg-row {
    display: flex;
    align-items: center;
    min-height: 24dp;
    min-width: 0;
    border-bottom-width: 1dp;
    border-bottom-color: rgb(45, 45, 45);
}

.pkg-header {
    font-weight: bold;
    color: rgb(170, 170, 170);
}

.pkg-row {
    font-family: "JetBrains Mono";
    font-size: 11dp;
}

.pkg-name {
    display: block;
    width: 32%;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pkg-version {
    display: block;
    width: 18%;
    min-width: 0;
    color: rgb(150, 150, 150);
    overflow: hidden;
    text-overflow: ellipsis;
}

.pkg-path {
    display: block;
    flex: 1;
    min-width: 0;
    color: rgb(150, 150, 150);
    overflow: hidden;
    text-overflow: ellipsis;
}

#packages-empty {
    display: none;
    padding-top: 12dp;
    color: rgb(150, 150, 150);
}
