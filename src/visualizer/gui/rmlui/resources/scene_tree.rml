<rml>
<head>
    <link type="text/rcss" href="scene_tree.rcss"/>
    <link type="text/rcss" href="history_shared.rcss"/>
</head>
<body id="body">
    <div class="scene-header">
        <div class="scene-header-row">
            <div class="scene-tab-bar">
                <button id="scene-tab" type="button" class="scene-tab"></button>
                <button id="history-tab" type="button" class="scene-tab"></button>
                <button id="logging-tab" type="button" class="scene-tab"></button>
            </div>
            <button id="asset-manager-button"
                    type="button"
                    class="scene-header-icon-button"
                    data-tooltip="toolbar.asset_manager">
                <img id="asset-manager-icon" />
            </button>
        </div>
        <div id="scene-chip-row" class="scene-chip-row">
            <span id="summary-model-chip" class="scene-chip scene-chip--accent"></span>
            <span id="summary-node-chip" class="scene-chip"></span>
            <span id="summary-filter-chip" class="scene-chip"></span>
        </div>
    </div>

    <div id="scene-view">
        <div id="search-container">
            <img id="search-icon" class="row-icon" />
            <input id="filter-input" type="text" placeholder="" />
            <button id="filter-clear" type="button">
                <img />
            </button>
        </div>

        <div id="empty-state" class="empty-state">
            <div id="empty-primary" class="empty-message"></div>
            <div id="empty-secondary" class="empty-message"></div>
        </div>

        <scene-graph id="tree-container" tab-index="auto"></scene-graph>

        <div id="selection-action-bar" class="selection-action-bar">
            <span id="selection-action-count" class="selection-action-count"></span>
            <button id="selection-clear" class="selection-action-button" type="button"
                    data-tooltip="scene.clear_selection"><img id="selection-clear-icon" /></button>
            <span class="selection-action-spacer"></span>
            <button id="selection-visibility" class="selection-action-button" type="button"
                    data-tooltip="scene.hide_selected"><img id="selection-visibility-icon" /></button>
            <button id="selection-training" class="selection-action-button" type="button"
                    data-tooltip="scene.disable_for_training"><img id="selection-training-icon" /></button>
            <button id="selection-delete" class="selection-action-button selection-action-delete" type="button"
                    data-tooltip="scene.delete"><img id="selection-delete-icon" /></button>
        </div>
    </div>

    <div id="history-container">
        <div class="history-summary">
            <div id="history-summary-label" class="history-summary__label text-muted"></div>
            <div id="history-summary-value" class="history-summary__value text-default"></div>
        </div>

        <div id="history-transaction" class="history-transaction status-info"></div>

        <div class="history-actions">
            <button id="history-undo-btn"
                    class="btn btn--primary history-action"
                    type="button"></button>
            <button id="history-redo-btn"
                    class="btn btn--secondary history-action"
                    type="button"></button>
            <button id="history-clear-btn"
                    class="btn btn--ghost history-action history-action--clear"
                    type="button"></button>
        </div>

        <div id="history-note" class="history-note text-muted"></div>

        <div class="separator"></div>

        <div class="history-section">
            <span id="history-undo-title" class="history-section__title text-accent"></span>
            <div class="history-list">
                <span id="history-empty-undo" class="history-empty text-muted"></span>
                <div id="history-undo-list" class="history-stack-item"></div>
            </div>
        </div>

        <div class="separator"></div>

        <div class="history-section">
            <span id="history-redo-title" class="history-section__title text-accent"></span>
            <div class="history-list">
                <span id="history-empty-redo" class="history-empty text-muted"></span>
                <div id="history-redo-list" class="history-stack-item"></div>
            </div>
        </div>
    </div>

    <div id="logging-container">
        <div class="history-summary">
            <div id="logging-summary-label" class="history-summary__label text-muted"></div>
            <div id="logging-summary-value" class="history-summary__value text-default"></div>
        </div>

        <div class="logging-toolbar">
            <div class="logging-level-group">
            <label id="logging-level-label" for="logging-level-select" class="logging-field-label text-muted"></label>
                <select id="logging-level-select" class="logging-level-select">
                    <option id="logging-level-trace" value="trace"></option>
                    <option id="logging-level-debug" value="debug"></option>
                    <option id="logging-level-info" value="info"></option>
                    <option id="logging-level-performance" value="performance"></option>
                    <option id="logging-level-warn" value="warn"></option>
                    <option id="logging-level-error" value="error"></option>
                    <option id="logging-level-critical" value="critical"></option>
                    <option id="logging-level-off" value="off"></option>
                </select>
            </div>

            <div class="logging-actions">
                <button id="logging-export-btn"
                        class="btn btn--secondary history-action"
                        type="button"></button>
                <button id="logging-copy-btn"
                        class="btn btn--secondary history-action"
                        type="button"></button>
            </div>
        </div>

        <div id="logging-feedback" class="logging-feedback status-info"></div>
        <div id="logging-note" class="history-note text-muted"></div>

        <div class="separator"></div>

        <div id="logging-scroll" class="logging-scroll">
            <span id="logging-empty" class="history-empty text-muted"></span>
            <div id="logging-list" class="logging-list"></div>
        </div>
    </div>
</body>
</rml>
