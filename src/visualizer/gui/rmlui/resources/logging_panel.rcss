/* Compact log table using the shared utility window and controls. */
#content-wrap { padding: 0; overflow: hidden; min-width: 0; min-height: 0; }
#content { display: flex; flex-direction: column; flex: 1; min-width: 0; min-height: 0; }
.log-search-bar, .log-controls, .log-actions, .log-footer {
    display: flex; align-items: center; gap: 8dp; padding: 8dp 12dp;
    flex-shrink: 0; min-width: 0;
}
.log-search-bar, .log-controls, .log-actions { flex-wrap: wrap; }
.log-search { flex: 1; min-width: 180dp; }
.log-source-filter { width: 160dp; }
.log-search-box { position: relative; display: flex; align-items: center; min-height: 28dp; }
.log-search-box input[type="text"] {
    flex: 1; min-width: 0; box-sizing: border-box; height: 28dp; min-height: 28dp;
    padding: 5dp 10dp; border-width: 1dp; font-size: 12dp; line-height: 16dp;
}
.log-placeholder {
    position: absolute; left: 10dp; right: 10dp; top: 6dp; line-height: 16dp;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none;
}
.log-search-bar .btn, .log-actions .btn, .log-footer .btn {
    box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center;
    height: 28dp; min-height: 28dp; padding: 0 10dp; font-size: 12dp;
}
.log-control { display: flex; align-items: center; gap: 6dp; }
.log-control select { width: 112dp; height: 26dp; min-height: 26dp; font-size: 12dp; }
.log-live { margin-left: auto; font-size: 11dp; }
.log-column-header, .log-row { display: flex; align-items: flex-start; min-width: 0; }
.log-column-header { padding: 6dp 12dp; flex-shrink: 0; font-size: 11dp; border-bottom-width: 1dp; }
#log-scroll { flex: 1; min-height: 0; min-width: 0; overflow: auto; }
.log-row { padding: 5dp 12dp; border-bottom-width: 1dp; font-size: 12dp; line-height: 17dp; }
.log-time { width: 98dp; min-width: 98dp; font-family: "JetBrains Mono"; font-size: 11dp; }
.log-level { width: 82dp; min-width: 82dp; font-size: 11dp; }
.log-source { width: 165dp; min-width: 165dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11dp; }
.log-message { flex: 1; min-width: 180dp; white-space: pre-wrap; word-break: break-all; font-family: "JetBrains Mono"; }
.log-rows--nowrap .log-message { white-space: pre; }
.log-empty { padding: 32dp 12dp; text-align: center; }
.log-summary { flex: 1; min-width: 0; font-size: 11dp; }
.log-footer { border-top-width: 1dp; }
.log-feedback { padding: 4dp 12dp 8dp; font-size: 11dp; }
.hidden { display: none; }
