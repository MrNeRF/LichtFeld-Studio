/* Viewport overlay: toolbars plus retained status dialogs.
 * Shared widget styles are in components.rcss (auto-included via applyTheme). */

body {
    font-family: Inter;
    width: 100%;
    height: 100%;
    position: relative;
}

#dm-root {
    position: relative;
    width: 100%;
    height: 100%;
}

.viewport-split-divider {
    position: absolute;
    pointer-events: none;
    z-index: 1;
}

.viewport-frame-border {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4dp;
    pointer-events: none;
    z-index: 1;
}

.left-dock-resize-indicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 12;
}

.project-drop-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-width: 2dp;
    border-radius: 8dp;
    pointer-events: none;
    z-index: 30;
}

.project-drop-overlay.hidden {
    display: none;
}

.project-drop-card {
    max-width: 420dp;
    padding: 14dp 20dp;
    border-width: 1dp;
    border-radius: 8dp;
    text-align: center;
}

.project-drop-title {
    font-size: 17dp;
    font-weight: 600;
}

.project-drop-label {
    margin-top: 5dp;
    font-size: 13dp;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.panel-toolbar-root {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
}

.panel-toolbar-root.toolbar-position-top,
.panel-toolbar-root.toolbar-position-free {
    align-items: flex-start;
}

.toolbar-container {
    display: flex;
    padding: 0;
    gap: 0;
}

.toolbar-vertical {
    position: relative;
    left: 0;
    width: 38dp;
    height: auto;
    padding: 5dp 3dp;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
    overflow: hidden;
}

.toolbar-position-top .toolbar-vertical {
    margin-top: 12dp;
}

.toolbar-drag-handle {
    display: none;
    width: 30dp;
    height: 12dp;
    margin: 0 0 2dp 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2dp;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.toolbar-position-free .toolbar-drag-handle {
    display: flex;
}

.toolbar-drag-line {
    display: block;
    width: 13dp;
    height: 1dp;
}

.toolbar-vertical .icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30dp;
    height: 30dp;
    min-width: 30dp;
    min-height: 30dp;
    margin: 1dp 0;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 6dp;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background-color border-color 0.12s quadratic-out;
}

.toolbar-vertical .icon-btn.selected {
    padding: 3dp;
    border-width: 1dp;
}

.toolbar-vertical .icon-btn img {
    width: 20dp;
    height: 20dp;
}

.toolbar-vertical .rail-columns,
.toolbar-vertical .rail-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.toolbar-vertical.rail-tools-empty .rail-group--tools,
.toolbar-vertical.rail-panels-empty .rail-group--panels,
.toolbar-vertical.rail-tools-empty .rail-columns > .toolbar-separator,
.toolbar-vertical.rail-panels-empty .rail-columns > .toolbar-separator {
    display: none;
}

.toolbar-vertical.rail-two-column {
    width: auto;
}

.toolbar-vertical.rail-two-column .rail-columns {
    flex-direction: row;
    align-items: stretch;
}

.toolbar-vertical.rail-two-column .rail-columns > .toolbar-separator {
    width: 1dp;
    height: auto;
    margin: 0 5dp;
}

.toolbar-vertical.rail-compact .icon-btn {
    width: 26dp;
    height: 26dp;
    min-width: 26dp;
    min-height: 26dp;
    margin: 0;
    padding: 2dp;
}

.toolbar-vertical.rail-compact .icon-btn img {
    width: 18dp;
    height: 18dp;
}

.toolbar-vertical.rail-compact .rail-columns > .toolbar-separator {
    margin-top: 4dp;
    margin-bottom: 3dp;
}

.viewport-gizmo-controls {
    position: absolute;
    top: 108dp;
    right: 10dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 95dp;
    gap: 3dp;
    pointer-events: none;
    z-index: 8;
}

.viewport-gizmo-control-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 95dp;
    gap: 3dp;
    pointer-events: auto;
}

.viewport-gizmo-controls .icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 27dp;
    height: 27dp;
    min-width: 27dp;
    min-height: 27dp;
    margin: 0;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 5dp;
    box-sizing: border-box;
    flex-shrink: 0;
    opacity: 0.88;
    transition: background-color border-color opacity 0.12s quadratic-out;
}

.viewport-gizmo-controls .icon-btn:hover,
.viewport-gizmo-controls .icon-btn.selected {
    opacity: 1;
}

.viewport-gizmo-controls .icon-btn img {
    width: 18dp;
    height: 18dp;
}

.toolbar-hcenter {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
}

.toolbar-hcenter > div {
    pointer-events: auto;
}

.toolbar-hcenter .toolbar-container {
    align-items: center;
    padding: 5dp 6dp;
    border-radius: 6dp;
    box-sizing: border-box;
}

.toolbar-hcenter .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30dp;
    height: 30dp;
    min-width: 30dp;
    min-height: 30dp;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 6dp;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background-color border-color 0.12s quadratic-out;
}

.toolbar-hcenter .icon-btn img {
    width: 20dp;
    height: 20dp;
}

.toolbar-layer-primary {
    top: 5dp;
}

.crop-roi-popover {
    position: absolute;
    top: 42dp;
    left: 50%;
    width: 440dp;
    margin-left: -220dp;
    padding: 8dp 10dp;
    display: flex;
    flex-direction: column;
    gap: 3dp;
    border-width: 1dp;
    border-radius: 6dp;
    box-sizing: border-box;
    pointer-events: auto;
    z-index: 10;
}

.crop-roi-popover.hidden {
    display: none;
}

.crop-roi-popover-title {
    height: 20dp;
    line-height: 20dp;
    font-size: 12dp;
    font-weight: bold;
}

.crop-roi-setting-row > .setting-row__label-col {
    width: 180dp;
    min-width: 180dp;
}

.crop-roi-setting-row .setting-slider {
    height: 22dp;
    min-height: 22dp;
}

.crop-roi-setting-row .slider-value {
    width: 42dp;
    min-width: 42dp;
}

.viewport-selection-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-depth-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-transform-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-depth-header {
    flex-wrap: nowrap;
    align-items: center;
}

.viewport-transform-meta.viewport-depth-meta {
    min-width: 0;
    max-width: none;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 24dp;
}

.viewport-transform-meta.viewport-depth-meta .viewport-transform-meta__tool {
    line-height: 24dp;
    font-size: 12dp;
    white-space: nowrap;
}

#depth-view-block .viewport-transform-meta.viewport-depth-meta {
    min-height: 22dp;
}

#depth-view-block .viewport-transform-meta.viewport-depth-meta .viewport-transform-meta__tool {
    line-height: 22dp;
}

.viewport-depth-mode-select {
    width: 112dp;
    min-width: 112dp;
    height: 24dp;
    min-height: 24dp;
    font-size: 12dp;
    line-height: 22dp;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

#depth-view-block .viewport-depth-mode-select {
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
}

.viewport-depth-mode-select selectvalue {
    height: 22dp;
    line-height: 22dp;
    margin-right: 20dp;
    padding: 0 0 0 8dp;
    position: relative;
    top: 0;
}

#depth-view-block .viewport-depth-mode-select selectvalue {
    height: 20dp;
    line-height: 20dp;
}

.viewport-depth-mode-select selectarrow {
    width: 20dp;
    height: 22dp;
    line-height: 22dp;
    position: relative;
    top: 0;
}

#depth-view-block .viewport-depth-mode-select selectarrow {
    height: 20dp;
    line-height: 20dp;
}

.viewport-selection-depth-fields {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6dp;
    flex-grow: 1;
}

#selection-block .viewport-selection-depth-fields {
    flex-wrap: nowrap;
    gap: 10dp;
    flex-grow: 0;
    flex-shrink: 1;
    position: relative;
}

/* Vertically center the 4dp track (and its progress fill) inside the 22dp
   slider box so it lines up with the label and value box; the thumb keeps
   its -3dp offset relative to the track line. */
#selection-block .viewport-selection-slider slidertrack {
    margin-top: 8dp;
}

#selection-block .viewport-selection-slider sliderbar {
    margin-top: 5dp;
}

#selection-block .viewport-selection-depth-axis {
    gap: 6dp;
}

/* Sub-rows: Near/Far and Size/X/Y ride side by side on one line at full
   width and stack as whole units when the row wraps. */
#selection-block .depth-axis-group {
    display: flex;
    align-items: center;
    gap: 10dp;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

/* Depth toolbar width tiers:
   >1480dp: Near/Far and Size/X/Y on one line.
   >960dp through 1480dp: Near/Far above Size/X/Y.
   <=960dp: icons only; depth fields hidden. No taller stack.
   Breakpoints derive from the effective cascade; see calculations above each @media. */
#selection-block .viewport-selection-depth-axis {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 330dp;
}

#selection-block .viewport-selection-depth-fields {
    flex-grow: 1;
}

#selection-block .viewport-selection-slider {
    min-width: 56dp;
    max-width: 240dp;
    flex-grow: 1;
    flex-shrink: 1;
}

#selection-block .viewport-selection-depth-axis > .number-input.viewport-selection-depth-input {
    /* Content-fit, never grows: the global .number-input flex: 1 would split
       the axis's spare width with the slider. RmlUi cannot size a text input
       to its content, so a tight fixed width stands in for it. */
    flex-grow: 0;
    flex-shrink: 0;
    width: 50dp;
    min-width: 50dp;
}

/* The chip labels the depth sliders' target panel in independent-dual only.
   Keep it inside Near/Far to avoid an extra wrapped line with the sync toggle.
   Keep this selector a descendant match so styling applies at every width. */
#selection-block .viewport-selection-depth-panel-chip {
    flex-grow: 0;
    flex-shrink: 0;
    width: 20dp;
    height: 20dp;
    line-height: 20dp;
    text-align: center;
    font-size: 12dp;
    font-weight: bold;
    border-radius: 4dp;
    /* Palette fill belongs in viewport_overlay.theme.rcss; see
       docs/docs/development/rmlui-styling.md, Theme Tokens. */
}

#selection-block .depth-axis-size > .number-input.viewport-selection-depth-input {
    /* Wide enough for the anisotropic "63x45%" Size readout at 1.5x UI scale. */
    width: 104dp;
    min-width: 104dp;
}

/* Wrap uses context width M (viewport + left dock), in every split mode.
   RmlUi media queries use context dimensions; top-level #selection-block has
   left 52dp/right 12dp, so its panel content width is A(M) = .65 * (M - 64).

   One-line minimum, with in-flow buttons (all dimensions in dp):
     Near/Far/X/Y axis = label 24 + gap 6 + slider 56 + gap 6 + input 50 = 142
     Size axis        = 24 + 6 + 56 + 6 + input 104                    = 196
     Near/Far group   = chip 20 + 10 + 142 + 10 + 142                  = 324
     Size/X/Y group   = 196 + 10 + 142 + 10 + 142                      = 500
     Full row         = 324 + 10 + 500 + 10 + button 30 + 10 + 30      = 914

   Fit requires M >= 914/.65 + 64 = 1470.154; 1471dp is the first whole dp.
   Wrap at 1480dp gives A=920.4dp, with 6.4dp spare. Without chip and sync
   (Primary/Secondary comparison), the 844dp row needs M>=1362.462, so this
   breakpoint covers it too. */
@media (max-width: 1480dp) {
    /* Center Near/Far above Size/X/Y with equal slider lengths.
       Pin one action button to the right of each line; this RmlUi has no flex
       `order`, so flow would place both on the last line.
       Sync shares the chip's independent-dual visibility and sits beside Near/Far.
       Viz stays beside Size/X/Y whenever the depth row is shown. */
    #selection-block .viewport-selection-depth-fields {
        flex-wrap: wrap;
        /* Reserve 36dp on the right for one 30dp button plus 6dp clearance.
           Mirror it on the left to keep both lines centered. Buttons use the padding
           box (right: 0), while flex-basis:100% uses the content box. Include both
           reserves (72dp total) when calculating line width and the hide breakpoint. */
        padding-right: 36dp;
        padding-left: 36dp;
    }
    #selection-block .depth-axis-group {
        flex-basis: 100%;
        justify-content: center;
    }
    #selection-block .depth-axis-group .viewport-selection-slider {
        width: 90dp;
        min-width: 56dp;
        max-width: 150dp;
    }
    #selection-block .viewport-selection-depth-fields > .viewport-transform-action {
        position: absolute;
        right: 0;
    }
    /* Keep one button per line on the same right edge. Center each 30dp button
       on its 24dp line with -3dp outer offsets. The 58dp row (24 + 10 + 24)
       then has a 4dp button gap; flush top/bottom placement would overlap by 2dp.
       The 3dp overhang fits inside the 4dp upper gap and 5dp bottom padding,
       leaving row height and panel-bottom clearance unchanged. */
    #selection-block .viewport-selection-depth-fields > .viewport-selection-sync-action {
        top: -3dp;
    }
    #selection-block .viewport-selection-depth-fields > .viewport-selection-viz-action {
        bottom: -3dp;
    }
    /* With depth fields visible, the panel (z-index 9, pointer-events auto)
       can cover the viewport gizmos (z-index 8). The 72dp row reserve protects
       only its own buttons. A split divider can put primary gizmos at any x,
       so horizontal clearance cannot protect them.

       Panel bottom = top 5 + border 1 + padding 5 + icon row 32 + gap 4
                      + fields height + padding 5 + border 1 = 53 + fields.
       One line: max(axis 24, in-flow button 30) = 30; bottom 83, leaving 25dp
       below the stock gizmo top 108. Two lines: 24 + gap 10 + 24 = 58; bottom
       111, so top 120 leaves 9dp. Three lines cannot clear stock top 108.
       Absolute buttons add no row height; the lower button ends at 108,
       inside the panel. Move gizmos in this tier and restore top when fields
       hide. These width rules also move gizmos when depth/GT state hides fields. */
    .viewport-gizmo-controls {
        top: 120dp;
    }
}

/* Hide is the final tier: widths that cannot fit two lines hide the row.
   Size/X/Y is the binding line at 500dp. Two 36dp reserves leave
     L(M) = .65 * (M - 64) - 72.
   Each reserve is button 30 + clearance 6; the buttons occupy one line
   each, and matching left padding centers the groups.
   The exact fit is M = (500 + 72)/.65 + 64 = 944dp. At 960dp, L=510.4dp
   leaves 10.4dp spare. Sliders are already at their 56dp floor, so
   332 + 3*56 = 500dp cannot shrink further.

   Near/Far needs 324dp, fitting at M=(324+72)/.65+64=673.231dp. These
   minima use #selection-block's ID-qualified axis rules: gap 6dp and
   flex-shrink 1, overriding generic gap 3dp/shrink 0. The chosen 960dp
   clears both lines. Above 1480dp buttons return to flow; reserves no
   longer apply. */
@media (max-width: 960dp) {
    #selection-block .viewport-selection-depth-fields {
        display: none;
    }
    /* The wrap query also matches here, so restore the controls' top from 120dp
       to 108dp. With only the icon row, the panel bottom is
       5 + 1 + 5 + 32 + 5 + 1 = 49dp, leaving 59dp clearance. */
    .viewport-gizmo-controls {
        top: 108dp;
    }
}

.viewport-selection-depth-axis {
    display: flex;
    align-items: center;
    gap: 3dp;
    min-width: 0;
    flex-shrink: 0;
}

.viewport-selection-depth-axis > .viewport-transform-axis-label {
    width: 24dp;
    min-width: 24dp;
}

.viewport-selection-slider {
    width: 112dp;
    min-width: 112dp;
    height: 22dp;
    min-height: 22dp;
    margin-top: 0;
    position: relative;
    top: 0;
}

.viewport-selection-depth-axis > .number-input.viewport-selection-depth-input {
    /* Wide enough for the anisotropic "63x45%" Size readout at 1.5x UI scale
       (88dp still clipped the percent sign). */
    width: 104dp;
    min-width: 104dp;
    height: 24dp;
    min-height: 24dp;
    padding: 2dp 5dp;
    line-height: 18dp;
    font-size: 12dp;
    box-sizing: border-box;
}

.viewport-depth-fields {
    flex-grow: 0;
    flex-shrink: 0;
    flex-wrap: nowrap;
    gap: 8dp;
}

#depth-view-block .viewport-depth-fields {
    gap: 5dp;
}

.viewport-depth-axis {
    gap: 4dp;
    height: 24dp;
    min-height: 24dp;
}

#depth-view-block .viewport-depth-axis {
    height: 22dp;
    min-height: 22dp;
    gap: 3dp;
}

.viewport-depth-axis > .viewport-transform-axis-label {
    width: auto;
    min-width: 0;
    font-size: 12dp;
    line-height: 24dp;
    text-align: left;
}

#depth-view-block .viewport-depth-axis > .viewport-transform-axis-label {
    line-height: 22dp;
}

.viewport-selection-slider.viewport-depth-slider {
    width: 128dp;
    min-width: 128dp;
    height: 24dp;
    min-height: 24dp;
    top: 3dp;
}

#depth-view-block .viewport-selection-slider.viewport-depth-slider {
    height: 22dp;
    min-height: 22dp;
    top: 0;
}

#depth-view-block .viewport-depth-axis > .scrub-field {
    width: 112dp;
    min-width: 112dp;
    height: 22dp;
    min-height: 22dp;
}

#depth-view-block .viewport-depth-axis > .viewport-depth-step-btn {
    width: 18dp;
    min-width: 18dp;
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
    padding: 0 0 1dp 0;
    margin-left: 0;
    font-size: 12dp;
    border-radius: 4dp;
    box-sizing: border-box;
    flex-shrink: 0;
}

#depth-view-block .viewport-depth-axis > .viewport-depth-step-btn:disabled {
    opacity: 0.45;
    cursor: default;
}

.viewport-selection-actions {
    margin-left: 0;
}

.viewport-depth-actions {
    margin-left: 0;
}

.viewport-transform-panel {
    pointer-events: auto;
    min-width: 360dp;
    max-width: 100%;
    padding: 7dp 8dp;
    border-width: 1dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6dp;
}

.viewport-transform-panel.viewport-selection-panel {
    min-width: 600dp;
}

#selection-block .viewport-selection-panel {
    min-width: 0;
    /* Window-relative: the panel tracks the viewport width and the sliders
       grow into it (capped below), instead of collapsing to the icon row. */
    width: 65%;
    max-width: 1500dp;
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 4dp;
}

.viewport-transform-panel.viewport-depth-panel {
    min-width: 624dp;
}

#depth-view-block .viewport-depth-panel {
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 0;
    min-width: 0;
}

#gt-compare-mode-block .viewport-gt-compare-panel {
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 0;
    min-width: 0;
}

#gt-compare-mode-block .viewport-gt-compare-mode-select {
    width: 120dp;
    min-width: 120dp;
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
}

.viewport-gt-color-legend {
    width: 240dp;
    min-width: 240dp;
    margin-top: 4dp;
}

.viewport-gt-color-scale {
    width: 240dp;
    height: 10dp;
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
    border-width: 1dp;
    border-color: #585b70;
    border-radius: 3dp;
}

.viewport-gt-color-scale__segment {
    display: block;
    width: 0;
    height: 8dp;
    flex-grow: 1;
    flex-shrink: 0;
}

.viewport-gt-color-scale__segment--loss-lowest {
    decorator: horizontal-gradient(#000000 #380578);
}

.viewport-gt-color-scale__segment--loss-low {
    decorator: horizontal-gradient(#380578 #b81f4a);
}

.viewport-gt-color-scale__segment--loss-medium {
    decorator: horizontal-gradient(#b81f4a #fca60a);
}

.viewport-gt-color-scale__segment--loss-high {
    decorator: horizontal-gradient(#fca60a #ffffbf);
}

.viewport-gt-color-scale__segment--depth-far {
    flex-grow: 20;
    decorator: horizontal-gradient(#0d0a26 #0f3280);
}

.viewport-gt-color-scale__segment--depth-far-mid {
    flex-grow: 23;
    decorator: horizontal-gradient(#0f3280 #0080a6);
}

.viewport-gt-color-scale__segment--depth-mid {
    flex-grow: 24;
    decorator: horizontal-gradient(#0080a6 #5cbb69);
}

.viewport-gt-color-scale__segment--depth-near-mid {
    flex-grow: 19;
    decorator: horizontal-gradient(#5cbb69 #f6d14d);
}

.viewport-gt-color-scale__segment--depth-near {
    flex-grow: 14;
    decorator: horizontal-gradient(#f6d14d #fb6e20);
}

