/* Viewport overlay: toolbars plus retained status dialogs.
 * Shared widget styles are in components.rcss (auto-included via applyTheme). */

body {
    font-family: Inter;
    width: 100%;
    height: 100%;
    position: relative;
}

#dm-root {
    position: relative;
    width: 100%;
    height: 100%;
}

.viewport-split-divider {
    position: absolute;
    pointer-events: none;
    z-index: 1;
}

.viewport-frame-border {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4dp;
    pointer-events: none;
    z-index: 1;
}

.left-dock-resize-indicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 12;
}

.project-drop-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-width: 2dp;
    border-radius: 8dp;
    pointer-events: none;
    z-index: 30;
}

.project-drop-overlay.hidden {
    display: none;
}

.project-drop-card {
    max-width: 420dp;
    padding: 14dp 20dp;
    border-width: 1dp;
    border-radius: 8dp;
    text-align: center;
}

.project-drop-title {
    font-size: 17dp;
    font-weight: 600;
}

.project-drop-label {
    margin-top: 5dp;
    font-size: 13dp;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.panel-toolbar-root {
    position: absolute;
    top: 0;
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
}

.panel-toolbar-root.toolbar-position-top,
.panel-toolbar-root.toolbar-position-free {
    align-items: flex-start;
}

.toolbar-container {
    display: flex;
    padding: 0;
    gap: 0;
}

.toolbar-vertical {
    position: relative;
    left: 0;
    width: 38dp;
    height: auto;
    padding: 5dp 3dp;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
    overflow: hidden;
}

.toolbar-position-top .toolbar-vertical {
    margin-top: 12dp;
}

.toolbar-drag-handle {
    display: none;
    width: 30dp;
    height: 12dp;
    margin: 0 0 2dp 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2dp;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.toolbar-position-free .toolbar-drag-handle {
    display: flex;
}

.toolbar-drag-line {
    display: block;
    width: 13dp;
    height: 1dp;
}

.toolbar-vertical .icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30dp;
    height: 30dp;
    min-width: 30dp;
    min-height: 30dp;
    margin: 1dp 0;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 6dp;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background-color border-color 0.12s quadratic-out;
}

.toolbar-vertical .icon-btn.selected {
    padding: 3dp;
    border-width: 1dp;
}

.toolbar-vertical .icon-btn img {
    width: 20dp;
    height: 20dp;
}

.toolbar-vertical .rail-columns,
.toolbar-vertical .rail-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.toolbar-vertical.rail-tools-empty .rail-group--tools,
.toolbar-vertical.rail-panels-empty .rail-group--panels,
.toolbar-vertical.rail-tools-empty .rail-columns > .toolbar-separator,
.toolbar-vertical.rail-panels-empty .rail-columns > .toolbar-separator {
    display: none;
}

.toolbar-vertical.rail-two-column {
    width: auto;
}

.toolbar-vertical.rail-two-column .rail-columns {
    flex-direction: row;
    align-items: stretch;
}

.toolbar-vertical.rail-two-column .rail-columns > .toolbar-separator {
    width: 1dp;
    height: auto;
    margin: 0 5dp;
}

.toolbar-vertical.rail-compact .icon-btn {
    width: 26dp;
    height: 26dp;
    min-width: 26dp;
    min-height: 26dp;
    margin: 0;
    padding: 2dp;
}

.toolbar-vertical.rail-compact .icon-btn img {
    width: 18dp;
    height: 18dp;
}

.toolbar-vertical.rail-compact .rail-columns > .toolbar-separator {
    margin-top: 4dp;
    margin-bottom: 3dp;
}

.viewport-gizmo-controls {
    position: absolute;
    top: 108dp;
    right: 10dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 95dp;
    gap: 3dp;
    pointer-events: none;
    z-index: 8;
}

.viewport-gizmo-control-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 95dp;
    gap: 3dp;
    pointer-events: auto;
}

.viewport-gizmo-controls .icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 27dp;
    height: 27dp;
    min-width: 27dp;
    min-height: 27dp;
    margin: 0;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 5dp;
    box-sizing: border-box;
    flex-shrink: 0;
    opacity: 0.88;
    transition: background-color border-color opacity 0.12s quadratic-out;
}

.viewport-gizmo-controls .icon-btn:hover,
.viewport-gizmo-controls .icon-btn.selected {
    opacity: 1;
}

.viewport-gizmo-controls .icon-btn img {
    width: 18dp;
    height: 18dp;
}

.toolbar-hcenter {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
}

.toolbar-hcenter > div {
    pointer-events: auto;
}

.toolbar-hcenter .toolbar-container {
    align-items: center;
    padding: 5dp 6dp;
    border-radius: 6dp;
    box-sizing: border-box;
}

.toolbar-hcenter .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30dp;
    height: 30dp;
    min-width: 30dp;
    min-height: 30dp;
    padding: 3dp;
    border-width: 1dp;
    border-color: transparent;
    border-radius: 6dp;
    box-sizing: border-box;
    flex-shrink: 0;
    transition: background-color border-color 0.12s quadratic-out;
}

.toolbar-hcenter .icon-btn img {
    width: 20dp;
    height: 20dp;
}

.toolbar-layer-primary {
    top: 5dp;
}

.crop-roi-popover {
    position: absolute;
    top: 42dp;
    left: 50%;
    width: 440dp;
    margin-left: -220dp;
    padding: 8dp 10dp;
    display: flex;
    flex-direction: column;
    gap: 3dp;
    border-width: 1dp;
    border-radius: 6dp;
    box-sizing: border-box;
    pointer-events: auto;
    z-index: 10;
}

.crop-roi-popover.hidden {
    display: none;
}

.crop-roi-popover-title {
    height: 20dp;
    line-height: 20dp;
    font-size: 12dp;
    font-weight: bold;
}

.crop-roi-setting-row > .setting-row__label-col {
    width: 180dp;
    min-width: 180dp;
}

.crop-roi-setting-row .setting-slider {
    height: 22dp;
    min-height: 22dp;
}

.crop-roi-setting-row .slider-value {
    width: 42dp;
    min-width: 42dp;
}

.viewport-selection-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-depth-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-transform-overlay {
    position: absolute;
    top: 5dp;
    left: 52dp;
    right: 12dp;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 9;
}

.viewport-depth-header {
    flex-wrap: nowrap;
    align-items: center;
}

.viewport-transform-meta.viewport-depth-meta {
    min-width: 0;
    max-width: none;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 24dp;
}

.viewport-transform-meta.viewport-depth-meta .viewport-transform-meta__tool {
    line-height: 24dp;
    font-size: 12dp;
    white-space: nowrap;
}

#depth-view-block .viewport-transform-meta.viewport-depth-meta {
    min-height: 22dp;
}

#depth-view-block .viewport-transform-meta.viewport-depth-meta .viewport-transform-meta__tool {
    line-height: 22dp;
}

.viewport-depth-mode-select {
    width: 112dp;
    min-width: 112dp;
    height: 24dp;
    min-height: 24dp;
    font-size: 12dp;
    line-height: 22dp;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

#depth-view-block .viewport-depth-mode-select {
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
}

.viewport-depth-mode-select selectvalue {
    height: 22dp;
    line-height: 22dp;
    margin-right: 20dp;
    padding: 0 0 0 8dp;
    position: relative;
    top: 0;
}

#depth-view-block .viewport-depth-mode-select selectvalue {
    height: 20dp;
    line-height: 20dp;
}

.viewport-depth-mode-select selectarrow {
    width: 20dp;
    height: 22dp;
    line-height: 22dp;
    position: relative;
    top: 0;
}

#depth-view-block .viewport-depth-mode-select selectarrow {
    height: 20dp;
    line-height: 20dp;
}

.viewport-selection-depth-fields {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6dp;
    flex-grow: 1;
}

#selection-block .viewport-selection-depth-fields {
    flex-wrap: nowrap;
    gap: 10dp;
    flex-grow: 0;
    flex-shrink: 1;
    position: relative;
}

/* Vertically center the 4dp track (and its progress fill) inside the 22dp
   slider box so it lines up with the label and value box; the thumb keeps
   its -3dp offset relative to the track line. */
#selection-block .viewport-selection-slider slidertrack {
    margin-top: 8dp;
}

#selection-block .viewport-selection-slider sliderbar {
    margin-top: 5dp;
}

#selection-block .viewport-selection-depth-axis {
    gap: 6dp;
}

/* Sub-rows: Near/Far and Size/X/Y ride side by side on one line at full
   width and stack as whole units when the row wraps. */
#selection-block .depth-axis-group {
    display: flex;
    align-items: center;
    gap: 10dp;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

/* Narrow-width behavior, breakpoint style. The depth toolbar has EXACTLY
   THREE width states -- a layout that cannot be fitted is hidden
   outright rather than restacked into more lines:
     > 1480dp       one line   (Near/Far and Size/X/Y side by side)
     961 - 1480dp   two lines  (Near/Far above, Size/X/Y below)
     <= 960dp       hidden     (icon toolbar only)
   There is no stacked tier. A layout that cannot fit on two lines is not laid
   out at all. Both numbers are derived from the effective cascade, not chosen
   -- the derivations sit above each @media block below. */
#selection-block .viewport-selection-depth-axis {
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 330dp;
}

#selection-block .viewport-selection-depth-fields {
    flex-grow: 1;
}

#selection-block .viewport-selection-slider {
    min-width: 56dp;
    max-width: 240dp;
    flex-grow: 1;
    flex-shrink: 1;
}

#selection-block .viewport-selection-depth-axis > .number-input.viewport-selection-depth-input {
    /* Content-fit, never grows: the global .number-input flex: 1 would split
       the axis's spare width with the slider. RmlUi cannot size a text input
       to its content, so a tight fixed width stands in for it. */
    flex-grow: 0;
    flex-shrink: 0;
    width: 50dp;
    min-width: 50dp;
}

/* Focused-panel chip: which split panel the depth sliders address. Present
   only in independent-dual split, where two windows exist. It is a member of
   the Near/Far group (viewport_overlay.rml), NOT a direct child of the
   wrapping row: as a direct child it was a 20dp item ahead of a
   flex-basis:100% group and therefore claimed a whole line of its own below
   the wrap breakpoint, which the top-pinned sync toggle then shared. This
   selector stays a descendant match, so the chip's appearance is unchanged
   at every width. */
#selection-block .viewport-selection-depth-panel-chip {
    flex-grow: 0;
    flex-shrink: 0;
    width: 20dp;
    height: 20dp;
    line-height: 20dp;
    text-align: center;
    font-size: 12dp;
    font-weight: bold;
    border-radius: 4dp;
    /* The chip's fill is a palette value, so it lives in the sibling theme file
       (viewport_overlay.theme.rcss), not here -- docs/docs/development/
       rmlui-styling.md "Theme Tokens". */
}

#selection-block .depth-axis-size > .number-input.viewport-selection-depth-input {
    /* Wide enough for the anisotropic "63x45%" Size readout at 1.5x UI scale. */
    width: 104dp;
    min-width: 104dp;
}

/* WRAP breakpoint, derived rather than chosen.

   Both this rule and the hide rule below key on the SAME measure: RmlUi
   evaluates `max-width` against the CONTEXT dimensions
   (StyleSheetContainer::UpdateCompiledStyleSheet -> vp_dimensions.x), and this
   overlay's context is set to the viewport plus the left dock
   (gui_manager.cpp `overlay_size`, RmlViewportOverlay::setViewportBounds ->
   SetDimensions). `#selection-block` is a top-level child of that context --
   NOT a child of #primary-toolbar-root -- so its band is `left: 52dp;
   right: 12dp` of the context in EVERY split mode, and the panel is 65% of
   that band in every split mode too. There is no window-vs-band mismatch:
   what was wrong was the NUMBER.

   Above this breakpoint the row is `nowrap` and the two action buttons are in
   flow, so ONE line must hold everything:
     axis (Near/Far/X/Y) = label 24 + gap 6 + slider 56 + gap 6 + input 50 = 142
     axis (Size)         = label 24 + gap 6 + slider 56 + gap 6 + input 104 = 196
     Near/Far group      = chip 20 + gap 10 + 142 + gap 10 + 142            = 324
     Size/X/Y group      = 196 + gap 10 + 142 + gap 10 + 142                = 500
     row = 324 + 10 + 500 + 10 + btn 30 + 10 + btn 30                       = 914
   Available (content-box: `width: 65%` already IS the content width):
     A(M) = 0.65 * (M - 64)
       M = 1150dp -> A =  705.9dp   (914 needed: the row was OVER-CONSTRAINED
                                     by 208dp -- the reported collision)
       M = 1470dp -> A =  913.9dp   (0.1dp short -- true threshold M = 1470.2dp)
       M = 1471dp -> A =  914.6dp   (first whole dp that fits)
       M = 1480dp -> A =  920.4dp   (CHOSEN, 6.4dp of content margin)
   So the escaped band was 1151-1470dp: too narrow for one line, too wide to
   wrap. Without the chip (Primary/Secondary split, where the sync button is
   absent too) the row needs 844dp and the band was 1151-1362dp -- a subset,
   so this one breakpoint closes both. (844 / 0.65 + 64 = 1362.46, so 1363dp is
   the first whole dp that already fit; the band ends one below it.) */
@media (max-width: 1480dp) {
    /* Deterministic 2+3 wrap: the Near/Far group takes the first line, the
       Size/X/Y group the second, each centered, with UNIFORM slider lengths
       on both lines. The two action buttons are pinned to the right flank,
       one per line (document order would put them both on the last line; this
       RmlUi has no flex `order`).

       Which button goes on which line follows their VISIBILITY, not taste.
       The sync toggle carries `data-if="selection_panel_chip_visible"`, the
       same condition as the focused-panel chip, and the chip is the leftmost
       item of the Near/Far line. Putting the toggle on that line keeps the
       two independent-dual-only controls together: outside that split mode
       the top line loses both its flank occupants at once, instead of losing
       one from each line. The viz-mode cycle, which is present in every split
       mode, takes the Size/X/Y line. */
    #selection-block .viewport-selection-depth-fields {
        flex-wrap: wrap;
        /* ONE 30dp pinned button per line -- the sync toggle rides the
           Near/Far line, the viz-mode cycle the Size/X/Y line -- so the
           reserve holds a single button plus the row's 6dp of breathing room,
           not a side-by-side pair. When both were stacked horizontally on the
           top line the reserve had to be 70dp; splitting them vertically is
           what buys the 34dp back on each side.

           The two paddings are EQUAL on purpose. Absolutely positioned
           children are offset from the PADDING box, so `right: 0` keeps the
           buttons on the row's right edge whatever the padding is, while both
           `flex-basis: 100%` lines are laid out in the CONTENT box. With a
           right reserve only, that content box -- and therefore both centred
           lines -- sat left of the row's own centre while the buttons sat at
           its right edge: three different centres. Mirroring the reserve on
           the left gives the row one centre, with the chip's flank the same
           width as the buttons'. It is charged to both lines (padding shrinks
           the content box the `flex-basis: 100%` lines resolve against), which
           is where the hide breakpoint below comes from. */
        padding-right: 36dp;
        padding-left: 36dp;
    }
    #selection-block .depth-axis-group {
        flex-basis: 100%;
        justify-content: center;
    }
    #selection-block .depth-axis-group .viewport-selection-slider {
        width: 90dp;
        min-width: 56dp;
        max-width: 150dp;
    }
    #selection-block .viewport-selection-depth-fields > .viewport-transform-action {
        position: absolute;
        right: 0;
    }
    /* One button per wrapped line, on the same right edge. The row's content
       box is 24 + row gap 10 + 24 = 58dp tall and a button is 30dp, so two
       buttons cannot both sit flush against that box (30 + 30 > 58): pinning
       one to `top: 0` and the other to `bottom: 0` would overlap them by 2dp.
       Each is therefore CENTRED on its own line instead, by the same offset
       the flex row would have given it: (line 24 - button 30) / 2 = -3dp from
       that line's own outer edge. The two buttons then span y -3..27 and
       31..61 in row coordinates -- 4dp apart, the row's own breathing room.

       The 3dp of overhang at each end stays inside the panel: above, the 4dp
       panel gap separates this row from the icon row; below, the panel's own
       5dp bottom padding sits between the row's content box and its border.
       Nothing leaves the flow, so the row is still 58dp tall and every
       panel-bottom clearance below is unchanged. */
    #selection-block .viewport-selection-depth-fields > .viewport-selection-sync-action {
        top: -3dp;
    }
    #selection-block .viewport-selection-depth-fields > .viewport-selection-viz-action {
        bottom: -3dp;
    }
    /* VERTICAL clearance for the per-viewport control group, derived rather
       than chosen. Every wrapped tier makes the panel TALLER, and the panel is
       z-index 9 with pointer-events: auto while each viewport's own top-right
       control group (.viewport-gizmo-controls) is z-index 8 -- so wherever the
       panel's box reaches that group, it both paints over it and swallows its
       clicks. The 72dp reserve above protects only the panel's OWN pinned
       sync/viz buttons; it does nothing for this EXTERNAL group.

       Horizontal escape is not available: the panel is centred and 65% wide in
       a band that spans the whole context, while in independent-dual split the
       PRIMARY viewport's group rides the divider and can therefore sit at any
       x. A shorter panel is not available either -- the chrome alone is 53dp,
       so three or more 24dp lines cannot fit above 108dp. So the group moves
       DOWN, and this is the only tier that needs it: above the wrap breakpoint
       the panel bottom is 83dp (the single-line fields row is
       max(axis 24, button 30) = 30dp, because the buttons are still in flow
       there), which the stock 108dp already clears by 25dp with NO relocation.
       Below the hide breakpoint the row is gone and the stock top is restored
       there. Two relocations exist in this file and no more: this one, and the
       restore.

       Panel bottom = overlay top 5 + border 1 + padding 5 + icon row 32
                      (30dp button + the tool group's 1dp border, both sides)
                      + panel gap 4 + fields height + padding 5 + border 1.
       Two-line tier: fields = 24 + row gap 10 + 24 = 58  ->  bottom = 111dp.
       The stock 108dp top overlapped it by 3dp (pre-existing: this tier is
       unchanged here). 120dp clears it by 9dp.

       Splitting the two pinned buttons across the two lines does NOT change
       any number here. Both are still absolutely positioned, so neither
       contributes to the row's height; the row is 58dp in both arrangements
       and the panel still ends at 111dp. The lower button's 3dp of overhang
       reaches 108dp, still 3dp inside the panel's own border. */
    .viewport-gizmo-controls {
        top: 120dp;
    }
}

/* HIDE breakpoint, derived rather than chosen, and it is the LAST tier: below
   it the depth row is not laid out at all: a width that cannot hold two
   lines gets nothing, not a taller stack.

   The two-line tier's binding line is the SECOND one, the Size/X/Y group, at
   500dp (the 104dp anisotropic Size readout makes it wider than the 324dp
   Near/Far line, chip included). The line box in that tier is the row's
   CONTENT box, so both of the row's paddings are charged to it:
     L(M) = 0.65 * (M - 64) - 72   (72dp = a 36dp reserve on each side; the
                                    right one holds ONE pinned button -- 30dp
                                    plus 6dp of clearance -- because the two
                                    buttons are now stacked one per line
                                    rather than side by side, and the left one
                                    mirrors it so the row has a single centre)
     M =  944dp -> L = 500.0dp   (the exact threshold:
                                  (500 + 72) / 0.65 + 64 = M = 944.0dp)
     M =  960dp -> L = 510.4dp   (CHOSEN, 10.4dp of content margin -- the same
                                  order of margin as the wrap tier's 6.4dp)
   The group cannot be squeezed onto that line below 944.0dp: the slider is
   already at its 56dp floor, so the group's minimum is 332 + 3 * 56 = 500dp
   flat and no shrink is available.

   Why the reserve halved. With both buttons pinned to the top-right the right
   flank had to be as wide as the PAIR (a 30dp button at `right: 0` plus a
   second at `right: 34dp`), i.e. 64dp plus clearance = 70dp, mirrored to
   140dp; the threshold was then 1048.6dp and the row hid at or below 1060dp.
   One button per line needs only 30dp plus the same clearance, so the reserve
   is 36dp a side, 72dp charged, and the threshold falls 104.6dp to 944.0dp.

   The other line, Near/Far, now shares its space with ONE pinned button
   rather than two, and it must fit too. Axis minimum (EFFECTIVE cascade --
   the ID-qualified `#selection-block .viewport-selection-depth-axis` wins with
   gap 6dp / flex-shrink: 1, not the generic gap 3dp / flex-shrink: 0 further
   down): label 24 + gap 6 + slider 56 + gap 6 + input 50 = 142dp; top line =
   chip 20 + group gap 10 + 142 + 10 + 142 = 324dp, which first fits at
   M = 673.2dp. 960dp clears it by a wide margin, so the top line is a floor
   the chosen number passes rather than the number's source. Above 1480dp the
   buttons are back in flow (the pinning lives inside that media query), so no
   button-overlap question arises there. */
@media (max-width: 960dp) {
    #selection-block .viewport-selection-depth-fields {
        display: none;
    }
    /* The slider row is gone, so the panel is back to the icon row alone:
       bottom = 5 + 1 + 5 + 32 + 5 + 1 = 49dp. The wrap block above also matches
       here (it is max-width), so its 120dp push MUST be undone or the controls
       would sit 12dp low for a panel that is not there. Back to the stock
       108dp, which clears the 49dp panel by 59dp. */
    .viewport-gizmo-controls {
        top: 108dp;
    }
}

.viewport-selection-depth-axis {
    display: flex;
    align-items: center;
    gap: 3dp;
    min-width: 0;
    flex-shrink: 0;
}

.viewport-selection-depth-axis > .viewport-transform-axis-label {
    width: 24dp;
    min-width: 24dp;
}

.viewport-selection-slider {
    width: 112dp;
    min-width: 112dp;
    height: 22dp;
    min-height: 22dp;
    margin-top: 0;
    position: relative;
    top: 0;
}

.viewport-selection-depth-axis > .number-input.viewport-selection-depth-input {
    /* Wide enough for the anisotropic "63x45%" Size readout at 1.5x UI scale
       (88dp still clipped the percent sign). */
    width: 104dp;
    min-width: 104dp;
    height: 24dp;
    min-height: 24dp;
    padding: 2dp 5dp;
    line-height: 18dp;
    font-size: 12dp;
    box-sizing: border-box;
}

.viewport-depth-fields {
    flex-grow: 0;
    flex-shrink: 0;
    flex-wrap: nowrap;
    gap: 8dp;
}

#depth-view-block .viewport-depth-fields {
    gap: 5dp;
}

.viewport-depth-axis {
    gap: 4dp;
    height: 24dp;
    min-height: 24dp;
}

#depth-view-block .viewport-depth-axis {
    height: 22dp;
    min-height: 22dp;
    gap: 3dp;
}

.viewport-depth-axis > .viewport-transform-axis-label {
    width: auto;
    min-width: 0;
    font-size: 12dp;
    line-height: 24dp;
    text-align: left;
}

#depth-view-block .viewport-depth-axis > .viewport-transform-axis-label {
    line-height: 22dp;
}

.viewport-selection-slider.viewport-depth-slider {
    width: 128dp;
    min-width: 128dp;
    height: 24dp;
    min-height: 24dp;
    top: 3dp;
}

#depth-view-block .viewport-selection-slider.viewport-depth-slider {
    height: 22dp;
    min-height: 22dp;
    top: 0;
}

#depth-view-block .viewport-depth-axis > .scrub-field {
    width: 112dp;
    min-width: 112dp;
    height: 22dp;
    min-height: 22dp;
}

#depth-view-block .viewport-depth-axis > .viewport-depth-step-btn {
    width: 18dp;
    min-width: 18dp;
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
    padding: 0 0 1dp 0;
    margin-left: 0;
    font-size: 12dp;
    border-radius: 4dp;
    box-sizing: border-box;
    flex-shrink: 0;
}

#depth-view-block .viewport-depth-axis > .viewport-depth-step-btn:disabled {
    opacity: 0.45;
    cursor: default;
}

.viewport-selection-actions {
    margin-left: 0;
}

.viewport-depth-actions {
    margin-left: 0;
}

.viewport-transform-panel {
    pointer-events: auto;
    min-width: 360dp;
    max-width: 100%;
    padding: 7dp 8dp;
    border-width: 1dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6dp;
}

.viewport-transform-panel.viewport-selection-panel {
    min-width: 600dp;
}

#selection-block .viewport-selection-panel {
    min-width: 0;
    /* Window-relative: the panel tracks the viewport width and the sliders
       grow into it (capped below), instead of collapsing to the icon row. */
    width: 65%;
    max-width: 1500dp;
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 4dp;
}

.viewport-transform-panel.viewport-depth-panel {
    min-width: 624dp;
}

#depth-view-block .viewport-depth-panel {
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 0;
    min-width: 0;
}

#gt-compare-mode-block .viewport-gt-compare-panel {
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 0;
    min-width: 0;
}

#gt-compare-mode-block .viewport-gt-compare-mode-select {
    width: 120dp;
    min-width: 120dp;
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
}

.viewport-gt-color-legend {
    width: 240dp;
    min-width: 240dp;
    margin-top: 4dp;
}

.viewport-gt-color-scale {
    width: 240dp;
    height: 10dp;
    box-sizing: border-box;
    display: flex;
    overflow: hidden;
    border-width: 1dp;
    border-color: #585b70;
    border-radius: 3dp;
}

.viewport-gt-color-scale__segment {
    display: block;
    width: 0;
    height: 8dp;
    flex-grow: 1;
    flex-shrink: 0;
}

.viewport-gt-color-scale__segment--loss-lowest {
    decorator: horizontal-gradient(#000000 #380578);
}

.viewport-gt-color-scale__segment--loss-low {
    decorator: horizontal-gradient(#380578 #b81f4a);
}

.viewport-gt-color-scale__segment--loss-medium {
    decorator: horizontal-gradient(#b81f4a #fca60a);
}

.viewport-gt-color-scale__segment--loss-high {
    decorator: horizontal-gradient(#fca60a #ffffbf);
}

.viewport-gt-color-scale__segment--depth-far {
    flex-grow: 20;
    decorator: horizontal-gradient(#0d0a26 #0f3280);
}

.viewport-gt-color-scale__segment--depth-far-mid {
    flex-grow: 23;
    decorator: horizontal-gradient(#0f3280 #0080a6);
}

.viewport-gt-color-scale__segment--depth-mid {
    flex-grow: 24;
    decorator: horizontal-gradient(#0080a6 #5cbb69);
}

.viewport-gt-color-scale__segment--depth-near-mid {
    flex-grow: 19;
    decorator: horizontal-gradient(#5cbb69 #f6d14d);
}

.viewport-gt-color-scale__segment--depth-near {
    flex-grow: 14;
    decorator: horizontal-gradient(#f6d14d #fb6e20);
}

.viewport-gt-color-scale__segment--depth-gray {
    decorator: horizontal-gradient(#000000 #ffffff);
}

.viewport-gt-color-labels {
    width: 240dp;
    margin-top: 2dp;
    display: flex;
    justify-content: space-between;
    color: #a6adc8;
    font-size: 10dp;
    line-height: 12dp;
}

.viewport-transform-panel.viewport-export-panel {
    width: 470dp;
    min-width: 470dp;
    max-width: 470dp;
    padding: 6dp 8dp;
    gap: 4dp;
    box-sizing: border-box;
}

.viewport-transform-panel.viewport-export-panel.has-custom {
    width: 624dp;
    min-width: 624dp;
    max-width: 624dp;
}

.viewport-transform-panel.viewport-export-panel.has-alpha {
    width: 532dp;
    min-width: 532dp;
    max-width: 532dp;
}

.viewport-transform-panel.viewport-export-panel.has-custom.has-alpha {
    width: 686dp;
    min-width: 686dp;
    max-width: 686dp;
}

#transform-block .viewport-transform-panel {
    min-width: 0;
    padding: 5dp 6dp;
    border-radius: 6dp;
    gap: 0;
}

.viewport-transform-row,
.viewport-selection-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 5dp;
    min-width: 0;
}

.viewport-transform-tool-group,
.viewport-selection-tool-group {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    border-width: 1dp;
    border-radius: 5dp;
    flex-shrink: 0;
}

.viewport-export-overlay {
    flex-direction: column;
    align-items: center;
    gap: 5dp;
}

.viewport-transform-header {
    display: flex;
    align-items: center;
    gap: 8dp;
    min-width: 0;
}

.viewport-transform-meta {
    min-width: 180dp;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: 1dp;
    flex-grow: 1;
    flex-shrink: 1;
}

.viewport-transform-meta__tool {
    font-size: 12dp;
    font-weight: bold;
}
.viewport-transform-context {
    display: flex;
    align-items: center;
    gap: 4dp;
    flex-shrink: 0;
}

.viewport-transform-option-group {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0;
    border-width: 1dp;
    border-radius: 5dp;
}

.viewport-transform-option-group.hidden {
    display: none;
}

.viewport-transform-option {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24dp;
    height: 24dp;
    min-width: 24dp;
    min-height: 24dp;
    padding: 3dp;
    border-radius: 4dp;
    box-sizing: border-box;
}

.viewport-transform-option img {
    width: 18dp;
    height: 18dp;
}

#transform-block .viewport-transform-option,
#transform-block .viewport-transform-action,
#selection-block .viewport-transform-option,
#selection-block .viewport-transform-action,
#depth-view-block .viewport-transform-action {
    width: 30dp;
    height: 30dp;
    min-width: 30dp;
    min-height: 30dp;
    padding: 3dp;
}

#transform-block .viewport-transform-option img,
#transform-block .viewport-transform-action img,
#selection-block .viewport-transform-option img,
#selection-block .viewport-transform-action img,
#depth-view-block .viewport-transform-action img {
    width: 20dp;
    height: 20dp;
}

.icon-btn.disabled,
.icon-btn.disabled:hover,
.icon-btn.disabled:active {
    background-color: transparent;
    border-color: transparent;
}

.icon-btn.disabled img {
    image-color: rgba(255, 255, 255, 95);
}

.viewport-export-fields {
    display: flex;
    align-items: center;
    gap: 8dp;
    height: 26dp;
    min-height: 26dp;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

.viewport-export-axis {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 26dp;
    min-height: 26dp;
    flex-shrink: 0;
}

.viewport-export-header {
    flex-wrap: nowrap;
    align-items: center;
    min-height: 26dp;
}

.viewport-transform-meta.viewport-export-meta {
    width: 171dp;
    min-width: 171dp;
    max-width: 171dp;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 26dp;
}

.viewport-transform-meta.viewport-export-meta .viewport-transform-meta__tool {
    font-size: 12dp;
    line-height: 26dp;
    white-space: nowrap;
}

.viewport-export-axis > .viewport-transform-axis-label {
    width: 64dp;
    min-width: 64dp;
    font-size: 12dp;
    line-height: 26dp;
    text-align: left;
    white-space: nowrap;
    flex-shrink: 0;
}

.viewport-export-resolution-select,
.viewport-export-format-select {
    height: 26dp;
    min-height: 26dp;
    font-size: 12dp;
    line-height: 24dp;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.viewport-export-resolution-select {
    width: 102dp;
    min-width: 102dp;
}

.viewport-export-format-select {
    width: 74dp;
    min-width: 74dp;
}

.viewport-export-resolution-select selectvalue,
.viewport-export-format-select selectvalue {
    height: 24dp;
    line-height: 24dp;
    margin-right: 20dp;
    padding: 0 0 0 8dp;
    position: relative;
    top: 0;
}

.viewport-export-resolution-select selectarrow,
.viewport-export-format-select selectarrow {
    width: 20dp;
    height: 24dp;
    line-height: 24dp;
    position: relative;
    top: 0;
}

.viewport-export-custom-size {
    display: flex;
    align-items: center;
    gap: 5dp;
    height: 26dp;
    min-height: 26dp;
    flex-shrink: 0;
}

.viewport-export-custom-size.hidden {
    display: none;
}

.viewport-export-size-input {
    width: 64dp;
    min-width: 64dp;
    height: 24dp;
    min-height: 24dp;
    font-size: 12dp;
    line-height: 16dp;
    padding: 3dp 6dp;
    flex-shrink: 0;
    text-align: right;
    box-sizing: border-box;
}

.viewport-export-size-separator {
    width: 8dp;
    min-width: 8dp;
    font-size: 12dp;
    line-height: 26dp;
    height: 26dp;
    text-align: center;
    flex-shrink: 0;
}

.viewport-export-transparency {
    display: flex;
    align-items: center;
    gap: 4dp;
    height: 26dp;
    min-height: 26dp;
    font-size: 12dp;
    white-space: nowrap;
    flex-shrink: 0;
}

.viewport-export-transparency.hidden {
    display: none;
}

.viewport-export-actions {
    height: 26dp;
    min-height: 26dp;
    flex-shrink: 0;
}

.viewport-export-button {
    width: 66dp;
    min-width: 66dp;
    height: 26dp;
    min-height: 26dp;
    padding: 0;
    font-size: 12dp;
    line-height: 24dp;
    box-sizing: border-box;
    flex-shrink: 0;
}

.viewport-export-status {
    pointer-events: none;
    max-width: 360dp;
    min-height: 22dp;
    padding: 4dp 10dp;
    border-width: 1dp;
    border-radius: 6dp;
    font-size: 11dp;
    line-height: 14dp;
    white-space: nowrap;
    opacity: 1;
}

.viewport-export-status.hidden {
    display: none;
}

.viewport-transform-fields {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6dp;
}

.viewport-transform-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6dp;
    min-width: 0;
}

.viewport-transform-axis {
    display: flex;
    align-items: center;
    gap: 2dp;
    min-width: 0;
    flex-shrink: 0;
}

#transform-block .viewport-transform-fields,
#transform-block .viewport-transform-group {
    flex-wrap: nowrap;
    gap: 4dp;
}

#transform-block .viewport-transform-fields {
    justify-content: flex-start;
    flex-shrink: 0;
}

.viewport-transform-axis-label {
    width: 10dp;
    min-width: 10dp;
    font-size: 11dp;
    text-align: center;
}

.viewport-transform-axis > .number-input {
    width: 64dp;
    min-width: 64dp;
    height: 22dp;
    min-height: 22dp;
    padding: 2dp 5dp;
    line-height: 16dp;
    font-size: 12dp;
    box-sizing: border-box;
}

.viewport-transform-axis > .num-step-btn {
    width: 22dp;
    height: 22dp;
    min-width: 22dp;
    min-height: 22dp;
    padding: 0 0 1dp 0;
    line-height: 20dp;
    margin-left: 0;
    box-sizing: border-box;
}

#transform-block .viewport-transform-axis-label {
    width: 8dp;
    min-width: 8dp;
}

#transform-block .viewport-transform-axis > .number-input {
    width: 58dp;
    min-width: 58dp;
    height: 22dp;
    min-height: 22dp;
}

#transform-block .viewport-transform-axis > .num-step-btn {
    width: 20dp;
    min-width: 20dp;
}

.viewport-transform-axis--split {
    margin-left: 4dp;
    padding-left: 6dp;
    border-left-width: 1dp;
}

.viewport-transform-actions {
    display: flex;
    align-items: center;
    gap: 3dp;
    flex-shrink: 0;
}

.viewport-transform-action {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24dp;
    height: 24dp;
    min-width: 24dp;
    min-height: 24dp;
    padding: 3dp;
    border-radius: 5dp;
    box-sizing: border-box;
}

.viewport-transform-action img {
    width: 18dp;
    height: 18dp;
}

.toolbar-separator {
    width: 1dp;
    margin: 2dp 0;
}

.toolbar-vertical .toolbar-separator {
    width: 24dp;
    height: 1dp;
    margin: 8dp 0 7dp;
}

.toolbar-hcenter .toolbar-separator {
    width: 1dp;
    height: 22dp;
    margin: 0 5dp;
}

.viewport-status-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.viewport-metrics-overlay {
    position: absolute;
    pointer-events: none;
    z-index: 20;
}

.viewport-lod-stats-overlay {
    position: absolute;
    pointer-events: none;
    z-index: 18;
}

.viewport-lod-stats-card {
    width: 356dp;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    box-sizing: border-box;
}

.viewport-lod-stats-title {
    font-size: 12dp;
    font-weight: bold;
    line-height: 16dp;
    margin-bottom: 2dp;
}

.viewport-lod-stats-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8dp;
    min-height: 14dp;
}

.viewport-lod-stats-label {
    width: 70dp;
    min-width: 70dp;
    font-size: 9dp;
    line-height: 14dp;
    white-space: nowrap;
}

.viewport-lod-stats-value {
    flex-grow: 1;
    min-width: 0;
    font-family: "JetBrains Mono";
    font-size: 9dp;
    line-height: 14dp;
    text-align: right;
    white-space: normal;
    word-break: break-word;
}

.viewport-metrics-card {
    min-width: 152dp;
    padding: 10dp 12dp;
    border-width: 1dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    gap: 6dp;
}

.viewport-metrics-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16dp;
}

.viewport-metrics-label,
.viewport-metrics-value {
    font-size: 12dp;
}

.viewport-metrics-value {
    font-size: 15dp;
    font-weight: bold;
}

.vram-hud-overlay {
    position: absolute;
    right: 16dp;
    top: 16dp;
    width: 620dp;
    height: 72%;
    pointer-events: auto;
    z-index: 21;
}

.vram-hud-card {
    position: relative;
    height: 100%;
    box-sizing: border-box;
    padding: 10dp 12dp;
    border-width: 1dp;
    border-radius: 8dp;
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

.vram-hud-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    drag: drag;
    cursor: move;
}

.vram-hud-tabs {
    display: flex;
    gap: 0dp;
    border-bottom-width: 1dp;
}

.vram-hud-tab {
    flex: 1;
    height: 24dp;
    font-size: 11dp;
    text-align: center;
    cursor: pointer;
    border-width: 0dp;
    border-radius: 0dp;
}

.vram-hud-panel {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 6dp;
    overflow-y: auto;
}

.vram-hud-panel.hidden {
    display: none;
}

.vram-hud-counters-header {
    font-size: 11dp;
    font-weight: bold;
    padding-top: 4dp;
}

.perf-hud-tracking-off {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12dp;
    padding: 10dp;
    border-width: 1dp;
    border-radius: 5dp;
    font-size: 11dp;
}

.perf-hud-tracking-off.hidden {
    display: none;
}

.perf-hud-enable-tracking {
    height: 24dp;
    padding: 2dp 9dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 11dp;
    cursor: pointer;
}

.perf-hud-ledger-header {
    display: flex;
    flex-direction: column;
    gap: 3dp;
    padding: 5dp 7dp;
    border-width: 1dp;
    border-radius: 5dp;
}

.perf-hud-ledger-header-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8dp;
}

.perf-hud-ledger-header-detail {
    justify-content: flex-start;
    gap: 14dp;
}

.perf-hud-ledger-process {
    font-size: 12dp;
    font-weight: bold;
}

.perf-hud-ledger-header-detail span {
    font-size: 10dp;
}

.perf-hud-ledger-closure {
    padding: 1dp 5dp;
    border-width: 1dp;
    border-radius: 8dp;
    font-size: 10dp;
}

.perf-hud-ledger-over-banner {
    padding: 5dp 8dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 11dp;
    font-weight: bold;
    text-align: center;
}

.perf-hud-ledger-over-banner.hidden {
    display: none;
}

.perf-hud-ledger-rows {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 1dp;
    overflow-y: auto;
}

.perf-hud-ledger-row {
    display: flex;
    align-items: center;
    gap: 6dp;
    min-height: 30dp;
    padding: 2dp 3dp;
    border-radius: 3dp;
}

.perf-hud-ledger-row.root {
    margin-top: 2dp;
    border-top-width: 1dp;
}

.perf-hud-ledger-row.has-children {
    cursor: pointer;
}

.perf-hud-ledger-row-header {
    min-height: 18dp;
    max-height: 18dp;
    font-size: 9dp;
    font-weight: bold;
}

.perf-hud-ledger-name-cell {
    flex: 1;
    min-width: 80dp;
    display: flex;
    align-items: baseline;
    gap: 4dp;
    overflow: hidden;
}

.perf-hud-ledger-toggle {
    width: 11dp;
    min-width: 11dp;
    text-align: center;
    font-size: 10dp;
}

.perf-hud-ledger-name {
    font-size: 11dp;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.perf-hud-ledger-note {
    flex: 1;
    min-width: 0;
    font-size: 9dp;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.perf-hud-ledger-share {
    width: 64dp;
    min-width: 64dp;
    height: 5dp;
    border-radius: 3dp;
    overflow: hidden;
}

.perf-hud-ledger-share-fill {
    display: block;
    height: 5dp;
    border-radius: 3dp;
}

.perf-hud-ledger-disclosure {
    width: 100dp;
    min-width: 100dp;
    flex-shrink: 1;
    font-size: 9dp;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.perf-hud-ledger-allocated {
    width: 76dp;
    min-width: 76dp;
    flex-shrink: 0;
    font-size: 10dp;
    text-align: right;
}

.perf-hud-ledger-badge {
    width: 28dp;
    min-width: 28dp;
    flex-shrink: 0;
    padding: 1dp 2dp;
    border-width: 1dp;
    border-radius: 7dp;
    font-size: 9dp;
    text-align: center;
}

.vram-hud-counters-empty {
    font-size: 11dp;
}

.vram-hud-allocs-summary {
    display: flex;
    justify-content: space-between;
    padding: 2dp 3dp;
    font-size: 11dp;
    font-weight: bold;
}

.vram-hud-allocs-rows {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 1dp;
}

.vram-hud-allocs-row {
    display: flex;
    gap: 8dp;
    align-items: baseline;
    padding: 1dp 3dp;
}

.vram-hud-allocs-name {
    flex: 1;
    font-size: 11dp;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.vram-hud-allocs-bytes {
    font-size: 11dp;
    font-weight: bold;
    width: 90dp;
    text-align: right;
}

.vram-hud-allocs-pct {
    font-size: 11dp;
    width: 52dp;
    text-align: right;
}

.vram-hud-anno-summary {
    display: flex;
    justify-content: space-between;
    padding: 2dp 3dp;
    font-size: 11dp;
    font-weight: bold;
}

.vram-hud-anno-row {
    display: flex;
    gap: 6dp;
    align-items: baseline;
    padding: 1dp 3dp;
}

.vram-hud-anno-row-header {
    height: 18dp;
    min-height: 18dp;
    max-height: 18dp;
    font-weight: bold;
}

.vram-hud-anno-row-header span {
    font-size: 10dp;
}

.vram-hud-anno-cat {
    width: 32dp;
    font-size: 10dp;
    text-align: center;
}

.vram-hud-anno-name {
    flex: 1;
    font-size: 11dp;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.vram-hud-anno-bytes,
.vram-hud-anno-peak {
    width: 72dp;
    font-size: 11dp;
    font-weight: bold;
    text-align: right;
}

.vram-hud-anno-wall,
.vram-hud-anno-gpu {
    width: 60dp;
    font-size: 11dp;
    text-align: right;
}

.vram-hud-anno-calls {
    width: 56dp;
    font-size: 11dp;
    text-align: right;
}

.vram-hud-anno-rows {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 1dp;
}

.vram-hud-filter-row {
    display: flex;
    align-items: center;
    gap: 4dp;
    padding-bottom: 4dp;
}

#vram-hud-filter {
    flex: 1;
    height: 22dp;
    font-size: 11dp;
    padding: 2dp 6dp;
    border-width: 1dp;
    border-radius: 4dp;
}

.vram-hud-filter-clear {
    width: 22dp;
    height: 22dp;
    font-size: 10dp;
    text-align: center;
    border-width: 1dp;
    border-radius: 4dp;
    cursor: pointer;
}

.vram-hud-filter-clear.hidden {
    display: none;
}

.vram-hud-resize {
    position: absolute;
    right: 0dp;
    bottom: 0dp;
    width: 14dp;
    height: 14dp;
    drag: drag;
    cursor: nwse-resize;
}

.vram-hud-title {
    font-size: 13dp;
    font-weight: bold;
}

.vram-hud-iteration {
    font-size: 11dp;
}

.vram-hud-summary {
    display: flex;
    flex-direction: column;
    gap: 3dp;
    padding-bottom: 6dp;
}

.vram-hud-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 12dp;
}

.vram-hud-summary-label,
.vram-hud-device,
.vram-hud-empty {
    font-size: 12dp;
}

.vram-hud-summary-value {
    font-size: 12dp;
    font-weight: bold;
}

.vram-hud-device {
    margin-top: 2dp;
}

.vram-hud-rows {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

.vram-hud-tree-row {
    display: flex;
    gap: 8dp;
    align-items: baseline;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    padding: 2dp 3dp;
    overflow: hidden;
}

.vram-hud-tree-row.has-children {
    cursor: pointer;
}

.vram-hud-tree-row span {
    font-size: 10dp;
}

.vram-hud-row-name,
.vram-hud-col-source {
    width: 240dp;
}

.vram-hud-row-name {
    display: flex;
    gap: 4dp;
    align-items: baseline;
    min-width: 0;
}

.vram-hud-col-live {
    width: 78dp;
}

.vram-hud-col-peak {
    width: 78dp;
}

.vram-hud-col-delta {
    width: 82dp;
}

.vram-hud-col-time {
    width: 68dp;
}

.vram-hud-col-gpu {
    width: 68dp;
}

.vram-hud-header-meta {
    display: flex;
    gap: 8dp;
    align-items: baseline;
}

.perf-hud-card-chevron {
    width: 14dp;
    min-width: 14dp;
    font-size: 12dp;
    text-align: center;
    cursor: pointer;
    drag: none;
}

.vram-hud-throughput {
    font-size: 11dp;
}

.vram-hud-throughput.hidden {
    display: none;
}

.vram-hud-counters {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    padding-bottom: 6dp;
}

.vram-hud-counters.hidden {
    display: none;
}

.vram-hud-counter-row {
    display: flex;
    justify-content: space-between;
    gap: 12dp;
}

.vram-hud-counter-label {
    font-size: 12dp;
}

.vram-hud-counter-value {
    font-size: 12dp;
    font-weight: bold;
}

.vram-hud-node-label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.vram-hud-row-header span {
    font-size: 10dp;
    font-weight: bold;
}

.vram-hud-row-header {
    height: 18dp;
    min-height: 18dp;
    max-height: 18dp;
}

.vram-hud-tree-row em {
    display: block;
    font-style: normal;
    font-size: 9dp;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.vram-hud-expand-toggle {
    display: inline-block;
    width: 12dp;
    font-size: 12dp;
    text-align: center;
    cursor: pointer;
}

.vram-hud-row-badges {
    display: inline;
    font-size: 9dp;
}

.vram-hud-empty {
    padding: 4dp 6dp;
    font-size: 11dp;
}

.viewport-status-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.viewport-status-panel {
    position: relative;
    min-width: 320dp;
    max-width: 420dp;
    padding: 16dp 18dp;
    border-width: 1dp;
    display: flex;
    flex-direction: column;
    gap: 8dp;
}

.viewport-status-title {
    font-size: 13dp;
    font-weight: bold;
}

.viewport-status-path,
.viewport-status-stage,
.viewport-status-panel .status-success,
.viewport-status-panel .status-error {
    line-height: 1.3;
    min-width: 0;
    word-break: break-word;
}

.viewport-status-progress {
    position: relative;
    width: 100%;
}

.viewport-status-progress progress {
    width: 100%;
}

.viewport-status-actions {
    display: flex;
    justify-content: center;
    margin-top: 4dp;
}

.hidden {
    display: none;
}

.perf-hud-strip {
    position: absolute;
    right: 18dp;
    top: 18dp;
    width: 300dp;
    min-height: 142dp;
    padding: 10dp 12dp;
    display: flex;
    flex-direction: column;
    gap: 5dp;
    border-width: 1dp;
    border-radius: 7dp;
    z-index: 30;
}

.perf-hud-strip-header {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 18dp;
    cursor: pointer;
}

.perf-hud-strip-title { flex-grow: 1; }
.perf-hud-strip-rate, .perf-hud-strip-value, .perf-hud-strip-badge { font-family: "JetBrains Mono"; font-weight: normal; }
.perf-hud-strip-meter { display: flex; align-items: center; gap: 5dp; height: 18dp; cursor: pointer; }
.perf-hud-strip-label { width: 34dp; }
.perf-hud-meter-track { flex-grow: 1; display: flex; height: 7dp; overflow: hidden; border-radius: 3dp; }
.perf-hud-meter-fill { display: block; height: 100%; width: 0%; }
/* Fits "23.51 GiB / 23.51 GiB" on one line (mono 10dp). */
.perf-hud-strip-value { width: 128dp; min-width: 128dp; text-align: right; font-size: 10dp; white-space: nowrap; }
.perf-hud-strip-badge { width: 12dp; font-size: 10dp; }
.perf-hud-core-strip { display: flex; align-items: flex-end; gap: 1dp; height: 13dp; margin-left: 39dp; overflow: hidden; }
.perf-hud-core-strip .perf-hud-core-bar { flex: 1 1 0; min-width: 1dp; max-width: 4dp; height: 100%; }
.perf-hud-strip-header, .perf-hud-strip-meter, .perf-hud-core-strip { box-sizing: border-box; }
.vram-hud-overlay.perf-hud-compact .vram-hud-card { display: none; }
.vram-hud-overlay.perf-hud-compact .perf-hud-strip { display: flex; }
.vram-hud-overlay:not(.perf-hud-compact) .perf-hud-strip { display: none; }
.perf-hud-strip.hidden { display: none; }

.perf-hud-overview-meters {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    margin-top: 8dp;
}

.perf-hud-sparkline-row {
    display: flex;
    align-items: center;
    gap: 6dp;
    height: 28dp;
}

.perf-hud-sparkline-label {
    width: 34dp;
    font-size: 10dp;
}

.perf-hud-sparkline {
    flex-grow: 1;
    height: 24dp;
    display: flex;
    align-items: flex-end;
    gap: 1dp;
    overflow: hidden;
}

.perf-hud-sparkline .histogram-bar-fill {
    flex: 1 1 0;
    min-width: 1dp;
    max-width: 4dp;
    height: 0%;
}

.perf-hud-ledger-allocated,
.perf-hud-ledger-disclosure,
.perf-hud-ledger-badge,
.vram-hud-summary-value,
.vram-hud-col-live,
.vram-hud-col-peak,
.vram-hud-col-delta,
.vram-hud-col-time,
.vram-hud-col-gpu,
.vram-hud-anno-bytes,
.vram-hud-anno-peak,
.vram-hud-anno-wall,
.vram-hud-anno-gpu,
.vram-hud-anno-calls,
.vram-hud-allocs-summary-value,
.vram-hud-breakdown-bytes,
.vram-hud-breakdown-pct {
    font-family: "JetBrains Mono";
    font-weight: normal;
}
