/* Theme-dependent status bar styles. */

body,
#progress-text {
    color: @{text};
}

#status-row {
    @{chrome.status_decor};
}

.safe-mode #status-row {
    background-color: @{blend(surface,warning,0.20)};
}

#safe-mode-badge {
    color: @{text};
    background-color: @{blend(surface,warning,0.42)};
}

#mcp-chip {
    background-color: @{alpha(surface_bright,0.35)};
    border-color: @{alpha(text_dim,0.55)};
}

#mcp-chip:hover,
#mcp-chip.expanded {
    background-color: @{alpha(surface_bright,0.45)};
    border-color: @{text_dim};
}

#mcp-popup {
    color: @{text};
    background-color: @{surface};
    border-color: @{border};
}

.mcp-success {
    color: @{success};
}

.mcp-error {
    color: @{error};
}

.mcp-switch-track {
    border-color: @{border};
    background-color: @{surface_bright};
}

.mcp-switch-knob {
    background-color: @{text_dim};
}

#mcp-toggle.is-on .mcp-switch-track {
    border-color: @{success};
}

#mcp-toggle.is-on .mcp-switch-knob {
    background-color: @{success};
}

.mcp-edit-button {
    color: @{text};
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{blend(surface,primary,button.tint_normal)};
}

.mcp-edit-button:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{blend(surface,primary,button.tint_hover)};
}

.dim,
.separator {
    color: @{text_dim};
}

#progress-container {
    background-color: @{statusbar.progress_bg};
}

#progress-fill {
    @{statusbar.progress_fill_decor};
}

.progress-marker {
    background-color: @{statusbar.progress_marker};
}

.progress-marker.is-past {
    background-color: @{statusbar.progress_marker_past};
}

.progress-marker.is-hovered,
.progress-marker.is-preview {
    background-color: @{statusbar.progress_marker_active};
}

#gallery-chip {
    background-color: @{alpha(surface_bright,0.35)};
    border-color: @{alpha(text_dim,0.55)};
}

#gallery-chip:hover {
    background-color: @{alpha(surface_bright,0.70)};
    border-color: @{text_dim};
}

#gallery-chip.busy {
    background-color: @{blend(surface,primary,0.14)};
    border-color: @{primary};
}

#gallery-chip.attention {
    background-color: @{blend(surface,warning,0.14)};
    border-color: @{warning};
}

#gallery-chip.error {
    background-color: @{blend(surface,error,0.14)};
    border-color: @{error};
}

#gallery-chip-icon {
    image-color: @{text_dim};
}

#gallery-chip.busy #gallery-chip-icon {
    image-color: @{primary};
}

#gallery-chip.attention #gallery-chip-icon {
    image-color: @{warning};
}

#gallery-chip.error #gallery-chip-icon {
    image-color: @{error};
}

#account-chip {
    background-color: @{alpha(surface_bright,0.35)};
    border-color: @{alpha(text_dim,0.55)};
}

#account-chip:hover {
    background-color: @{alpha(surface_bright,0.70)};
    border-color: @{text_dim};
}

#account-chip.warning {
    background-color: @{blend(surface,warning,0.14)};
    border-color: @{warning};
}

#gpu-icon {
    image-color: @{text_dim};
}

#gallery-chip.compact { background-color: @{alpha(surface,0)}; }
