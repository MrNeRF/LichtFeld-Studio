/* Theme-dependent status bar styles. */

body,
#progress-text {
    color: @{text};
}

#status-row {
    @{chrome.status_decor};
}

.safe-mode #status-row {
    background-color: @{blend(surface,warning,0.20)};
}

#safe-mode-badge {
    color: @{text};
    background-color: @{blend(surface,warning,0.42)};
}

#mcp-chip {
    background-color: @{alpha(surface_bright,0.35)};
    border-color: @{alpha(text_dim,0.55)};
}

#mcp-chip:hover,
#mcp-chip.expanded {
    background-color: @{alpha(surface_bright,0.45)};
    border-color: @{text_dim};
}

#mcp-popup {
    color: @{text};
    background-color: @{surface};
    border-color: @{border};
}

.mcp-success {
    color: @{success};
}

.mcp-error {
    color: @{error};
}

.mcp-edit-button {
    color: @{text};
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{blend(surface,primary,button.tint_normal)};
}

.mcp-edit-button:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{blend(surface,primary,button.tint_hover)};
}

.dim,
.separator {
    color: @{text_dim};
}

#progress-container {
    background-color: @{statusbar.progress_bg};
}

#progress-fill {
    @{statusbar.progress_fill_decor};
}

.progress-marker {
    background-color: @{statusbar.progress_marker};
}

.progress-marker.is-past {
    background-color: @{statusbar.progress_marker_past};
}

.progress-marker.is-hovered,
.progress-marker.is-preview {
    background-color: @{statusbar.progress_marker_active};
}

#gpu-icon {
    image-color: @{text_dim};
}

.status-portal-connection:hover {
    background-color: @{menu.hover};
}

.status-portal-connection.connected {
    color: @{success};
}

.status-portal-connection.connected img {
    image-color: @{success};
}

.status-portal-connection.connecting,
.status-portal-connection.transferring {
    color: @{info};
}

.status-portal-connection.connecting img,
.status-portal-connection.transferring img {
    image-color: @{info};
}

.status-portal-connection.disconnected {
    color: @{text_dim};
}

.status-portal-connection.disconnected img {
    image-color: @{text_dim};
}

.status-portal-connection.error {
    color: @{error};
}

.status-portal-connection.error img {
    image-color: @{error};
}
