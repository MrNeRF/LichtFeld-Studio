/* Shared border roles and shape scale. */

.backend-chip {
    border-radius: @{radius.control}dp;
}

#upscaler-popup {
    border-radius: @{radius.control}dp;
}

#safe-mode-badge {
    border-radius: 2dp;
}

#mcp-chip {
    border-radius: 2dp;
}

#mcp-popup {
    border-radius: 3dp;
}

.mcp-switch-track {
    border-radius: 6dp;
}

.mcp-switch-knob {
    border-radius: 4dp;
}

.mcp-edit-button {
    border-radius: 2dp;
}

#progress-container {
    border-radius: 2dp;
}

.progress-marker {
    border-radius: 2dp;
}

#progress-container.miner .progress-marker {
    border-radius: 0;
}

#progress-container.tessle {
    border-radius: 2dp;
    border-bottom: 1dp @{border};
}

#progress-container.tessle .progress-marker {
    border-radius: 0;
}

/* Theme-dependent status bar styles. */

body,
#progress-text {
    color: @{text};
}

#status-row {
    @{chrome.status_decor};
}

.safe-mode #status-row {
    background-color: @{blend(surface,warning,0.20)};
}

#safe-mode-badge {
    color: @{text};
    background-color: @{blend(surface,warning,0.42)};
}

#mcp-chip {
    background-color: @{alpha(surface_bright,0.35)};
    border-color: @{border};
}

.input-device {
    image-color: @{text_dim};
}

#input-device-toggle:hover .input-device {
    image-color: @{text};
}

#mcp-chip:hover,
#mcp-chip.expanded {
    background-color: @{alpha(surface_bright,0.45)};
    border-color: @{border};
}

#mcp-popup {
    color: @{text};
    background-color: @{surface};
    border-color: @{border};
}

.mcp-success {
    color: @{success};
}

.mcp-error {
    color: @{error};
}

.mcp-switch-track {
    border-color: @{border};
    background-color: @{surface_bright};
}

.mcp-switch-knob {
    background-color: @{text_dim};
}

#mcp-toggle.is-on .mcp-switch-track {
    border-color: @{success};
}

#mcp-toggle.is-on .mcp-switch-knob {
    background-color: @{success};
}

.mcp-edit-button {
    color: @{text};
    background-color: @{blend(surface,primary,button.tint_normal)};
    border-color: @{primary};
}

.mcp-edit-button:hover {
    background-color: @{blend(surface,primary,button.tint_hover)};
    border-color: @{primary};
}

.dim,
.separator {
    color: @{text_dim};
}

#progress-container {
    background-color: @{statusbar.progress_bg};
}

#progress-fill {
    @{statusbar.progress_fill_decor};
}

.progress-marker {
    background-color: @{statusbar.progress_marker};
}

.progress-marker.is-past {
    background-color: @{statusbar.progress_marker_past};
}

.progress-marker.is-hovered,
.progress-marker.is-preview {
    background-color: @{statusbar.progress_marker_active};
}

#gpu-icon {
    image-color: @{text_dim};
}

.backend-chip {
    color: @{text};
    background-color: @{alpha(surface_bright,0.30)};
    border-color: @{border};
}

.backend-label {
    color: @{text_dim};
}

#upscaler-toggle { color: @{text}; background-color: #00000000; }
#upscaler-popup { color: @{text}; background-color: @{surface}; border-color: @{border}; }
.upscaler-choice { color: @{text}; background-color: #00000000; }
.upscaler-choice:hover { background-color: @{surface_bright}; }
.upscaler-choice.selected { color: @{primary}; background-color: @{surface_bright}; }
.upscaler-presets-label { color: @{text_dim}; }

#gpu-restart-chip {
    color: @{warning};
    border-color: @{warning};
    background-color: @{blend(surface,warning,0.16)};
}
