/* Scene tree panel — panel-specific styles only.
 * Shared widget styles are in components.rcss (auto-included via applyTheme). */

body {
    font-family: Inter;
    font-size: 12dp;
    color: #cdd6f4;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    border-width: 1dp;
    border-radius: 5dp;
    overflow: hidden;
}

.scene-header {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    padding: 5dp 6dp 3dp;
}

.scene-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6dp;
    min-width: 0;
}

.scene-tab-bar {
    display: flex;
    align-items: stretch;
    gap: 4dp;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.scene-tab {
    display: inline-block;
    min-width: 0;
    padding: 5dp 12dp 6dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #f5f7ff;
    background-color: rgba(137, 180, 250, 28);
    border-width: 1dp;
    border-color: rgba(137, 180, 250, 132);
    border-bottom-width: 2dp;
    border-bottom-color: rgba(137, 180, 250, 255);
    border-top-left-radius: 4dp;
    border-top-right-radius: 4dp;
}

.scene-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4dp;
    justify-content: flex-start;
    min-width: 0;
}

.scene-chip {
    display: inline-block;
    padding: 2dp 7dp;
    font-size: 12dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
}

.scene-chip--accent {
    color: #f5f7ff;
    background-color: rgba(137, 180, 250, 72);
    border-color: rgba(137, 180, 250, 150);
}

/* Search container */
#search-container {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 4dp 6dp;
    margin-bottom: 4dp;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
}

#scene-view {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin-left: 6dp;
    margin-right: 6dp;
}

#search-icon {
    width: 13dp;
    height: 13dp;
    margin-right: 4dp;
    image-color: #6c7086;
}

#filter-input {
    flex: 1;
    font-size: 12dp;
    color: #cdd6f4;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

#filter-input:focus {
    border-width: 0;
}

#filter-clear {
    width: 12dp;
    height: 12dp;
    margin-left: 4dp;
    background-color: transparent;
    border-width: 0;
    cursor: pointer;
    padding: 0;
}

#filter-clear img {
    width: 12dp;
    height: 12dp;
    image-color: #6c7086;
}

#filter-clear:hover img,
#filter-clear:focus-visible img {
    image-color: #cdd6f4;
}

scene-graph,
#tree-container {
    flex: 1;
    display: block;
    overflow-x: auto;
    overflow-y: auto;
    min-height: 0;
    position: relative;
    tab-index: auto;
}

.scene-graph-content {
    position: relative;
    width: 100%;
    height: 0dp;
}

.scene-graph-models-header {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 24dp;
    margin: 0;
    border-top-width: 0;
}



.tree-row {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    width: auto;
    height: 20dp;
    box-sizing: border-box;
    padding: 1dp 4dp;
    border-left-width: 2dp;
    border-left-color: rgba(0, 0, 0, 0);
    cursor: pointer;
    overflow: hidden;
    transition: top 0.15s quadratic-out, background-color 0.12s quadratic-out,
        border-color 0.12s quadratic-out;
}

.scene-graph-content.no-anim .tree-row,
.scene-graph-content.no-anim .tree-insert-line {
    transition: none;
}

.tree-row.placeholder {
    display: none;
}

.tree-row:hover {
    background-color: rgba(137, 180, 250, 28);
    border-left-color: rgba(137, 180, 250, 255);
}

.tree-row.even {
    background-color: #1e1e2e08;
}

.tree-row.odd {
    background-color: #31324408;
}

/* selected MUST come after even/odd for cascade */
.tree-row.selected {
    background-color: rgba(137, 180, 250, 71);
}

.tree-row.selected:hover {
    background-color: rgba(137, 180, 250, 97);
    border-left-color: rgba(180, 208, 251, 255);
}

.tree-row.drop-target {
    border-width: 1dp;
    border-color: #89b4fa;
    background-color: rgba(137, 180, 250, 48);
}

.tree-row.dragging {
    opacity: 0.45;
}

.tree-row.just-moved {
    background-color: rgba(137, 180, 250, 89);
}

.tree-drag-ghost {
    display: none;
    position: absolute;
    z-index: 9999;
    pointer-events: none;
    padding: 3dp 10dp;
    background-color: rgba(49, 50, 68, 242);
    border-width: 1dp;
    border-color: #89b4fa;
    border-radius: 4dp;
    color: #cdd6f4;
    font-size: 12dp;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 3dp;
    box-shadow: 0 2dp 8dp rgba(0, 0, 0, 110);
    transition: opacity 0.09s quadratic-out;
}

.tree-drag-ghost.invalid {
    border-color: rgba(243, 139, 168, 255);
    color: rgba(243, 139, 168, 220);
    opacity: 0.65;
}

.tree-drag-ghost .type-icon {
    flex: none;
}

.tree-drag-ghost-badge {
    display: none;
    color: #89b4fa;
    font-size: 11dp;
}

.tree-insert-line {
    position: absolute;
    z-index: 10000;
    left: 4dp;
    height: 2dp;
    right: 4dp;
    background-color: #89b4fa;
    border-radius: 1dp;
    pointer-events: none;
    transition: top 0.08s quadratic-out;
}

.tree-insert-line-dot {
    position: absolute;
    left: -2dp;
    top: -2dp;
    width: 6dp;
    height: 6dp;
    border-radius: 3dp;
    background-color: #89b4fa;
}

.row-content {
    display: flex;
    align-items: center;
    height: 100%;
    white-space: nowrap;
    min-width: 0;
}

/* Expand/collapse toggle — inline before name */
.expand-toggle {
    display: inline;
    width: 12dp;
    font-size: 12dp;
    color: #a6adc8;
    cursor: pointer;
    text-align: center;
    transition: color 0.1s quadratic-out;
}

.expand-toggle:hover {
    color: #cdd6f4;
}

/* Leaf spacer — same width as expand-toggle for alignment */
.leaf-spacer {
    display: inline;
    width: 12dp;
}

/* Icon images — base style for all PNG icons */
.row-icon {
    display: inline;
    width: 14dp;
    height: 14dp;
    margin-right: 2dp;
    image-color: #cdd6f4;
}

.row-icon.type-icon {
    width: 12dp;
    height: 12dp;
    margin-right: 4dp;
    image-color: #a6adc8;
}

.row-icon.mask-icon {
    width: 12dp;
    height: 12dp;
    margin-right: 2dp;
    image-color: rgba(148, 226, 213, 200);
}

.row-icon.mask-icon.mask-inverted {
    transform: rotate(180deg);
}

/* Visibility toggle */
.row-icon.icon-vis-on {
    image-color: rgba(102, 230, 102, 255);
    transition: image-color 0.12s quadratic-out;
}

.row-icon.icon-vis-on:hover {
    image-color: rgba(130, 255, 130, 255);
}

.row-icon.icon-vis-off {
    image-color: rgba(153, 102, 102, 178);
    transition: image-color 0.12s quadratic-out;
}

.row-icon.icon-vis-off:hover {
    image-color: rgba(180, 120, 120, 220);
}


/* Colored dot — replaces type icons for a cleaner row */
.row-icon.type-icon.splat        { image-color: rgba(153, 204, 255, 230); }
.row-icon.type-icon.group        { image-color: rgba(178, 178, 178, 204); }
.row-icon.type-icon.ply_sequence { image-color: rgba(105, 175, 255, 220); }
.row-icon.type-icon.dataset      { image-color: rgba(127, 178, 255, 230); }
.row-icon.type-icon.camera       { image-color: rgba(127, 153, 204, 200); }
.row-icon.type-icon.camera_group { image-color: rgba(153, 178, 230, 204); }
.row-icon.type-icon.cropbox      { image-color: rgba(255, 178, 77, 230); }
.row-icon.type-icon.transform    { image-color: rgba(255, 178, 77, 230); }
.row-icon.type-icon.ellipsoid    { image-color: rgba(77, 204, 255, 230); }
.row-icon.type-icon.pointcloud   { image-color: rgba(204, 127, 255, 204); }
.row-icon.type-icon.mesh         { image-color: rgba(127, 230, 153, 230); }

/* Fallback Unicode node icons (keyframe etc. without PNG) */
.node-icon {
    display: inline;
    width: 16dp;
    font-size: 12dp;
    text-align: center;
    margin-right: 4dp;
}

.node-icon.keyframe_group { color: rgba(230, 178, 77, 204); }
.node-icon.keyframe       { color: rgba(255, 204, 51, 230); }


.row-icon.trash-icon {
    width: 14dp;
    height: 14dp;
    margin-left: 2dp;
    margin-right: 0;
    flex-shrink: 0;
    image-color: rgba(230, 90, 90, 210);
}

.tree-row.keyboard-cursor {
    border-left-width: 2dp;
    border-left-color: rgba(245, 194, 107, 210);
}

.tree-checkbox {
    display: inline-block;
    position: absolute;
    left: 5dp;
    top: 5dp;
    width: 9dp;
    height: 9dp;
    box-sizing: border-box;
    border-width: 1dp;
    border-color: rgba(166, 173, 200, 90);
    border-radius: 5dp;
    background-color: rgba(166, 173, 200, 10);
    color: rgba(166, 173, 200, 150);
    font-size: 8dp;
    line-height: 7dp;
    text-align: center;
    cursor: pointer;
    flex-shrink: 0;
    z-index: 2;
}

.tree-checkbox:hover {
    border-color: rgba(137, 180, 250, 155);
    background-color: rgba(137, 180, 250, 35);
}

.tree-checkbox.checked {
    border-color: rgba(137, 180, 250, 185);
    background-color: rgba(137, 180, 250, 145);
}

.tree-checkbox.mixed {
    border-color: rgba(137, 180, 250, 145);
    background-color: rgba(137, 180, 250, 24);
}

.selection-action-bar {
    display: none;
    align-items: center;
    box-sizing: border-box;
    flex-shrink: 0;
    height: 27dp;
    margin-top: 2dp;
    padding: 2dp 1dp 2dp 6dp;
    border-top-width: 1dp;
}

.selection-action-count {
    font-size: 11dp;
    height: 22dp;
    line-height: 22dp;
    white-space: nowrap;
}

#selection-clear {
    margin-left: 3dp;
}

.selection-action-spacer {
    flex: 1;
    min-width: 3dp;
}

.selection-action-button {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 22dp;
    height: 22dp;
    padding: 0;
    margin-left: 1dp;
    border-width: 0;
    background-color: transparent;
    cursor: pointer;
}

.selection-action-button img {
    display: block;
    width: 14dp;
    height: 14dp;
}

.selection-action-button.disabled {
    opacity: 0.28;
    cursor: default;
}


.row-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
    margin-right: -11dp;
    padding-left: 4dp;
    padding-right: 3dp;
}

.row-action-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 23dp;
    height: 20dp;
    flex-shrink: 0;
}

.row-action-slot .row-icon {
    margin-left: 0;
    margin-right: 0;
}

.row-icon.training-toggle-icon {
    width: 14dp;
    height: 14dp;
    margin-left: 0;
    margin-right: 0;
    flex-shrink: 0;
}

.training-mixed-mark {
    position: absolute;
    right: 1dp;
    bottom: 3dp;
    width: 6dp;
    height: 2dp;
    border-radius: 1dp;
    pointer-events: none;
}

.row-icon.trash-icon:hover {
    image-color: rgba(243, 139, 168, 230);
}

.tree-row.selected .row-icon.trash-icon {
    image-color: rgba(255, 153, 153, 230);
}

.node-name {
    display: block;
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    color: #cdd6f4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.node-name.training-disabled {
    color: #a6adc8;
}


/* Inline rename input */
.rename-input {
    display: inline;
    min-width: 0;
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
    padding: 2dp 4dp;
    font-size: 12dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #89b4fa;
}

/* Scene tree overrides section-header to block display with different padding */
.section-header {
    display: block;
    min-height: 24dp;
    padding: 4dp 6dp;
    font-size: 12dp;
    cursor: pointer;
}

.section-arrow {
    display: inline-block;
    width: 12dp;
    color: #a6adc8;
}

.empty-state {
    padding: 6dp 0;
}
