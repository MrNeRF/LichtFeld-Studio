/* Scene tree panel styles */

body {
    font-family: Inter;
    font-size: 14dp;
    color: #cdd6f4;
    overflow: auto;
}

/* Filter input */
#filter-input {
    display: block;
    width: 100%;
    padding: 4dp 6dp;
    margin-bottom: 4dp;
    font-size: 13dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
}

#filter-input:focus {
    border-color: #89b4fa;
}

#tree-container {
    width: 100%;
}

.tree-row {
    display: block;
    width: auto;
    padding: 1dp 4dp;
    cursor: pointer;
}

.tree-row:hover {
    background-color: #313244;
}

.tree-row.even {
    background-color: #1e1e2e08;
}

.tree-row.odd {
    background-color: #31324408;
}

/* selected MUST come after even/odd for cascade */
.tree-row.selected {
    background-color: #3c5a8a;
}

.tree-row.selected:hover {
    background-color: #4a6a9a;
}

.tree-row.drop-target {
    border-width: 1dp;
    border-color: #89b4fa;
}

.tree-row:drag {
    opacity: 0.5;
}

.row-content {
    display: inline;
    white-space: nowrap;
}

/* Expand/collapse toggle — inline before name */
.expand-toggle {
    display: inline;
    width: 12dp;
    font-size: 10dp;
    color: #a6adc8;
    cursor: pointer;
    text-align: center;
}

.expand-toggle:hover {
    color: #cdd6f4;
}

/* Leaf spacer — same width as expand-toggle for alignment */
.leaf-spacer {
    display: inline;
    width: 12dp;
}

/* Icon images — base style for all PNG icons */
.row-icon {
    display: inline;
    width: 14dp;
    height: 14dp;
    margin-right: 2dp;
    image-color: #cdd6f4;
}

/* Grip handle — compound selector to beat theme .row-icon override */
.row-icon.icon-grip {
    image-color: rgba(128, 128, 128, 128);
    cursor: move;
}

/* Visibility toggle */
.row-icon.icon-vis-on {
    image-color: rgba(102, 230, 102, 255);
}

.row-icon.icon-vis-on:hover {
    image-color: rgba(130, 255, 130, 255);
}

.row-icon.icon-vis-off {
    image-color: rgba(153, 102, 102, 178);
}

.row-icon.icon-vis-off:hover {
    image-color: rgba(180, 120, 120, 220);
}

/* Trash icon — dim by default, highlighted when row selected */
.row-icon.icon-trash {
    image-color: rgba(128, 128, 128, 128);
}

.row-icon.icon-trash:hover {
    image-color: rgba(255, 153, 153, 230);
}

.tree-row.selected .row-icon.icon-trash {
    image-color: rgba(255, 153, 153, 230);
}

/* Training toggle */
.row-icon.icon-train-on {
    image-color: rgba(102, 179, 255, 255);
}

.row-icon.icon-train-off {
    image-color: rgba(128, 128, 128, 102);
}

/* Node type icons — tinted per type, matching master palette */
.row-icon.icon-type {
    margin-right: 4dp;
}

.row-icon.icon-type.splat        { image-color: rgba(153, 204, 255, 230); }
.row-icon.icon-type.group        { image-color: rgba(178, 178, 178, 204); }
.row-icon.icon-type.dataset      { image-color: rgba(127, 178, 255, 230); }
.row-icon.icon-type.camera       { image-color: rgba(127, 153, 204, 153); }
.row-icon.icon-type.camera_group { image-color: rgba(153, 178, 230, 204); }
.row-icon.icon-type.cropbox      { image-color: rgba(255, 178, 77, 230); }
.row-icon.icon-type.ellipsoid    { image-color: rgba(77, 204, 255, 230); }
.row-icon.icon-type.pointcloud   { image-color: rgba(204, 127, 255, 204); }
.row-icon.icon-type.mesh         { image-color: rgba(127, 230, 153, 230); }

/* Fallback Unicode node icons (keyframe etc. without PNG) */
.node-icon {
    display: inline;
    width: 16dp;
    font-size: 14dp;
    text-align: center;
    margin-right: 4dp;
}

.node-icon.keyframe_group { color: rgba(230, 178, 77, 204); }
.node-icon.keyframe       { color: rgba(255, 204, 51, 230); }

/* Fallback Unicode action icons */
.action-icon {
    display: inline;
    width: 14dp;
    font-size: 14dp;
    text-align: center;
    cursor: pointer;
    margin-right: 2dp;
}

.action-icon.train-off {
    color: rgba(128, 128, 128, 102);
}

.node-name {
    display: inline;
    color: #cdd6f4;
}

.node-name.training-disabled {
    color: #a6adc8;
    text-decoration: line-through;
}

.node-count {
    display: inline;
    color: #6c7086;
    font-size: 12dp;
    margin-left: 6dp;
}

.tree-children {
    /* indentation handled via inline style on each tree-row */
}

.tree-children.collapsed {
    display: none;
}

/* Inline rename input */
.rename-input {
    display: inline;
    width: 150dp;
    padding: 2dp 4dp;
    font-size: 13dp;
    color: #cdd6f4;
    background-color: #313244;
    border-width: 1dp;
    border-color: #89b4fa;
}

/* Context menu popup */
.context-menu {
    display: none;
    position: absolute;
    z-index: 100;
    background-color: #313244;
    border-width: 1dp;
    border-color: #45475a;
    padding: 4dp 0;
    min-width: 150dp;
}

.context-menu.visible {
    display: block;
}

.context-menu-item {
    display: block;
    padding: 4dp 12dp;
    cursor: pointer;
    color: #cdd6f4;
    font-size: 13dp;
}

.context-menu-item:hover {
    background-color: #89b4fa;
    color: #ffffff;
}

.context-menu-item.active {
    font-weight: bold;
}

.context-menu-item.submenu-item {
    padding-left: 20dp;
    font-size: 12dp;
}

.context-menu-label {
    display: block;
    padding: 4dp 12dp;
    color: #a6adc8;
    font-size: 12dp;
}

.context-menu-separator {
    display: block;
    height: 1dp;
    margin: 2dp 4dp;
    background-color: #45475a;
}

/* Section headers */
.section-header {
    display: block;
    padding: 4dp 6dp;
    font-weight: bold;
    color: #cdd6f4;
    cursor: pointer;
    font-size: 14dp;
}

.section-header:hover {
    background-color: #313244;
}

.collapsed {
    display: none;
}

/* Empty state */
.empty-message {
    display: block;
    padding: 8dp 6dp;
    color: #a6adc8;
    font-size: 13dp;
}
