/* Asset Manager styles - Base RCSS */

#content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#asset-floating-header {
    min-height: 28dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8dp;
    padding: 0 4dp;
}

#asset-floating-header.hidden {
    display: none;
}

#asset-floating-title {
    font-size: 12dp;
    font-weight: bold;
}

.asset-panel-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6dp;
    flex-shrink: 0;
}

.asset-button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    margin: 0;
    padding: 0 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 12dp;
    line-height: 16dp;
    font-weight: 400;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
}

.asset-button--text {
    width: auto;
    min-width: 64dp;
    max-width: none;
}

.asset-button--icon {
    width: 28dp;
    min-width: 28dp;
    max-width: 28dp;
    padding: 0;
}

.asset-button--small-icon {
    width: 24dp;
    min-width: 24dp;
    max-width: 24dp;
    height: 24dp;
    min-height: 24dp;
    max-height: 24dp;
    padding: 0;
}

.asset-button-text {
    display: block;
    line-height: 16dp;
    white-space: nowrap;
}

.asset-button-glyph {
    display: block;
    font-size: 18dp;
    line-height: 20dp;
}

.asset-panel-close {
    margin-left: auto;
}

/* ── Shell wrapper ─────────────────────────────────────── */

#asset-shell {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: 100%;
}

#asset-shell.is-floating {
    padding-top: 10dp;
}

#asset-popup {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-height: 0;
}

#asset-viewport-edge {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1dp;
    pointer-events: none;
    z-index: 20;
}

#asset-shell.is-floating #asset-viewport-edge {
    display: none;
}

#asset-popup-toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    gap: 16dp;
    padding: 28dp 12dp 10dp;
    border-bottom-width: 1dp;
    min-height: 44dp;
}

.toolbar-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-height: 0;
}

.toolbar-row-primary {
    flex: 1;
}

.toolbar-row-secondary {
    flex-shrink: 0;
    margin-top: 4dp;
}

.asset-toolbar-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    min-width: 0;
}

.asset-search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    min-width: 0;
    border-width: 1dp;
    border-radius: 4dp;
    padding: 0 8dp;
    height: 28dp;
}

.asset-search-icon {
    font-size: 12dp;
    margin-right: 6dp;
}

.asset-search-box input[type="text"] {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    font-size: 11dp;
    padding: 0 0 0 6dp;
    font-size: 12dp;
    padding: 0 0 0 6dp;
}

.asset-search-box input[type="text"]:focus {
    border-width: 0;
    box-shadow: none;
}

.asset-view-toggle {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.asset-view-toggle-icons {
    flex-shrink: 0;
}

.asset-icon-grid {
    display: inline-flex;
    flex-wrap: wrap;
    width: 11dp;
    height: 11dp;
    gap: 1dp;
}

.asset-icon-grid > span {
    display: block;
    width: 5dp;
    height: 5dp;
}

.asset-icon-list {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    width: 11dp;
    height: 11dp;
    gap: 2dp;
}

.asset-icon-list > span {
    display: block;
    width: 11dp;
    height: 1.5dp;
}

.asset-refresh-button img {
    width: 18dp;
    height: 18dp;
}

.asset-refresh-button.is-stop {
    width: auto;
    min-width: 64dp;
    max-width: none;
    padding: 0 10dp;
}

.asset-import-button {
    font-weight: 600;
}

#asset-main-row {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

#asset-sidebar {
    height: 280dp;
    min-height: 0;
    box-sizing: border-box;
    border-bottom-width: 1dp;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
}

.asset-sidebar-inner {
    flex: 1;
    min-height: 0;
    padding: 8dp;
    overflow-y: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    border-top-width: 1dp;
    border-bottom-width: 1dp;
    z-index: 10;
    flex-shrink: 0;
}

.asset-sidebar-section {
    flex-shrink: 0;
    margin-bottom: 8dp;
}

.asset-sidebar-global {
    flex-shrink: 0;
    margin-bottom: 6dp;
    padding-bottom: 6dp;
    border-bottom-width: 1dp;
}

.asset-sidebar-title,
.asset-info-section-title {
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 8dp;
    letter-spacing: 0.2dp;
}

.asset-sidebar-title .section-arrow {
    display: inline-block;
    width: 10dp;
    font-size: 10dp;
    text-align: center;
    transform: rotate(0deg);
    transition: transform 0.18s cubic-out, color 0.18s cubic-out;
}

.asset-sidebar-title .section-arrow.is-expanded {
    transform: rotate(90deg);
}

.section-content {
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.18s cubic-out;
}

.asset-filter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 6dp;
    margin-bottom: 2dp;
    cursor: pointer;
    border-radius: 3dp;
}

.asset-row-label {
    font-size: 12dp;
}


.asset-row-count {
    font-size: 12dp;
}

.asset-folder-row-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
}

.asset-folder-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-folder-menu img {
    width: 14dp;
    height: 14dp;
}

#asset-gallery {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.asset-gallery-header {
    flex-shrink: 0;
    padding: 10dp 12dp;
    border-bottom-width: 1dp;
}

.asset-gallery-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    min-width: 0;
}

.asset-gallery-header-copy {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-width: 0;
    flex: 1;
}

.asset-gallery-header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-shrink: 1;
    margin-left: auto;
    min-width: 0;
}

.asset-gallery-scan-status {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-gallery-title {
    font-size: 12dp;
    font-weight: 600;
    display: block;
}

.asset-gallery-subtitle {
    font-size: 12dp;
    display: block;
}

.asset-gallery-notice {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin-top: 6dp;
}

.asset-gallery-scroll {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
    min-height: 160dp;
}

.asset-scroll-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.asset-scroll-shell-gallery {
    gap: 0;
}

.asset-scroll-shell-list {
    gap: 4dp;
    padding: 0 12dp 32dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid,
.asset-list-view {
    flex: none;
    min-width: 0;
    min-height: 0;
}

.asset-card-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    padding: 12dp 24dp 12dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid-window {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10dp;
    align-content: flex-start;
    min-width: 0;
}

.asset-card-slot {
    min-width: 0;
    display: flex;
}

.asset-card {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    border-width: 1dp;
    border-radius: 4dp;
    position: relative;
}

.asset-card.is-draggable,
.asset-list-row.is-draggable {
    drag: drag-drop;
    cursor: grab;
}

.asset-card.is-draggable:active,
.asset-list-row.is-draggable:active {
    cursor: grabbing;
}

.asset-card-thumb {
    height: 92dp;
    flex-shrink: 0;
    position: relative;
    border-bottom-width: 1dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.asset-card-placeholder {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 4dp 6dp;
    font-size: 12dp;
    font-weight: 600;
    line-height: 16dp;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.asset-card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 8dp;
}

.asset-card-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4dp;
}

.asset-card-title,
.asset-info-name {
    font-size: 12dp;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.asset-card-title {
    min-width: 0;
}


.asset-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    font-size: 12dp;
}

.asset-card-actions {
    min-height: 24dp;
    flex-shrink: 0;
    padding-right: 30dp;
    display: flex;
    flex-direction: row;
    gap: 6dp;
    margin-top: auto;
    align-items: center;
}

.asset-card-button {
    flex: 1;
}

.asset-card-menu {
    position: absolute;
    bottom: 8dp;
    right: 8dp;
    border-color: transparent;
}

.asset-card-menu img {
    width: 16dp;
    height: 16dp;
}


.asset-list-view {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    /* Reserve a real gutter for the native scrollbars so rows never paint into
     * the scrollbar lane when the panel is docked and space is tight. */
    padding: 12dp 0 0 0;
    box-sizing: border-box;
}

.asset-list-window {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    min-width: 0;
}

.asset-virtual-spacer {
    flex: 0 0 auto;
    width: 100%;
    min-width: 100%;
    pointer-events: none;
}

.asset-gallery-scroll scrollbarvertical,
.asset-gallery-scroll scrollbarhorizontal {
    z-index: 20;
}

.asset-gallery-scroll::-webkit-scrollbar {
    height: 8dp;
    width: 8dp;
}

.asset-gallery-scroll::-webkit-scrollbar-thumb {
    border-radius: 4dp;
}

.asset-list-header,
.asset-list-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
}

.asset-list-header {
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 12dp;
    font-weight: 600;
}

.asset-list-row {
    min-height: 44dp;
    height: 44dp;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    cursor: pointer;
    font-size: 12dp;
    position: relative;
}

.asset-card {
    height: 220dp;
    overflow: hidden;
}

.asset-card-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.asset-list-primary {
    font-weight: 600;
}

.asset-list-primary {
    display: block;
}

.asset-col {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-col-name {
    flex: 1 1 64dp;
    min-width: 64dp;
}

.asset-col-folder { display: none; width: 58dp; flex-shrink: 0; }
.asset-scroll-shell-list.show-folder .asset-col-folder { display: block; }

.asset-col-size {
    width: 48dp;
    flex-shrink: 0;
}

.asset-col-modified { display: none; width: 72dp; flex-shrink: 0; font-size: 10dp; }
.asset-scroll-shell-list.is-wide .asset-col-modified { display: block; }
.asset-col-gallery { width: 96dp; min-width: 96dp; flex-shrink: 0; }


#asset-info-panel {
    height: 220dp;
    min-height: 0;
    box-sizing: border-box;
    overflow: hidden;
    border-top-width: 1dp;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

#bottom-panel-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    border-top-width: 1dp;
    border-bottom-width: 1dp;
    z-index: 10;
    flex-shrink: 0;
}

.asset-info-tabs {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1dp;
}

.asset-info-tab {
    flex: 1;
    text-align: center;
    padding: 8dp 4dp;
    font-size: 12dp;
    cursor: pointer;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
}

.asset-info-content {
    flex: 1;
    overflow-y: auto;
    padding: 12dp;
    min-height: 0;
}

.asset-info-header {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6dp;
    margin-bottom: 12dp;
    padding-bottom: 10dp;
    border-bottom-width: 1dp;
}

.asset-info-section {
    margin-bottom: 16dp;
}

.parameter-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 5dp 0;
    border-bottom-width: 1dp;
}

.parameter-label {
    width: 110dp;
    min-width: 110dp;
    font-size: 12dp;
}

.parameter-value {
    flex: 1;
    min-width: 0;
    text-align: left;
    font-size: 12dp;
    white-space: normal;
    word-break: break-word;
}

.asset-path-value {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


.asset-info-warning {
    padding: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
}

.asset-info-button {
    width: auto;
}


.asset-info-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140dp;
}

.asset-info-empty-text {
    font-size: 12dp;
}

/* Gallery shares the catalog geometry; status and action slots never grow. */
.gallery-sidebar-heading, .gallery-actions { display: flex; align-items: center; gap: 4dp; flex-wrap: wrap; }
.gallery-account-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gallery-checked { padding: 2dp 8dp; }
.gallery-toolbar-button { position: relative; }
.gallery-toolbar-button img { width: 16dp; height: 16dp; }
.gallery-count-overlay { position: absolute; right: 1dp; bottom: 0dp; font-size: 9dp; }
.gallery-badge { position: absolute; top: 6dp; right: 6dp; width: 20dp; height: 20dp; border-radius: 10dp; display: flex; align-items: center; justify-content: center; }
.gallery-badge img { width: 16dp; height: 16dp; }
.gallery-list-icon { width: 12dp; height: 12dp; margin-right: 4dp; }
.gallery-remote { border-width: 1dp; }
.gallery-card-action { visibility: hidden; box-sizing: border-box; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0 8dp; line-height: 16dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-card-meta span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 16dp; }
.asset-card:hover .gallery-card-action, .asset-card:focus .gallery-card-action, .asset-card.is-selected .gallery-card-action { visibility: visible; }
.gallery-card-transfer { display: flex; flex-direction: column; gap: 4dp; padding-top: 4dp; padding-bottom: 4dp; min-width: 0; }
.gallery-card-action.is-persistent { visibility: visible; }
.gallery-stored { position: absolute; left: 7dp; top: 7dp; padding: 1dp 5dp; border-radius: 9dp; font-size: 13dp; }
.gallery-stored-list { margin-left: 4dp; }
.gallery-file-action { box-sizing: border-box; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0 8dp; line-height: 22dp; font-size: 11dp; white-space: nowrap; }
.asset-col-gallery .gallery-file-action { padding: 0 5dp; min-width: 22dp; overflow: hidden; text-overflow: ellipsis; }
.gallery-progress { height: 5dp; width: 100%; flex-shrink: 0; overflow: hidden; border-radius: 2dp; }
.gallery-progress-fill { height: 100%; }
.gallery-list-progress { position: absolute; left: 0; bottom: 0; height: 3dp; }
@keyframes gallery-progress-pulse { from { opacity: 1; } to { opacity: 0.35; } }
.gallery-progress-fill.is-indeterminate { animation: gallery-progress-pulse 0.8s quadratic-in-out infinite alternate; }
.asset-col-name { flex-direction: column; justify-content: center; }
.asset-list-secondary { font-size: 10dp; overflow: hidden; text-overflow: ellipsis; }
#asset-info-gallery .section-content { padding: 4dp; }
#asset-info-gallery .setting-row { display: flex; align-items: center; gap: 8dp; margin-bottom: 4dp; flex-wrap: wrap; }
#asset-info-gallery input, #asset-info-gallery select { flex: 1; min-width: 100dp; }
#asset-info-gallery .section-header { display: flex; align-items: center; gap: 6dp; flex-wrap: wrap; }

.asset-sidebar-title { margin-bottom: 6dp; }

/* Local folders yield to the always-visible Gallery scopes. */
#asset-sidebar-local-scroll { min-height: 0; overflow-y: auto; flex: 0 1 auto; }
#asset-sidebar-local-content { flex-shrink: 0; }
#asset-sidebar-gallery { flex-shrink: 1; min-height: 140dp; max-height: 100%; overflow-y: auto; }
.asset-sidebar-inner { overflow: hidden; }
#asset-sidebar .asset-filter-row { box-sizing: border-box; min-height: 24dp; line-height: 16dp; flex-shrink: 0; }
#asset-sidebar-gallery .asset-filter-row { height: 24dp; }
.gallery-sidebar-heading { height: 28dp; flex-wrap: nowrap; }
.gallery-sidebar-heading .btn { box-sizing: border-box; height: 28dp; min-height: 28dp; padding: 0 6dp; }
.gallery-checked { box-sizing: border-box; height: 20dp; line-height: 16dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#sidebar-resize-handle, #bottom-panel-resize-handle { box-sizing: border-box; }
#sidebar-resize-handle { cursor: default; }

/* Inline gallery approval and nonmodal completion actions. */
.gallery-user-code { font-family: "JetBrains Mono"; font-size: 24dp; margin-bottom: 8dp; }
.gallery-completion { display: flex; align-items: center; flex-wrap: wrap; gap: 6dp; padding: 6dp; }
.gallery-empty { padding: 8dp; }
