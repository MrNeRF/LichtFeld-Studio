/* Asset Manager styles - Base RCSS */

#content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#asset-floating-header {
    min-height: 28dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8dp;
    padding: 0 4dp;
}

#asset-floating-header.hidden {
    display: none;
}

#asset-floating-title {
    font-size: 12dp;
    font-weight: bold;
}

.asset-panel-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6dp;
    flex-shrink: 0;
}

.asset-button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    margin: 0;
    padding: 0 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 12dp;
    line-height: 16dp;
    font-weight: 400;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
}

.asset-button--text {
    width: auto;
    min-width: 64dp;
    max-width: none;
}

.asset-button--icon {
    width: 28dp;
    min-width: 28dp;
    max-width: 28dp;
    padding: 0;
}

.asset-button--small-icon {
    width: 24dp;
    min-width: 24dp;
    max-width: 24dp;
    height: 24dp;
    min-height: 24dp;
    max-height: 24dp;
    padding: 0;
}

.asset-button-text {
    display: block;
    line-height: 16dp;
    white-space: nowrap;
}

.asset-button-glyph {
    display: block;
    font-size: 18dp;
    line-height: 20dp;
}

.asset-panel-close {
    margin-left: auto;
}

/* ── Shell wrapper ─────────────────────────────────────── */

#asset-shell {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: 100%;
}

#asset-shell.is-floating {
    padding-top: 10dp;
}

#asset-popup {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-height: 0;
}

.asset-quick-look {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.52);
    z-index: 30;
}

.asset-size-layer, .asset-size-dismiss { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.asset-size-layer { z-index: 35; }
.asset-size-menu { box-sizing: border-box; position: absolute; top: 80dp; left: 8dp; right: 8dp; max-width: 280dp; padding: 8dp; border-width: 1dp; border-radius: 4dp; }
.asset-size-heading, .asset-size-controls { display: flex; align-items: center; height: 24dp; gap: 8dp; }
.asset-size-heading { margin-bottom: 8dp; }
.asset-size-menu .asset-button { height: 24dp; min-height: 24dp; max-height: 24dp; }
.asset-size-menu .asset-button--icon { width: 24dp; min-width: 24dp; max-width: 24dp; }
.asset-size-title { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
#asset-thumbnail-menu-slider { display: block; flex: 1; min-width: 0; width: auto; }

.asset-quick-look-card {
    width: 360dp;
    max-width: 80%;
    padding: 12dp;
    background-color: #20242b;
    border-width: 1dp;
    border-radius: 6dp;
}

.asset-quick-look-heading,
.asset-quick-look-facts {
    display: flex;
    align-items: center;
    gap: 8dp;
}

.asset-quick-look-heading { justify-content: space-between; margin-bottom: 8dp; }
.asset-quick-look-thumb { height: 180dp; margin-bottom: 8dp; }
.asset-quick-look-facts { flex-direction: column; align-items: flex-start; }
.asset-quick-look-facts > span {
    display: block;
    box-sizing: border-box;
    min-width: 0;
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

#asset-viewport-edge {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1dp;
    pointer-events: none;
    z-index: 20;
}

#asset-shell.is-floating #asset-viewport-edge {
    display: none;
}

#asset-popup-toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    box-sizing: border-box;
    gap: 0;
    padding: 0;
    border-bottom-width: 0;
    height: 40dp;
    min-height: 40dp;
}

.toolbar-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-height: 0;
}

.toolbar-row-primary {
    flex: 1;
}

.toolbar-row-secondary {
    flex-shrink: 0;
    margin-top: 4dp;
}

.asset-toolbar-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    min-width: 0;
}

.asset-search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    min-width: 0;
    border-width: 1dp;
    border-radius: 4dp;
    padding: 0 8dp;
    height: 28dp;
}

.asset-search-icon {
    font-size: 12dp;
    margin-right: 6dp;
}

.asset-search-box input[type="text"] {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    font-size: 11dp;
    padding: 0 0 0 6dp;
    font-size: 12dp;
    padding: 0 0 0 6dp;
}

.asset-search-box input[type="text"]:focus {
    border-width: 0;
    box-shadow: none;
}

.asset-view-toggle {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.asset-view-toggle-icons {
    flex-shrink: 0;
}

.asset-icon-grid {
    display: inline-flex;
    flex-wrap: wrap;
    width: 11dp;
    height: 11dp;
    gap: 1dp;
}

.asset-icon-grid > span {
    display: block;
    width: 5dp;
    height: 5dp;
}

.asset-icon-list {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    width: 11dp;
    height: 11dp;
    gap: 2dp;
}

.asset-icon-list > span {
    display: block;
    width: 11dp;
    height: 1.5dp;
}

.asset-refresh-button img {
    width: 18dp;
    height: 18dp;
}

.asset-refresh-button.is-stop {
    width: auto;
    min-width: 64dp;
    max-width: none;
    padding: 0 10dp;
}

.asset-import-button {
    font-weight: 600;
}

#asset-main-row {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

#asset-sidebar {
    height: auto;
    min-height: 0;
    box-sizing: border-box;
    border-bottom-width: 1dp;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
}

.asset-sidebar-inner {
    flex: 1;
    min-height: 0;
    padding: 8dp;
    overflow-y: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    border-top-width: 1dp;
    border-bottom-width: 1dp;
    z-index: 10;
    flex-shrink: 0;
}

.asset-sidebar-section {
    flex-shrink: 0;
    margin-bottom: 8dp;
}

.asset-sidebar-global {
    flex-shrink: 0;
    margin-bottom: 6dp;
    padding-bottom: 6dp;
    border-bottom-width: 1dp;
}

.asset-sidebar-title,
.asset-info-section-title {
    font-size: 12dp;
    font-weight: bold;
    margin-bottom: 8dp;
    letter-spacing: 0.2dp;
}

.asset-sidebar-title .section-arrow {
    display: inline-block;
    width: 10dp;
    font-size: 10dp;
    text-align: center;
    transform: rotate(0deg);
    transition: transform 0.18s cubic-out, color 0.18s cubic-out;
}

.asset-sidebar-title-main,
.asset-row-main {
    background-color: transparent;
    border-width: 0;
    text-align: left;
}

.asset-sidebar-title-main {
    display: flex;
    align-items: center;
    gap: 4dp;
    padding: 0;
    flex: 1;
    height: auto;
    min-height: 20dp;
    max-height: none;
    border-radius: 0;
    min-width: 0;
}

.asset-sidebar-title .section-arrow.is-expanded {
    transform: rotate(90deg);
}

.section-content {
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.18s cubic-out;
}

.asset-filter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 6dp;
    margin-bottom: 2dp;
    cursor: pointer;
    border-radius: 3dp;
    background-color: transparent;
    border-width: 0;
    text-align: left;
    width: 100%;
}

.asset-row-label {
    font-size: 12dp;
}


.asset-row-count {
    font-size: 12dp;
}

.asset-folder-row-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
}

.asset-row-main {
    min-width: 0;
    padding: 0;
    flex: 1;
    height: auto;
    min-height: 20dp;
    max-height: none;
    border-radius: 0;
    min-width: 0;
}

.asset-folder-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-folder-menu img {
    width: 14dp;
    height: 14dp;
}

#asset-gallery {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
}

.asset-gallery-header {
    flex-shrink: 0;
    padding: 10dp 12dp;
    border-bottom-width: 1dp;
}

.asset-gallery-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    min-width: 0;
}

.asset-gallery-header-copy {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-width: 0;
    flex: 1;
}

.asset-gallery-header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-shrink: 1;
    margin-left: auto;
    min-width: 0;
}

.asset-gallery-scan-status {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-gallery-title {
    font-size: 12dp;
    font-weight: 600;
    display: block;
}

.asset-gallery-subtitle {
    font-size: 12dp;
    display: block;
}

.asset-gallery-notice {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin-top: 6dp;
}

.asset-gallery-scroll {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
    min-height: 160dp;
}

.asset-scroll-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.asset-scroll-shell-gallery {
    gap: 0;
}

.asset-scroll-shell-list {
    gap: 4dp;
    padding: 0 12dp 32dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid,
.asset-list-view {
    flex: none;
    min-width: 0;
    min-height: 0;
}

.asset-card-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    padding: 12dp 24dp 12dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid-window {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10dp;
    align-content: flex-start;
    min-width: 0;
}

.asset-card-slot {
    min-width: 0;
    display: flex;
}

.asset-card {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    border-width: 1dp;
    border-radius: 4dp;
    position: relative;
}

.asset-card.is-draggable,
.asset-list-row.is-draggable {
    drag: drag-drop;
    cursor: grab;
}

.asset-card.is-draggable:active,
.asset-list-row.is-draggable:active {
    cursor: grabbing;
}

.asset-card-thumb {
    height: 92dp;
    flex-shrink: 0;
    position: relative;
    border-bottom-width: 1dp;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.asset-card-placeholder {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 4dp 6dp;
    font-size: 12dp;
    font-weight: 600;
    line-height: 16dp;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.asset-card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 8dp;
}

.asset-card-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4dp;
}

.asset-card-title,
.asset-info-name {
    font-size: 12dp;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.asset-card-title {
    min-width: 0;
}


.asset-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    font-size: 12dp;
}

.asset-card-actions {
    min-height: 24dp;
    flex-shrink: 0;
    padding-right: 30dp;
    display: flex;
    flex-direction: row;
    gap: 6dp;
    margin-top: auto;
    align-items: center;
}

.asset-card-button {
    flex: 1;
}

.asset-card-menu {
    position: absolute;
    bottom: 8dp;
    right: 8dp;
    border-color: transparent;
}

.asset-card-menu img {
    width: 16dp;
    height: 16dp;
}


.asset-list-view {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    /* Reserve a real gutter for the native scrollbars so rows never paint into
     * the scrollbar lane when the panel is docked and space is tight. */
    padding: 12dp 0 0 0;
    box-sizing: border-box;
}

.asset-list-window {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    min-width: 0;
}

.asset-virtual-spacer {
    flex: 0 0 auto;
    width: 100%;
    min-width: 100%;
    pointer-events: none;
}

.asset-gallery-scroll scrollbarvertical,
.asset-gallery-scroll scrollbarhorizontal {
    z-index: 20;
}

.asset-gallery-scroll::-webkit-scrollbar {
    height: 8dp;
    width: 8dp;
}

.asset-gallery-scroll::-webkit-scrollbar-thumb {
    border-radius: 4dp;
}

.asset-list-header,
.asset-list-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
}

.asset-list-header {
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    font-size: 12dp;
    font-weight: 600;
}

.asset-list-row {
    min-height: 44dp;
    height: 44dp;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-radius: 4dp;
    cursor: pointer;
    font-size: 12dp;
    position: relative;
}

.asset-card-body {
    height: 40dp;
    min-height: 40dp;
    max-height: 40dp;
    overflow: hidden;
}

.asset-list-primary {
    font-weight: 600;
}

.asset-list-primary {
    display: block;
}

.asset-col {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-col-name {
    flex: 1 1 64dp;
    min-width: 64dp;
}

.asset-col-folder { display: none; width: 58dp; flex-shrink: 0; }
.asset-scroll-shell-list.show-folder .asset-col-folder { display: block; }

.asset-col-size {
    width: 48dp;
    flex-shrink: 0;
}

.asset-col-modified { display: none; width: auto; flex-shrink: 0; font-size: 10dp; }
.asset-scroll-shell-list.is-wide .asset-col-modified { display: block; }
.asset-col-gallery { width: auto; min-width: 0; flex: 0 0 auto; }


#asset-info-panel {
    height: 220dp;
    min-height: 0;
    box-sizing: border-box;
    overflow: hidden;
    border-top-width: 1dp;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

#bottom-panel-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    border-top-width: 1dp;
    border-bottom-width: 1dp;
    z-index: 10;
    flex-shrink: 0;
}

.asset-info-tabs {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1dp;
}

.asset-info-tab {
    flex: 1;
    text-align: center;
    padding: 8dp 4dp;
    font-size: 12dp;
    cursor: pointer;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
}

.asset-info-content {
    flex: 1;
    overflow-y: auto;
    padding: 12dp;
    min-height: 0;
}

.asset-info-asset-layout {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 12dp;
    min-width: 0;
}

.asset-info-details {
    flex: 1 1 auto;
    min-width: 0;
}

#asset-info-thumbnail {
    flex: 0 0 160dp;
    width: 160dp;
    height: 100dp;
    min-width: 160dp;
    min-height: 100dp;
    background-color: transparent;
}

.asset-info-details {
    flex: 1;
    min-width: 0;
}

.asset-info-header {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6dp;
    margin-bottom: 12dp;
    padding-bottom: 10dp;
    border-bottom-width: 1dp;
}

.asset-info-section {
    margin-bottom: 16dp;
}

.parameter-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 5dp 0;
    border-bottom-width: 1dp;
}

.parameter-label {
    width: 110dp;
    min-width: 110dp;
    font-size: 12dp;
}

.parameter-value {
    flex: 1;
    min-width: 0;
    text-align: left;
    font-size: 12dp;
    white-space: normal;
    word-break: break-word;
}

.asset-path-value {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


.asset-info-warning {
    padding: 8dp;
    border-width: 1dp;
    border-radius: 4dp;
}

.asset-info-button {
    width: auto;
}


.asset-info-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140dp;
}

.asset-info-empty-text {
    display: block;
    font-size: 12dp;
}

/* Gallery shares the catalog geometry; status and action slots never grow. */
.gallery-sidebar-heading, .gallery-actions { display: flex; align-items: center; gap: 4dp; flex-wrap: wrap; }
.gallery-account-label { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gallery-checked { padding: 2dp 8dp; }
.gallery-toolbar-button { position: relative; }
.gallery-toolbar-button img { width: 16dp; height: 16dp; }
.gallery-count-overlay { position: absolute; right: 1dp; bottom: 0dp; font-size: 9dp; }
.gallery-badge { position: absolute; top: 6dp; right: 6dp; width: 20dp; height: 20dp; border-radius: 10dp; display: flex; align-items: center; justify-content: center; }
.gallery-badge img { width: 16dp; height: 16dp; }
.gallery-list-icon { width: 12dp; height: 12dp; margin-right: 4dp; }
.gallery-remote { border-width: 1dp; }
.gallery-card-action { visibility: hidden; box-sizing: border-box; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0 8dp; line-height: 16dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-card-meta span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; line-height: 16dp; }
.asset-card:hover .gallery-card-action, .asset-card:focus .gallery-card-action, .asset-card.is-selected .gallery-card-action { visibility: visible; }
.gallery-card-transfer { display: flex; flex-direction: column; gap: 4dp; padding-top: 4dp; padding-bottom: 4dp; min-width: 0; }
.gallery-card-action.is-persistent { visibility: visible; }
.gallery-stored { position: absolute; left: 7dp; top: 7dp; padding: 1dp 5dp; border-radius: 9dp; font-size: 13dp; }
.gallery-stored-list { margin-left: 4dp; }
.gallery-file-action { box-sizing: border-box; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0 8dp; line-height: 22dp; font-size: 11dp; white-space: nowrap; }
.asset-col-gallery .gallery-file-action { padding: 0 5dp; min-width: 22dp; overflow: hidden; text-overflow: ellipsis; }
.gallery-progress { height: 5dp; width: 100%; flex-shrink: 0; overflow: hidden; border-radius: 2dp; }
.gallery-progress-fill { height: 100%; }
.gallery-list-progress { position: absolute; left: 0; bottom: 0; height: 3dp; }
@keyframes gallery-progress-pulse { from { opacity: 1; } to { opacity: 0.35; } }
.gallery-progress-fill.is-indeterminate { animation: gallery-progress-pulse 0.8s quadratic-in-out infinite alternate; }
.asset-col-name { flex-direction: column; justify-content: center; }
.asset-list-secondary { font-size: 10dp; overflow: hidden; text-overflow: ellipsis; }
#asset-info-gallery .section-content { padding: 4dp; }
#asset-info-gallery .setting-row { display: flex; align-items: center; gap: 8dp; margin-bottom: 4dp; flex-wrap: wrap; }
#asset-info-gallery input, #asset-info-gallery select { flex: 1; min-width: 100dp; }
#asset-info-gallery .section-header { display: flex; align-items: center; gap: 6dp; flex-wrap: wrap; }

.asset-sidebar-title { margin-bottom: 6dp; }

/* Local folders yield to the always-visible Gallery scopes. */
#asset-sidebar-local-scroll { min-height: 0; overflow-y: auto; flex: 0 1 auto; }
#asset-sidebar-local-content { flex-shrink: 0; }
#asset-sidebar-gallery { flex-shrink: 1; min-height: 140dp; max-height: 100%; overflow-y: auto; }
.asset-sidebar-inner { overflow: hidden; }
#asset-sidebar .asset-filter-row { box-sizing: border-box; min-height: 24dp; line-height: 16dp; flex-shrink: 0; }
#asset-sidebar-gallery .asset-filter-row { height: 24dp; }
.gallery-sidebar-heading { height: 28dp; flex-wrap: nowrap; }
.gallery-sidebar-heading .btn { box-sizing: border-box; height: 28dp; min-height: 28dp; padding: 0 6dp; }
.gallery-checked { box-sizing: border-box; height: 20dp; line-height: 16dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#sidebar-resize-handle, #bottom-panel-resize-handle { box-sizing: border-box; }
#sidebar-resize-handle { cursor: default; }

/* Inline gallery approval and nonmodal completion actions. */
.gallery-user-code { font-family: "JetBrains Mono"; font-size: 24dp; margin-bottom: 8dp; }
.gallery-completion { display: flex; align-items: center; flex-wrap: wrap; gap: 6dp; padding: 6dp; }
.gallery-empty { padding: 8dp; }

/* Projects panel layout. Region geometry is selected by the root breakpoint class. */
#asset-shell,
#asset-popup,
#asset-main-row {
    min-width: 0;
    min-height: 0;
}

#asset-popup {
    display: flex;
    flex-direction: column;
    flex: 1;
}

#asset-popup-toolbar {
    flex-shrink: 0;
}

.toolbar-row-primary {
    box-sizing: border-box;
    height: 40dp;
    min-height: 40dp;
    display: flex;
    align-items: center;
    gap: 8dp;
    padding: 8dp;
    flex-wrap: nowrap;
}

.toolbar-row-primary > .asset-button,
.toolbar-row-primary > .asset-view-toggle > .asset-button {
    box-sizing: border-box;
    min-height: 24dp;
    height: 24dp;
    max-height: 24dp;
    min-width: 0;
    padding: 0 8dp;
}

.toolbar-row-primary > .asset-button--icon,
.toolbar-row-primary > .asset-view-toggle > .asset-button--icon {
    width: 24dp;
    min-width: 24dp;
    max-width: 24dp;
    padding: 0;
}

.asset-search-box {
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: center;
    min-width: 80dp;
    height: 24dp;
    min-height: 24dp;
    max-height: 24dp;
    border-width: 0;
    padding: 0;
    flex: 1 1 120dp;
    overflow: hidden;
}

.asset-search-box input[type="text"] {
    box-sizing: border-box;
    min-width: 0;
    flex: 1;
    height: 24dp;
    border-width: 1dp;
    padding: 0 8dp;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-search-placeholder {
    position: absolute;
    left: 8dp;
    right: 8dp;
    top: 4dp;
    height: 16dp;
    line-height: 16dp;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

.asset-search-icon {
    display: block;
    flex: 0 1 auto;
    width: auto;
    max-width: 64dp;
    min-width: 0;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.asset-toolbar-filter { display: inline-flex; }
.asset-toolbar-view { display: none; }
.asset-check-gallery { display: flex; align-items: center; flex: 0 0 auto; max-width: none; }
.asset-check-gallery .asset-button-text,
.asset-check-gallery .gallery-checked {
    flex: 0 0 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.asset-check-gallery-icon { display: none; }
.asset-check-gallery .gallery-checked { margin-left: 4dp; }
.asset-thumbnail-slider { box-sizing: border-box; width: 96dp; height: 24dp; min-height: 24dp; max-height: 24dp; margin: 0; padding: 0; border-width: 0; flex: 0 0 auto; }
.asset-thumbnail-slider slidertrack { height: 4dp; margin-top: 10dp; }
.asset-thumbnail-slider sliderprogress { height: 4dp; margin-top: 0; }
.asset-thumbnail-slider[type="range"] sliderbar { width: 10dp; height: 10dp; margin-top: 7dp; }
/* Track clicks move the knob under the pointer. Keep focus on the input so
   both clicks have the same focus target and RmlUi recognizes a double click. */
.asset-thumbnail-slider slidertrack,
.asset-thumbnail-slider sliderprogress,
.asset-thumbnail-slider sliderbar { focus: none; }
.asset-add-existing-icon { display: none; }
.asset-view-toggle-icons { display: flex; flex: 0 0 auto; height: 24dp; gap: 8dp; }
.asset-view-button { width: 24dp; height: 24dp; min-width: 24dp; min-height: 24dp; padding: 0; }
.asset-view-button img { width: 16dp; height: 16dp; }

#asset-main-row {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex: 1 1 0dp;
    overflow: hidden;
}

.asset-results-stack { display: flex; flex: 1 1 0dp; min-width: 0; min-height: 0; overflow: hidden; }

.asset-navigator {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    min-width: 0;
    padding: 12dp 8dp;
    overflow: hidden;
}

.asset-navigator-scope { display: none; padding-bottom: 8dp; }
.asset-navigator-scope select { width: 100%; height: 24dp; }
.asset-sidebar-inner { display: flex; flex-direction: column; min-height: 0; flex: 1; }
#asset-sidebar-local-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
#asset-sidebar-gallery { flex: 0 0 auto; min-height: 0; max-height: none; overflow: visible; }
.asset-sidebar-section { min-width: 0; }
.asset-sidebar-title { display: flex; align-items: center; gap: 4dp; min-height: 24dp; margin: 0; white-space: nowrap; overflow: hidden; }
.asset-sidebar-title .section-arrow { width: 12dp; flex: 0 0 12dp; font-size: 8dp; }
.asset-sidebar-title > span:nth-child(2) { overflow: hidden; text-overflow: ellipsis; }
.asset-sidebar-title .asset-folder-menu, .asset-sidebar-title .gallery-refresh { margin-left: auto; flex: 0 0 auto; }
.asset-filter-row { display: flex; align-items: center; gap: 8dp; height: 24dp; min-height: 24dp; padding: 0 8dp; border-radius: 3dp; }
.asset-row-label { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-row-count { margin-left: auto; font-family: "JetBrains Mono"; }
.asset-folder-row-right { display: flex; align-items: center; gap: 4dp; margin-left: auto; }
.asset-account-chip { padding: 8dp; white-space: normal; }
.gallery-account-row { display: flex; align-items: center; gap: 6dp; min-height: 24dp; padding: 0 8dp; }
.gallery-account-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.asset-resize-handle { flex: 0 0 auto; z-index: 2; background-color: transparent; }
.asset-resize-handle--vertical { width: 12dp; min-width: 12dp; margin: 0 -2dp; cursor: ew-resize; }
.asset-resize-handle--horizontal { height: 12dp; min-height: 12dp; margin: -2dp 0; cursor: ns-resize; }
.asset-resize-handle:hover, .asset-resize-handle:active, .asset-resize-handle:focus {
    background-color: rgba(128, 160, 220, 0.45);
}

#asset-gallery { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0; min-height: 0; }
.asset-gallery-header { flex: 0 0 auto; min-width: 0; }
.asset-gallery-header-row { min-height: 32dp; display: flex; align-items: center; gap: 8dp; padding: 4dp 12dp; }
.asset-gallery-header-copy { display: flex; align-items: center; gap: 8dp; min-width: 0; flex: 1; }
.asset-gallery-subtitle, .asset-gallery-scan-status { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.asset-refresh-glyph { display: block; width: 16dp; height: 16dp; line-height: 16dp; font-size: 16dp; text-align: center; }
.asset-gallery-header-actions { display: flex; align-items: center; gap: 8dp; min-width: 0; }
.asset-gallery-empty-search { display: flex; align-items: center; gap: 8dp; white-space: nowrap; }
.asset-gallery-notice, .gallery-completion, .gallery-empty { padding: 8dp 12dp; }
.asset-gallery-scroll { flex: 1 1 0dp; min-width: 0; min-height: 0; overflow-y: auto; overflow-x: hidden; }
.asset-scroll-shell { min-width: 0; }

.asset-card-grid { display: flex; flex-direction: column; gap: 0; padding: 12dp; }
.asset-card-grid-window { display: flex; flex-wrap: wrap; gap: 12dp; align-items: flex-start; }
.asset-card-slot { flex: 0 0 auto; min-width: 0; }
.asset-card { position: relative; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
.asset-card-thumb { box-sizing: border-box; width: 100%; min-height: 1dp; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.asset-card-body { box-sizing: border-box; flex: 0 0 40dp; min-width: 0; height: 40dp; padding: 4dp 8dp; display: flex; flex-direction: column; justify-content: center; }
.asset-card-title-row, .asset-card-meta { min-width: 0; height: 16dp; line-height: 16dp; display: flex; gap: 8dp; }
.asset-card-title-row { margin-bottom: 0; }
.asset-card-meta { flex-direction: row; }
.asset-card-title, .asset-card-meta span { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-card-title { flex: 1; font-size: 12dp; }
.asset-card.is-selected .asset-card-title { font-size: 14dp; }
.asset-card-menu { position: absolute; top: 4dp; right: 4dp; visibility: hidden; }
.asset-card:hover .asset-card-menu, .asset-card:focus .asset-card-menu, .asset-card.is-selected .asset-card-menu { visibility: visible; }
.gallery-badge { position: absolute; top: 6dp; right: 6dp; width: 20dp; height: 20dp; display: flex; align-items: center; justify-content: center; border-radius: 10dp; }
.gallery-badge img { width: 16dp; height: 16dp; }
.gallery-card-transfer { height: 8dp; padding: 2dp 0; }
.gallery-progress { height: 4dp; min-height: 4dp; overflow: hidden; border-radius: 2dp; }
.gallery-progress-fill { height: 100%; }

.asset-scroll-shell-list { box-sizing: border-box; padding: 0 12dp; }
.asset-list-header, .asset-list-row { display: flex; align-items: center; gap: 0; min-width: 0; box-sizing: border-box; }
.asset-list-thumb { flex: 0 0 32dp; width: 32dp; height: 20dp; min-width: 32dp; min-height: 20dp; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.asset-list-thumb .asset-card-placeholder { padding: 0; font-size: 8dp; line-height: 10dp; }
.asset-list-header { height: 40dp; min-height: 40dp; }
#asset-gallery > .asset-list-header { width: auto; margin: 0 12dp; padding: 0 8dp; border-width: 0; }
.asset-list-row { position: relative; height: 40dp; min-height: 40dp; padding: 0 8dp; border-width: 0; border-bottom-width: 1dp; }
.asset-list-header .asset-col { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.asset-list-header-spacer { visibility: hidden; }
.asset-list-header-label { display: block; height: 24dp; line-height: 24dp; min-width: 0; flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-list-row .asset-col { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-col-name { flex: 1 1 0dp; min-width: 120dp; display: flex; flex-direction: column; justify-content: center; }
.asset-col-folder { flex: 0 0 auto; }
.asset-col-size { flex: 0 0 auto; text-align: right; font-family: "JetBrains Mono"; }
.asset-col-modified { flex: 0 0 auto; font-family: "JetBrains Mono"; }
.asset-col-gallery { flex: 0 0 auto; min-width: 0; display: flex; align-items: center; gap: 4dp; }
.asset-list-header .asset-col-gallery { display: flex; }
.asset-list-header .asset-col, .asset-list-row .asset-col { flex: 0 0 auto; min-width: 0; max-width: none; box-sizing: border-box; height: 24dp; line-height: 24dp; }
.asset-list-header .asset-col { position: relative; display: flex; flex-direction: row; align-items: center; height: 24dp; padding: 0; font-family: Inter; font-size: 12dp; font-weight: 400; }
.asset-list-column-handle {
    position: absolute;
    right: 0;
    top: 0;
    width: 8dp;
    min-width: 8dp;
    height: 24dp;
    margin-left: auto;
    border-right-width: 1dp;
    border-right-color: transparent;
    cursor: ew-resize;
}
.asset-list-column-handle:hover { border-right-color: #8fb4ff; background-color: rgba(143, 180, 255, 0.18); }
.asset-list-header .asset-col-gallery, .asset-list-row .asset-col-gallery { flex: 0 0 auto; min-width: 0; }
.asset-scroll-shell-list.show-folder .asset-col-folder { display: block; }
.asset-scroll-shell-list.is-wide .asset-col-modified { display: block; }
.asset-list-header.gallery-compact .asset-col-gallery,
.asset-scroll-shell-list.gallery-compact .asset-col-gallery { min-width: 24dp; }
.asset-list-primary, .asset-list-secondary { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-list-secondary { display: none; height: 16dp; line-height: 16dp; font-size: 10dp; }
.gallery-list-icon { width: 16dp; height: 16dp; flex: 0 0 16dp; margin: 0; }
.asset-list-row .asset-col-gallery { gap: 8dp; }
.asset-list-row .asset-col-gallery > span { display: block; flex: 1 1 0dp; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.gallery-list-progress { position: absolute; left: 0; right: 0; bottom: 0; }

.asset-inspector { position: relative; display: flex; flex-direction: column; flex: 0 0 auto; min-width: 0; min-height: 0; overflow: hidden; box-sizing: border-box; }
.inspector-strip { box-sizing: border-box; position: relative; display: none; align-items: center; gap: 8dp; height: 32dp; min-height: 32dp; padding: 0 12dp; overflow: hidden; }
.inspector-strip-name { flex: 1 1 0dp; width: 0; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.inspector-strip-meta { flex: 0 1 56dp; width: 56dp; min-width: 0; max-width: 56dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 10dp; }
.inspector-strip-open { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; min-width: 48dp; padding: 0 8dp; white-space: nowrap; }
.asset-inspector-content { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 0; min-height: 0; overflow-x: hidden; overflow-y: scroll; }
.asset-inspector-content > [data-if] { flex: 0 0 auto; min-width: 0; width: 100%; }
.asset-info-asset-layout { box-sizing: border-box; display: flex; width: 100%; min-width: 0; gap: 16dp; align-items: stretch; }
.asset-info-details { box-sizing: border-box; width: 100%; min-width: 0; flex: 0 0 auto; }
#asset-info-thumbnail { margin: 0; padding: 0; min-width: 0; min-height: 0; flex-shrink: 0; }
.inspector-header { box-sizing: border-box; display: flex; flex-direction: column; flex-wrap: nowrap; align-items: stretch; gap: 8dp; padding: 8dp 12dp; margin: 0; min-width: 0; border-bottom-width: 1dp; }
.inspector-title, .inspector-path { display: block; min-width: 0; width: 100%; height: 16dp; min-height: 16dp; line-height: 16dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.inspector-title { font-size: 12dp; font-weight: bold; }
.inspector-path { font-size: 10dp; }
.inspector-actions { box-sizing: border-box; display: flex; align-items: center; flex-wrap: wrap; height: auto; min-height: 24dp; gap: 8dp; min-width: 0; }
.inspector-actions .btn { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; min-width: 48dp; max-width: 100%; padding: 0 8dp; white-space: nowrap; }
.inspector-actions .btn span { flex: 0 0 auto; }
.inspector-actions .btn span, .inspector-operation span { display: block; min-width: 0; line-height: 16dp; white-space: nowrap; }
.inspector-more { margin-left: auto; flex: 0 0 24dp; }
.inspector-more img { width: 16dp; height: 16dp; }
.inspector-facts { display: flex; flex-direction: column; min-width: 0; }
.inspector-section { box-sizing: border-box; display: flex; flex: 0 0 auto; flex-direction: column; gap: 8dp; padding: 8dp 12dp; border-bottom-width: 1dp; min-width: 0; }
.inspector-section-title { box-sizing: border-box; display: flex; flex: 0 0 24dp; align-items: center; gap: 4dp; justify-content: flex-start; width: 100%; height: 24dp; min-height: 24dp; padding: 0; margin: 0; border-width: 0; line-height: 16dp; font-weight: bold; text-align: left; cursor: pointer; }
.inspector-section-title span { display: block; line-height: 16dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inspector-disclosure { flex: 0 0 8dp; width: 8dp; height: 8dp; transform: rotate(-90deg); }
.inspector-disclosure.is-expanded { transform: rotate(0deg); }
.inspector-section-body { display: flex; flex-direction: column; min-width: 0; }
.parameter-row { box-sizing: border-box; display: flex; flex: 0 0 24dp; flex-direction: row; align-items: center; gap: 8dp; height: 24dp; min-height: 24dp; padding: 0; border-width: 0; min-width: 0; }
.parameter-label, .parameter-value { display: block; box-sizing: border-box; height: 24dp; min-height: 24dp; line-height: 24dp; padding: 0; margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* Covers the longest label in all ten locales at 12 dp, including French
   automatic save (160 dp). Keep the value column separate and ellipsized. */
.parameter-label { flex: 0 0 168dp; width: 168dp; min-width: 168dp; font-size: 12dp; overflow: visible; }
.inspector-problem-status { display: block; flex: 0 0 auto; line-height: 18dp; white-space: normal; }
.inspector-problem > .btn { max-width: 100%; height: auto; min-height: 24dp; white-space: normal; }
.parameter-value { flex: 1 1 0dp; width: 0; min-width: 0; font-family: "JetBrains Mono"; font-size: 11dp; }
.inspector-gallery-summary { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.inspector-gallery-reason { display: block; padding: 4dp 0; }
.inspector-operations { display: flex; flex-direction: column; align-items: stretch; gap: 8dp; min-width: 0; width: 100%; }
.inspector-operation { box-sizing: border-box; display: flex; align-items: center; flex: 0 0 24dp; width: 100%; min-width: 0; max-width: 100%; padding: 0 8dp; text-align: left; justify-content: flex-start; }
.inspector-band-facts { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 16dp; min-width: 0; }
.inspector-band-column { display: flex; flex: 1 1 240dp; flex-direction: column; min-width: 240dp; }
.inspector-multi { display: flex; flex-wrap: wrap; gap: 8dp; align-items: center; }
.asset-info-empty { display: block; box-sizing: border-box; padding: 16dp 12dp; }

.project-operation-modal { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 24dp; background-color: rgba(0, 0, 0, 0.52); z-index: 40; }
.project-operation-dialog { display: flex; flex-direction: column; width: 520dp; max-width: 100%; max-height: 90%; min-width: 280dp; padding: 16dp; gap: 12dp; border-width: 1dp; border-radius: 6dp; overflow: hidden; }
.project-operation-header, .project-operation-footer { display: flex; align-items: center; gap: 8dp; min-height: 28dp; }
.project-operation-header { justify-content: space-between; }
.project-operation-body { display: flex; flex-direction: column; gap: 8dp; min-height: 0; overflow-y: auto; }
.project-operation-footer { justify-content: flex-end; }
.project-dialog-input { width: 100%; min-width: 0; height: 28dp; min-height: 28dp; padding: 4dp 8dp; }
.project-dialog-check { display: flex; align-items: center; gap: 8dp; min-height: 28dp; }
.project-dialog-table { display: flex; flex-direction: column; min-width: 0; }
.project-dialog-table-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 28dp; gap: 8dp; padding: 4dp 8dp; text-align: left; }
.project-dialog-message { white-space: pre-wrap; }

.asset-tray { position: relative; box-sizing: border-box; display: flex; flex: 0 0 auto; flex-direction: column; align-items: stretch; gap: 8dp; height: 32dp; min-height: 32dp; padding: 4dp 8dp; overflow: visible; }
.asset-tray-heading, .asset-tray-title-row, .asset-tray-status-row, .asset-tray-actions { display: flex; align-items: center; gap: 8dp; min-width: 0; height: 24dp; min-height: 24dp; flex-shrink: 0; }
.asset-tray-heading-button { display: flex; align-items: center; gap: 8dp; }
.asset-tray-heading .asset-tray-detail { flex: 1 1 auto; font-size: 10dp; }
.asset-tray-title, .asset-tray-phase, .asset-tray-bytes, .asset-tray-detail { min-width: 0; height: 24dp; line-height: 24dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.asset-tray-list { min-height: 0; flex: 1 1 auto; overflow-y: auto; }
.asset-tray-row { display: flex; flex-direction: column; gap: 8dp; padding: 8dp 0; min-width: 0; }
.asset-tray-direction { flex: 0 0 16dp; height: 24dp; line-height: 24dp; text-align: center; }
.asset-tray-title { flex: 1 1 auto; }
.asset-tray-bytes { flex: 0 1 auto; font-family: "JetBrains Mono"; font-size: 10dp; text-align: right; }
.asset-tray-phase { flex: 1 1 auto; font-size: 10dp; }
.asset-tray-progress { height: 8dp; min-height: 8dp; width: 100%; overflow: hidden; border-radius: 2dp; }
.asset-tray-progress span { display: block; height: 100%; }
.asset-tray-actions { flex: 0 0 auto; }
.asset-tray .btn, .asset-tray .asset-button { box-sizing: border-box; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0 8dp; font-size: 11dp; line-height: 22dp; flex-shrink: 0; }
.asset-tray .asset-button--small-icon { width: 24dp; min-width: 24dp; padding: 0; }
.asset-tray-reason { white-space: normal; }
.asset-tray .asset-tray-project { flex: 1 1 0dp; min-width: 0; padding: 0; text-align: left; }
.asset-tray-project span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-tray .hidden { display: none; }
#asset-tray-resize-handle { position: absolute; left: 0; right: 0; top: -6dp; width: auto; height: 12dp; min-height: 12dp; margin: 0; }

.asset-shell.is-wide #asset-main-row { flex-direction: row; }
.asset-shell.is-wide .asset-results-stack { flex-direction: row; }
.asset-shell.is-floating #asset-popup { min-width: 260dp; min-height: 360dp; }
.asset-shell.is-wide .asset-navigator { flex: 0 0 auto; height: auto; border-right-width: 1dp; border-bottom-width: 0; }
.asset-shell.is-wide .inspector-resize-handle { display: block; }
.asset-shell.is-wide .asset-inspector { flex: 0 0 auto; min-width: 240dp; max-width: 420dp; }
.asset-shell.is-wide .asset-info-asset-layout,
.asset-shell.is-narrow .asset-info-asset-layout,
.asset-shell.is-compact .asset-info-asset-layout { flex-direction: column; }
.asset-shell.is-wide .asset-inspector > .asset-resize-handle--horizontal { display: none; }
.asset-shell.is-medium #asset-main-row { flex-direction: row; }
.asset-shell.is-medium .asset-results-stack { flex-direction: column; }
.asset-shell.is-medium .asset-navigator { flex: 0 0 auto; height: auto; border-right-width: 1dp; border-bottom-width: 0; }
.asset-shell.is-medium .asset-inspector { position: absolute; left: 0; right: 0; bottom: 0; width: auto; flex: 0 0 auto; overflow: visible; }
.asset-shell.is-medium .asset-info-asset-layout { padding: 8dp 16dp; align-items: flex-start; }
.asset-shell.is-medium .asset-info-details { flex: 1 1 0dp; width: auto; }
.asset-shell.is-medium .inspector-header { padding: 0; margin: 0 0 8dp; border-width: 0; }


.asset-shell.is-medium .inspector-resize-handle { display: none; }
.asset-shell.is-medium .asset-inspector > .asset-resize-handle { position: absolute; left: 0; right: 0; top: -8dp; height: 12dp; margin: 0; }
.asset-shell.is-medium .inspector-strip { display: none; }
.asset-shell.is-narrow #asset-main-row, .asset-shell.is-compact #asset-main-row { flex-direction: column; }
.asset-shell.is-narrow .asset-results-stack, .asset-shell.is-compact .asset-results-stack { flex-direction: column; }
.asset-shell.is-narrow .asset-navigator, .asset-shell.is-compact .asset-navigator { display: flex; flex: 0 0 32dp; width: auto; padding: 4dp 8dp; }
.asset-shell.is-narrow .asset-sidebar-inner, .asset-shell.is-compact .asset-sidebar-inner { display: none; }
.asset-shell.is-narrow .asset-navigator-scope, .asset-shell.is-compact .asset-navigator-scope { display: block; }
.asset-shell.is-narrow .asset-resize-handle--vertical, .asset-shell.is-compact .asset-resize-handle--vertical { display: none; }
.asset-shell.is-narrow .asset-inspector, .asset-shell.is-compact .asset-inspector { width: auto; height: 32dp; flex: 0 0 32dp; overflow: visible; }
.asset-shell.is-narrow .inspector-resize-handle, .asset-shell.is-compact .inspector-resize-handle { display: none; }
.asset-shell.is-narrow .inspector-strip, .asset-shell.is-compact .inspector-strip { display: flex; }
.asset-shell.is-narrow .asset-inspector-content, .asset-shell.is-compact .asset-inspector-content { position: absolute; left: 0; right: 0; bottom: 32dp; height: 200dp; display: none; z-index: 3; }
.asset-shell.is-narrow.inspector-expanded .asset-inspector-content, .asset-shell.is-compact.inspector-expanded .asset-inspector-content { display: block; }
.asset-shell.is-compact .asset-toolbar-filter, .asset-shell.is-compact .asset-sort-button { display: none; }
.asset-shell.is-compact .asset-toolbar-view { display: block; }
.asset-shell.is-compact .asset-view-toggle-icons, .asset-shell.is-compact .asset-thumbnail-slider, .asset-shell.is-compact .asset-check-gallery { display: none; }
.asset-shell.is-compact .asset-import-button { display: none; }
.asset-shell.is-compact .asset-add-existing-icon { display: block; }
.asset-shell.is-narrow .asset-toolbar-filter, .asset-shell.is-narrow .asset-sort-button { display: none; }
.asset-shell.is-narrow .asset-toolbar-view { display: block; }
.asset-shell.is-narrow .asset-view-toggle-icons, .asset-shell.is-narrow .asset-thumbnail-slider { display: none; }
.asset-shell.is-narrow .asset-check-gallery,
.asset-shell.is-compact .asset-check-gallery { display: inline-flex; width: 24dp; min-width: 24dp; max-width: 24dp; padding: 0; }
.asset-shell.is-narrow .asset-check-gallery .asset-button-text,
.asset-shell.is-compact .asset-check-gallery .asset-button-text,
.asset-shell.is-narrow .asset-check-gallery .gallery-checked,
.asset-shell.is-compact .asset-check-gallery .gallery-checked { display: none; }
.asset-shell.is-narrow .asset-check-gallery-icon,
.asset-shell.is-compact .asset-check-gallery-icon { display: block; font-size: 16dp; line-height: 16dp; }
.asset-shell.is-narrow .asset-import-button { display: none; }
.asset-shell.is-narrow .asset-add-existing-icon { display: block; }
.asset-shell.is-narrow .gallery-account-row, .asset-shell.is-compact .gallery-account-row { display: none; }
.asset-shell.is-compact .toolbar-row-primary, .asset-shell.is-narrow .toolbar-row-primary { flex-wrap: wrap; height: 80dp; min-height: 80dp; row-gap: 16dp; }
.asset-shell.is-compact .asset-search-box, .asset-shell.is-narrow .asset-search-box { flex-basis: 100%; }

.asset-shell.is-narrow #asset-popup-toolbar,
.asset-shell.is-compact #asset-popup-toolbar { height: 80dp; min-height: 80dp; }
.asset-shell.is-compact .asset-check-gallery { display: inline-flex; }
.asset-shell.is-compact .asset-toolbar-view, .asset-shell.is-narrow .asset-toolbar-view { flex: 1; }
.asset-shell.is-compact .asset-panel-close, .asset-shell.is-narrow .asset-panel-close { margin-left: 0; }
.asset-shell.is-medium .asset-import-button { display: none; }
.asset-shell.is-medium .asset-add-existing-icon { display: inline-flex; }

/* The header and rows share one browser column grid at every UI scale. */
.asset-list-sort { box-sizing: border-box; display: block; width: 100%; min-width: 0; max-width: none; height: 24dp; min-height: 24dp; max-height: 24dp; padding: 0; margin: 0; border-width: 0; background-color: transparent; text-align: left; font-size: 12dp; cursor: pointer; }
.asset-col-size .asset-list-sort { text-align: right; }
.asset-list-header .asset-col.hidden, .asset-list-row .asset-col.hidden { display: none; }
.asset-list-header-gallery-icon { display: none; }
.asset-list-header.gallery-compact .asset-col-gallery .asset-list-header-label { display: none; }
.asset-list-header.gallery-compact .asset-list-header-gallery-icon { display: block; width: 16dp; height: 16dp; margin: 4dp; }
.asset-scroll-shell-list.gallery-compact .asset-col-gallery > span { display: none; }
.asset-scroll-shell-list.gallery-compact .asset-col-gallery { justify-content: center; gap: 0; }
.asset-list-header.gallery-compact .asset-col-gallery .asset-list-column-handle { display: none; }
.asset-scroll-shell-list.gallery-compact .asset-list-row { height: 48dp; min-height: 48dp; }
.asset-scroll-shell-list.gallery-compact .asset-col-name { height: 32dp; line-height: 16dp; }
.asset-scroll-shell-list.gallery-compact .asset-list-primary, .asset-scroll-shell-list.gallery-compact .asset-list-secondary { display: block; height: 16dp; line-height: 16dp; }

/* Runtime font measurements include cell padding. Rows keep their own inset. */
#asset-text-measure { position: absolute; visibility: hidden; pointer-events: none; width: 0; height: 0; }
#asset-measure-prose { font-family: Inter; font-size: 12dp; font-weight: 400; }
#asset-measure-mono { font-family: "JetBrains Mono"; font-size: 10dp; font-weight: 400; }
.asset-list-thumb { margin-right: 8dp; }
.asset-list-row .asset-col, .asset-list-header .asset-col { padding: 0 8dp; }
.asset-list-row .asset-col-size, .asset-list-row .asset-col-modified { font-size: 10dp; }
.asset-list-header.gallery-compact .asset-list-header-gallery-icon { margin: 4dp 0; }
.asset-card-meta { min-width: 0; }
.asset-card-meta span { flex: 1 1 0dp; }
.project-operation-dialog { box-sizing: border-box; min-width: 0; }
.project-operation-footer { flex-wrap: wrap; }
.project-operation-header > span { min-width: 0; white-space: normal; }

.asset-row-count { flex: 0 0 auto; white-space: nowrap; }

.asset-card-placeholder { box-sizing: border-box; max-width: 100%; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* Relationship glyphs sit beside words; activity and file health are independent. */
.gallery-card-state { display: flex; align-items: center; gap: 4dp; min-width: 0; }
.gallery-card-state > span { min-width: 0; flex: 1 1 0dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.gallery-card-state .gallery-list-icon { flex: 0 0 16dp; }
.gallery-activity { position: absolute; top: 6dp; right: 6dp; width: 16dp; height: 16dp; }
.gallery-activity > img, .gallery-activity > progress { position: absolute; left: 0; top: 0; width: 16dp; height: 16dp; }
.gallery-activity > progress { fill-image: ../icon/gallery-progress-ring.png; }
.asset-health-badge { position: absolute; left: 6dp; top: 6dp; width: 16dp; height: 16dp; display: flex; justify-content: center; align-items: center; border-radius: 8dp; line-height: 16dp; font-size: 12dp; font-weight: bold; }
.asset-list-thumb .asset-health-badge { left: 0; top: 0; }
.asset-list-thumb .gallery-activity { right: 0; top: 0; }
.inspector-strip > .asset-health-badge, .inspector-strip > .gallery-activity { position: relative; left: auto; right: auto; top: auto; flex: 0 0 16dp; }

.asset-card-menu { top: auto; bottom: 44dp; right: 6dp; }

.asset-health-badge > span { display: block; line-height: 16dp; }
