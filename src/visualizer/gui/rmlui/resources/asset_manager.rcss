/* Asset Manager styles - Base RCSS */
/* Colors are defaults; theme RCSS overrides with @{variable} syntax */

/* ── Window Layout ─────────────────────────────────────── */

#asset-popup {
    width: 980dp;
    height: 620dp;
    display: flex;
    flex-direction: column;
    background-color: #24221f;
    color: #d8d0c3;
    border-width: 1dp;
    border-color: #514a42;
}

#content-wrap {
    padding: 0;
    overflow: hidden;
}

/* ── Toolbar ─────────────────────────────────────────────── */

#asset-popup-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    padding: 10dp 12dp;
    background-color: #2b2825;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
    min-height: 44dp;
}

.asset-search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    min-width: 0;
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    padding: 0 8dp;
    height: 28dp;
}

.asset-search-icon {
    font-size: 10dp;
    color: #a9a093;
    margin-right: 6dp;
}

.asset-search-box input[type="text"] {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    color: #d8d0c3;
    font-size: 11dp;
    padding: 0;
    height: 100%;
}

.asset-search-box input[type="text"]:focus {
    border-width: 0;
    box-shadow: none;
}

.asset-sort-button {
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    color: #d8d0c3;
    font-size: 11dp;
    padding: 4dp 10dp;
    border-radius: 4dp;
    cursor: pointer;
}

.asset-view-toggle {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.asset-view-button {
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    color: #a9a093;
    font-size: 10dp;
    padding: 4dp 10dp;
    cursor: pointer;
}

.asset-view-button.is-active {
    background-color: #38342f;
    color: #f0ebe2;
    border-color: #7fb9a5;
}

/* ── Summary Bar ─────────────────────────────────────────── */

#asset-popup-summary {
    display: flex;
    flex-direction: row;
    gap: 16dp;
    padding: 6dp 12dp;
    background-color: #24221f;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
    font-size: 11dp;
    color: #a9a093;
}

/* ── Main Content Layout ───────────────────────────────── */

#asset-popup-content {
    flex: 1;
    display: flex;
    flex-direction: row;
    min-height: 0;
    overflow: hidden;
}

/* ── Sidebar ─────────────────────────────────────────────── */

#asset-sidebar {
    width: 150dp;
    min-width: 150dp;
    padding: 10dp;
    background-color: #2b2825;
    border-right-width: 1dp;
    border-right-color: #3c3630;
    overflow-y: auto;
}

.asset-sidebar-section {
    margin-bottom: 14dp;
}

.asset-sidebar-title {
    font-size: 9dp;
    font-weight: bold;
    color: #a9a093;
    margin-bottom: 8dp;
    letter-spacing: 0.5dp;
}

.asset-filter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 6dp;
    margin-bottom: 2dp;
    cursor: pointer;
    border-radius: 3dp;
    transition: background-color 0.1s;
}

.asset-filter-row:hover {
    background-color: #38342f;
}

.asset-filter-row.is-active {
    background-color: #36564b;
}

.asset-row-label {
    font-size: 11dp;
    color: #d8d0c3;
}

.asset-filter-row.is-active .asset-row-label {
    color: #9be0ca;
}

.asset-row-count {
    font-size: 10dp;
    color: #a9a093;
}

/* ── Gallery ─────────────────────────────────────────────── */

#asset-gallery {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background-color: #24221f;
}

.asset-gallery-header {
    padding: 10dp 12dp;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-gallery-title {
    font-size: 12dp;
    font-weight: 600;
    color: #f0ebe2;
    display: block;
}

.asset-gallery-subtitle {
    font-size: 10dp;
    color: #a9a093;
    display: block;
    margin-top: 2dp;
}

.asset-gallery-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 12dp;
}

.asset-card-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10dp;
}

/* ── Asset Cards ─────────────────────────────────────────── */

.asset-card {
    width: 200dp;
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    overflow: hidden;
    transition: border-color 0.1s, box-shadow 0.1s;
}

.asset-card:hover {
    border-color: #7fb9a5;
}

.asset-card.is-selected {
    border-color: #7fb9a5;
    border-width: 2dp;
}

.asset-card-thumb {
    height: 92dp;
    position: relative;
    border-bottom-width: 1dp;
    border-bottom-color: #514a42;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Thumbnail variations */
.asset-thumb-statue {
    background-color: #3f3a33;
    decorator: vertical-gradient(#777064 #2e2a25);
}

.asset-thumb-fountain {
    background-color: #4a4239;
    decorator: vertical-gradient(#8a7f70 #3a342d);
}

.asset-thumb-interior {
    background-color: #4a3f33;
    decorator: vertical-gradient(#8a7864 #3a3229);
}

.asset-thumb-tree {
    background-color: #3a4233;
    decorator: vertical-gradient(#6a7a5c #2a3025);
}

.asset-thumb-video {
    background-color: #3a3a42;
    decorator: vertical-gradient(#6a6a7a #2a2a32);
}

.asset-thumb-bust {
    background-color: #423a33;
    decorator: vertical-gradient(#7a6e64 #322c29);
}

.asset-thumb-label {
    position: absolute;
    left: 8dp;
    bottom: 8dp;
    font-size: 15dp;
    font-weight: bold;
    color: #f0ebe2;
}

.asset-card-overlay {
    position: absolute;
    top: 6dp;
    left: 6dp;
    right: 6dp;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.asset-checkbox {
    width: 16dp;
    height: 16dp;
    background-color: rgba(0, 0, 0, 100);
    border-width: 1dp;
    border-color: #7fb9a5;
    border-radius: 3dp;
    color: #7fb9a5;
    font-size: 10dp;
    text-align: center;
    line-height: 14dp;
}

.asset-checkbox.is-checked {
    background-color: #7fb9a5;
    color: #151412;
}

.asset-pill {
    font-size: 9dp;
    font-weight: bold;
    padding: 2dp 6dp;
    border-radius: 3dp;
}

.asset-pill-ply {
    background-color: #36564b;
    color: #9be0ca;
}

.asset-pill-mp4 {
    background-color: #584531;
    color: #e9b56e;
}

.asset-pill-rad {
    background-color: #46405c;
    color: #c0b7e8;
}

.asset-video-duration {
    position: absolute;
    right: 8dp;
    bottom: 8dp;
    font-size: 10dp;
    color: #f0ebe2;
    background-color: rgba(0, 0, 0, 150);
    padding: 2dp 6dp;
    border-radius: 3dp;
}

.asset-card-body {
    padding: 8dp;
}

.asset-card-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4dp;
}

.asset-card-title {
    font-size: 11dp;
    font-weight: 600;
    color: #f0ebe2;
}

.asset-favorite {
    font-size: 12dp;
    color: #e9b56e;
}

.asset-card-meta {
    font-size: 10dp;
    color: #a9a093;
    margin-bottom: 6dp;
}

.asset-card-tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 4dp;
    margin-bottom: 8dp;
}

.asset-card-tag {
    font-size: 9dp;
    color: #a9a093;
    background-color: #38342f;
    padding: 2dp 6dp;
    border-radius: 3dp;
}

.asset-card-actions {
    display: flex;
    flex-direction: row;
    gap: 4dp;
}

.asset-card-button {
    flex: 1;
    font-size: 9dp;
    color: #d8d0c3;
    background-color: #38342f;
    border-width: 1dp;
    border-color: #514a42;
    padding: 3dp 6dp;
    cursor: pointer;
    border-radius: 3dp;
}

.asset-card-button:hover {
    background-color: #454038;
    border-color: #7fb9a5;
}

/* ── Info Panel ──────────────────────────────────────────── */

#asset-info-panel {
    width: 245dp;
    min-width: 245dp;
    background-color: #2b2825;
    border-left-width: 1dp;
    border-left-color: #3c3630;
    display: flex;
    flex-direction: column;
}

.asset-info-tabs {
    display: flex;
    flex-direction: row;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-info-tab {
    flex: 1;
    text-align: center;
    padding: 8dp 4dp;
    font-size: 11dp;
    color: #a9a093;
    cursor: pointer;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
    margin-bottom: -1dp;
}

.asset-info-tab:hover {
    color: #d8d0c3;
}

.asset-info-tab.is-active {
    color: #7fb9a5;
    border-bottom-color: #7fb9a5;
}

.asset-info-content {
    flex: 1;
    overflow-y: auto;
    padding: 12dp;
}

.asset-info-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    margin-bottom: 12dp;
    padding-bottom: 10dp;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-info-name {
    flex: 1;
    font-size: 13dp;
    font-weight: 600;
    color: #f0ebe2;
}

.asset-info-favorite {
    font-size: 12dp;
    color: #e9b56e;
}

.asset-info-section {
    margin-bottom: 16dp;
}

.asset-info-section-title {
    font-size: 10dp;
    font-weight: bold;
    color: #a9a093;
    margin-bottom: 8dp;
    letter-spacing: 0.5dp;
}

.parameter-row {
    display: flex;
    flex-direction: row;
    padding: 5dp 0;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.parameter-label {
    width: 115dp;
    color: #a9a093;
    font-size: 10dp;
}

.parameter-value {
    flex: 1;
    text-align: right;
    color: #f0ebe2;
    font-size: 10dp;
}

.asset-preview-thumb {
    height: 100dp;
    border-radius: 4dp;
    margin-bottom: 10dp;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.asset-open-viewer-btn {
    width: 100%;
    font-size: 11dp;
    color: #d8d0c3;
    background-color: #38342f;
    border-width: 1dp;
    border-color: #514a42;
    padding: 6dp 12dp;
    cursor: pointer;
    border-radius: 4dp;
}

.asset-open-viewer-btn:hover {
    background-color: #454038;
    border-color: #7fb9a5;
}

/* ── Footer / Batch Actions ─────────────────────────────── */

#asset-popup-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10dp 12dp;
    background-color: #2b2825;
    border-top-width: 1dp;
    border-top-color: #3c3630;
    min-height: 52dp;
}

.asset-batch-summary {
    display: flex;
    flex-direction: column;
}

.asset-batch-title {
    font-size: 12dp;
    font-weight: 600;
    color: #f0ebe2;
}

.asset-batch-subtitle {
    font-size: 10dp;
    color: #a9a093;
    margin-top: 2dp;
}

.asset-batch-actions {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.asset-batch-button {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    font-size: 11dp;
    color: #d8d0c3;
    background-color: #38342f;
    border-width: 1dp;
    border-color: #514a42;
    padding: 6dp 12dp;
    cursor: pointer;
    border-radius: 4dp;
}

.asset-batch-button:hover {
    background-color: #454038;
    border-color: #7fb9a5;
}

.asset-batch-button.is-danger {
    color: #e8a095;
    border-color: #8b4a42;
}

.asset-batch-button.is-danger:hover {
    background-color: #5a3a35;
    border-color: #d86a5f;
}

.asset-btn-icon {
    font-size: 10dp;
}
