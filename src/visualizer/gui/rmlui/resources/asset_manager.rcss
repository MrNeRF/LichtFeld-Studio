/* Asset Manager styles - Base RCSS */

#content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

#content-wrap {
    padding: 0;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

#asset-floating-header {
    min-height: 28dp;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8dp;
    padding: 0 4dp;
}

#asset-floating-header.hidden {
    display: none;
}

#asset-floating-title {
    font-size: 12dp;
    font-weight: bold;
    color: #cdd6f4;
}

.asset-panel-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6dp;
    flex-shrink: 0;
}

.asset-button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    margin: 0;
    padding: 0 10dp;
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    color: #d8d0c3;
    font-size: 12dp;
    line-height: 16dp;
    font-weight: 400;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    cursor: pointer;
}

.asset-button:hover {
    background-color: #454038;
    border-color: #7fb9a5;
    color: #f0ebe2;
}

.asset-button:active {
    background-color: #36564b;
    border-color: #7fb9a5;
}

.asset-button--text {
    width: auto;
    min-width: 64dp;
    max-width: none;
}

.asset-button--icon {
    width: 28dp;
    min-width: 28dp;
    max-width: 28dp;
    padding: 0;
}

.asset-button--small-icon {
    width: 24dp;
    min-width: 24dp;
    max-width: 24dp;
    height: 24dp;
    min-height: 24dp;
    max-height: 24dp;
    padding: 0;
}

.asset-button-text {
    display: block;
    line-height: 16dp;
    white-space: nowrap;
}

.asset-button-glyph {
    display: block;
    font-size: 18dp;
    line-height: 20dp;
}

.asset-panel-close {
    margin-left: auto;
}

/* ── Shell wrapper ─────────────────────────────────────── */

#asset-shell {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    width: 100%;
}

#asset-shell.is-floating {
    padding-top: 10dp;
}

#asset-popup {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
    min-height: 240dp;
    background-color: #24221f;
    color: #d8d0c3;
}

#asset-viewport-edge {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 1dp;
    background-color: rgba(88, 91, 112, 153);
    pointer-events: none;
    z-index: 20;
}

#asset-shell.is-floating #asset-viewport-edge {
    display: none;
}

#asset-popup-toolbar {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex-shrink: 0;
    gap: 16dp;
    padding: 28dp 12dp 10dp;
    background-color: #2b2825;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
    min-height: 44dp;
}

.toolbar-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-height: 0;
}

.toolbar-row-primary {
    flex: 1;
}

.toolbar-row-secondary {
    flex-shrink: 0;
    margin-top: 4dp;
}

.asset-toolbar-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    min-width: 0;
}

.asset-search-box {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1;
    min-width: 0;
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    padding: 0 8dp;
    height: 28dp;
}

.asset-search-icon {
    font-size: 12dp;
    color: #a9a093;
    margin-right: 6dp;
}

.asset-search-box input[type="text"] {
    flex: 1;
    background-color: transparent;
    border-width: 0;
    color: #d8d0c3;
    font-size: 11dp;
    padding: 0 0 0 6dp;
    font-size: 12dp;
    padding: 0 0 0 6dp;
}

.asset-search-box input[type="text"]:focus {
    border-width: 0;
    box-shadow: none;
}

.asset-view-toggle {
    display: flex;
    flex-direction: row;
    gap: 2dp;
}

.asset-view-toggle-icons {
    flex-shrink: 0;
}

.asset-view-button {
    color: #a9a093;
}

.asset-view-button.is-active {
    background-color: #38342f;
    color: #f0ebe2;
    border-color: #7fb9a5;
}

.asset-icon-grid {
    display: inline-flex;
    flex-wrap: wrap;
    width: 11dp;
    height: 11dp;
    gap: 1dp;
}

.asset-icon-grid > span {
    display: block;
    width: 5dp;
    height: 5dp;
    background-color: #d8d0c3;
}

.asset-icon-list {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    width: 11dp;
    height: 11dp;
    gap: 2dp;
}

.asset-icon-list > span {
    display: block;
    width: 11dp;
    height: 1.5dp;
    background-color: #d8d0c3;
}

.asset-refresh-button img {
    width: 18dp;
    height: 18dp;
    image-color: rgba(216, 208, 195, 235);
}

.asset-refresh-button:hover img {
    image-color: rgba(255, 255, 255, 255);
}

.asset-refresh-button.is-stop {
    width: auto;
    min-width: 64dp;
    max-width: none;
    padding: 0 10dp;
}

.asset-import-button {
    background-color: #7fb9a5;
    border-color: #6ba08d;
    color: #1a1a1a;
    font-weight: 600;
}

.asset-import-button:hover {
    background-color: #8fcab5;
}

#asset-main-row {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

#asset-sidebar {
    height: 176dp;
    min-height: 120dp;
    max-height: 400dp;
    background-color: #2b2825;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
}

.asset-sidebar-inner {
    flex: 1;
    padding: 10dp;
    overflow-y: auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

#sidebar-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    background-color: rgba(127, 185, 165, 0.12);
    border-top-width: 1dp;
    border-top-color: rgba(127, 185, 165, 0.28);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(0, 0, 0, 0.35);
    z-index: 10;
    flex-shrink: 0;
}

#sidebar-resize-handle:hover {
    background-color: rgba(127, 185, 165, 0.34);
}

#sidebar-resize-handle.dragging {
    background-color: rgba(127, 185, 165, 0.48);
}

.asset-sidebar-section {
    margin-bottom: 14dp;
}

.asset-sidebar-global {
    margin-bottom: 10dp;
    padding-bottom: 8dp;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-sidebar-title,
.asset-info-section-title {
    font-size: 12dp;
    font-weight: bold;
    color: #a9a093;
    margin-bottom: 8dp;
    letter-spacing: 0.2dp;
}

.asset-sidebar-title .section-arrow {
    display: inline-block;
    width: 10dp;
    font-size: 10dp;
    color: #7a7268;
    text-align: center;
    transform: rotate(0deg);
    transition: transform 0.18s cubic-out, color 0.18s cubic-out;
}

.asset-sidebar-title:hover .section-arrow,
.asset-sidebar-title .section-arrow.is-expanded {
    color: #d8d0c3;
}

.asset-sidebar-title .section-arrow.is-expanded {
    transform: rotate(90deg);
}

.section-content {
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.18s cubic-out;
}

.asset-filter-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 6dp;
    margin-bottom: 2dp;
    cursor: pointer;
    border-radius: 3dp;
}

.asset-filter-row:hover {
    background-color: #38342f;
}

.asset-filter-row.is-active {
    background-color: #36564b;
}

.asset-row-label {
    font-size: 12dp;
    color: #d8d0c3;
}

.asset-filter-row.is-active .asset-row-label {
    color: #9be0ca;
}


.asset-row-count {
    font-size: 12dp;
    color: #a9a093;
}

.asset-folder-row-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
}

.asset-folder-menu {
    background-color: transparent;
    border-color: transparent;
}

.asset-folder-menu img {
    width: 14dp;
    height: 14dp;
    image-color: rgba(216, 208, 195, 230);
}

.asset-folder-menu:hover {
    background-color: rgba(72, 67, 61, 0.95);
}

.asset-folder-menu:hover img {
    image-color: rgba(255, 255, 255, 255);
}

#asset-gallery {
    flex: 1;
    min-width: 0;
    min-height: 240dp;
    display: flex;
    flex-direction: column;
    background-color: #24221f;
}

.asset-gallery-header {
    flex-shrink: 0;
    padding: 10dp 12dp;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-gallery-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10dp;
    min-width: 0;
}

.asset-gallery-header-copy {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
    min-width: 0;
    flex: 1;
}

.asset-gallery-header-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    flex-shrink: 1;
    margin-left: auto;
    min-width: 0;
}

.asset-gallery-scan-status {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin: 0;
    color: #a9a093;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-gallery-title {
    font-size: 12dp;
    font-weight: 600;
    color: #f0ebe2;
    display: block;
}

.asset-gallery-subtitle {
    font-size: 12dp;
    color: #a9a093;
    display: block;
}

.asset-gallery-notice {
    display: block;
    font-size: 11dp;
    line-height: 14dp;
    margin-top: 6dp;
    color: #d9a39a;
}

.asset-gallery-scroll {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
    min-height: 140dp;
}

.asset-scroll-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.asset-scroll-shell-gallery {
    gap: 0;
}

.asset-scroll-shell-list {
    gap: 4dp;
    padding: 0 32dp 32dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid,
.asset-list-view {
    flex: none;
    min-width: 0;
    min-height: 0;
}

.asset-card-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    padding: 12dp 24dp 12dp 12dp;
    box-sizing: border-box;
}

.asset-card-grid-window {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10dp;
    align-content: flex-start;
    min-width: 0;
}

.asset-card-slot {
    min-width: 0;
    display: flex;
}

.asset-card {
    width: 100%;
    min-width: 0;
    background-color: #302d29;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    position: relative;
}

.asset-card.is-draggable,
.asset-list-row.is-draggable {
    drag: drag;
    cursor: grab;
}

.asset-card.is-draggable:active,
.asset-list-row.is-draggable:active {
    cursor: grabbing;
}

.asset-card:hover,
.asset-list-row:hover {
    border-color: #7fb9a5;
}

.asset-card.is-selected,
.asset-card.is-multi-selected,
.asset-list-row.is-selected,
.asset-list-row.is-multi-selected {
    border-color: #7fb9a5;
    background-color: #34302c;
}

.asset-card.is-missing,
.asset-list-row.is-missing {
    border-color: #8b4a42;
}

.asset-card-thumb {
    height: 92dp;
    position: relative;
    border-bottom-width: 1dp;
    border-bottom-color: #514a42;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.asset-thumb-project {
    background-color: #2f4545;
}

.asset-card-placeholder {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    padding: 4dp 6dp;
    font-size: 12dp;
    font-weight: 600;
    line-height: 16dp;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: #8f887c;
}

.asset-card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 8dp;
}

.asset-card-title-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4dp;
}

.asset-card-title,
.asset-info-name {
    font-size: 12dp;
    font-weight: 600;
    color: #f0ebe2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.asset-card-title {
    min-width: 0;
}


.asset-card-meta {
    display: flex;
    flex-direction: column;
    gap: 2dp;
    font-size: 12dp;
    color: #a9a093;
}

.asset-card-actions {
    display: flex;
    flex-direction: row;
    gap: 6dp;
    margin-top: 8dp;
    align-items: center;
}

.asset-card-button {
    flex: 1;
}

.asset-card-menu {
    position: absolute;
    top: 4dp;
    right: 4dp;
    background-color: rgba(48, 45, 41, 0.85);
    border-color: transparent;
}

.asset-card-menu img {
    width: 16dp;
    height: 16dp;
    image-color: rgba(216, 208, 195, 230);
}

.asset-card-menu:hover {
    background-color: rgba(72, 67, 61, 0.95);
}

.asset-card-menu:hover img {
    image-color: rgba(255, 255, 255, 255);
}


.asset-list-view {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    /* Reserve a real gutter for the native scrollbars so rows never paint into
     * the scrollbar lane when the panel is docked and space is tight. */
    padding: 12dp 0 0 0;
    box-sizing: border-box;
}

.asset-list-window {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    min-width: 0;
}

.asset-virtual-spacer {
    flex: 0 0 auto;
    width: 100%;
    min-width: 100%;
    pointer-events: none;
}

.asset-gallery-scroll scrollbarvertical,
.asset-gallery-scroll scrollbarhorizontal {
    z-index: 20;
}

.asset-gallery-scroll::-webkit-scrollbar {
    height: 8dp;
    width: 8dp;
}

.asset-gallery-scroll::-webkit-scrollbar-track {
    background: #2b2825;
}

.asset-gallery-scroll::-webkit-scrollbar-thumb {
    background: #514a42;
    border-radius: 4dp;
}

.asset-gallery-scroll::-webkit-scrollbar-thumb:hover {
    background: #6a5f55;
}

.asset-list-header,
.asset-list-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    min-width: 440dp;
    width: 100%;
    box-sizing: border-box;
}

.asset-list-header {
    padding: 8dp 10dp;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    background-color: #2e2b27;
    color: #a9a093;
    font-size: 12dp;
    font-weight: 600;
}

.asset-list-row {
    min-height: 44dp;
    height: 44dp;
    padding: 8dp 10dp;
    border-width: 1dp;
    border-color: #514a42;
    border-radius: 4dp;
    background-color: #302d29;
    color: #d8d0c3;
    cursor: pointer;
    font-size: 12dp;
    position: relative;
}

.asset-card {
    height: 220dp;
    overflow: hidden;
}

.asset-card-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
}

.asset-list-primary {
    font-weight: 600;
    color: #f0ebe2;
}

.asset-list-primary {
    display: block;
}

.asset-col {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.asset-col-name {
    width: 118dp;
    min-width: 88dp;
    flex-shrink: 1;
}

.asset-col-folder {
    width: 58dp;
    flex-shrink: 0;
}

.asset-col-size {
    width: 78dp;
    flex-shrink: 0;
}

.asset-col-modified {
    width: 150dp;
    min-width: 150dp;
    flex: 1 0 150dp;
}


#asset-info-panel {
    height: 220dp;
    min-height: 160dp;
    max-height: 400dp;
    background-color: #2b2825;
    border-top-width: 1dp;
    border-top-color: #3c3630;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

#bottom-panel-resize-handle {
    height: 10dp;
    min-height: 10dp;
    cursor: ns-resize;
    background-color: rgba(127, 185, 165, 0.12);
    border-top-width: 1dp;
    border-top-color: rgba(127, 185, 165, 0.28);
    border-bottom-width: 1dp;
    border-bottom-color: rgba(0, 0, 0, 0.35);
    z-index: 10;
    flex-shrink: 0;
}

#bottom-panel-resize-handle:hover {
    background-color: rgba(127, 185, 165, 0.34);
}

#bottom-panel-resize-handle.dragging {
    background-color: rgba(127, 185, 165, 0.48);
}

.asset-info-tabs {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-info-tab {
    flex: 1;
    text-align: center;
    padding: 8dp 4dp;
    font-size: 12dp;
    color: #a9a093;
    cursor: pointer;
    border-bottom-width: 2dp;
    border-bottom-color: transparent;
}

.asset-info-tab.is-active {
    color: #7fb9a5;
    border-bottom-color: #7fb9a5;
}

.asset-info-content {
    flex: 1;
    overflow-y: auto;
    padding: 12dp;
    min-height: 140dp;
}

.asset-info-header {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 6dp;
    margin-bottom: 12dp;
    padding-bottom: 10dp;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.asset-info-section {
    margin-bottom: 16dp;
}

.parameter-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 5dp 0;
    border-bottom-width: 1dp;
    border-bottom-color: #3c3630;
}

.parameter-label {
    width: 110dp;
    min-width: 110dp;
    color: #a9a093;
    font-size: 12dp;
}

.parameter-value {
    flex: 1;
    min-width: 0;
    text-align: left;
    color: #f0ebe2;
    font-size: 12dp;
    white-space: normal;
    word-break: break-word;
}

.asset-path-value {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


.asset-info-warning {
    padding: 8dp;
    border-width: 1dp;
    border-color: #8b4a42;
    border-radius: 4dp;
    background-color: #342421;
}

.asset-info-button {
    width: auto;
}


.asset-artifact-type {
    color: #a9a093;
}

.asset-info-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140dp;
}

.asset-info-empty-text {
    color: #a9a093;
    font-size: 12dp;
}
