div {
    display: block;
}

body {
    font-family: Inter;
    font-size: 12dp;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    padding: 0 6dp;
    margin: 0;
    background-color: transparent;
    white-space: nowrap;
    overflow: hidden;
}

#status-left {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

#status-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 12dp;
}

#mode-text,
#status-left > div,
#status-right > *,
.status-item,
.status-item > * {
    flex-shrink: 0;
}

.status-item {
    display: flex;
    flex-direction: row;
    align-items: center;
}

#training-section,
#splat-section,
#split-section,
#wasd-section,
#zoom-section {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.hidden {
    display: none;
}

#training-section.hidden,
#splat-section.hidden,
#split-section.hidden,
#wasd-section.hidden,
#zoom-section.hidden {
    display: none;
}

/* Within-training separators: 12dp each side. The shared components sheet styles .separator as a
   1dp divider line; here it is a glyph, so the divider geometry has to be undone. */
.separator {
    margin: 0 12dp;
    height: auto;
    background-color: transparent;
}

/* Section-level separator in training: 20dp left, 12dp right */
#training-section > .section-sep {
    margin-left: 20dp;
}

/* Section-level separators for non-training sections: 20dp left, 6dp right */
#splat-section > .separator:first-child,
#split-section > .separator:first-child {
    margin-left: 20dp;
    margin-right: 6dp;
}

.separator.wasd-sep,
.separator.zoom-sep {
    margin-left: 20dp;
    margin-right: 6dp;
}

/* Thin separator in right section */
.separator.thin {
    margin: 0 2dp;
}

#progress-container {
    position: relative;
    width: 360dp;
    height: 16dp;
    overflow: hidden;
    border-radius: 2dp;
    flex-shrink: 0;
    cursor: pointer;
}

#progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
}

#progress-markers {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.progress-marker {
    position: absolute;
    top: 1dp;
    bottom: 1dp;
    width: 6dp;
    margin-left: -3dp;
    border-radius: 2dp;
    cursor: pointer;
}

.progress-marker.is-hovered,
.progress-marker.is-preview {
    top: 0;
    bottom: 0;
    width: 8dp;
    margin-left: -4dp;
}

#progress-text {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    text-align: center;
    line-height: 16dp;
}

#account-chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 16dp;
    margin-right: 12dp;
    padding: 0 6dp;
    border-width: 1dp;
    border-radius: 8dp;
    cursor: pointer;
}

#account-tier {
    margin-left: 4dp;
    font-size: 10dp;
}

#gpu-icon {
    width: 14dp;
    height: 14dp;
    margin-right: 4dp;
    cursor: pointer;
    image-color: rgba(255, 255, 255, 150);
}

#gpu-icon:hover {
    image-color: rgba(255, 255, 255, 215);
}

#gpu-icon.active {
    image-color: rgba(255, 255, 255, 255);
}

#gpu-model {
    display: block;
    min-width: 0;
    max-width: 220dp;
    margin-right: 6dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#lfs-mem {
    margin-right: 0;
}

#gpu-mem {
    margin-right: 0;
}

#fps-value {
    margin-left: 16dp;
}

#fps-label {
    margin-left: 0;
}

#git-commit {
    margin-left: 16dp;
    cursor: pointer;
}

#git-commit:hover {
    text-decoration: underline;
}

#step-label {
    margin-left: 12dp;
    margin-right: 6dp;
}

#loss-label,
#gaussians-label {
    margin-right: 6dp;
}

#eta-label {
    margin-left: 6dp;
    margin-right: 6dp;
}

#split-detail {
    margin-left: 4dp;
}

/* Responsive fit levels. RmlStatusBar measures the laid-out bar and sets fit-1 .. fit-9 on the body
   cumulatively, so level N carries every rule up to N. Each level must only ever remove width. */
body.fit-1 #git-commit {
    display: none;
}

body.fit-1 .separator {
    margin: 0 6dp;
}

body.fit-1 .separator.thin {
    margin: 0 2dp;
}

body.fit-1 #training-section > .section-sep,
body.fit-1 #splat-section > .separator:first-child,
body.fit-1 #split-section > .separator:first-child,
body.fit-1 #wasd-section > .separator:first-child,
body.fit-1 #zoom-section > .separator:first-child,
body.fit-1 #status-message-section > .separator:first-child {
    margin-left: 10dp;
}

body.fit-2 #gpu-model,
body.fit-2 #account-tier {
    display: none;
}

body.fit-3 #progress-container {
    width: 220dp;
}

body.fit-3 #time-metric {
    display: none;
}

body.fit-4 #eval-metric,
body.fit-4 #fps-label,
body.fit-4 #wasd-section,
body.fit-4 #zoom-section {
    display: none;
}

body.fit-5 #progress-container {
    width: 140dp;
}

body.fit-5 .metric-label {
    display: none;
}

body.fit-6 #progress-group,
body.fit-6 #lfs-mem-group {
    display: none;
}

body.fit-7 #loss-metric,
body.fit-7 #split-detail {
    display: none;
}

body.fit-8 #gaussians-metric,
body.fit-8 #splat-section,
body.fit-8 #split-section {
    display: none;
}

body.fit-9 #mode-text,
body.fit-9 #status-message {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

body.fit-9 #status-message-section {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

body.fit-9 #status-right {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

body.fit-9 #gpu-mem {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}
