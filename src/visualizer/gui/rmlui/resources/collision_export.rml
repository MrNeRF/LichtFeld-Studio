<rml>
<head><link type="text/template" href="floating_window.rml"/></head>
<body template="floating-window">
  <div id="export-scroll">
    <p class="export-target"><span>@tr:collision.target</span> <span id="export-target"/></p>
    <div class="export-option"><button id="export-voxels" class="btn btn--primary"><span>@tr:collision.export_voxels</span></button><p>@tr:collision.export_voxels_help</p></div>
    <div class="export-option"><button id="export-glb" class="btn btn--secondary"><span>@tr:collision.export_glb</span></button><p>@tr:collision.export_glb_help</p></div>
    <p class="export-note">@tr:collision.export_coordinates</p>
    <div id="export-job" style="display: none;">
      <p id="export-stage"/>
      <div id="export-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="export-progress-fill"/></div>
      <div class="export-job-footer"><p id="export-time"/><button id="export-cancel" class="btn btn--secondary"><span>@tr:collision.cancel_generation</span></button></div>
    </div>
    <p id="export-status"/>
    <p id="export-error" style="display: none;"/>
  </div>
</body>
</rml>
