<rml>
<head>
    <link type="text/rcss" href="area_editor_header.rcss"/>
</head>
<body id="area-header">
    <div class="area-header">
        <select id="editor-select" class="editor-select" title="Area editor">
        </select>
        <span class="area-spacer"></span>
        <button id="projection" class="area-action" type="button" data-action="projection"
                title="Toggle projection" aria-label="Toggle projection">
            <img id="projection-icon" src="../icon/perspective.png" />
        </button>
        <button id="maximize" class="area-action" type="button" data-action="maximize"
                title="Maximize area" aria-label="Maximize area">
            <img id="maximize-icon" src="../icon/arrows-maximize.png" />
        </button>
        <button id="close" class="area-action area-close" type="button" data-action="close"
                title="Close area" aria-label="Close area">
            <img src="../icon/scene/x.png" />
        </button>
    </div>
</body>
</rml>
