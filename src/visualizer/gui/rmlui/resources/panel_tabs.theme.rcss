/* Shared border roles and shape scale. */

.tab-nav {
    border-radius: 4dp;
}

.tab {
    border-top-left-radius: 4dp;
    border-top-right-radius: 4dp;
}

.tab-close {
    border-radius: 4dp;
}

.tab {
    background-color: @{alpha(surface_bright,0.36)};
    color: @{text_dim};
    border-color: @{border};
}

.tab:hover {
    @{right_panel.tab_hover_decor};
}

.tab:focus-visible {
    @{right_panel.tab_hover_decor};
    color: @{text};
    border-color: @{primary};
}

.tab.active {
    decorator: none;
    background-color: transparent;
    color: @{text};
    border-color: @{primary};
}

.tab-close {
    color: @{text_dim};
}

.tab-close:hover,
.tab-close:focus-visible {
    background-color: @{right_panel.tab_hover};
    color: @{text};
}

.tab-nav {
    background-color: @{right_panel.tab_nav_bg};
    color: @{text_dim};
}

.tab-nav:hover {
    background-color: @{right_panel.tab_nav_hover};
    color: @{text};
}

.tab-nav.disabled,
.tab-nav.disabled:hover {
    background-color: transparent;
    color: @{right_panel.tab_nav_disabled};
    opacity: 0.55;
}

#tab-separator {
    background-color: @{right_panel.separator};
}
