/* Shared border roles and shape scale. */

.thumb-item {
    border-color: transparent;
    border-radius: @{radius.control}dp;
}

.nav-arrow {
    border-radius: @{radius.surface}dp;
}

.btn-copy {
    border-radius: @{radius.control}dp;
}

.view-btn {
    border-radius: @{radius.control}dp;
}

.hk-key {
    border-radius: @{radius.control}dp;
}

/* Image preview panel theme overrides. */

#filmstrip {
    border-right-color: @{border};
}

#preview-toolbar, #sampled-color-controls, #shortcut-help {
    border-bottom-color: @{border};
    background-color: @{surface};
}

#preview-message {
    color: @{error};
}

.thumb-item.selected {
    border-color: @{primary};
}

.thumb-index {
    color: @{text};
    background-color: @{alpha(background,0.85)};
    padding: 1dp 3dp;
}

.thumb-item:focus-visible, .nav-arrow:focus-visible, .btn-copy:focus-visible {
    border-color: @{primary};
}

#sam-overlay, .thumb-mask {
    image-color: @{alpha(primary,0.45)};
}

#mask-overlay {
    image-color: @{alpha(primary,0.45)};
}

#no-image-text,
.sidebar-header-label-ip,
.section-label-ip,
.meta-key,
.meta-val-secondary,
.hk-label,
.status-item,
.status-position {
    color: @{text_dim};
}

#sidebar {
    border-left-color: @{border};
}

.sidebar-header-ip,
.sidebar-section-ip,
#sam-controls {
    border-bottom-color: @{border};
}

#sidebar-filename,
.meta-val,
#sidebar-mask-name {
    color: @{text};
}

.meta-val-accent {
    color: @{primary};
}

.btn-copy-icon {
    image-color: @{text_dim};
}

.btn-copy:hover .btn-copy-icon {
    image-color: @{text};
}

#status-bar {
    border-top-color: @{border};
}

.nav-arrow,
.view-btn {
    color: @{alpha(text,0.86)};
    background-color: @{alpha(white,0.05)};
    border-color: @{border};
}

.nav-arrow:hover,
.view-btn:hover {
    color: @{text};
    background-color: @{alpha(white,0.10)};
    border-color: @{primary};
}

.view-btn:active {
    background-color: @{alpha(white,0.15)};
    border-color: @{primary};
}

.view-btn:focus-visible {
    border-color: @{primary};
    box-shadow: 0 0 0 1dp @{alpha(primary,0.39)};
}

.hk-key {
    color: @{text};
    background-color: @{surface_bright};
}

#sam-controls button[aria-pressed="true"] { background-color: @{alpha(primary,0.3)}; }
.sam-note { color: @{text_dim}; }
.sam-point { border-color: @{white}; color: @{white}; }
.sam-point-1 { background-color: @{success}; }
.sam-point-0 { background-color: @{error}; }
.sam-box { border-color: @{primary}; }
.sam-point-selected, .sam-box-selected { border-color: @{warning}; }
.sam-box-handle { background-color: @{primary}; border-color: @{white}; }

#sam-controls {
    border-bottom-color: @{border};
}

.sam-point {
    border-radius: @{radius.round}dp;
}
