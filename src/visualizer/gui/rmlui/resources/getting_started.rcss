.guide-tabs {
    display: flex;
    gap: 6dp;
    margin: 4dp 0 10dp;
}

.guide-tab {
    flex: 1;
    text-align: center;
}

.video-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12dp;
    margin-bottom: 8dp;
}

.video-card {
    flex: 0 0 31%;
    min-width: 0;
    padding: 0;
    text-align: left;
    cursor: pointer;
}

.card-body {
    position: relative;
    height: 0;
    padding-top: 56.25%;
    border-width: 1dp;
    border-radius: 6dp;
    transition: background-color border-color 0.12s quadratic-out;
}

.play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 22dp;
}

.card-title {
    display: block;
    font-size: 12dp;
    line-height: 18dp;
    min-height: 36dp;
    margin-top: 8dp;
}

.guide-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8dp;
    border-top-width: 1dp;
    padding-top: 12dp;
    margin-top: 12dp;
}

.wiki-link {
    cursor: pointer;
}

.wiki-link:hover,
.wiki-link:focus-visible {
    text-decoration: underline;
}
