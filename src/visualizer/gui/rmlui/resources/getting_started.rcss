body {
    font-family: Inter;
    font-size: 13dp;
    color: #cdd6f4;
}

#window-frame {
    background-color: #1e1e2e;
    border: 1dp #45475a;
}

#title-bar {
    height: 28dp;
    display: flex;
    align-items: center;
    padding: 0 8dp;
    background-color: #313244;
}

#title-text {
    flex: 1;
    font-size: 13dp;
    color: #cdd6f4;
}

#close-btn {
    font-size: 16dp;
    color: #a6adc8;
    cursor: pointer;
    padding: 0 4dp;
}

#close-btn:hover {
    color: #f38ba8;
}

#content-wrap {
    display: flex;
    flex-direction: column;
    padding: 8dp 12dp;
}

.panel-title {
    font-size: 16dp;
    font-weight: bold;
    color: #89b4fa;
    margin-bottom: 6dp;
}

.description {
    color: #cdd6f4;
    margin-bottom: 10dp;
}

.section-label {
    font-size: 12dp;
    color: #a6adc8;
    margin-bottom: 4dp;
    margin-top: 6dp;
}

.video-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12dp;
    margin-bottom: 8dp;
}

.video-card {
    width: 160dp;
    cursor: pointer;
}

.video-card:hover .card-body {
    border-color: #89b4fa;
    background-color: #313244;
}

.card-body {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 90dp;
    background-color: #1e1e2e;
    border-width: 1dp;
    border-color: #45475a;
    transition: background-color border-color 0.12s quadratic-out;
}

.play-icon {
    font-size: 28dp;
    color: #89b4fa;
}

.card-title {
    display: block;
    font-size: 11dp;
    color: #a6adc8;
    margin-top: 4dp;
    text-align: center;
}

.wiki-link {
    cursor: pointer;
}

.wiki-link:hover {
    text-decoration: underline;
}
