/* Theme colours of the area frames and headers. */

.area {
    @{panel.body_decor};
}

.area.view {
    decorator: none;
    background-color: transparent;
}

.area-header {
    background-color: @{blend(surface,background,0.35)};
    border-bottom-color: @{alpha(border,0.4)};
}

.area.view .area-header {
    background-color: @{blend(surface,background,0.2)};
}

.area.hovered .area-header {
    background-color: @{blend(surface,background,0.2)};
}

.area.view.active .area-header {
    border-bottom-color: @{alpha(primary,0.55)};
}

.editor-switch {
    background-color: @{alpha(text,0.06)};
}

.editor-switch:hover,
.hitem:hover {
    background-color: @{alpha(text,0.1)};
}

.hitem.label:hover {
    background-color: transparent;
}

.editor-icon,
.hitem-icon {
    image-color: @{text_dim};
}

.editor-switch:hover .editor-icon,
.hitem:hover .hitem-icon {
    image-color: @{text};
}

.editor-caret,
.hitem-caret {
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: @{text_dim};
}

.hitem-label {
    color: @{text_dim};
}

.hitem:hover .hitem-label,
.hitem.menu .hitem-label {
    color: @{text};
}

.hitem.active {
    background-color: @{alpha(primary,0.22)};
}

.hitem.active .hitem-icon {
    image-color: @{primary};
}

.hitem.active:hover {
    background-color: @{alpha(primary,0.32)};
}

.view-label {
    color: #b8b8b8;
    font-effect: shadow(1dp 1dp #000000d0);
    background-color: #00000040;
    border-radius: @{num(size.frame_rounding)}dp;
}

.tab {
    background-color: @{alpha(surface_bright,0.36)};
    border-color: @{alpha(border,0.42)};
    color: @{text_dim};
}

.tab:hover {
    background-color: @{alpha(surface_bright,0.5)};
    color: @{text};
}

.tab.active {
    background-color: transparent;
    border-color: @{alpha(primary,0.55)};
    color: @{text};
}

.tab-edge {
    background-color: @{alpha(primary,0.55)};
}

.tab-nav {
    background-color: @{alpha(surface_bright,0.2)};
    color: @{text_dim};
}

.tab-nav:hover {
    background-color: @{alpha(surface_bright,0.55)};
    color: @{text};
}

.tab-nav[disabled] {
    background-color: transparent;
    color: @{alpha(text_dim,0.35)};
}

.tab-close {
    background-color: transparent;
    color: @{text_dim};
}

.tab-close:hover {
    background-color: @{alpha(text,0.12)};
    color: @{text};
}
