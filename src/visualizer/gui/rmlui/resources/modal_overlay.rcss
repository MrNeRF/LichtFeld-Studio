body {
    font-family: Inter;
    display: block;
    margin: 0;
    padding: 0;
    overflow: hidden;
    width: 100%;
    height: 100%;
}

.modal-backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 100);
}

.modal-dialog {
    display: none;
    position: absolute;
    padding: 16dp 20dp;
    border-width: 2dp;
    border-radius: 6dp;
}

#modal-form {
    display: block;
}

.modal-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    text-align: center;
    margin-bottom: 4dp;
}

.modal-sep {
    display: block;
    height: 1dp;
    margin: 8dp 0;
}

.modal-content {
    display: block;
    font-size: 12dp;
    text-align: center;
    max-height: 400dp;
    word-break: break-word;
    overflow-x: hidden;
    overflow-y: auto;
}

.modal-input-row {
    display: none;
    margin: 8dp 0 0 0;
}

.modal-input-row.visible {
    display: block;
}

.modal-input-row input[type="text"] {
    width: 100%;
}

.modal-button-row {
    display: flex;
    gap: 8dp;
    justify-content: center;
}

.modal-button-row .btn {
    min-width: 90dp;
}

/* Style accent classes for border color */
.modal-dialog.style-info {
}

.modal-dialog.style-warning {
}

.modal-dialog.style-error {
}

/* Content helper classes */
.dim-text {
    font-size: 12dp;
}

.error-text {
}

.warning-text {
}

.content-row {
    display: block;
    margin: 2dp 0;
}
.details-block {
    display: block;
    font-size: 11dp;
    text-align: left;
    margin-top: 8dp;
    padding: 8dp;
    max-height: 260dp;
    overflow-y: auto;
}

/* Shared forms use one 28dp row and text baseline for every control. */
.modal-dialog.form-modal {
    box-sizing: border-box;
    max-width: 96%;
    padding: 16dp;
}
.form-modal .modal-title { text-align: left; line-height: 28dp; margin: 0; }
.form-modal .modal-content { text-align: left; }
.form-modal .modal-button-row { justify-content: flex-end; align-items: center; flex-wrap: nowrap; }
.form-modal .modal-button-row .btn {
    box-sizing: border-box;
    display: block;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    min-width: 64dp;
    padding: 0 8dp;
    margin: 0;
    line-height: 26dp;
    flex-shrink: 0;
    white-space: nowrap;
}
.project-form { display: block; }
.modal-field {
    display: flex;
    align-items: center;
    gap: 8dp;
    box-sizing: border-box;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    margin: 0 0 8dp;
}
.modal-field--multiline { height: auto; min-height: 96dp; max-height: none; align-items: flex-start; }
.form-modal .modal-field--multiline textarea {
    flex: 1;
    min-width: 0;
    height: 88dp;
    min-height: 88dp;
    max-height: none;
    overflow-y: auto;
}
.modal-field-label {
    display: block;
    width: 200dp;
    flex-shrink: 0;
    height: 28dp;
    line-height: 28dp;
    white-space: nowrap;
}
.modal-field-value {
    display: block;
    flex: 1;
    min-width: 0;
    height: 28dp;
    line-height: 28dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.form-modal input[type="text"], .form-modal select, .form-modal textarea {
    display: block;
    flex: 1;
    min-width: 0;
    margin: 0;
}
.form-modal select { overflow: visible; }
.form-modal select selectvalue {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.form-modal select selectbox {
    box-sizing: border-box;
    max-height: 280dp;
    margin: 0;
    padding: 0;
    overflow-y: auto;
}
.form-modal select option {
    transition: none;
    box-sizing: border-box;
    display: block;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    line-height: 28dp;
    padding: 0 8dp;
    white-space: nowrap;
}
.modal-option-name { display: block; font-size: 12dp; line-height: 14dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.modal-option-meaning { display: block; font-size: 10dp; line-height: 12dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.form-modal selectvalue .modal-option-name { line-height: 26dp; }
.form-modal selectvalue .modal-option-meaning { display: none; }
.modal-note { display: block; margin: 8dp 0; line-height: 20dp; }
.modal-check {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    gap: 8dp;
    padding: 0;
    margin: 8dp 0;
}
.modal-check input {
    box-sizing: border-box;
    width: 16dp;
    height: 16dp;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}
.modal-check span { display: block; line-height: 28dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Export controls reserve a gutter even when RmlUi overlays its scrollbar. */
.sequencer-export-form {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding-right: 12dp;
}
.export-field-controls { display: flex; align-items: center; gap: 8dp; flex: 1; min-width: 0; }
/* Keep the editable input's layer local so neighbouring native popups cover it. */
.export-fps-combo { display: flex; align-items: center; position: relative; z-index: 0; flex: 1; min-width: 0; height: 28dp; }
.form-modal .export-fps-combo select { position: absolute; left: 0; top: 50%; margin-top: -9dp; width: 100%; height: 18dp; }
.form-modal .export-fps-combo selectvalue { visibility: hidden; }
.form-modal .export-fps-combo input { position: relative; z-index: 1; flex: 1; min-width: 0; height: 18dp; margin-right: 18dp; border-right-width: 0; }
.export-quality-scale { display: block; flex: 1; min-width: 24dp; }
.export-quality-slider { display: block; width: 100%; height: 28dp; margin: 0; padding: 0; box-sizing: border-box; }
.export-quality-slider[type="range"] slidertrack { margin-top: 12dp; }
.export-quality-slider[type="range"] sliderbar { margin-top: 9dp; }
.export-quality-value { display: flex; align-items: center; gap: 8dp; height: 28dp; flex-shrink: 0; }
.form-modal .export-quality-value .export-quality-number { flex: 0 0 44dp; width: 44dp; }
.export-crf-label { flex-shrink: 0; font-size: 11dp; }
.sequencer-export-form .modal-field { margin-bottom: 6dp; }
.sequencer-export-form .modal-note { margin: 5dp 0; line-height: 18dp; }
@media (max-height: 650dp) {
    .sequencer-export-form { max-height: 50vh; overflow-x: hidden; overflow-y: auto; }
}
@media (max-width: 650dp) {
    .sequencer-export-form .modal-field-label { width: 150dp; white-space: normal; height: auto; line-height: 14dp; }
}
