body {
    font-family: Inter;
    display: block;
    margin: 0;
    padding: 0;
    overflow: hidden;
    width: 100%;
    height: 100%;
}

.modal-backdrop {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 100);
}

.modal-dialog {
    display: none;
    position: absolute;
    padding: 16dp 20dp;
    border-width: 2dp;
    border-radius: 6dp;
}

#modal-form {
    display: block;
}

.modal-title {
    display: block;
    font-size: 12dp;
    font-weight: bold;
    text-align: center;
    margin-bottom: 4dp;
}

.modal-sep {
    display: block;
    height: 1dp;
    margin: 8dp 0;
}

.modal-content {
    display: block;
    font-size: 12dp;
    text-align: center;
    max-height: 400dp;
    word-break: break-word;
    overflow-x: hidden;
    overflow-y: auto;
}

.modal-input-row {
    display: none;
    margin: 8dp 0 0 0;
}

.modal-input-row.visible {
    display: block;
}

.modal-input-row input[type="text"] {
    width: 100%;
}

.modal-button-row {
    display: flex;
    gap: 8dp;
    justify-content: center;
}

.modal-button-row .btn {
    min-width: 90dp;
}

/* Style accent classes for border color */
.modal-dialog.style-info {
}

.modal-dialog.style-warning {
}

.modal-dialog.style-error {
}

/* Content helper classes */
.dim-text {
    font-size: 12dp;
}

.error-text {
}

.warning-text {
}

.content-row {
    display: block;
    margin: 2dp 0;
}
.details-block {
    display: block;
    font-family: "JetBrains Mono";
    font-size: 11dp;
    text-align: left;
    margin-top: 8dp;
    padding: 8dp;
    max-height: 260dp;
    overflow-y: auto;
}

/* Shared forms use one 28dp row and text baseline for every control. */
.modal-dialog.form-modal {
    box-sizing: border-box;
    max-width: 96%;
    padding: 16dp;
}
.form-modal .modal-title { text-align: left; line-height: 28dp; margin: 0; }
.form-modal .modal-content { text-align: left; }
.form-modal .modal-button-row { justify-content: flex-end; align-items: center; flex-wrap: nowrap; }
.form-modal .modal-button-row .btn {
    box-sizing: border-box;
    display: block;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    min-width: 64dp;
    padding: 0 8dp;
    margin: 0;
    line-height: 26dp;
    flex-shrink: 0;
    white-space: nowrap;
}
.project-form { display: block; }
.modal-field {
    display: flex;
    align-items: center;
    gap: 8dp;
    box-sizing: border-box;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    margin: 0 0 8dp;
}
.modal-field-label {
    display: block;
    width: 200dp;
    flex-shrink: 0;
    height: 28dp;
    line-height: 28dp;
    white-space: nowrap;
}
.modal-field-value {
    display: block;
    flex: 1;
    min-width: 0;
    height: 28dp;
    line-height: 28dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.form-modal input[type="text"], .form-modal select, .form-modal textarea {
    box-sizing: border-box;
    display: block;
    flex: 1;
    min-width: 0;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    line-height: 26dp;
    border-width: 1dp;
    padding: 0 8dp;
    margin: 0;
}
.form-modal select { overflow: visible; }
.form-modal select selectvalue {
    box-sizing: border-box;
    position: relative;
    top: 0;
    height: 26dp;
    line-height: 26dp;
    margin: 0 24dp 0 0;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.form-modal select selectarrow {
    box-sizing: border-box;
    position: relative;
    /* Account for the transparent padding in the shared arrow bitmap. */
    top: 4dp;
    right: -2dp;
    width: 16dp;
    height: 16dp;
    margin: 0;
    padding: 0;
}
.form-modal select selectbox {
    box-sizing: border-box;
    min-width: 100%;
    width: 100%;
    max-width: 100%;
    max-height: 280dp;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    overflow-y: auto;
}
.form-modal select option {
    box-sizing: border-box;
    display: block;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    line-height: 28dp;
    padding: 0 8dp;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.modal-option-name { display: block; font-size: 12dp; line-height: 14dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.modal-option-meaning { display: block; font-size: 10dp; line-height: 12dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.form-modal selectvalue .modal-option-name { line-height: 26dp; }
.form-modal selectvalue .modal-option-meaning { display: none; }
.modal-note { display: block; margin: 8dp 0; line-height: 20dp; }
.modal-check {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    height: 28dp;
    min-height: 28dp;
    max-height: 28dp;
    gap: 8dp;
    padding: 0;
    margin: 8dp 0;
}
.modal-check input {
    box-sizing: border-box;
    width: 16dp;
    height: 16dp;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}
.modal-check span { display: block; line-height: 28dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
