#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D u_current;
layout(set = 0, binding = 1) uniform sampler2D u_history;
layout(set = 0, binding = 2) uniform sampler2D u_motion;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D u_output;

layout(push_constant) uniform ResolveParams {
    ivec4 extents;       // xy = render, zw = output
    vec4 control;        // x = history valid, y = weight, z = motion rejection pixels
    vec4 current_uv;     // xy = scale, zw = clamp max
} params;

bool finite2(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 output_extent = params.extents.zw;
    if (any(greaterThanEqual(pixel, output_extent))) {
        return;
    }

    vec2 output_uv = (vec2(pixel) + vec2(0.5)) / vec2(output_extent);
    vec2 current_uv = min(output_uv * params.current_uv.xy, params.current_uv.zw);
    vec4 current = texture(u_current, current_uv);
    if (params.control.x < 0.5) {
        imageStore(u_output, pixel, current);
        return;
    }

    vec2 motion = texture(u_motion, current_uv).xy;
    if (!finite2(motion) || length(motion) > params.control.z) {
        imageStore(u_output, pixel, current);
        return;
    }
    vec2 previous_uv = output_uv + motion / vec2(params.extents.xy);
    vec2 history_half_texel = 0.5 / vec2(output_extent);
    if (!finite2(previous_uv) || any(lessThan(previous_uv, history_half_texel)) ||
        any(greaterThan(previous_uv, vec2(1.0) - history_half_texel))) {
        imageStore(u_output, pixel, current);
        return;
    }

    vec3 neighborhood_min = current.rgb;
    vec3 neighborhood_max = current.rgb;
    vec2 texel = 1.0 / vec2(params.extents.xy);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 sample_uv = min(current_uv + vec2(x, y) * texel, params.current_uv.zw);
            vec3 value = texture(u_current, max(sample_uv, vec2(0.0))).rgb;
            neighborhood_min = min(neighborhood_min, value);
            neighborhood_max = max(neighborhood_max, value);
        }
    }
    vec3 history = clamp(texture(u_history, previous_uv).rgb,
                         neighborhood_min,
                         neighborhood_max);
    float confidence = params.control.z > 0.0
                           ? clamp(1.0 - length(motion) / params.control.z, 0.0, 1.0)
                           : 0.0;
    vec3 resolved = mix(current.rgb,
                        history,
                        clamp(params.control.y, 0.0, 1.0) * confidence);
    imageStore(u_output, pixel, vec4(resolved, current.a));
}
