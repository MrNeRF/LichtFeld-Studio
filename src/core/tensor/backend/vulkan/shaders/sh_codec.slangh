static const uint LFS_LOCAL_SIZE_X = 256;
static const uint LFS_PUSH_CONSTANT_SIZE = 64;
[SpecializationConstant] const uint sourceFormat = 1;
[SpecializationConstant] const uint destinationFormat = 1;
[SpecializationConstant] const uint indexType = 0;
[SpecializationConstant] const uint scatter = 0;
[SpecializationConstant] const uint sourceRest = 15;
[SpecializationConstant] const uint destinationRest = 15;
struct Parameters {
    uint64_t source, destination, indices, sourceBounds, destinationBounds;
    uint sourceRows, destinationRows, count;
    uint sourceOffset, destinationOffset, padding;
};
#include "sh_decode.slangh"
uint indexAt(Parameters p, uint i) {
    return indexType == 2 ? uint(((Ptr<int64_t, Access.Read>)p.indices)[i])
                         : uint(((Ptr<int, Access.Read>)p.indices)[i]);
}
float readCell(Parameters p, uint row, uint c) {
    return shReadCell(p.source, p.sourceBounds, sourceFormat, sourceRest, p.sourceRows, row, c);
}
