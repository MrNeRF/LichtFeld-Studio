// Each compensation step rounds independently; contraction erases the residual.
#include "../../../../include/core/rounded_math.slangh"

struct Df { float hi; float lo; };

Df df_two_sum(float a, float b) {
    const float s = roundedAdd(a, b);
    const float v = roundedSub(s, a);
    Df r; r.hi = s;
    r.lo = roundedAdd(roundedSub(a, roundedSub(s, v)), roundedSub(b, v));
    return r;
}
Df df_renorm(float hi, float lo) {
    const float s = roundedAdd(hi, lo);
    Df r; r.hi = s; r.lo = roundedSub(lo, roundedSub(s, hi)); return r;
}
Df df_add(Df a, Df b) {
    const Df s = df_two_sum(a.hi, b.hi);
    return df_renorm(s.hi, roundedAdd(roundedAdd(a.lo, b.lo), s.lo));
}
Df df_sub(Df a, Df b) { Df n; n.hi = -b.hi; n.lo = -b.lo; return df_add(a, n); }
Df df_from(float x) { Df r; r.hi = x; r.lo = 0; return r; }
Df df_mul(Df a, Df b) {
    const float p = roundedMul(a.hi, b.hi);
    float e = fma(a.hi, b.hi, -p);
    e = fma(a.hi, b.lo, e);
    e = fma(a.lo, b.hi, e);
    e = fma(a.lo, b.lo, e);
    return df_renorm(p, e);
}
Df df_div(Df a, Df b) {
    const float q0 = roundedDiv(a.hi, b.hi);
    Df r = df_sub(a, df_mul(df_from(q0), b));
    const float q1 = roundedAdd(q0, roundedDiv(r.hi, b.hi));
    r = df_sub(a, df_mul(df_from(q1), b));
    return df_renorm(q1, roundedDiv(r.hi, b.hi));
}
Df df_sqrt(Df a) {
    const float v = a.hi + a.lo;
    if (!(v > 0)) return df_from(0);
    Df y = df_from(sqrt(v));
    // Two Newton steps from a float sqrt recover the float-float square root.
    y = df_mul(df_from(0.5), df_add(y, df_div(a, y)));
    return df_mul(df_from(0.5), df_add(y, df_div(a, y)));
}
bool df_gt(Df a, Df b) {
    const bool ainf = isinf(a.hi);
    const bool binf = isinf(b.hi);
    if (ainf || binf) {
        if (ainf && a.hi > 0 && !(binf && b.hi > 0)) return true;
        return false;
    }
    const Df d = df_sub(a, b);
    if (isnan(d.hi)) return false;
    return d.hi > 0 || (d.hi == 0 && d.lo > 0);
}
float df_ldexp(float x, int n) {
    const uint u = asuint(x);
    int e = int((u >> 23) & 0xffu);
    if (e == 0 || e == 255 || x == 0) return x;
    e += n;
    if (e >= 255) return asfloat((u & 0x80000000u) | 0x7f800000u);
    if (e <= 0) return asfloat(u & 0x80000000u);
    return asfloat((u & 0x807fffffu) | (uint(e) << 23));
}
Df df_scale2(Df a, int n) { Df r; r.hi = df_ldexp(a.hi, n); r.lo = df_ldexp(a.lo, n); return r; }

static const Df DF_LN2 = {0.6931471824645996, -1.904654323148236e-9};

Df df_exp(Df x) { return df_from(exp(x.hi + x.lo)); }
// Logistic without overflow: exp(-|x|) never exceeds one.
Df df_sigmoid(float x) {
    const Df e = df_exp(df_from(-abs(x)));
    const Df sum = df_add(df_from(1), e);
    return x >= 0 ? df_div(df_from(1), sum) : df_div(e, sum);
}
Df df_exp_precise(Df x) {
    if (!isfinite(x.hi) || x.hi < -80 || x.hi > 80)
        return df_exp(x);
    const int n = int(round(x.hi * 1.4426950408889634));
    const Df r = df_sub(x, df_mul(df_from(float(n)), DF_LN2));
    // Range reduction bounds |r| by ln(2)/2; the degree-12 remainder is below 3e-16.
    Df value = {2.0876755879584152e-09, 1.1082839809204342e-16};
    const Df c11 = {2.5052107943679403e-08, 4.4176230446483665e-16};
    value = df_add(df_mul(value, r), c11);
    const Df c10 = {2.755731998149713e-07, -7.5751122090511949e-15};
    value = df_add(df_mul(value, r), c10);
    const Df c9 = {2.7557318844628753e-06, 3.7935712242972291e-14};
    value = df_add(df_mul(value, r), c9);
    const Df c8 = {2.4801587642286904e-05, -3.4069960936668198e-13};
    value = df_add(df_mul(value, r), c8);
    const Df c7 = {0.00019841270113829523, -2.7255968749334558e-12};
    value = df_add(df_mul(value, r), c7);
    const Df c6 = {0.0013888889225199819, -3.3631094437103215e-11};
    value = df_add(df_mul(value, r), c6);
    const Df c5 = {0.0083333337679505348, -4.3461720333759502e-10};
    value = df_add(df_mul(value, r), c5);
    const Df c4 = {0.041666667908430099, -1.2417634698280722e-09};
    value = df_add(df_mul(value, r), c4);
    const Df c3 = {0.1666666716337204, -4.9670538793122887e-09};
    value = df_add(df_mul(value, r), c3);
    const Df c2 = {0.5, 0};
    value = df_add(df_mul(value, r), c2);
    const Df c1 = {1, 0};
    value = df_add(df_mul(value, r), c1);
    const Df c0 = {1, 0};
    value = df_add(df_mul(value, r), c0);
    return df_scale2(value, n);
}
Df df_log(Df a) {
    const float v = a.hi + a.lo;
    return df_from(v > 0 ? log(v) : -80);
}
Df df_pow(Df a, Df b) { return df_from(pow(max(a.hi + a.lo, 0), b.hi + b.lo)); }
Df df_const(float hi, float lo) { Df r; r.hi = hi; r.lo = lo; return r; }
float df_round_up(Df a) {
    if (!(a.lo > 0) || !(a.hi < 3.402823e38)) return a.hi;
    uint bits = asuint(a.hi);
    if ((bits & 0x7fffffffu) == 0) return asfloat(1u << 23);
    bits = (a.hi >= 0) ? bits + 1 : bits - 1;
    return asfloat(bits);
}
