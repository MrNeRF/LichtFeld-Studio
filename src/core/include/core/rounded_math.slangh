// Keep intermediate arithmetic rounded independently at geometric boundaries.
__target_intrinsic(cuda, "lfs_rounded_add")
float roundedAdd(float a, float b) {
    return spirv_asm {
        % value : $$float = OpFAdd $a $b;
        OpDecorate % value NoContraction;
result:
        $$float = OpCopyObject % value;
    };
}

__target_intrinsic(cuda, "lfs_rounded_sub")
float roundedSub(float a, float b) {
    return spirv_asm {
        % value : $$float = OpFSub $a $b;
        OpDecorate % value NoContraction;
result:
        $$float = OpCopyObject % value;
    };
}

__target_intrinsic(cuda, "lfs_rounded_mul")
float roundedMul(float a, float b) {
    return spirv_asm {
        % value : $$float = OpFMul $a $b;
        OpDecorate % value NoContraction;
result:
        $$float = OpCopyObject % value;
    };
}

__target_intrinsic(cuda, "lfs_rounded_div")
float roundedDiv(float a, float b) {
    return spirv_asm {
        % value : $$float = OpFDiv $a $b;
        OpDecorate % value NoContraction;
result:
        $$float = OpCopyObject % value;
    };
}

float dotRounded(float3 a, float3 b) {
    return roundedAdd(roundedAdd(roundedMul(a.x, b.x), roundedMul(a.y, b.y)), roundedMul(a.z, b.z));
}
