# core module (CMake: src/core/CMakeLists.txt and its subdirectories)
#
#   lfs_logger.dll        logger + environment            (src/core/logger)
#   lfs_event_bridge.dll  cross-module singletons         (src/core/event_bridge)
#   lfs_core.dll          core + tensor library
#   core_cuda, tensor_kernels, nn_kernels: static CUDA libraries linked into lfs_core.dll

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:lfs.bzl", "lfs_cc_library", "lfs_cuda_library", "lfs_dll")
load("//bazel/gen:defs.bzl", "LFS_VERSION", "lfs_core_abi_stamp")

package(default_visibility = ["//:__subpackages__"])

#-------------------------------------------------------------------------------------
# Headers
#-------------------------------------------------------------------------------------

# Standalone so that //src/geometry:headers can use it without depending on all
# of core (core/events.hpp in turn includes geometry/bounding_box.hpp).
cc_library(
    name = "camera_types",
    hdrs = ["include/core/camera_types.h"],
    includes = ["include"],
)

# All headers of the core module (public include/ tree and internal headers of
# core/, core/cuda, core/tensor, core/nn, core/logger, core/event_bridge).
cc_library(
    name = "headers",
    hdrs = glob(
        [
            "**/*.h",
            "**/*.hpp",
            "**/*.cuh",
        ],
        exclude = ["include/core/camera_types.h"],
    ),
    # CMake: target_compile_definitions(lfs_core PUBLIC LFS_ALLOCATION_PROFILING_ENABLED=...)
    defines = ["LFS_ALLOCATION_PROFILING_ENABLED=0"],
    includes = [
        "event_bridge",
        "include",
        "nn",
        "tensor",
        "tensor/internal",
    ],
    deps = [
        ":camera_types",
        "//bazel/deps:cuda_headers",
        "//bazel/deps:openssl_headers",
        "//bazel/deps:spdlog_headers",
        "//bazel/deps:stb_headers",
        "//bazel/deps:xxhash_headers",
        "//src:generated_headers",
        "//src:root_includes",
        "//src/diagnostics:headers",
        "//src/geometry:headers",
        "@glm",
        "@nlohmann_json//:json",
    ],
)

# CMake: lfs_core_abi_stamp.h (cmake/GenerateCoreAbiStamp.cmake). The app refuses
# to start when the loaded lfs_core.dll was built from different core sources.
lfs_core_abi_stamp(
    name = "core_abi_stamp_h",
    srcs = glob([
        "**/*.cpp",
        "**/*.cu",
        "**/*.cuh",
        "**/*.hpp",
    ]) + ["BUILD.bazel"],
    out = "abi/lfs_core_abi_stamp.h",
    material = [
        LFS_VERSION,
        "Windows",
        "8",
        "MSVC",
        "NVIDIA",
    ] + select({
        "//bazel/config:dbg": ["Debug"],
        "//conditions:default": ["Release"],
    }),
    template = "//:cmake/lfs_core_abi_stamp.h.in",
)

cc_library(
    name = "core_abi_stamp",
    hdrs = [":core_abi_stamp_h"],
    includes = ["abi"],
)

#-------------------------------------------------------------------------------------
# lfs_logger.dll (leaf: breaks the lfs_core <-> lfs_event_bridge cycle)
#-------------------------------------------------------------------------------------

lfs_dll(
    name = "lfs_logger",
    srcs = [
        "environment.cpp",
        "logger.cpp",
    ],
    dll_name = "lfs_logger.dll",
    description = "LichtFeld Studio logging",
    export_define = "LFS_LOGGER_EXPORTS",
    interface_deps = [":headers"],
    deps = [
        "//src/diagnostics:lfs_diagnostics",
        "@spdlog",
        "@xxhash",
    ],
)

#-------------------------------------------------------------------------------------
# lfs_event_bridge.dll (solves singleton duplication between exe and Python module)
#-------------------------------------------------------------------------------------

lfs_dll(
    name = "lfs_event_bridge",
    srcs = [
        "event_bridge/command_center.cpp",
        "event_bridge/command_center_bridge.cpp",
        "event_bridge/control_boundary.cpp",
        "event_bridge/event_bridge.cpp",
        "event_bridge/localization_manager.cpp",
        "event_bridge/scoped_handler.cpp",
    ],
    dll_name = "lfs_event_bridge.dll",
    description = "LichtFeld Studio event bridge",
    export_define = "LFS_EVENT_BRIDGE_EXPORTS",
    interface_deps = [
        ":headers",
        "@cuda//:cuda_runtime",
    ],
    deps = [
        ":lfs_logger",
        "//src/geometry:lfs_geometry",
        "//src/training:headers",
        "@nlohmann_json//:json",
        "@spdlog",
    ],
)

#-------------------------------------------------------------------------------------
# Static CUDA libraries, linked privately into lfs_core.dll
#-------------------------------------------------------------------------------------

# CMake: lfs_core_cuda (memory arena, lanczos resize, core kernels)
lfs_cuda_library(
    name = "core_cuda_kernels",
    srcs = [
        "cuda/collision_voxelization.cu",
        "cuda/kernels/image_quantize.cu",
        "cuda/kernels/initial_scales.cu",
        "cuda/kernels/mask_normalization.cu",
        "cuda/kernels/selection_ops.cu",
        "cuda/kernels/sh_layout.cu",
        "cuda/kernels/splat_transform.cu",
        "cuda/lanczos_resize/lanczos_resize.cu",
        "cuda/memory_arena.cu",
        "cuda/sh_value_quant_kernels.cu",
        "cuda/tensor_debug.cu",
        "cuda/undistort/undistort.cu",
    ],
    includes = ["cuda"],
    deps = [
        ":headers",
        "@cuda//:cuda",
        "@cuda//:curand",
    ],
)

lfs_cc_library(
    name = "core_cuda",
    srcs = ["cuda/exportable_storage.cpp"],
    deps = [
        ":core_cuda_kernels",
        ":headers",
        "//src/diagnostics:lfs_diagnostics",
        "@cuda//:cuda",
        "@cuda//:curand",
        "@glm",
        "@spdlog",
    ],
)

_TENSOR_KERNEL_SRCS = [
    "tensor/tensor_dot_optimized.cu",
    "tensor/tensor_fused_pointwise.cu",
    "tensor/tensor_mask_compaction.cu",
    "tensor/tensor_masking_ops.cu",
    "tensor/tensor_matrix_ops.cu",
    "tensor/tensor_nn_ops.cu",
    "tensor/tensor_ops.cu",
    "tensor/tensor_random_ops.cu",
    "tensor/tensor_strided_ops.cu",
    "tensor/tensor_warp_reduce.cu",
]

# CMake: lfs_tensor_kernels (compiled with LFS_CORE_EXPORTS: linked into lfs_core.dll)
lfs_cuda_library(
    name = "tensor_kernels",
    srcs = _TENSOR_KERNEL_SRCS,
    host_copts = ["/bigobj"],
    includes = ["tensor"],
    local_defines = ["LFS_CORE_EXPORTS"],
    deps = [
        ":headers",
        ":tensor_kernels_o0",
        "//src/diagnostics:lfs_diagnostics",
        "@cuda//:curand",
    ],
)

# Windows nvcc ICE workaround of the CMake build: tensor_broadcast_ops.cu at -O0.
lfs_cuda_library(
    name = "tensor_kernels_o0",
    srcs = ["tensor/tensor_broadcast_ops.cu"],
    copts = ["-O0"],
    host_copts = ["/bigobj"],
    includes = ["tensor"],
    local_defines = ["LFS_CORE_EXPORTS"],
    deps = [
        ":headers",
        "@cuda//:curand",
    ],
)

# CMake: lfs_nn_kernels
lfs_cuda_library(
    name = "nn_kernels",
    srcs = [
        "nn/attention.cu",
        "nn/conv.cu",
        "nn/conv3x3_mma.cu",
        "nn/elementwise.cu",
        "nn/gemm.cu",
        "nn/lpips_kernels.cu",
    ],
    includes = ["nn"],
    local_defines = ["LFS_CORE_EXPORTS"],
    deps = [
        ":headers",
        "//src/diagnostics:lfs_diagnostics",
    ],
)

# CUDA sources that are part of lfs_core itself.
lfs_cuda_library(
    name = "core_dll_cuda",
    srcs = [
        "splat_data_mirror_centroid.cu",
        "tensor/tensor_exports.cu",
    ],
    alwayslink = True,
    host_copts = ["/bigobj"],
    includes = ["tensor"],
    local_defines = [
        "LFS_CORE_EXPORTS",
        "_USE_MATH_DEFINES",
    ],
    deps = [":headers"],
)

