+void Context::ProcessMouseButtonCancel(int button_index, int key_modifier_state)
+{
+	if (button_index != 0)
+		return;
+
+	const auto observe = [](const auto& chain) {
+		Vector<ObserverPtr<Element>> result;
+		result.reserve(chain.size());
+		for (Element* element : chain)
+			result.push_back(element->GetObserverPtr());
+		return result;
+	};
+	auto cancelled_active = observe(active_chain);
+	auto cancelled_hover = observe(hover_chain);
+	auto cancelled_drag_hover = observe(drag_hover_chain);
+	ObserverPtr<Element> cancelled_drag = drag && drag_started ? drag->GetObserverPtr() : nullptr;
+	ObserverPtr<Element> cancelled_clone = drag_clone ? drag_clone->GetObserverPtr() : nullptr;
+	const bool notify_drag_out = drag_started && drag_verbose;
+	Dictionary parameters;
+	GenerateMouseEventParameters(parameters);
+	GenerateKeyModifierEventParameters(parameters, key_modifier_state);
+	parameters["cancelled"] = true;
+
+	// Detach before pseudo-class hooks, clone removal, or event callbacks can reenter.
+	active = nullptr;
+	active_chain.clear();
+	hover = nullptr;
+	hover_chain.clear();
+	mouse_active = false;
+	last_click_element = nullptr;
+	last_click_time = 0;
+	drag = nullptr;
+	drag_hover = nullptr;
+	drag_hover_chain.clear();
+	drag_started = false;
+	drag_verbose = false;
+	drag_clone = nullptr;
+	if (cancelled_drag && drag != cancelled_drag.get())
+	{
+		parameters["drag_element"] = (void*)cancelled_drag.get();
+		cancelled_drag->DispatchEvent(EventId::Dragend, parameters);
+	}
+	if (cancelled_clone)
+	{
+		if (!drag_clone)
+			static_cast<ElementDocument&>(*cursor_proxy).SetStyleSheetContainer(nullptr);
+		if (cancelled_clone && cancelled_clone->GetParentNode() == cursor_proxy.get())
+			cursor_proxy->RemoveChild(cancelled_clone.get());
+	}
+	if (enable_cursor && !mouse_active)
+	{
+		String new_cursor_name;
+		if (scroll_controller->GetMode() == ScrollController::Mode::Autoscroll)
+			new_cursor_name = scroll_controller->GetAutoscrollCursor(mouse_position, density_independent_pixel_ratio);
+		if (new_cursor_name != cursor_name)
+		{
+			cursor_name = new_cursor_name;
+			GetSystemInterface()->SetMouseCursor(new_cursor_name);
+		}
+	}
+
+
+	// A callback may already have acquired the same element for a fresh interaction.
+	for (auto& element : cancelled_active)
+	{
+		if (element && std::find(active_chain.begin(), active_chain.end(), element.get()) == active_chain.end())
+			element->SetPseudoClass("active", false);
+	}
+	for (auto& element : cancelled_hover)
+	{
+		if (element && hover_chain.count(element.get()) == 0)
+			element->DispatchEvent(EventId::Mouseout, parameters);
+	}
+	if (notify_drag_out)
+	{
+		for (auto& element : cancelled_drag_hover)
+		{
+			parameters["drag_element"] = (void*)cancelled_drag.get();
+			if (element && drag_hover_chain.count(element.get()) == 0)
+				element->DispatchEvent(EventId::Dragout, parameters);
+		}
+	}
+}
