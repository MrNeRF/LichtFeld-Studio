diff --git a/lib/jxl/decode.cc b/lib/jxl/decode.cc
--- a/lib/jxl/decode.cc
+++ b/lib/jxl/decode.cc
@@ -849,12 +849,20 @@
   void* alloc =
       jxl::MemoryManagerAlloc(&local_memory_manager, sizeof(JxlDecoder));
   if (!alloc) return nullptr;
-  // Placement new constructor on allocated memory
+  const auto free_alloc = [&local_memory_manager](void* pointer) {
+    jxl::MemoryManagerFree(&local_memory_manager, pointer);
+  };
+  std::unique_ptr<void, decltype(free_alloc)> allocation(alloc, free_alloc);
+  // Release raw storage if construction throws, and members if setup throws.
   JxlDecoder* dec = new (alloc) JxlDecoder();
+  const auto destroy = [](JxlDecoder* pointer) { pointer->~JxlDecoder(); };
+  std::unique_ptr<JxlDecoder, decltype(destroy)> object(dec, destroy);
   dec->Initialize(local_memory_manager);
 
   JxlDecoderReset(dec);
 
+  object.release();
+  allocation.release();
   return dec;
 }
 
