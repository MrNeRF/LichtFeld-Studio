body.scrub-controls-demo {
    padding: 0;
    margin: 0;
}

.demo-shell {
    display: flex;
    flex-direction: column;
    gap: 12dp;
    padding: 16dp;
}

.demo-header {
    display: flex;
    flex-direction: column;
    gap: 4dp;
}

.demo-card {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    padding: 14dp;
}

.demo-actions {
    display: flex;
    gap: 8dp;
    justify-content: flex-end;
}
