body {
    padding: 16dp;
    margin: 0;
}

.hero {
    display: flex;
    justify-content: space-between;
    gap: 12dp;
    align-items: flex-start;
    padding-bottom: 12dp;
}

.hero-copy {
    display: flex;
    flex-direction: column;
    gap: 3dp;
}

.info-pill {
    min-height: 28dp;
    padding: 4dp 12dp;
}

.card {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    margin-top: 12dp;
    padding: 14dp;
}

.hybrid-input {
    min-width: 220dp;
}
