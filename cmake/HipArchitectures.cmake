include_guard(GLOBAL)

function(lfs_hip_architectures)
    option(LFS_HIP_PORTABLE "Build HIP code for all declared wave32 architectures" OFF)
    set(_portable gfx1010 gfx1011 gfx1012 gfx1030 gfx1031 gfx1032 gfx1033 gfx1034 gfx1035 gfx1036
        gfx1100 gfx1101 gfx1102 gfx1103 gfx1150 gfx1151 gfx1152 gfx1153 gfx1200 gfx1201)
    set(LFS_HIP_ARCHITECTURES "" CACHE STRING "HIP target list; empty uses the developer target")
    if(LFS_HIP_PORTABLE AND NOT LFS_HIP_ARCHITECTURES)
        set(_architectures ${_portable})
    elseif(LFS_HIP_ARCHITECTURES)
        set(_architectures ${LFS_HIP_ARCHITECTURES})
    else()
        set(_architectures ${LFS_HIP_ARCHITECTURE})
    endif()
    if(NOT _architectures)
        message(FATAL_ERROR "Set LFS_HIP_ARCHITECTURE or LFS_HIP_ARCHITECTURES")
    endif()
    list(REMOVE_DUPLICATES _architectures)
    set(_flags)
    foreach(_architecture IN LISTS _architectures)
        if(NOT _architecture IN_LIST _portable)
            message(FATAL_ERROR "Unsupported HIP wave32 target: ${_architecture}")
        endif()
        list(APPEND _flags "--offload-arch=${_architecture}")
    endforeach()
    list(JOIN _architectures "," _identity)
    set(LFS_HIP_EFFECTIVE_ARCHITECTURES "${_architectures}" PARENT_SCOPE)
    set(LFS_HIP_COMPILED_ARCHITECTURES "${_identity}" PARENT_SCOPE)
    set(LFS_HIP_OFFLOAD_FLAGS "${_flags}" PARENT_SCOPE)
endfunction()
