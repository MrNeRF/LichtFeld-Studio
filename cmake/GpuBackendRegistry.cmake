function(lfs_generate_backend_registry)
    set(_enabled)
    set(_standard)
    set(_declarations "")
    set(_registrations "")
    foreach(_backend IN ITEMS CUDA Vulkan Metal HIP)
        if(_backend STREQUAL "CUDA")
            set(_built "${LFS_HAS_CUDA}")
        elseif(_backend STREQUAL "Vulkan")
            set(_built "${LFS_TENSOR_VULKAN}")
        elseif(_backend STREQUAL "Metal")
            set(_built "${LFS_TENSOR_METAL}")
        else()
            set(_built "${LFS_TENSOR_HIP}")
        endif()
        if(_built)
            list(APPEND _enabled "GpuBackend::${_backend}")
            if(NOT _backend STREQUAL "HIP")
                list(APPEND _standard "GpuBackend::${_backend}")
            endif()
            string(TOLOWER "${_backend}" _name)
            string(APPEND _declarations "void register_${_name}_backend(BackendRegistry&);\n")
            string(APPEND _registrations "    register_${_name}_backend(registry);\n")
        endif()
    endforeach()
    if(LFS_HAS_CUDA)
        set(_defaults GpuBackend::CUDA)
    elseif(LFS_TENSOR_METAL AND LFS_TENSOR_VULKAN)
        set(_defaults GpuBackend::Metal GpuBackend::Vulkan)
    elseif(LFS_TENSOR_METAL)
        set(_defaults GpuBackend::Metal)
    elseif(LFS_TENSOR_VULKAN)
        set(_defaults GpuBackend::Vulkan)
    elseif(LFS_TENSOR_HIP)
        set(_defaults GpuBackend::HIP)
    else()
        set(_defaults GpuBackend::CUDA)
    endif()
    list(LENGTH _enabled _count)
    list(LENGTH _standard _standard_count)
    list(LENGTH _defaults _default_count)
    list(JOIN _enabled ", " _enabled_cpp)
    list(JOIN _standard ", " _standard_cpp)
    list(JOIN _defaults ", " _defaults_cpp)
    set(_header "// Generated by CMake; do not edit.\n#pragma once\nnamespace lfs::core {\ninline constexpr std::array<GpuBackend, ${_standard_count}> kStandardGpuBackends{${_standard_cpp}};\ninline constexpr std::array<GpuBackend, ${_count}> kCompiledGpuBackends{${_enabled_cpp}};\ninline constexpr std::array<GpuBackend, ${_default_count}> kDefaultGpuBackends{${_defaults_cpp}};\n}\n")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include/core")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/include/core/gpu_backend_config.hpp" CONTENT "${_header}" @ONLY)
    set(_source "// Generated by CMake; do not edit.\n#include \"core/tensor/backend/backend_driver.hpp\"\nnamespace lfs::core::internal {\n${_declarations}\nvoid register_compiled_backends(BackendRegistry& registry) {\n${_registrations}}\n}\n")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated_backend_registration.cpp" CONTENT "${_source}" @ONLY)
endfunction()
