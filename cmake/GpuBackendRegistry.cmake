function(lfs_generate_backend_registry)
    set(_enabled)
    set(_standard)
    set(_declarations "")
    set(_registrations "")
    set(_image_declarations "")
    set(_image_cases "")
    foreach(_backend IN ITEMS CUDA Vulkan Metal HIP)
        if(_backend STREQUAL "CUDA")
            set(_built "${LFS_HAS_CUDA}")
        elseif(_backend STREQUAL "Vulkan")
            set(_built "${LFS_TENSOR_VULKAN}")
        elseif(_backend STREQUAL "Metal")
            set(_built "${LFS_TENSOR_METAL}")
        elseif(_backend STREQUAL "HIP")
            set(_built "${LFS_TENSOR_HIP}")
        endif()
        if(_built)
            list(APPEND _enabled "GpuBackend::${_backend}")
            list(APPEND _standard "GpuBackend::${_backend}")
            string(TOLOWER "${_backend}" _name)
            if(_backend STREQUAL "CUDA")
                string(APPEND _image_declarations "const gpu_ops::SharedImageOps& ${_name}_shared_image_ops();\n")
                set(_address "&")
            else()
                string(APPEND _image_declarations "const gpu_ops::SharedImageOps* ${_name}_shared_image_ops();\n")
                set(_address "")
            endif()
            string(APPEND _image_cases "    case GpuBackend::${_backend}: return ${_address}${_name}_shared_image_ops();\n")
            string(APPEND _declarations "void register_${_name}_backend(BackendRegistry&);\n")
            string(APPEND _registrations "    register_${_name}_backend(registry);\n")
        endif()
    endforeach()
    if(LFS_HAS_CUDA)
        set(_defaults GpuBackend::CUDA)
    elseif(LFS_TENSOR_METAL AND LFS_TENSOR_VULKAN)
        set(_defaults GpuBackend::Metal GpuBackend::Vulkan)
    elseif(LFS_TENSOR_METAL)
        set(_defaults GpuBackend::Metal)
    elseif(LFS_TENSOR_VULKAN)
        set(_defaults GpuBackend::Vulkan)
    elseif(LFS_TENSOR_HIP)
        set(_defaults GpuBackend::HIP)
    else()
        set(_defaults GpuBackend::CUDA)
    endif()
    list(LENGTH _enabled _count)
    list(LENGTH _standard _standard_count)
    list(LENGTH _defaults _default_count)
    list(JOIN _enabled ", " _enabled_cpp)
    list(JOIN _standard ", " _standard_cpp)
    list(JOIN _defaults ", " _defaults_cpp)
    if(LFS_HAS_CUDA)
        set(_raw_storage "GpuBackend::CUDA")
        set(_pointer_probe "GpuBackend::CUDA")
    else()
        set(_raw_storage "GpuBackend::Vulkan")
        if(LFS_TENSOR_VULKAN)
            set(_pointer_probe "GpuBackend::Vulkan")
        else()
            set(_pointer_probe "GpuBackend::Metal")
        endif()
    endif()
    set(_header "// Generated by CMake; do not edit.\n#pragma once\nnamespace lfs::core {\ninline constexpr std::array<GpuBackend, ${_standard_count}> kStandardGpuBackends{${_standard_cpp}};\ninline constexpr std::array<GpuBackend, ${_count}> kCompiledGpuBackends{${_enabled_cpp}};\ninline constexpr std::array<GpuBackend, ${_default_count}> kDefaultGpuBackends{${_defaults_cpp}};\ninline constexpr GpuBackend kCompatibilityRawStorageBackend = ${_raw_storage};\ninline constexpr GpuBackend kCompatibilityPointerProbeBackend = ${_pointer_probe};\n}\n")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/include/core")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/include/core/gpu_backend_config.hpp" CONTENT "${_header}" @ONLY)
    set(_source "// Generated by CMake; do not edit.\n#include \"core/tensor/backend/backend_driver.hpp\"\nnamespace lfs::core::internal {\n${_declarations}\nvoid register_compiled_backends(BackendRegistry& registry) {\n${_registrations}}\n}\n")
    string(APPEND _source "\n#include \"core/shared_image_ops.hpp\"\nnamespace lfs::core {\n${_image_declarations}\nconst gpu_ops::SharedImageOps* shared_image_ops(GpuBackend backend) {\n    switch (backend) {\n${_image_cases}    default: return nullptr;\n    }\n}\n}\n")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated_backend_registration.cpp" CONTENT "${_source}" @ONLY)
    if(NOT TARGET lfs_backend_configuration)
        add_library(lfs_backend_configuration INTERFACE)
        target_include_directories(lfs_backend_configuration INTERFACE "${CMAKE_BINARY_DIR}/include")
    endif()
endfunction()
