include_guard(GLOBAL)

# Match the actual OS directory, not any dependency/build path named windows.
function(lfs_windows_system_library_regex output system_root)
    string(REPLACE "\\" "/" _root "${system_root}")
    string(REGEX REPLACE "/+$" "" _root "${_root}")
    if(NOT _root MATCHES "^[A-Za-z]:/")
        message(FATAL_ERROR "Expected an absolute Windows system root: ${system_root}")
    endif()
    set(_regex "^")
    set(_special "." "+" "*" "?" "^" "$" "(" ")" "[" "]" "{" "}" "|" "\\")
    string(LENGTH "${_root}" _length)
    math(EXPR _last "${_length} - 1")
    foreach(_index RANGE 0 ${_last})
        string(SUBSTRING "${_root}" ${_index} 1 _char)
        if(_char MATCHES "[A-Za-z]")
            string(TOLOWER "${_char}" _lower)
            string(TOUPPER "${_char}" _upper)
            string(APPEND _regex "[${_lower}${_upper}]")
        elseif(_char STREQUAL "/")
            string(APPEND _regex "[/\\\\]")
        elseif(_char IN_LIST _special)
            string(APPEND _regex "\\${_char}")
        else()
            string(APPEND _regex "${_char}")
        endif()
    endforeach()
    set(${output} "${_regex}[/\\\\].*" PARENT_SCOPE)
endfunction()
