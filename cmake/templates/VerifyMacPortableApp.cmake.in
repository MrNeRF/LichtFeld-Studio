# Verify that every installed Mach-O file has only app-relative or system links.
# CMAKE_INSTALL_PREFIX is set by cmake --install, including when --prefix is used.
set(_contents "${CMAKE_INSTALL_PREFIX}/@_lfs_macos_contents@")
set(_exe "${_contents}/MacOS/LichtFeld-Studio")
set(_icd "${_contents}/share/vulkan/icd.d/MoltenVK_icd.json")
set(_moltenvk "${_contents}/lib/libMoltenVK.dylib")
# These are the bundle's executable/driver contracts. Data resources are
# verified as complete inventories below, rather than by representative files.
foreach(_required IN ITEMS "${_exe}" "${_icd}" "${_moltenvk}" "${_contents}/Info.plist")
    if(NOT EXISTS "${_required}")
        message(FATAL_ERROR "Incomplete portable macOS app: ${_required} is missing")
    endif()
endforeach()

# CMake's actual installation manifest also covers generated files, helper
# executables and dependency libraries that are not in a source resource tree.
foreach(_installed IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
    if(NOT EXISTS "${_installed}")
        message(FATAL_ERROR "Missing installed file: ${_installed}")
    endif()
endforeach()

include("@CMAKE_SOURCE_DIR@/cmake/VerifyInstalledTree.cmake")
set(_resources "${_contents}/share/LichtFeld-Studio")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/visualizer/gui/assets"
    "${_resources}/assets" "*" "[.](md|icns)$")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/visualizer/gui/assets"
    "${_contents}/Resources" "*.icns" "")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/visualizer/gui/rmlui/resources"
    "${_resources}/assets/rmlui" "*" "")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/visualizer/gui/resources"
    "${_resources}" "*" "")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/python/lfs_plugins"
    "${_contents}/lib/python/lfs_plugins" "*.py" "(^|/)__pycache__(/|$)")
lfs_verify_installed_tree("@CMAKE_SOURCE_DIR@/src/python/stubs"
    "${_contents}/lib/python" "*" "(^|/)__pycache__(/|$)")
# All top-level Python helpers are installed beside the extension.
file(GLOB _helpers "@CMAKE_SOURCE_DIR@/src/python/*.py")
foreach(_helper IN LISTS _helpers)
    get_filename_component(_name "${_helper}" NAME)
    if(NOT EXISTS "${_contents}/lib/python/${_name}")
        message(FATAL_ERROR "Missing bundled Python helper: ${_name}")
    endif()
endforeach()
lfs_verify_installed_tree("@_lfs_portable_python_stdlib@"
    "${_contents}/lib/python3.12" "*"
    "(^|/)(__pycache__|test|tests|idle_test|tkinter|turtledemo|idlelib|lib2to3|ensurepip|unittest|lib-dynload)(/|$)|[.]pyc$")
lfs_verify_installed_tree("@_lfs_portable_python_stdlib@/lib-dynload"
    "${_contents}/lib/python3.12/lib-dynload" "*" "")
lfs_verify_installed_tree("@_LFS_VULKAN_RASTERIZER_SPV_DIR@"
    "${_resources}/shaders/vulkan_rasterizer" "*.spv" "")
file(GLOB _python_modules "${_contents}/lib/python/lichtfeld*.so")
if(NOT _python_modules)
    message(FATAL_ERROR "Missing bundled lichtfeld Python extension")
endif()

file(GLOB_RECURSE _candidates LIST_DIRECTORIES FALSE
    "${_contents}/MacOS/*" "${_contents}/lib/*")
foreach(_candidate IN LISTS _candidates)
    # otool can print diagnostics for text files while returning success.
    # Inspect the Mach-O magic before interpreting its output or signing it.
    file(READ "${_candidate}" _magic LIMIT 4 HEX)
    string(TOLOWER "${_magic}" _magic)
    if(NOT _magic MATCHES "^(cffaedfe|feedfacf|cafebabe|cafebabf)$")
        continue()
    endif()
    # Third-party libraries copied by GET_RUNTIME_DEPENDENCIES retain build-tree
    # LC_RPATH entries. Remove those from the copied file before validation.
    execute_process(COMMAND /usr/bin/otool -l "${_candidate}"
        RESULT_VARIABLE _otool_result OUTPUT_VARIABLE _load_commands ERROR_QUIET)
    if(NOT _otool_result EQUAL 0)
        message(FATAL_ERROR "Cannot inspect Mach-O load commands: ${_candidate}")
    endif()
    string(REPLACE "\n" ";" _load_lines "${_load_commands}")
    foreach(_line IN LISTS _load_lines)
        if(_line MATCHES "^[ \t]*path (/[^ \t]+) ")
            execute_process(COMMAND /usr/bin/install_name_tool -delete_rpath
                "${CMAKE_MATCH_1}" "${_candidate}" COMMAND_ERROR_IS_FATAL ANY)
        endif()
    endforeach()

    execute_process(COMMAND /usr/bin/otool -L "${_candidate}"
        RESULT_VARIABLE _otool_result OUTPUT_VARIABLE _links ERROR_QUIET)
    if(NOT _otool_result EQUAL 0)
        continue() # Python source, stubs and other non-Mach-O files.
    endif()
    string(REPLACE "\n" ";" _lines "${_links}")
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^[ \t]*(/[^ \t]+)[ \t]+[(]")
            set(_dependency "${CMAKE_MATCH_1}")
            if(NOT _dependency MATCHES "^/System/Library/" AND
               NOT _dependency MATCHES "^/usr/lib/")
                message(FATAL_ERROR "Non-portable dependency in ${_candidate}: ${_dependency}")
            endif()
        elseif(_line MATCHES "^[ \t]*@rpath/([^ \t]+)[ \t]+[(]")
            set(_rpath_name "${CMAKE_MATCH_1}")
            if(NOT EXISTS "${_contents}/lib/${_rpath_name}" AND
               NOT EXISTS "${_contents}/MacOS/${_rpath_name}")
                message(FATAL_ERROR "Missing bundled @rpath dependency in ${_candidate}: ${_rpath_name}")
            endif()
        endif()
    endforeach()
    execute_process(COMMAND /usr/bin/otool -l "${_candidate}"
        RESULT_VARIABLE _otool_result OUTPUT_VARIABLE _load_commands ERROR_QUIET)
    if(_otool_result EQUAL 0)
        string(REPLACE "\n" ";" _lines "${_load_commands}")
        foreach(_line IN LISTS _lines)
            if(_line MATCHES "^[ \t]*path (/[^ \t]+) ")
                message(FATAL_ERROR "Absolute rpath in ${_candidate}: ${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endif()
    list(APPEND _macho_files "${_candidate}")
endforeach()

# CMake may rewrite install rpaths and MoltenVK's install name. Sign the final
# installed Mach-O files, then seal the bundle so arm64 dyld accepts them.
foreach(_candidate IN LISTS _macho_files)
    execute_process(COMMAND /usr/bin/codesign --force --sign - "${_candidate}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()
get_filename_component(_app "${_contents}" DIRECTORY)
execute_process(COMMAND /usr/bin/codesign --force --sign - "${_app}"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${_app}"
    COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Verified and ad-hoc signed portable macOS app: ${_app}")
