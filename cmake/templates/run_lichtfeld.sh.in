SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
EXECUTABLE="$(realpath -e -- "$SCRIPT_DIR/@PROJECT_NAME@")" || exit 1
export LD_LIBRARY_PATH="${EXECUTABLE%/*}/../lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$EXECUTABLE" "$@"
