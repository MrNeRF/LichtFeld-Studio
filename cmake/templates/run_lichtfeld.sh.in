SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export LFS_LAUNCHER_LIBRARY_DIR="$SCRIPT_DIR/../lib"
export LD_LIBRARY_PATH="$LFS_LAUNCHER_LIBRARY_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$SCRIPT_DIR/@PROJECT_NAME@" "$@"
